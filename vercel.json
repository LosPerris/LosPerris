{
    "version": 2,
    "buildCommand": "npm run build",
    "installCommand": "npm install",
    "outputDirectory": "dist",
    "redirects": [
        {
            "source": "/apis",
            "destination": "/api",
            "permanent": true
        },
        {
            "source": "/twitch",
            "destination": "/api/twitch/",
            "permanent": true
        },
        {
            "source": "/api/twitch",
            "destination": "/api/twitch/",
            "permanent": true
        },
        {
            "source": "/api/qr",
            "destination": "/api/qr/",
            "permanent": true
        },
        {
            "source": "/api/valorant",
            "destination": "/api/valorant/",
            "permanent": true
        }
    ],
    "rewrites": [],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "upgrade-insecure-requests; frame-ancestors 'self'"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "SAMEORIGIN"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=63072000; includeSubDomains; preload"
                }
            ]
        }
    ]
}