{
    "version": 2,
    "buildCommand": "npm run build",
    "installCommand": "npm install",
    "outputDirectory": "dist",
    "redirects": [
        {
            "source": "/apis",
            "destination": "/api",
            "permanent": true
        },
        {
            "source": "/twitch",
            "destination": "/api/twitch/",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/api/twitch/:path*",
            "destination": "https://twitch-api-smoky.vercel.app/:path*"
        },
        {
            "source": "/api/qr/:path*",
            "destination": "https://generador-qr-lyart.vercel.app/:path*"
        },
        {
            "source": "/api/valorant/:path*",
            "destination": "https://los-perris-valorant-api.vercel.app/:path*"
        },
        {
            "source": "/malaworld/api/:path*",
            "destination": "http://23.230.3.241:25908/api/:path*"
        }
    ]
}