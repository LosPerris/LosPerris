{
    "version": 2,
    "buildCommand": "npm run build",
    "installCommand": "npm install",
    "outputDirectory": "dist",
    "redirects": [
        {
            "source": "/apis",
            "destination": "/api",
            "permanent": true
        },
        {
            "source": "/twitch",
            "destination": "/api/twitch/",
            "permanent": true
        },
        {
            "source": "/api/twitch",
            "destination": "/api/twitch/",
            "permanent": true
        },
        {
            "source": "/api/qr",
            "destination": "/api/qr/",
            "permanent": true
        },
        {
            "source": "/api/valorant",
            "destination": "/api/valorant/",
            "permanent": true
        }
    ],
    "rewrites": []
}