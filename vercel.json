{
    "version": 2,
    "buildCommand": "npm run build",
    "installCommand": "npm install",
    "outputDirectory": "dist",
    "redirects": [
        {
            "source": "/followage",
            "destination": "/followage/",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/js/(.*)",
            "destination": "https://followage-api.vercel.app/js/$1"
        },
        {
            "source": "/css/(.*)",
            "destination": "https://followage-api.vercel.app/css/$1"
        },
        {
            "source": "/imgs/(.*)",
            "destination": "https://followage-api.vercel.app/imgs/$1"
        },
        {
            "source": "/img/(.*)",
            "destination": "https://followage-api.vercel.app/imgs/$1"
        },
        {
            "source": "/followage",
            "destination": "https://followage-api.vercel.app/twitch/followage/"
        },
        {
            "source": "/followage/(.*)",
            "destination": "https://followage-api.vercel.app/twitch/followage/$1"
        },
        {
            "source": "/twitch/clips",
            "destination": "https://followage-api.vercel.app/twitch/clips"
        },
        {
            "source": "/twitch/clips/(.*)",
            "destination": "https://followage-api.vercel.app/twitch/clips/$1"
        },
        {
            "source": "/clips/(.*)",
            "destination": "https://followage-api.vercel.app/clips/$1"
        },
        {
            "source": "/channel/(.*)",
            "destination": "https://followage-api.vercel.app/channel/$1"
        },
        {
            "source": "/me",
            "destination": "https://followage-api.vercel.app/me"
        },
        {
            "source": "/channel/me",
            "destination": "https://followage-api.vercel.app/channel/me"
        },
        {
            "source": "/health",
            "destination": "https://followage-api.vercel.app/health"
        },
        {
            "source": "/auth/(.*)",
            "destination": "https://followage-api.vercel.app/api/app/auth/$1"
        },
        {
            "source": "/twitch/(.*)",
            "destination": "https://followage-api.vercel.app/twitch/$1"
        },
        {
            "source": "/twitch",
            "destination": "https://followage-api.vercel.app/"
        },
        {
            "source": "/valorantapi",
            "destination": "https://los-perris-valorant-api.vercel.app/"
        },
        {
            "source": "/valorantapi/(.*)",
            "destination": "https://los-perris-valorant-api.vercel.app/$1"
        },
        {
            "source": "/qr",
            "destination": "https://codigo-qr.vercel.app/"
        },
        {
            "source": "/qr/(.*)",
            "destination": "https://codigo-qr.vercel.app/$1"
        },
        {
            "source": "/LosPerris-gamer.ico",
            "destination": "https://codigo-qr.vercel.app/LosPerris-gamer.ico"
        }
    ]
}