{
    "version": 2,
    "buildCommand": "npm run build",
    "installCommand": "npm install",
    "outputDirectory": "dist",
    "redirects": [
        {
            "source": "/apis",
            "destination": "/api",
            "permanent": true
        },
        {
            "source": "/twitch",
            "destination": "/api/twitch/",
            "permanent": true
        },
        {
            "source": "/api/twitch",
            "destination": "/api/twitch/",
            "permanent": true
        },
        {
            "source": "/api/qr",
            "destination": "/api/qr/",
            "permanent": true
        },
        {
            "source": "/api/valorant",
            "destination": "/api/valorant/",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/api/twitch",
            "destination": "https://twitch-api-smoky.vercel.app/"
        },
        {
            "source": "/api/twitch/css/(.*)",
            "destination": "https://twitch-api-smoky.vercel.app/css/$1"
        },
        {
            "source": "/api/twitch/js/(.*)",
            "destination": "https://twitch-api-smoky.vercel.app/js/$1"
        },
        {
            "source": "/api/twitch/imgs/(.*)",
            "destination": "https://twitch-api-smoky.vercel.app/imgs/$1"
        },
        {
            "source": "/api/twitch/(.*)",
            "destination": "https://twitch-api-smoky.vercel.app/$1"
        },
        {
            "source": "/auth/(.*)",
            "destination": "https://twitch-api-smoky.vercel.app/auth/$1"
        },
        {
            "source": "/api/qr",
            "destination": "https://generador-qr-lyart.vercel.app/"
        },
        {
            "source": "/api/qr/styles/(.*)",
            "destination": "https://generador-qr-lyart.vercel.app/styles/$1"
        },
        {
            "source": "/api/qr/scripts/(.*)",
            "destination": "https://generador-qr-lyart.vercel.app/scripts/$1"
        },
        {
            "source": "/api/qr/LosPerris-gamer.ico",
            "destination": "https://generador-qr-lyart.vercel.app/LosPerris-gamer.ico"
        },
        {
            "source": "/api/qr/(.*)",
            "destination": "https://generador-qr-lyart.vercel.app/$1"
        },
        {
            "source": "/qr/(.*)",
            "destination": "https://generador-qr-lyart.vercel.app/$1"
        },
        {
            "source": "/api/valorant",
            "destination": "https://los-perris-valorant-api.vercel.app/"
        },
        {
            "source": "/api/valorant/style.css",
            "destination": "https://los-perris-valorant-api.vercel.app/style.css"
        },
        {
            "source": "/api/valorant/js/(.*)",
            "destination": "https://los-perris-valorant-api.vercel.app/js/$1"
        },
        {
            "source": "/api/valorant/imgs/(.*)",
            "destination": "https://los-perris-valorant-api.vercel.app/imgs/$1"
        },
        {
            "source": "/api/valorant/(.*)",
            "destination": "https://los-perris-valorant-api.vercel.app/$1"
        },
        {
            "source": "/valorantapi/(.*)",
            "destination": "https://los-perris-valorant-api.vercel.app/$1"
        },
        {
            "source": "/malaworld/api/(.*)",
            "destination": "http://23.230.3.241:25908/api/$1"
        }
    ]
}