{
  "name": "losperris",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "sync:updates": "node scripts/updates/sync.mjs",
    "prune:updates": "node scripts/updates/prune.mjs",
    "test:updates": "node --test scripts/updates/test/intent.test.mjs",
    "updates:verify": "pnpm test:updates && pnpm check",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,astro}": [
      "prettier --write",
      "astro check"
    ]
  },
  "dependencies": {
    "@astrojs/vercel": "^10.0.8",
    "@tailwindcss/vite": "^4.1.17",
    "astro": "^6.4.2",
    "lenis": "^1.3.23",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.2"
  }
}
