# Discord bots (invites)
PUBLIC_BOT_HELP_CLIENT_ID=
PUBLIC_BOT_GAME_CLIENT_ID=

# Webhook Discord (sección /maria / alertas de sync)
DISCORD_WEBHOOK_URL=
# Opcional: webhook solo para fallos del sync de actualizaciones (si no, usa DISCORD_WEBHOOK_URL)
UPDATES_ALERT_WEBHOOK=

# Local: token de lectura para pnpm sync:updates (repos privados). En CI usa UPDATE_SYNC_TOKEN en GitHub Secrets.
# GITHUB_TOKEN=

# true = build sin leer published.json (página /actualizaciones vacía en dev)
# SKIP_GITHUB_UPDATES=true
