# Discord bots (invites públicas)
PUBLIC_BOT_HELP_CLIENT_ID=
PUBLIC_BOT_GAME_CLIENT_ID=

# Webhook Discord para alertas (p. ej. fallos del sync de actualizaciones)
DISCORD_WEBHOOK_URL=
# Opcional: webhook solo para fallos del sync (si no, usa DISCORD_WEBHOOK_URL)
UPDATES_ALERT_WEBHOOK=

# Local: token de lectura para pnpm sync:updates (repos privados de APIs).
# En CI usa UPDATE_SYNC_TOKEN en GitHub Secrets. No commits este valor.
# GITHUB_TOKEN=

# true = build sin leer published.json (página /actualizaciones vacía en dev)
# SKIP_GITHUB_UPDATES=true
