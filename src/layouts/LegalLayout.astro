---
import Layout from "./Layout.astro";
import Button from "../components/ui/Button.astro";
import { Image } from "astro:assets";
import realImg from "../assets/img/Real.webp";
import BackgroundEffects from "../components/ui/BackgroundEffects.astro";
import BackButton from "../components/ui/BackButton.astro";
import { discordLink, domain } from "../data/community";

interface Props {
  title: string;
  pageTitlePrimary: string;
  pageTitleSecondary: string;
  pageIcon: string;
  lastUpdated: string;
  description: string;
}

const {
  title,
  pageTitlePrimary,
  pageTitleSecondary,
  pageIcon,
  lastUpdated,
  description,
} = Astro.props;
---

<Layout title={title}>
  <main class="flex-1 pt-32 pb-12 bg-[#050505] relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-8 relative z-10">
      <!-- Botón de Volver -->
      <BackButton />

      <div class="text-center mb-16">
        <h1
          class="text-3xl md:text-5xl font-bold mb-6 text-white flex flex-wrap items-center justify-center gap-x-4 gap-y-2 tracking-tight text-center"
        >
          <span class="flex items-center gap-3 justify-center">
            <i class={`${pageIcon} text-[#f97316]`}></i>
            {pageTitlePrimary}
          </span>
          <span class="text-[#f97316]">{pageTitleSecondary}</span>
        </h1>
        <p
          class="text-text-muted mb-4 text-sm font-mono border border-white/10 inline-block px-4 py-1 rounded-full bg-white/5"
        >
          Última actualización: <strong class="text-white">{lastUpdated}</strong
          >
        </p>
        <p
          class="text-xl text-text-secondary max-w-2xl mx-auto font-light mt-6"
        >
          {description}
        </p>
      </div>

      <div class="mb-12 space-y-6">
        <slot />
      </div>

      <div class="mt-12">
        <div
          class="bg-[#111111] border border-[#27272a] p-8 rounded-xl mb-12 flex items-center gap-6"
        >
          <div
            class="w-12 h-12 shrink-0 rounded-full bg-[#f97316]/10 flex items-center justify-center text-[#f97316] text-xl"
          >
            <i class="fas fa-check-circle"></i>
          </div>
          <p class="text-zinc-300 font-medium m-0 text-sm md:text-base">
            Al utilizar nuestros bots y APIs, confirmas que has leído, entendido
            y aceptado nuestras políticas.
          </p>
        </div>
        <div class="flex gap-4 justify-center flex-wrap">
          <Button href="/">
            <i class="fas fa-home mr-2"></i> Volver al Inicio
          </Button>
          <Button onclick="window.print()" variant="outline">
            <i class="fas fa-print mr-2"></i> Imprimir
          </Button>
        </div>
      </div>
    </div>
  </main>
</Layout>
