---
import Layout from "./Layout.astro";
import Button from "../components/ui/Button.astro";
import { Image } from "astro:assets";
import realImg from "../assets/img/Real.webp";
import BackgroundEffects from "../components/ui/BackgroundEffects.astro";
import { discordLink, domain } from "../data/community";

interface Props {
  title: string;
  pageTitlePrimary: string;
  pageTitleSecondary: string;
  pageIcon: string;
  lastUpdated: string;
  description: string;
}

const {
  title,
  pageTitlePrimary,
  pageTitleSecondary,
  pageIcon,
  lastUpdated,
  description,
} = Astro.props;
---

<Layout title={title} showHeader={false} showFooter={false}>
  <header
    class="sticky top-0 z-[100] backdrop-blur-md bg-[#050505]/95 border-b border-[#27272a] py-4"
  >
    <nav class="w-full">
      <div class="max-w-7xl mx-auto px-8 flex justify-between items-center">
        <div class="flex items-center gap-4">
          <Image
            src={realImg}
            alt="Los Perris Logo"
            class="w-10 h-10 rounded-full"
            width={40}
            height={40}
            loading="eager"
          />
          <span class="text-2xl font-bold text-white">LosPerris - Real</span>
        </div>
        <div class="nav-actions">
          <Button href="/" variant="outline">
            <i class="fas fa-arrow-left mr-2"></i> Volver al Inicio
          </Button>
        </div>
      </div>
    </nav>
  </header>

  <main class="flex-1 py-12 bg-[#050505] relative overflow-hidden">
    <BackgroundEffects />

    <div class="max-w-4xl mx-auto px-8 relative z-10">
      <div class="text-center mb-16">
        <h1
          class="text-3xl md:text-5xl font-bold mb-6 text-white flex flex-wrap items-center justify-center gap-x-4 gap-y-2 tracking-tight text-center"
        >
          <span class="flex items-center gap-3 justify-center">
            <i class={`${pageIcon} text-[#f97316]`}></i>
            {pageTitlePrimary}
          </span>
          <span class="text-[#f97316]">{pageTitleSecondary}</span>
        </h1>
        <p
          class="text-text-muted mb-4 text-sm font-mono border border-white/10 inline-block px-4 py-1 rounded-full bg-white/5"
        >
          Última actualización: <strong class="text-white">{lastUpdated}</strong
          >
        </p>
        <p
          class="text-xl text-text-secondary max-w-2xl mx-auto font-light mt-6"
        >
          {description}
        </p>
      </div>

      <div class="mb-12 space-y-6">
        <slot />
      </div>

      <div class="mt-12">
        <div
          class="bg-[#111111] border border-[#27272a] p-8 rounded-xl mb-12 flex items-center gap-6"
        >
          <div
            class="w-12 h-12 shrink-0 rounded-full bg-[#f97316]/10 flex items-center justify-center text-[#f97316] text-xl"
          >
            <i class="fas fa-check-circle"></i>
          </div>
          <p class="text-zinc-300 font-medium m-0 text-sm md:text-base">
            Al utilizar nuestros bots y APIs, confirmas que has leído, entendido
            y aceptado nuestras políticas.
          </p>
        </div>
        <div class="flex gap-4 justify-center flex-wrap">
          <Button href="/">
            <i class="fas fa-home mr-2"></i> Volver al Inicio
          </Button>
          <Button onclick="window.print()" variant="outline">
            <i class="fas fa-print mr-2"></i> Imprimir
          </Button>
        </div>
      </div>
    </div>
  </main>

  <footer class="bg-[#050505] py-8 border-t border-[#27272a] mt-auto">
    <div class="max-w-4xl mx-auto px-8">
      <div
        class="flex justify-between items-center flex-wrap gap-4 text-center"
      >
        <p class="text-text-muted">
          &copy; {new Date().getFullYear()}
          {domain}. Todos los derechos reservados.
        </p>
        <div class="flex gap-8">
          <a
            href="/"
            class="text-text-muted no-underline transition-all hover:text-white"
            >Inicio</a
          >
          <a
            href="/terminos"
            class="text-text-muted no-underline transition-all hover:text-white"
            >Términos y Condiciones</a
          >
          <a
            href={discordLink}
            class="text-text-muted no-underline transition-all hover:text-white"
            >Discord</a
          >
        </div>
      </div>
    </div>
  </footer>
</Layout>
