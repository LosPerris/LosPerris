---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title: string;
    showHeader?: boolean;
    showFooter?: boolean;
}

const { title, showHeader = true, showFooter = true } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="description"
            content="LosPerris - Real - Página Oficial. Bots para Discord con moderación avanzada y gaming completo."
        />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/png" href="/img/Real-icon.png" />
        <meta name="generator" content={Astro.generator} />
        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
            rel="stylesheet"
        />
        <title>{title}</title>
    </head>
    <body>
        {showHeader && <Header />}
        <slot />
        {showFooter && <Footer />}
        <script src="/js/script.js" is:inline></script>
    </body>
</html>
