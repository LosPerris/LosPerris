---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import BackgroundEffects from "../components/ui/BackgroundEffects.astro";

interface Props {
    title: string;
    showHeader?: boolean;
    showFooter?: boolean;
    showWallpaper?: boolean;
}

const {
    title,
    showHeader = true,
    showFooter = true,
    showWallpaper = true,
} = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="description"
            content="LosPerris - Real - Página Oficial. Bots para Discord con moderación avanzada y gaming completo."
        />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/png" href="/img/Real-icon.png" />
        <meta name="generator" content={Astro.generator} />
        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
            rel="stylesheet"
        />
        <title>{title}</title>
    </head><body
        class="bg-[#151515] min-h-screen relative text-white selection:bg-[#5865F2] selection:text-white overflow-x-hidden"
    >
        <div
            class="absolute top-0 inset-x-0 h-[110vh] overflow-hidden -z-10 pointer-events-none"
            style="mask-image: linear-gradient(to bottom, black 85%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 85%, transparent 100%);"
        >
            <BackgroundEffects
                withWallpaper={showWallpaper}
                variant="hero"
                showBlobs={true}
            />
        </div>
        {showHeader && <Header />}
        <slot />
        {showFooter && <Footer />}
        <script src="/js/script.js" is:inline></script>
    </body>
</html>
