---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import BackgroundEffects from "../components/ui/BackgroundEffects.astro";

interface Props {
  title: string;
  description?: string;
  showHeader?: boolean;
  showFooter?: boolean;
  showWallpaper?: boolean;
}

const {
  title,
  description = "LosPerris | Bots de Moderación y Gaming para Discord. Mejora tu servidor con herramientas avanzadas y estadísticas en tiempo real.",
  showHeader = true,
  showFooter = true,
  showWallpaper = true,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f97316" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={`https://losperris.dev${Astro.url.pathname}`} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://losperris.dev/icon.webp" />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://losperris.dev/icon.webp" />

    <link rel="icon" type="image/webp" href="/icon.webp" />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
      rel="stylesheet"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
      media="print"
      onload="this.media='all'"
    />
    <noscript
      ><link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
      /></noscript
    >
    <ClientRouter />
  </head>
  <body
    class="bg-[#151515] min-h-screen relative text-white selection:bg-[#f97316] selection:text-white overflow-x-hidden"
  >
    <div
      class="absolute top-0 inset-x-0 h-[110vh] overflow-hidden -z-10 pointer-events-none"
      style="mask-image: linear-gradient(to bottom, black 85%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 85%, transparent 100%);"
    >
      <BackgroundEffects
        withWallpaper={showWallpaper}
        variant="hero"
        showBlobs={false}
      />
    </div>
    {showHeader && <Header />}
    <slot />
    {showFooter && <Footer />}

    <script>
      import "../scripts/menu.ts";
      import "../scripts/lenis.ts";
    </script>
  </body>
</html>
