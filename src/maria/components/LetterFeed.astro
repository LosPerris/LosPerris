---
import SunflowerLogo from "./logo/SunflowerLogo.astro";

const reasons = [
  "Trajiste luz a los rincones oscuros de mi vida.",
  "No hay distancia que pueda apagar lo que siento por ti.",
  "Me haces soñar con un futuro donde despertamos juntos.",
  "Cada mensaje tuyo es un abrazo a mi alma.",
  "Amo la manera en la que haces que todo parezca más sencillo.",
  "Eres mi paz, mi locura y mi razón favorita de todas.",
  "La vida es mucho más bonita desde que tiene tu nombre.",
  "Me enseñaste que el amor a distancia te enseña a amar con el alma entera.",
  "Tu sonrisa es el único faro que necesito en mis días grises.",
  "Quiero ser quien riegue tus girasoles incluso en tus días de sequía.",
];

interface Props {
  message: string;
  dayNumber: number;
}

const { message, dayNumber } = Astro.props;

const todayFull = new Date().toLocaleDateString("es-ES", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});
const todayShort = new Date().toLocaleDateString("es-ES", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
---

<div class="w-full flex flex-col items-center gap-10 md:gap-24 pb-40 md:pb-48">
  {/* The Main Letter (Leather Notebook Style) */}
  <section
    id="maria-diary-stage"
    class="relative w-full max-w-[900px] mx-auto flex items-center justify-center mb-6 md:mb-12 animate-fade-in-up md:w-[95%] md:aspect-[1.4]"
    style="perspective: 2000px;"
  >
    <div
      id="book-wrapper"
      class="relative w-full h-full transition-transform duration-[1200ms] ease-in-out md:-translate-x-1/4"
    >
      {
        /* Interactive Cover State (Closed Rustic Leather Journal - Photorealistic) */
      }
      <div
        id="diary-cover"
        class="absolute inset-y-0 right-0 w-1/2 z-40 group origin-left transition-all duration-[1200ms] ease-in-out outline-none focus:outline-none"
      >
        <div
          class="absolute top-2.5 bottom-1 -right-2.5 left-2 rounded-r-sm rounded-bl-sm"
          style="background-color: #e8dec3; box-shadow: 1px 1px 0 #dfd4b6, 2px 2px 0 #d1c5a5, 3px 3px 0 #c4b591, inset 5px 5px 15px rgba(0,0,0,0.6);"
        >
          <div
            class="absolute inset-0 bg-[repeating-linear-gradient(to_bottom,transparent,transparent_1px,rgba(0,0,0,0.2)_2px)] opacity-30 rounded-r-sm rounded-bl-sm"
          >
          </div>
          <div
            class="absolute inset-0 bg-[repeating-linear-gradient(to_right,transparent,transparent_1px,rgba(0,0,0,0.2)_2px)] opacity-30 rounded-r-sm rounded-bl-sm"
          >
          </div>
        </div>

        <div
          class="absolute inset-0 rounded-r-lg rounded-l-md"
          style="background-color: #442312; box-shadow: inset 0 0 100px rgba(0,0,0,0.9), inset 0 2px 3px rgba(255,255,255,0.1), 0 30px 60px -15px rgba(0,0,0,0.8);"
        >
          <div
            class="absolute inset-0 rounded-r-lg rounded-l-md pointer-events-none opacity-[0.8] mix-blend-multiply leather-texture"
          >
          </div>

          <div
            class="absolute inset-2 border-[2px] border-dashed border-[#8b6b43] rounded-r-md pointer-events-none opacity-60"
            style="filter: drop-shadow(0px 1px 1px rgba(0,0,0,0.8));"
          >
          </div>
          <div
            class="absolute inset-y-2 left-4 md:left-8 border-l-[2px] border-dashed border-[#8b6b43] pointer-events-none opacity-60"
            style="filter: drop-shadow(0px 1px 1px rgba(0,0,0,0.8));"
          >
          </div>

          <div
            class="absolute top-0 bottom-0 left-4 md:left-8 w-[2px] bg-gradient-to-r from-black/40 to-transparent pointer-events-none"
          >
          </div>
        </div>

        <div
          id="snap-strap"
          class="absolute top-1/2 -translate-y-1/2 right-0 w-12 h-10 md:w-24 md:h-14 rounded-l-full z-50 flex items-center justify-start pl-2.5 md:pl-4 cursor-pointer origin-right group/strap outline-none focus:outline-none"
          style="background-color: #3a1d0f; box-shadow: inset 0 0 15px rgba(0,0,0,0.9), inset -1px 1px 1px rgba(255,255,255,0.1), -5px 0 10px rgba(0,0,0,0.6);"
        >
          <div
            class="absolute inset-0 rounded-l-full pointer-events-none opacity-[0.8] mix-blend-multiply leather-texture"
          >
          </div>
          <div
            class="absolute inset-1.5 border-y-[2px] border-l-[2px] border-dashed border-[#8b6b43] rounded-l-full pointer-events-none opacity-60"
            style="filter: drop-shadow(0px 1px 1px rgba(0,0,0,0.8));"
          >
          </div>

          <div
            class="w-4 h-4 md:w-6 md:h-6 rounded-full bg-[#4a3a2a] shadow-[inset_0_-2px_4px_rgba(0,0,0,0.8),inset_0_2px_4px_rgba(255,255,255,0.2),0_4px_6px_rgba(0,0,0,0.6)] border border-[#1a110a] flex items-center justify-center group-hover/strap:shadow-[0_8px_12px_rgba(0,0,0,0.7)] group-hover/strap:scale-110 transition-all duration-300"
            style="will-change: transform, box-shadow;"
          >
            <div
              class="w-2.5 h-2.5 md:w-3 md:h-3 rounded-full border border-black/60 opacity-60 shadow-[inset_0_1px_1px_rgba(0,0,0,0.5)]"
            >
            </div>
          </div>
        </div>

        <div
          class="relative z-20 flex flex-col items-center justify-center h-full w-full pl-2 pr-6 md:pl-8 md:pr-0 pb-16 md:pb-64 text-center pointer-events-none"
        >
          <div
            class="maria-cover-mark text-[#d4af37] mb-4 md:mb-6 opacity-90"
            style="filter: drop-shadow(0px -1px 1px rgba(0,0,0,0.9)) drop-shadow(0px 1px 1px rgba(255,255,255,0.2));"
          >
            <SunflowerLogo />
          </div>
          <h3
            class="font-serif text-[11px] md:text-3xl text-[#d4af37] opacity-90 tracking-[0.1em] md:tracking-[0.2em] uppercase font-bold whitespace-nowrap"
            style="text-shadow: 0px -1px 1px rgba(0,0,0,0.9), 0px 1px 1px rgba(255,255,255,0.2);"
          >
            El Diario
          </h3>
          <p
            class="maria-cover-vol text-[#d4af37] opacity-70 text-[8px] md:text-[9px] tracking-[0.4em] uppercase font-bold mt-4 md:mt-8"
            style="text-shadow: 0px -1px 1px rgba(0,0,0,0.9), 0px 1px 1px rgba(255,255,255,0.2);"
          >
            VOL. I
          </p>
        </div>
      </div>

      {/* Hidden Content State (Open Photorealistic Leather Journal) */}
      <div
        id="diary-content"
        class="absolute inset-0 z-10 opacity-0 pointer-events-none transition-all duration-1000 ease-in-out flex w-full h-full rounded-lg py-2 px-2 md:py-10 md:px-8 invisible"
        style="background-color: #3a1e10; box-shadow: inset 0 0 100px rgba(0,0,0,0.9), inset 0 1px 2px rgba(255,255,255,0.1), 0 30px 60px -15px rgba(0,0,0,1);"
      >
        <div
          class="absolute inset-0 rounded-lg pointer-events-none opacity-[0.8] mix-blend-multiply leather-texture"
        >
        </div>

        <div
          class="absolute inset-1.5 border-[2px] border-dashed border-[#8b6b43] rounded-md pointer-events-none z-10 opacity-60"
          style="filter: drop-shadow(0px 1px 1px rgba(0,0,0,0.8));"
        >
        </div>

        <div
          id="close-strap"
          class="flex absolute top-1/2 -translate-y-1/2 -right-5 md:-right-20 w-8 md:w-24 h-7 md:h-14 rounded-r-full shadow-[8px_8px_20px_rgba(0,0,0,0.7)] z-0 items-center justify-end pr-1 md:pr-4 cursor-pointer origin-right group/close outline-none focus:outline-none"
          style="background-color: #3a1d0f; box-shadow: inset 0 0 15px rgba(0,0,0,0.9), inset 0 1px 1px rgba(255,255,255,0.1), 8px 8px 20px rgba(0,0,0,0.7); outline: 1px solid transparent;"
        >
          <div
            class="absolute inset-0 rounded-r-full pointer-events-none opacity-[0.8] mix-blend-multiply leather-texture"
          >
          </div>
          <div
            class="absolute inset-1.5 border-y-[2px] border-r-[2px] border-dashed border-[#8b6b43] rounded-r-full pointer-events-none opacity-60"
            style="filter: drop-shadow(0px 1px 1px rgba(0,0,0,0.8));"
          >
          </div>

          <div
            class="w-5 h-5 md:w-6 md:h-6 rounded-full bg-[#4a3a2a] shadow-[inset_0_-2px_4px_rgba(0,0,0,0.8),0_4px_6px_rgba(0,0,0,0.6)] border border-[#1a110a] flex items-center justify-center group-hover/close:shadow-[0_8px_12px_rgba(0,0,0,0.7)] transition-all duration-300"
            style="will-change: transform, box-shadow;"
          >
            <div
              class="w-2.5 h-2.5 md:w-3 md:h-3 rounded-full border border-black/60 opacity-60"
            >
            </div>
          </div>
        </div>

        <div
          class="hidden md:flex absolute top-1/2 -translate-y-1/2 left-3 w-8 h-8 rounded-full z-20 items-center justify-center"
        >
          <div
            class="w-5 h-5 rounded-full bg-[#1a110a] shadow-[inset_0_2px_5px_rgba(0,0,0,0.9),0_1px_1px_rgba(255,255,255,0.1)] border border-[#3a2a1a] flex items-center justify-center"
          >
            <div
              class="w-2.5 h-2.5 rounded-full bg-[#4a3a2a] shadow-[inset_0_1px_2px_rgba(0,0,0,0.8)]"
            >
            </div>
          </div>
        </div>

        <div
          class="relative w-full h-full rounded-sm flex z-20 overflow-hidden"
          style="background: linear-gradient(to right, #ded0af, #e6dbc3 2%, #e6dbc3 98%, #ded0af); box-shadow: 0px 1px 0px #e1d3b9, 0px 2px 0px #dccba9, 0px 3px 0px #e1d3b9, 0px 4px 0px #dccba9, -1px 0px 0px #e1d3b9, -2px 0px 0px #dccba9, -3px 0px 0px #e1d3b9, -4px 0px 0px #dccba9, 1px 0px 0px #e1d3b9, 2px 0px 0px #dccba9, 3px 0px 0px #e1d3b9, 4px 0px 0px #dccba9, 0 15px 30px rgba(0,0,0,0.6), inset 0 0 40px rgba(139,107,67,0.12);"
        >
          <div
            class="absolute inset-0 pointer-events-none opacity-[0.4] mix-blend-multiply z-30"
            style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%221.5%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"
          >
          </div>

          <div
            class="maria-fold-line absolute top-0 bottom-0 left-1/2 w-[1px] -translate-x-1/2 bg-[#5c4a3d]/10 z-40 shadow-[0_0_8px_rgba(0,0,0,0.15)] flex flex-col items-center"
          >
            <div
              class="absolute inset-y-0 border-l-[2px] border-dashed border-[#8b6b43] pointer-events-none opacity-60"
              style="filter: drop-shadow(0px 1px 1px rgba(0,0,0,0.4));"
            >
            </div>
          </div>

          <div
            class="maria-fold-line absolute top-0 bottom-0 left-1/2 w-12 bg-gradient-to-r from-[rgba(0,0,0,0.08)] to-transparent pointer-events-none z-30"
          >
          </div>
          <div
            class="maria-fold-line absolute top-0 bottom-0 right-1/2 w-12 bg-gradient-to-l from-[rgba(0,0,0,0.08)] to-transparent pointer-events-none z-30"
          >
          </div>

          <div
            class="maria-fold-line absolute top-0 bottom-0 left-1/2 ml-4 w-12 bg-gradient-to-r from-[rgba(255,255,255,0.25)] to-transparent pointer-events-none z-30"
          >
          </div>
          <div
            class="maria-fold-line absolute top-0 bottom-0 right-1/2 mr-4 w-12 bg-gradient-to-l from-[rgba(255,255,255,0.25)] to-transparent pointer-events-none z-30"
          >
          </div>

          <div
            class="absolute top-0 bottom-0 right-0 w-8 bg-gradient-to-l from-[rgba(0,0,0,0.08)] to-transparent pointer-events-none z-30"
          >
          </div>
          <div
            class="absolute top-0 bottom-0 left-0 w-8 bg-gradient-to-r from-[rgba(0,0,0,0.08)] to-transparent pointer-events-none z-30"
          >
          </div>

          <div
            id="diary-left-page"
            class="absolute left-0 w-1/2 h-full flex flex-col items-center justify-center pt-4 md:pt-12 border-r border-[#c4b599]/60 z-10 px-1 md:px-4"
          >
            <div
              class="border-[2.5px] border-[#8b3a3a] rounded-full p-1.5 md:p-2 mb-4 md:mb-12 flex items-center justify-center stamp-element opacity-0"
              style="--rotate: rotate(-15deg); --final-opacity: 0.4; animation-delay: 0.5s;"
            >
              <SunflowerLogo
                width="24"
                height="24"
                stroke-width="1.8"
                class="text-[#8b3a3a]"
              />
            </div>

            <div class="flex flex-col items-center gap-3 md:gap-6">
              <div
                class="border-2 border-[#8b3a3a] px-1.5 py-0.5 md:px-4 md:py-2 stamp-element opacity-0"
                style="--rotate: rotate(5deg); --final-opacity: 0.6; animation-delay: 1.2s;"
              >
                <p
                  class="font-bold tracking-widest text-[#8b3a3a] text-[7px] md:text-xs uppercase"
                  style="font-family: 'Special Elite', monospace;"
                >
                  Libreta de Girasoles
                </p>
                <p
                  class="text-[#8b3a3a] text-[7px] md:text-xs mt-0.5 md:mt-1"
                  style="font-family: 'Special Elite', monospace;"
                >
                  <span id="today-short-date" class="md:hidden"
                    >{todayShort}</span
                  >
                  <span id="today-full-date" class="hidden md:inline"
                    >{todayFull}</span
                  >
                </p>
              </div>

              <div
                class="border-2 border-[#8b3a3a] px-2 py-0.5 md:px-6 md:py-1.5 stamp-element opacity-0"
                style="--rotate: rotate(-3deg); --final-opacity: 0.6; animation-delay: 1.9s;"
              >
                <p
                  id="day-number-text"
                  class="font-bold tracking-widest text-[#8b3a3a] text-[10px] md:text-sm uppercase"
                  style="font-family: 'Special Elite', monospace;"
                >
                  Día {dayNumber}
                </p>
              </div>
            </div>
          </div>

          <div
            id="page-turner"
            class="absolute right-0 w-1/2 h-full z-20 origin-left transition-transform duration-[1500ms] ease-in-out"
            style="transform-style: preserve-3d;"
          >
            <div
              id="message-face"
              class="absolute inset-0 w-full h-full flex flex-col pt-4 pb-3 pl-3 pr-3 md:pt-16 md:pb-10 md:pl-12 md:pr-16 overflow-hidden"
              style="backface-visibility: hidden; -webkit-backface-visibility: hidden; background: linear-gradient(225deg, transparent 28px, #e4d8c0 28px);"
            >
              <div
                id="turn-page-btn"
                class="absolute top-0 right-0 w-[35px] h-[35px] md:w-[50px] md:h-[50px] cursor-pointer group z-50 opacity-0 transition-opacity duration-500 pointer-events-none"
              >
                <div
                  class="absolute inset-0 bg-[#d2c3aa] shadow-[-2px_2px_4px_rgba(0,0,0,0.2)] transition-colors duration-300 group-hover:bg-[#c6b394]"
                  style="clip-path: polygon(0 0, 100% 100%, 0 100%);"
                >
                </div>
                <svg
                  class="absolute bottom-2 left-2 w-4 h-4 text-[#8b3a3a] opacity-60 group-hover:opacity-100 transition-opacity duration-300"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg
                >
              </div>

              <div
                id="message-container"
                class="flex-grow overflow-hidden pr-2 flex flex-col justify-start"
              >
                <div
                  id="message-wrapper"
                  style="overflow-wrap: break-word; word-break: break-word;"
                >
                  <span
                    class="text-[#1a1510] leading-relaxed opacity-90"
                    style="font-size: clamp(15px, 4.2vw, 28px); font-family: 'Caveat', cursive; white-space: pre-wrap;"
                    id="daily-message-text"
                    data-text={message}></span>
                </div>
              </div>

              <footer
                class="w-full flex flex-col items-end gap-1 md:gap-2 mt-2 md:mt-4 opacity-80 shrink-0"
              >
                <span
                  id="right-signature"
                  data-text="Siempre tuyo, Ponss"
                  class="text-[#1a1510] text-sm md:text-3xl min-h-[1.2em] md:min-h-[1.5em] whitespace-nowrap"
                  style="font-family: 'Caveat', cursive;"></span>
                <div
                  id="right-signature-line"
                  class="w-24 md:w-40 h-[1px] bg-[#1a1510]/20 mt-0.5 md:mt-1 opacity-0 transition-opacity duration-500"
                >
                </div>
              </footer>
            </div>

            <div
              class="absolute inset-0 w-full h-full flex flex-col pt-4 px-2 pb-2.5 md:pt-16 md:px-12 md:pb-4 overflow-hidden"
              style="backface-visibility: hidden; -webkit-backface-visibility: hidden; transform: rotateY(180deg); background: linear-gradient(135deg, transparent 28px, #e1d3b9 28px);"
            >
              <div
                id="turn-back-btn"
                class="absolute top-0 left-0 w-[35px] h-[35px] md:w-[50px] md:h-[50px] cursor-pointer group z-50"
              >
                <div
                  class="absolute inset-0 bg-[#d2c3aa] shadow-[inset_-2px_-2px_4px_rgba(0,0,0,0.2)] transition-colors duration-300 group-hover:bg-[#c6b394]"
                  style="clip-path: polygon(0 0, 100% 0, 0 100%);"
                >
                </div>

                <svg
                  class="absolute bottom-2 right-2 w-4 h-4 text-[#8b3a3a] opacity-60 group-hover:opacity-100 transition-opacity duration-300"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg
                >
              </div>

              <div class="text-center mb-1.5 md:mb-6 shrink-0">
                <h2
                  id="reasons-title"
                  class="text-[#1a1510] text-base md:text-4xl opacity-90 min-h-[1em] leading-tight"
                  style="font-family: 'Caveat', cursive;"
                  data-text="Por qué te amo..."
                  aria-label="Por qué te amo..."
                >
                </h2>
                <div
                  id="reasons-title-line"
                  class="w-12 md:w-16 h-[1px] bg-[#8b3a3a]/30 mx-auto mt-1 md:mt-2 opacity-0 transition-opacity duration-500"
                >
                </div>
              </div>

              <div
                id="reasons-left-list"
                class="w-full flex-1 min-h-0 flex flex-col justify-start gap-0.5 md:gap-3 mt-0.5 md:mt-2 overflow-y-auto overscroll-contain custom-scrollbar"
              >
                {
                  reasons.slice(0, 5).map((reason, index) => (
                    <div class="flex items-start gap-1 md:gap-3">
                      <span
                        class="reason-number text-[#8b3a3a] font-bold font-serif opacity-70 text-[10px] md:text-[20px] mt-0.5 md:mt-1 w-3 md:w-8 flex-shrink-0"
                        data-text={`${index + 1}.`}
                      />
                      <p
                        class="reason-text text-[#1a1510] text-[10px] md:text-[20px] min-h-[1.15em] leading-[1.15] md:leading-tight opacity-90"
                        style="font-family: 'Caveat', cursive;"
                        data-text={reason}
                      />
                    </div>
                  ))
                }
              </div>
            </div>
          </div>

          <div
            id="diary-right-reasons"
            class="absolute right-0 w-1/2 h-full flex flex-col pt-5 pb-3 pl-2.5 pr-3 md:pt-8 md:pb-4 md:pl-12 md:pr-16 z-10 overflow-hidden"
          >
            <div
              id="reasons-right-list"
              class="w-full flex-1 min-h-0 flex flex-col justify-start gap-0.5 md:gap-3 mt-1 md:mt-6 overflow-y-auto overscroll-contain custom-scrollbar"
            >
              {
                reasons.slice(5, 10).map((reason, index) => (
                  <div class="flex items-start gap-1 md:gap-3">
                    <span
                      class="reason-number text-[#8b3a3a] font-bold font-serif opacity-70 text-[10px] md:text-[20px] mt-0.5 md:mt-1 w-3 md:w-8 flex-shrink-0"
                      data-text={`${index + 6}.`}
                    />
                    <p
                      class="reason-text text-[#1a1510] text-[10px] md:text-[20px] min-h-[1.15em] leading-[1.15] md:leading-tight opacity-90"
                      style="font-family: 'Caveat', cursive;"
                      data-text={reason}
                    />
                  </div>
                ))
              }
            </div>
          </div>

          {/* Safari/iOS: panel plano (sin rotateY) + tipografía progresiva */}
          <div
            id="mobile-reasons-panel"
            class="absolute inset-0 z-[60] hidden flex-col px-3 pt-4 pb-3 md:hidden"
            style="background: linear-gradient(90deg, #d8c9a8 0%, #e6dbc3 10%, #e1d3b9 100%); -webkit-overflow-scrolling: touch;"
            aria-hidden="true"
          >
            {/* Sombra de pliegue / lomo a la izquierda (hoja doblada) */}
            <div
              class="pointer-events-none absolute inset-y-0 left-0 w-5 z-[1]"
              style="background: linear-gradient(to right, rgba(60,40,20,0.22), rgba(60,40,20,0.06) 55%, transparent);"
              aria-hidden="true"
            >
            </div>
            <button
              id="mobile-reasons-back"
              type="button"
              class="absolute top-2 left-2 z-10 px-2 py-1 text-[#8b3a3a] opacity-70"
              style="font-family: 'Special Elite', monospace; font-size: 10px; letter-spacing: 0.12em;"
            >
              ← Volver
            </button>
            <div class="text-center mb-3 mt-5 shrink-0 relative z-[2]">
              <h2
                id="mobile-reasons-title"
                class="text-[#1a1510] text-[1.35rem] opacity-90 leading-tight min-h-[1.4em]"
                style="font-family: 'Caveat', cursive;"
                data-text="Por qué te amo..."
              >
              </h2>
              <div
                id="mobile-reasons-title-line"
