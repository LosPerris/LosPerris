---
import {
  messages,
  getDailyMessageIndex,
  getDaysSinceStart,
} from "../data/messages";

import FloatingPlayer from "./FloatingPlayer.astro";
import LetterFeed from "./LetterFeed.astro";

interface Props {
  songId?: string;
  question?: string;
}

const { songId, question } = Astro.props;

const index = getDailyMessageIndex();
const message = messages[index];
const dayNumber = getDaysSinceStart();
---

<div
  class="maria-page w-full max-w-7xl mx-auto flex flex-col relative z-10 pt-4 md:pt-10 lg:pt-14 px-3 sm:px-6"
>
  {/* Título arriba: en PC el diario abierto ya no lo tapa */}
  <header
    class="maria-hero w-full max-w-3xl mx-auto lg:mx-0 lg:max-w-xl mb-6 md:mb-10 flex flex-col gap-3 md:gap-4 relative z-20"
  >
    <div class="animate-fade-in-up maria-hero-copy">
      <h1
        class="font-serif italic text-3xl sm:text-5xl md:text-6xl lg:text-6xl text-amber-200/90 drop-shadow-[0_0_15px_rgba(251,191,36,0.3)] leading-tight tracking-tight animate-fade-in-up"
        style="animation-delay: 0.1s; animation-fill-mode: both;"
      >
        Tu Diario
      </h1>
      <div
        class="mt-3 md:mt-5 w-32 h-[1px] bg-gradient-to-r from-amber-400/80 via-amber-600/30 to-transparent animate-fade-in-up"
        style="animation-delay: 0.55s; animation-fill-mode: both;"
      >
      </div>

      <p
        class="mt-3 md:mt-5 font-sans text-sm sm:text-base md:text-lg text-white/60 font-light leading-relaxed max-w-md animate-fade-in-up"
        style="animation-delay: 0.85s; animation-fill-mode: both;"
      >
        Un lugar hecho solo para ti. Donde cada pagina te recuerda lo mucho que
        significas para mi.
      </p>

      <button
        id="bloom-btn"
        type="button"
        class="mt-5 md:mt-6 group relative animate-fade-in-up outline-none focus:outline-none"
        style="background: transparent; border: none; padding: 0; animation-delay: 1.2s; animation-fill-mode: both;"
      >
        <div
          class="flex items-center justify-center gap-3 px-7 py-3 min-w-[220px] border border-amber-600/25 text-amber-200/70 tracking-widest uppercase transition-all duration-500 group-hover:border-amber-500/50 group-hover:text-amber-200/90 group-hover:bg-amber-900/10 group-active:scale-95 group-active:bg-amber-900/30"
          style="font-family: 'Special Elite', monospace; font-size: 0.7rem; letter-spacing: 0.2em;"
        >
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            class="opacity-60 group-hover:opacity-90 transition-opacity"
          >
            <circle cx="12" cy="12" r="4" fill="currentColor"></circle>
            <ellipse
              cx="12"
              cy="4"
              rx="2"
              ry="4"
              fill="currentColor"
              opacity="0.7"></ellipse>
            <ellipse
              cx="12"
              cy="4"
              rx="2"
              ry="4"
              fill="currentColor"
              opacity="0.7"
              transform="rotate(45 12 12)"></ellipse>
            <ellipse
              cx="12"
              cy="4"
              rx="2"
              ry="4"
              fill="currentColor"
              opacity="0.7"
              transform="rotate(90 12 12)"></ellipse>
            <ellipse
              cx="12"
              cy="4"
              rx="2"
              ry="4"
              fill="currentColor"
              opacity="0.7"
              transform="rotate(135 12 12)"></ellipse>
            <ellipse
              cx="12"
              cy="4"
              rx="2"
              ry="4"
              fill="currentColor"
              opacity="0.7"
              transform="rotate(180 12 12)"></ellipse>
            <ellipse
              cx="12"
              cy="4"
              rx="2"
              ry="4"
              fill="currentColor"
              opacity="0.7"
              transform="rotate(225 12 12)"></ellipse>
            <ellipse
              cx="12"
              cy="4"
              rx="2"
              ry="4"
              fill="currentColor"
              opacity="0.7"
              transform="rotate(270 12 12)"></ellipse>
            <ellipse
              cx="12"
              cy="4"
              rx="2"
              ry="4"
              fill="currentColor"
              opacity="0.7"
              transform="rotate(315 12 12)"></ellipse>
          </svg>
          <span id="bloom-label">Hacer Florecer</span>
        </div>
      </button>
    </div>
  </header>

  <div class="w-full flex justify-center relative z-10">
    <LetterFeed message={message} dayNumber={dayNumber} />
  </div>
</div>

<FloatingPlayer songId={songId} question={question} />

<script>
  // ── Enhanced Petal & Magic Bloom Animation ─────────────────────────────
  const bloomBtn = document.getElementById("bloom-btn");
  const bloomLabel = document.getElementById("bloom-label");

  if (bloomBtn && bloomLabel) {
    let blooming = false;

    bloomBtn.addEventListener("click", () => {
      if (blooming) return;
      blooming = true;
      bloomLabel.textContent = "Floreciendo...";
      (bloomBtn as HTMLButtonElement).style.pointerEvents = "none";

      // Magic Screen Flash
      const flash = document.createElement("div");
      flash.style.position = "fixed";
      flash.style.inset = "0";
      flash.style.backgroundColor = "#fbbf24";
      flash.style.mixBlendMode = "overlay";
      flash.style.pointerEvents = "none";
      flash.style.zIndex = "9999";
      flash.style.opacity = "0";
      flash.style.transition = "opacity 2s ease-out";
      document.body.appendChild(flash);

      // Trigger flash
      requestAnimationFrame(() => {
        flash.style.opacity = "0.2";
        setTimeout(() => {
          flash.style.opacity = "0";
          setTimeout(() => flash.remove(), 2000);
        }, 300);
      });

      const totalParticles = 120; // More particles!
      const colors = [
        "#f5c842",
        "#e8a030",
        "#d4821a",
        "#f0d060",
        "#c8941a",
        "#ffffff",
      ];
      let created = 0;

      // Different SVG paths for variety
      const paths = [
        "M0,-10 C4,-6 6,2 0,8 C-6,2 -4,-6 0,-10Z", // Normal petal
        "M0,-12 C3,-5 4,3 0,10 C-4,3 -3,-5 0,-12Z", // Long petal
        "M0,-8 C5,-4 7,4 0,6 C-7,4 -5,-4 0,-8Z", // Wide petal
      ];

      const interval = setInterval(() => {
        for (let i = 0; i < 6 && created < totalParticles; i++) {
          const isMote = Math.random() > 0.75; // 25% chance to be a glowing mote of light

          const ns = "http://www.w3.org/2000/svg";
          const svg = document.createElementNS(ns, "svg");
          svg.setAttribute("width", isMote ? "10" : "24");
          svg.setAttribute("height", isMote ? "10" : "24");
          svg.setAttribute("viewBox", "-12 -12 24 24");
          svg.style.position = "fixed";
          svg.style.pointerEvents = "none";
          svg.style.zIndex = "10000";
          svg.style.opacity = "0";

          if (isMote) {
            // Glowing light mote
            const circle = document.createElementNS(ns, "circle");
            circle.setAttribute("cx", "0");
            circle.setAttribute("cy", "0");
            circle.setAttribute("r", "4");
            circle.setAttribute("fill", "#fbbf24");
            circle.style.filter = "blur(2px)";
            svg.appendChild(circle);
          } else {
            // Petal
            const path = document.createElementNS(ns, "path");
            path.setAttribute(
              "d",
              paths[Math.floor(Math.random() * paths.length)],
            );
            path.setAttribute(
              "fill",
              colors[Math.floor(Math.random() * (colors.length - 1))],
            ); // Exclude white for petals
            path.setAttribute(
              "opacity",
              (0.7 + Math.random() * 0.3).toString(),
            );
            svg.appendChild(path);
          }

          // Spread completely across the screen width (from slightly off-screen left to off-screen right)
          const startX = (Math.random() * 1.2 - 0.1) * window.innerWidth;
          const startY = window.innerHeight + 20;

          svg.style.left = `${startX}px`;
          svg.style.top = `${startY}px`;

          const size = isMote
            ? 0.5 + Math.random() * 1.5
            : 0.6 + Math.random() * 1.6;

          // 3D Tumbling physics setup
          const duration = 3500 + Math.random() * 4500;
          const swayX = -300 + Math.random() * 600; // Wider horizontal drift

          // Random 3D rotation axes
          const rX = Math.random() > 0.5 ? 1 : -1;
          const rY = Math.random() > 0.5 ? 1 : -1;
          const rZ = Math.random() > 0.5 ? 1 : -1;
          const endRot = 360 + Math.random() * 1080;

          svg.animate(
            [
              {
                transform: `scale(${size}) translate3d(0px, 0px, 0px) rotate3d(0, 0, 0, 0deg)`,
                opacity: 0,
              },
              {
                transform: `scale(${size}) translate3d(${swayX * 0.3}px, -30vh, 100px) rotate3d(${rX}, ${rY}, ${rZ}, ${endRot * 0.3}deg)`,
                opacity: isMote ? 0.8 : 1,
                offset: 0.15,
              },
              {
                transform: `scale(${size}) translate3d(${swayX * 0.8}px, -80vh, -100px) rotate3d(${rX}, ${rY}, ${rZ}, ${endRot * 0.7}deg)`,
                opacity: isMote ? 0.6 : 0.8,
                offset: 0.75,
              },
              {
                transform: `scale(${size}) translate3d(${swayX}px, -120vh, 200px) rotate3d(${rX}, ${rY}, ${rZ}, ${endRot}deg)`,
                opacity: 0,
              },
            ],
            {
              duration,
              easing: "cubic-bezier(0.25, 0.46, 0.45, 0.94)", // Smooth deceleration upwards
              fill: "forwards",
            },
          );

          document.body.appendChild(svg);
          setTimeout(() => svg.remove(), duration);
          created++;
        }
        if (created >= totalParticles) clearInterval(interval);
      }, 50);

      setTimeout(() => {
        blooming = false;
        bloomLabel.textContent = "Hacer Florecer";
        (bloomBtn as HTMLButtonElement).style.pointerEvents = "auto";
      }, 6500);
    });
  }
</script>
