---
import {
  messages,
  getDailyMessageIndex,
  getDaysSinceStart,
} from "../data/messages";

import FloatingPlayer from "./FloatingPlayer.astro";
import LetterFeed from "./LetterFeed.astro";

interface Props {
  songId?: string;
  question?: string;
}

const { songId, question } = Astro.props;

const index = getDailyMessageIndex();
const message = messages[index];
const dayNumber = getDaysSinceStart();
---

<div
  class="maria-page w-full max-w-7xl mx-auto flex flex-col relative z-10 pt-4 md:pt-10 lg:pt-0 px-3 sm:px-6"
>
  {/* Título a la izquierda; el diario abierto se corre a la derecha */}
  <header
    class="maria-hero w-full mb-6 md:mb-10 flex flex-col gap-3 md:gap-4 relative z-30"
  >
    <div class="animate-fade-in-up maria-hero-copy">
      <div class="maria-hero-text">
        <h1
          class="font-serif italic text-3xl sm:text-5xl md:text-6xl lg:text-6xl text-amber-200/90 drop-shadow-[0_0_15px_rgba(251,191,36,0.3)] leading-tight tracking-tight animate-fade-in-up"
          style="animation-delay: 0.1s; animation-fill-mode: both;"
        >
          Tu Diario
        </h1>
        <div
          class="mt-3 md:mt-5 w-32 h-[1px] bg-gradient-to-r from-amber-400/80 via-amber-600/30 to-transparent animate-fade-in-up"
          style="animation-delay: 0.55s; animation-fill-mode: both;"
        >
        </div>

        <p
          class="mt-3 md:mt-5 font-sans text-sm sm:text-base md:text-lg text-white/60 font-light leading-relaxed max-w-md animate-fade-in-up"
          style="animation-delay: 0.85s; animation-fill-mode: both;"
        >
          Tu rincón especial. Donde cada página te recuerda lo mucho que
          significas para mí.
        </p>
      </div>

      <button
        id="bloom-btn"
        type="button"
        class="mt-5 md:mt-6 group relative animate-fade-in-up outline-none focus:outline-none"
        style="background: transparent; border: none; padding: 0; animation-delay: 1.2s; animation-fill-mode: both;"
      >
        <div
          class="flex items-center justify-center gap-3 px-7 py-3 min-w-[220px] border border-amber-600/25 text-amber-200/70 tracking-widest uppercase transition-all duration-500 group-hover:border-amber-500/50 group-hover:text-amber-200/90 group-hover:bg-amber-900/10 group-active:scale-95 group-active:bg-amber-900/30"
          style="font-family: 'Special Elite', monospace; font-size: 0.7rem; letter-spacing: 0.2em;"
        >
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            class="opacity-60 group-hover:opacity-90 transition-opacity"
          >
            <circle cx="12" cy="12" r="4" fill="currentColor"></circle>
            <ellipse
              cx="12"
              cy="4"
              rx="2"
              ry="4"
              fill="currentColor"
              opacity="0.7"></ellipse>
            <ellipse
              cx="12"
              cy="4"
              rx="2"
              ry="4"
              fill="currentColor"
              opacity="0.7"
              transform="rotate(45 12 12)"></ellipse>
            <ellipse
              cx="12"
              cy="4"
              rx="2"
              ry="4"
              fill="currentColor"
              opacity="0.7"
              transform="rotate(90 12 12)"></ellipse>
            <ellipse
              cx="12"
              cy="4"
              rx="2"
              ry="4"
              fill="currentColor"
              opacity="0.7"
              transform="rotate(135 12 12)"></ellipse>
            <ellipse
              cx="12"
              cy="4"
              rx="2"
              ry="4"
              fill="currentColor"
              opacity="0.7"
              transform="rotate(180 12 12)"></ellipse>
            <ellipse
              cx="12"
              cy="4"
              rx="2"
              ry="4"
              fill="currentColor"
              opacity="0.7"
              transform="rotate(225 12 12)"></ellipse>
            <ellipse
              cx="12"
              cy="4"
              rx="2"
              ry="4"
              fill="currentColor"
              opacity="0.7"
              transform="rotate(270 12 12)"></ellipse>
            <ellipse
              cx="12"
              cy="4"
              rx="2"
              ry="4"
              fill="currentColor"
              opacity="0.7"
              transform="rotate(315 12 12)"></ellipse>
          </svg>
          <span id="bloom-label">Hacer Florecer</span>
        </div>
      </button>
    </div>
  </header>

  <div class="maria-stage w-full flex justify-center relative z-10">
    <LetterFeed message={message} dayNumber={dayNumber} />
  </div>
</div>

<FloatingPlayer songId={songId} question={question} />

<script>
  // ── Pétalos de girasol — Hacer Florecer ─────────────────────────────
  const bloomBtn = document.getElementById("bloom-btn");
  const bloomLabel = document.getElementById("bloom-label");

  if (bloomBtn && bloomLabel) {
    let blooming = false;

    // Forma real de pétalo de girasol: punta afilada + base redondeada
    const petalPaths = [
      "M0,-16 C4.2,-14 6.5,-6 5.2,2 C4.2,8 2.2,12 0,14 C-2.2,12 -4.2,8 -5.2,2 C-6.5,-6 -4.2,-14 0,-16Z",
      "M0,-18 C3.6,-15 5.8,-7 4.6,1 C3.5,8 1.8,13 0,15.5 C-1.8,13 -3.5,8 -4.6,1 C-5.8,-7 -3.6,-15 0,-18Z",
      "M0,-14 C5,-12 7.2,-5 5.5,3 C4,9 2,12.5 0,13.5 C-2,12.5 -4,9 -5.5,3 C-7.2,-5 -5,-12 0,-14Z",
      "M0,-17 C4.8,-14.5 6.2,-5.5 4.8,3 C3.6,9.5 1.6,13.5 0,15 C-1.6,13.5 -3.6,9.5 -4.8,3 C-6.2,-5.5 -4.8,-14.5 0,-17Z",
    ];

    const petalFills = [
      ["#ffe566", "#f5b800", "#e8920a"],
      ["#ffd54a", "#f0a020", "#d97808"],
      ["#fff08a", "#f5c842", "#e8a030"],
      ["#ffec70", "#fbbf24", "#c9770a"],
      ["#ffe9a0", "#f0b429", "#d4821a"],
    ];

    bloomBtn.addEventListener("click", () => {
      if (blooming) return;
      blooming = true;
      bloomLabel.textContent = "Floreciendo...";
      (bloomBtn as HTMLButtonElement).style.pointerEvents = "none";

      // Destello cálido suave desde abajo
      const flash = document.createElement("div");
      flash.style.cssText = `
        position:fixed;inset:0;pointer-events:none;z-index:9999;
        background:radial-gradient(ellipse 90% 55% at 50% 100%,
          rgba(251,191,36,0.4) 0%, rgba(251,191,36,0.12) 35%, transparent 70%);
        opacity:0;transition:opacity 1.6s ease-out;
      `;
      document.body.appendChild(flash);
      requestAnimationFrame(() => {
        flash.style.opacity = "1";
        setTimeout(() => {
          flash.style.opacity = "0";
          setTimeout(() => flash.remove(), 1800);
        }, 280);
      });

      const ns = "http://www.w3.org/2000/svg";
      const totalPetals = 95;
      const totalSeeds = 18;
      let created = 0;

      const spawnPetal = () => {
        const svg = document.createElementNS(ns, "svg");
        const sizePx = 28 + Math.random() * 26;
        svg.setAttribute("width", String(sizePx));
        svg.setAttribute("height", String(sizePx));
        svg.setAttribute("viewBox", "-10 -18 20 36");
        svg.style.cssText = `
          position:fixed;pointer-events:none;z-index:10000;
          left:0;top:0;opacity:0;will-change:transform,opacity;
          filter:drop-shadow(0 2px 3px rgba(80,40,0,0.25));
        `;

        const defs = document.createElementNS(ns, "defs");
        const gradId = `pg-${created}-${Math.random().toString(36).slice(2, 7)}`;
        const grad = document.createElementNS(ns, "linearGradient");
        grad.setAttribute("id", gradId);
        grad.setAttribute("x1", "0");
        grad.setAttribute("y1", "-16");
        grad.setAttribute("x2", "0");
        grad.setAttribute("y2", "14");
        grad.setAttribute("gradientUnits", "userSpaceOnUse");

        const fills = petalFills[Math.floor(Math.random() * petalFills.length)];
        fills.forEach((color, idx) => {
          const stop = document.createElementNS(ns, "stop");
          stop.setAttribute("offset", `${idx * 50}%`);
          stop.setAttribute("stop-color", color);
          grad.appendChild(stop);
        });
        defs.appendChild(grad);
        svg.appendChild(defs);

        const path = document.createElementNS(ns, "path");
        path.setAttribute(
          "d",
          petalPaths[Math.floor(Math.random() * petalPaths.length)],
        );
        path.setAttribute("fill", `url(#${gradId})`);
        path.setAttribute("opacity", String(0.88 + Math.random() * 0.12));
        svg.appendChild(path);

        // Nervadura central suave
        const vein = document.createElementNS(ns, "path");
        vein.setAttribute("d", "M0,-13 C0.4,-4 0.3,4 0,12");
        vein.setAttribute("fill", "none");
        vein.setAttribute("stroke", "rgba(180,90,10,0.28)");
        vein.setAttribute("stroke-width", "0.7");
        vein.setAttribute("stroke-linecap", "round");
        svg.appendChild(vein);

        // Todos desde abajo, repartidos por el ancho
        const startX = (Math.random() * 1.15 - 0.075) * window.innerWidth;
        const startY = window.innerHeight + 12 + Math.random() * 50;

        const scale = 0.55 + Math.random() * 1.15;
        const duration = 3800 + Math.random() * 4200;
        const sway = (Math.random() - 0.5) * 520;
        const liftPx = -(window.innerHeight * (1.05 + Math.random() * 0.25));
        const spin =
          (Math.random() > 0.5 ? 1 : -1) * (180 + Math.random() * 540);
        const flutter = 18 + Math.random() * 28;

        document.body.appendChild(svg);

        svg.animate(
          [
            {
              transform: `translate(${startX}px, ${startY}px) scale(${scale * 0.4}) rotate(${Math.random() * 40 - 20}deg)`,
              opacity: 0,
            },
            {
              transform: `translate(${startX + sway * 0.25}px, ${startY + liftPx * 0.28}px) scale(${scale}) rotate(${spin * 0.25}deg)`,
              opacity: 1,
              offset: 0.12,
            },
            {
              transform: `translate(${startX + sway * 0.55 + flutter}px, ${startY + liftPx * 0.62}px) scale(${scale * 0.95}) rotate(${spin * 0.55}deg)`,
              opacity: 0.95,
              offset: 0.45,
            },
            {
              transform: `translate(${startX + sway * 0.85 - flutter * 0.6}px, ${startY + liftPx * 0.88}px) scale(${scale * 0.85}) rotate(${spin * 0.85}deg)`,
              opacity: 0.7,
              offset: 0.78,
            },
            {
              transform: `translate(${startX + sway}px, ${startY + liftPx}px) scale(${scale * 0.55}) rotate(${spin}deg)`,
              opacity: 0,
            },
          ],
          {
            duration,
            easing: "cubic-bezier(0.22, 0.61, 0.36, 1)",
            fill: "forwards",
          },
        );

        setTimeout(() => svg.remove(), duration + 40);
        created++;
      };

      const spawnSeed = () => {
        const svg = document.createElementNS(ns, "svg");
        svg.setAttribute("width", "10");
        svg.setAttribute("height", "10");
        svg.setAttribute("viewBox", "-5 -5 10 10");
        svg.style.cssText = `
          position:fixed;pointer-events:none;z-index:10000;
          left:0;top:0;opacity:0;will-change:transform,opacity;
        `;
        const seed = document.createElementNS(ns, "ellipse");
        seed.setAttribute("cx", "0");
        seed.setAttribute("cy", "0");
        seed.setAttribute("rx", "2.2");
        seed.setAttribute("ry", "3.4");
        seed.setAttribute("fill", Math.random() > 0.5 ? "#5c3a1a" : "#3d2410");
        seed.setAttribute("opacity", "0.85");
        svg.appendChild(seed);

        const startX = (Math.random() * 1.1 - 0.05) * window.innerWidth;
        const startY = window.innerHeight + 8 + Math.random() * 30;
        const sway = (Math.random() - 0.5) * 260;
        const liftPx = -(window.innerHeight * (0.9 + Math.random() * 0.35));
        const duration = 3200 + Math.random() * 2800;
        const spin = (Math.random() - 0.5) * 720;

        document.body.appendChild(svg);
        svg.animate(
          [
            {
              transform: `translate(${startX}px, ${startY}px) scale(0.6) rotate(0deg)`,
              opacity: 0,
            },
            {
              transform: `translate(${startX + sway * 0.4}px, ${startY + liftPx * 0.45}px) scale(1) rotate(${spin * 0.4}deg)`,
              opacity: 0.9,
              offset: 0.2,
            },
            {
              transform: `translate(${startX + sway}px, ${startY + liftPx}px) scale(0.5) rotate(${spin}deg)`,
              opacity: 0,
            },
          ],
          {
            duration,
            easing: "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
            fill: "forwards",
          },
        );
        setTimeout(() => svg.remove(), duration + 40);
        created++;
      };

      // Todo sale desde abajo
      const interval = setInterval(() => {
        for (let i = 0; i < 5 && created < totalPetals; i++) {
          spawnPetal();
        }
        if (created >= totalPetals) clearInterval(interval);
      }, 55);

      for (let i = 0; i < totalSeeds; i++) {
        setTimeout(() => spawnSeed(), 80 + i * 45);
      }

      setTimeout(() => {
        blooming = false;
        bloomLabel.textContent = "Hacer Florecer";
        (bloomBtn as HTMLButtonElement).style.pointerEvents = "auto";
      }, 7200);
    });
  }
</script>
