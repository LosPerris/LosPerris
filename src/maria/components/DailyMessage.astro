---
import {
  messages,
  getDailyMessageIndex,
  getDaysSinceStart,
} from "../data/messages";

const index = getDailyMessageIndex();
const message = messages[index];
const dayNumber = getDaysSinceStart();

const today = new Date();
const dateStr = today.toLocaleDateString("es-MX", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article class="card-wrapper">
  <header class="card-header">
    <div class="heart-icon" aria-hidden="true">🌻</div>
    <p class="subtitle">para el amor de mi vida</p>
  </header>

  <div class="message-block">
    <span class="message-decor" aria-hidden="true">"</span>
    <blockquote class="message-text" id="daily-message-text">
      {message}
    </blockquote>
    <span class="message-decor message-decor--close" aria-hidden="true">"</span>
  </div>

  <footer class="card-footer">
    <div class="divider" aria-hidden="true">
      <span class="divider-line"></span>
      <span class="divider-heart">🌻</span>
      <span class="divider-line"></span>
    </div>
    <p class="date-label">
      <time datetime={today.toISOString()} id="daily-date">{dateStr}</time>
    </p>
    {
      dayNumber > 0 && (
        <p class="day-counter" id="daily-counter-block">
          Día <strong id="daily-day-num">{dayNumber}</strong> amándote y
          extrañándote cada vez más
        </p>
      )
    }
    <p class="signature">Con todo mi amor, Ponsscito ❤️</p>
    <button id="special-msg-btn" class="special-button">Nuestro deseo ✨</button
    >
  </footer>

  <div id="special-overlay" class="special-overlay">
    <div class="overlay-content">
      <button id="close-overlay" class="close-button">×</button>
      <p class="overlay-text">
        Cuando quieras podemos regresar y amarnos nuevamente, cada segundo de mi
        vida pienso en ti.❤️
      </p>
    </div>
  </div>
</article>

<script>
  import {
    messages,
    getDailyMessageIndex,
    getDaysSinceStart,
  } from "../data/messages";

  function updateContent() {
    const msgText = document.getElementById("daily-message-text");
    const dateEl = document.getElementById("daily-date");
    const dayNumEl = document.getElementById("daily-day-num");
    const counterBlock = document.getElementById("daily-counter-block");

    if (!msgText || !dateEl) return;

    const epoch = new Date(2026, 2, 23);
    const index = getDailyMessageIndex(epoch);
    const dayNumber = getDaysSinceStart(epoch);
    const today = new Date();

    msgText.textContent = messages[index];

    dateEl.textContent = today.toLocaleDateString("es-MX", {
      weekday: "long",
      year: "numeric",
      month: "long",
      day: "numeric",
    });
    dateEl.setAttribute("datetime", today.toISOString());

    if (dayNumEl) {
      dayNumEl.textContent = dayNumber.toString();
    }
    if (dayNumber <= 0 && counterBlock) {
      counterBlock.style.display = "none";
    } else if (counterBlock) {
      counterBlock.style.display = "block";
    }

    const specialBtn = document.getElementById("special-msg-btn");
    const overlay = document.getElementById("special-overlay");
    const closeBtn = document.getElementById("close-overlay");

    if (specialBtn && overlay && closeBtn) {
      specialBtn.onclick = () => {
        overlay.classList.add("is-active");
      };
      closeBtn.onclick = (e) => {
        e.stopPropagation();
        overlay.classList.remove("is-active");
      };
      overlay.onclick = () => {
        overlay.classList.remove("is-active");
      };
    }
  }

  updateContent();
  setInterval(updateContent, 1000 * 60 * 15);
</script>

<style>
  .card-wrapper {
    position: relative;
    width: min(640px, calc(100vw - 2rem));
    background: rgba(251, 191, 36, 0.05);
    border: 1px solid rgba(251, 191, 36, 0.18);
    border-radius: 2rem;
    padding: clamp(2rem, 5vw, 3.5rem);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow:
      0 0 0 1px rgba(251, 191, 36, 0.06),
      0 8px 64px rgba(251, 191, 36, 0.12),
      0 40px 80px rgba(12, 7, 16, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    animation: card-enter 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
    overflow: hidden;
  }

  .card-wrapper::before {
    content: "";
    position: absolute;
    top: -40%;
    right: -20%;
    width: 60%;
    height: 70%;
    background: radial-gradient(
      circle,
      rgba(251, 191, 36, 0.08) 0%,
      transparent 70%
    );
    pointer-events: none;
    border-radius: 50%;
  }

  @keyframes card-enter {
    from {
      opacity: 0;
      transform: translateY(32px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .card-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .heart-icon {
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    animation: heartbeat 1.8s ease-in-out infinite;
    filter: drop-shadow(0 0 12px rgba(251, 191, 36, 0.6));
    line-height: 1;
  }

  @keyframes heartbeat {
    0%,
    100% {
      transform: scale(1);
    }
    14% {
      transform: scale(1.15);
    }
    28% {
      transform: scale(1);
    }
    42% {
      transform: scale(1.08);
    }
    70% {
      transform: scale(1);
    }
  }

  .subtitle {
    font-family: "Inter", sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: rgba(251, 191, 36, 0.7);
  }

  .message-block {
    position: relative;
    margin-bottom: 2rem;
  }

  .message-decor {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(4rem, 10vw, 6rem);
    line-height: 0.5;
    color: rgba(251, 191, 36, 0.2);
    display: block;
    user-select: none;
    margin-bottom: -0.5rem;
  }

  .message-decor--close {
    text-align: right;
    margin-top: -1rem;
    margin-bottom: 0;
  }

  .message-text {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.75;
    color: rgba(255, 253, 245, 0.93);
    text-align: center;
    padding: 0 0.5rem;
    border: none;
    animation: text-reveal 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both;
  }

  @keyframes text-reveal {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .card-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    animation: footer-reveal 1s cubic-bezier(0.22, 1, 0.36, 1) 0.6s both;
  }

  @keyframes footer-reveal {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    max-width: 240px;
    margin-bottom: 0.5rem;
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgba(251, 191, 36, 0.35),
      transparent
    );
  }

  .divider-heart {
    color: rgba(251, 191, 36, 0.5);
    font-size: 0.75rem;
  }

  .date-label {
    font-family: "Inter", sans-serif;
    font-size: 0.78rem;
    color: rgba(255, 253, 245, 0.4);
    letter-spacing: 0.02em;
    text-transform: capitalize;
  }

  .day-counter {
    font-family: "Inter", sans-serif;
    font-size: 0.82rem;
    color: rgba(251, 191, 36, 0.65);
  }

  .day-counter strong {
    color: rgba(251, 191, 36, 0.95);
    font-weight: 600;
  }

  .signature {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 0.95rem;
    font-style: italic;
    color: rgba(255, 253, 245, 0.55);
    margin-top: 0.25rem;
  }

  .special-button {
    margin-top: 1.5rem;
    padding: 0.6rem 1.2rem;
    background: rgba(251, 191, 36, 0.1);
    border: 1px solid rgba(251, 191, 36, 0.2);
    border-radius: 99px;
    color: rgba(251, 191, 36, 0.8);
    font-family: "Inter", sans-serif;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.3s ease;
    backdrop-filter: blur(4px);
  }

  .special-button:hover {
    background: rgba(251, 191, 36, 0.2);
    border-color: rgba(251, 191, 36, 0.4);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(251, 191, 36, 0.2);
  }

  .special-button:active {
    transform: translateY(0);
  }

  .special-overlay {
    position: absolute;
    inset: 0;
    background: rgba(12, 7, 16, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease-in-out;
    z-index: 10;
  }

  .special-overlay.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .overlay-content {
    position: relative;
    text-align: center;
    transform: translateY(10px);
    transition: transform 0.4s ease-out;
  }

  .special-overlay.is-active .overlay-content {
    transform: translateY(0);
  }

  .overlay-text {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 1.25rem;
    font-style: italic;
    line-height: 1.8;
    color: #fff;
    animation: text-glow 2s ease-in-out infinite alternate;
  }

  @keyframes text-glow {
    from {
      text-shadow: 0 0 10px rgba(251, 191, 36, 0.2);
    }
    to {
      text-shadow: 0 0 20px rgba(251, 191, 36, 0.5);
    }
  }

  .close-button {
    position: absolute;
    top: -3rem;
    right: 50%;
    transform: translateX(50%);
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.5);
    font-size: 2rem;
    cursor: pointer;
    transition: color 0.3s ease;
  }

  .close-button:hover {
    color: #fff;
  }

  #daily-message-text {
  }

  @media (max-width: 400px) {
    .card-wrapper {
      border-radius: 1.25rem;
    }
  }
</style>
