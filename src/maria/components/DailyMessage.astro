---
import {
  messages,
  getDailyMessageIndex,
  getDaysSinceStart,
} from "../data/messages";

import LetterCard from "./LetterCard.astro";
import GiftModal from "./GiftModal.astro";
import ExperienceOverlays from "./ExperienceOverlays.astro";

interface Props {
  songId?: string;
  question?: string;
}

const { songId, question } = Astro.props;

const index = getDailyMessageIndex();
const message = messages[index];
const dayNumber = getDaysSinceStart();
---

<div class="daily-message-wrapper">
  <GiftModal songId={songId} question={question} />
  <LetterCard message={message} dayNumber={dayNumber} />
  <ExperienceOverlays />
</div>

<style>
  .daily-message-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    width: 100%;
    padding: 2rem 1rem;
    perspective: 1000px;
  }
</style>
