---
import {
  messages,
  getDailyMessageIndex,
  getDaysSinceStart,
} from "../data/messages";

const index = getDailyMessageIndex();
const message = messages[index];
const dayNumber = getDaysSinceStart();

const today = new Date();
const dateStr = today.toLocaleDateString("es-MX", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article class="card-wrapper sunflower-glass">
  <div class="card-glow"></div>
  <header class="card-header">
    <div class="sunflower-icon" id="main-sunflower" aria-hidden="true">🌻</div>
    <p class="subtitle">campo de girasoles</p>
  </header>

  <div class="message-block">
    <span class="message-decor" aria-hidden="true">🌻</span>
    <blockquote class="message-text" id="daily-message-text">
      {message}
    </blockquote>
    <span class="message-decor message-decor--close" aria-hidden="true">🌻</span
    >
  </div>

  <footer class="card-footer">
    <div class="divider" aria-hidden="true">
      <span class="divider-line"></span>
      <span class="divider-sun">☀️</span>
      <span class="divider-line"></span>
    </div>
    <p class="date-label">
      <time datetime={today.toISOString()} id="daily-date">{dateStr}</time>
    </p>
    {
      dayNumber > 0 && (
        <p class="day-counter" id="daily-counter-block">
          Día <strong id="daily-day-num">{dayNumber}</strong> floreciendo a tu
          lado
        </p>
      )
    }
    <p class="signature">Tu Ponsscito 🌻</p>
    <div class="button-group">
      <button id="bloom-btn" class="bloom-button">Hacer Florecer ✨</button>
      <button id="special-msg-btn" class="special-link">Nuestro deseo</button>
    </div>
  </footer>

  <div id="special-overlay" class="special-overlay">
    <div class="overlay-content">
      <button id="close-overlay" class="close-button">×</button>
      <p class="overlay-text">
        Cuando quieras podemos regresar y amarnos nuevamente, cada segundo de mi
        vida pienso en ti.❤️
      </p>
    </div>
  </div>
</article>

<script>
  import {
    messages,
    getDailyMessageIndex,
    getDaysSinceStart,
  } from "../data/messages";

  function updateContent() {
    const msgText = document.getElementById("daily-message-text");
    const dateEl = document.getElementById("daily-date");
    const dayNumEl = document.getElementById("daily-day-num");
    const counterBlock = document.getElementById("daily-counter-block");

    if (!msgText || !dateEl) return;

    const epoch = new Date(2026, 2, 23);
    const index = getDailyMessageIndex(epoch);
    const dayNumber = getDaysSinceStart(epoch);
    const today = new Date();

    function typeWriter(text: string, element: HTMLElement, delay = 40) {
      element.textContent = "";
      let i = 0;
      function type() {
        if (i < text.length) {
          element.textContent += text.charAt(i);
          i++;
          setTimeout(type, delay);
        }
      }
      type();
    }

    typeWriter(messages[index], msgText);

    dateEl.textContent = today.toLocaleDateString("es-MX", {
      weekday: "long",
      year: "numeric",
      month: "long",
      day: "numeric",
    });
    dateEl.setAttribute("datetime", today.toISOString());

    if (dayNumEl) {
      dayNumEl.textContent = dayNumber.toString();
    }

    const bloomBtn = document.getElementById("bloom-btn");
    if (bloomBtn) {
      bloomBtn.onclick = () => {
        const petals = ["🌻", "🌻", "🌻", "🍃", "🌿"];
        const totalParticles = 200;
        const batchSize = 20;
        let created = 0;

        const burstInterval = setInterval(() => {
          for (let i = 0; i < batchSize && created < totalParticles; i++) {
            const p = document.createElement("span");
            p.textContent = petals[Math.floor(Math.random() * petals.length)];
            p.className = "bloom-petal";

            const x = Math.random() * window.innerWidth;
            const y = Math.random() * window.innerHeight;

            p.style.left = `${x}px`;
            p.style.top = `${y}px`;

            const size = 0.6 + Math.random() * 3;
            const duration = 4 + Math.random() * 4;
            const swayX = (Math.random() - 0.5) * 60;
            const swayY = (Math.random() - 0.5) * 60;

            p.style.fontSize = `${size}rem`;
            p.style.setProperty("--sway-x", `${swayX}px`);
            p.style.setProperty("--sway-y", `${swayY}px`);
            p.style.setProperty("--rot", `${Math.random() * 360}deg`);
            p.style.animationDuration = `${duration}s`;

            document.body.appendChild(p);
            created++;

            setTimeout(() => p.remove(), duration * 1000);
          }

          if (created >= totalParticles) {
            clearInterval(burstInterval);
          }
        }, 40);

        const mainSun = document.getElementById("main-sunflower");
        if (mainSun) {
          mainSun.style.animation = "none";
          void mainSun.offsetWidth;
          mainSun.style.animation =
            "bloom-pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1)";
        }
      };
    }

    const specialBtn = document.getElementById("special-msg-btn");
    const overlay = document.getElementById("special-overlay");
    const closeBtn = document.getElementById("close-overlay");

    if (specialBtn && overlay && closeBtn) {
      specialBtn.onclick = () => {
        overlay.classList.add("is-active");
      };
      closeBtn.onclick = (e) => {
        e.stopPropagation();
        overlay.classList.remove("is-active");
      };
      overlay.onclick = () => {
        overlay.classList.remove("is-active");
      };
    }
  }

  updateContent();
  setInterval(updateContent, 1000 * 60 * 15);
</script>

<style>
  .card-wrapper {
    position: relative;
    width: min(600px, calc(100vw - 2rem));
    background: rgba(12, 8, 4, 0.4);
    backdrop-filter: blur(32px);
    -webkit-backdrop-filter: blur(32px);
    border: 1px solid rgba(251, 191, 36, 0.15);
    border-radius: 2.5rem;
    padding: clamp(2.5rem, 6vw, 4rem);
    box-shadow:
      0 20px 50px rgba(0, 0, 0, 0.5),
      inset 0 0 20px rgba(251, 191, 36, 0.05);
    animation: card-enter 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
    overflow: visible;
  }

  .card-glow {
    position: absolute;
    inset: 0;
    border-radius: 2.5rem;
    background: linear-gradient(
      135deg,
      rgba(251, 191, 36, 0.2),
      transparent 40%
    );
    pointer-events: none;
    opacity: 0.5;
  }

  @keyframes card-enter {
    0% {
      opacity: 0;
      transform: translateY(30px) scale(0.95);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .card-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .sunflower-icon {
    font-size: clamp(3rem, 8vw, 4rem);
    filter: drop-shadow(0 0 15px rgba(251, 191, 36, 0.5));
    animation: rotate-sway 6s ease-in-out infinite;
  }

  @keyframes rotate-sway {
    0%,
    100% {
      transform: rotate(-5deg) scale(1);
    }
    50% {
      transform: rotate(5deg) scale(1.05);
    }
  }

  @keyframes bloom-pop {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.3);
      filter: brightness(1.5) drop-shadow(0 0 20px #fbbf24);
    }
    100% {
      transform: scale(1);
    }
  }

  .subtitle {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--sunflower);
    opacity: 0.8;
  }

  .message-block {
    position: relative;
    margin: 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .message-decor {
    font-size: 1.5rem;
    color: rgba(251, 191, 36, 0.3);
    opacity: 0.6;
  }

  .message-decor--close {
    align-self: flex-end;
  }

  .message-text {
    font-family: "Playfair Display", serif;
    font-size: clamp(1.2rem, 3vw, 1.6rem);
    font-style: italic;
    line-height: 1.6;
    color: #fff;
    text-align: center;
    padding: 0 1rem;
    min-height: 6em;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    border-top: 1px solid rgba(251, 191, 36, 0.1);
    padding-top: 2rem;
  }

  .divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 60%;
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgba(251, 191, 36, 0.4),
      transparent
    );
  }

  .divider-sun {
    font-size: 0.8rem;
    color: var(--sunflower);
  }

  .date-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-transform: capitalize;
  }

  .day-counter {
    font-size: 0.9rem;
    color: var(--sunflower-light);
  }

  .signature {
    font-family: "Playfair Display", serif;
    font-size: 1.1rem;
    font-style: italic;
    color: var(--text-muted);
  }

  .button-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
    width: 100%;
  }

  .bloom-button {
    background: linear-gradient(135deg, var(--sunflower), var(--amber));
    border: none;
    border-radius: 100px;
    padding: 0.8rem 2.5rem;
    color: #000;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    box-shadow: 0 10px 20px rgba(251, 191, 36, 0.3);
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .bloom-button:hover {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 15px 30px rgba(251, 191, 36, 0.4);
  }

  .bloom-button:active {
    transform: translateY(0) scale(0.95);
  }

  .special-link {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 0.75rem;
    text-decoration: underline;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.3s;
  }

  .special-link:hover {
    opacity: 1;
    color: var(--sunflower);
  }
</style>

<style is:global>
  .bloom-petal {
    position: fixed;
    pointer-events: none;
    z-index: 10000;
    filter: drop-shadow(0 0 10px rgba(251, 191, 36, 0.5));
    will-change: transform, opacity;
    animation: garden-bloom ease-in-out forwards;
    transform: translate(-50%, -50%) scale(0);
    line-height: 1;
    user-select: none;
  }

  @keyframes garden-bloom {
    0% {
      transform: translate3d(-50%, -50%, 0) scale(0) rotate(-45deg);
      opacity: 0;
    }
    15% {
      opacity: 1;
      transform: translate3d(-50%, -50%, 0) scale(1.1) rotate(15deg);
    }
    30%,
    80% {
      opacity: 1;
      transform: translate3d(
          calc(-50% + var(--sway-x)),
          calc(-50% + var(--sway-y)),
          0
        )
        scale(1) rotate(var(--rot));
    }
    100% {
      transform: translate3d(
          calc(-50% + var(--sway-x) * 1.5),
          calc(-50% + var(--sway-y) * 1.5),
          0
        )
        scale(0) rotate(calc(var(--rot) + 90deg));
      opacity: 0;
    }
  }

  .special-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(15px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  .special-overlay.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .overlay-content {
    position: relative;
    width: min(500px, calc(100vw - 2rem));
    background: rgba(12, 8, 4, 0.4);
    backdrop-filter: blur(32px);
    -webkit-backdrop-filter: blur(32px);
    border: 1px solid rgba(251, 191, 36, 0.15);
    border-radius: 2.5rem;
    padding: clamp(2.5rem, 6vw, 4rem);
    box-shadow:
      0 20px 50px rgba(0, 0, 0, 0.5),
      inset 0 0 20px rgba(251, 191, 36, 0.05);
    text-align: center;
  }

  .overlay-text {
    font-family: "Playfair Display", serif;
    font-size: 1.5rem;
    font-style: italic;
    color: #fff;
    max-width: 400px;
    margin: 0 auto;
    line-height: 1.8;
  }

  .close-button {
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    background: none;
    border: none;
    color: var(--sunflower, rgba(251, 191, 36, 0.8));
    font-size: 2rem;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .close-button:hover {
    transform: scale(1.1);
  }

  @media (max-width: 480px) {
    .card-wrapper {
      padding: 2rem 1.5rem;
      border-radius: 2rem;
    }
  }
</style>
