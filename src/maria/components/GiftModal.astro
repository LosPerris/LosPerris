---
interface Props {
  songId?: string;
  question?: string;
}

const { songId, question } = Astro.props;
---

<div id="daily-modal" class="daily-modal-overlay">
  <div class="daily-modal-content">
    <h2 class="reasons-title">Una sorpresa para ti 🌻</h2>

    <div class="modal-section-label">Canción de hoy</div>
    {
      songId && (
        <div class="spotify-container modal-spotify">
          <iframe
            src={`https://open.spotify.com/embed/track/${songId}?utm_source=generator&theme=0`}
            width="100%"
            height="152"
            frameborder="0"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy"
            style="border-radius:12px;"
          />
        </div>
      )
    }

    {
      question && (
        <div
          class="question-container modal-question"
          id="daily-question-block"
        >
          <p class="question-text">{question}</p>
          <div class="question-buttons">
            <button class="answer-btn yes" data-answer="Sí">
              Sí
            </button>
            <button class="answer-btn no" data-answer="No">
              No
            </button>
          </div>
        </div>
      )
    }

    <div class="modal-footer-actions">
      <button id="close-daily-modal" class="bloom-button"
        >Entrar al jardín ✨</button
      >
    </div>
  </div>
</div>

<script>
  const questionBlock = document.getElementById("daily-question-block");
  if (questionBlock) {
    const buttons = questionBlock.querySelectorAll(".answer-btn");
    buttons.forEach((btn) => {
      (btn as HTMLButtonElement).onclick = async () => {
        const answer = btn.getAttribute("data-answer") || "";
        const questionText =
          questionBlock.querySelector(".question-text")?.textContent || "";

        buttons.forEach((b) => ((b as HTMLButtonElement).disabled = true));
        btn.classList.add("loading");

        try {
          const response = await fetch("/api/maria/respond", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ answer, question: questionText }),
          });

          if (response.ok) {
            questionBlock.innerHTML = `
              <div class="success-response">
                <span class="heart-icon">❤️</span>
                <p>¡Gracias por responder, mi vida! Te amo.</p>
              </div>
            `;
          }
        } catch (err) {
          console.error("Error sending response:", err);
          buttons.forEach((b) => ((b as HTMLButtonElement).disabled = false));
        }
      };
    });
  }

  const dailyModal = document.getElementById("daily-modal");
  const closeDailyBtn = document.getElementById("close-daily-modal");

  if (dailyModal && closeDailyBtn) {
    setTimeout(() => {
      dailyModal.classList.add("is-active");
    }, 500);

    closeDailyBtn.onclick = () => {
      dailyModal.classList.remove("is-active");
    };
  }
</script>

<style>
  .daily-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(7, 5, 2, 0.9);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .daily-modal-overlay.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .daily-modal-content {
    position: relative;
    width: min(500px, calc(100vw - 2rem));
    background: rgba(12, 8, 4, 0.5);
    backdrop-filter: blur(40px);
    -webkit-backdrop-filter: blur(40px);
    border: 1px solid rgba(251, 191, 36, 0.25);
    border-radius: 3rem;
    padding: clamp(2rem, 5vw, 3rem);
    box-shadow:
      0 30px 60px rgba(0, 0, 0, 0.6),
      inset 0 0 30px rgba(251, 191, 36, 0.05);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transform: translateY(20px);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .daily-modal-overlay.is-active .daily-modal-content {
    transform: translateY(0);
  }

  .reasons-title {
    font-family: "Playfair Display", serif;
    font-size: clamp(1.8rem, 4vw, 2.2rem);
    color: #fbbf24;
    text-align: center;
    margin: 0;
    font-weight: 600;
    font-style: italic;
    text-shadow: 0 0 15px rgba(251, 191, 36, 0.3);
  }

  .modal-section-label {
    text-align: center;
    color: #fbbf24;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.3rem;
    font-weight: 700;
    opacity: 0.8;
  }

  .spotify-container {
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.4);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .modal-spotify {
    margin: 0 !important;
  }

  .question-container {
    width: 100%;
    background: rgba(251, 191, 36, 0.08);
    border: 1px solid rgba(251, 191, 36, 0.2);
    border-radius: 1.5rem;
    padding: 1.5rem;
    text-align: center;
  }

  .question-text {
    font-family: "Inter", sans-serif;
    font-size: 1rem;
    color: #fff;
    margin-bottom: 1rem;
    font-style: italic;
  }

  .question-buttons {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .answer-btn {
    padding: 0.5rem 2rem;
    border-radius: 100px;
    border: 1px solid rgba(251, 191, 36, 0.3);
    background: transparent;
    color: #fbbf24;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .answer-btn:hover {
    background: rgba(251, 191, 36, 0.15);
    border-color: #fbbf24;
    transform: translateY(-2px);
  }

  .modal-footer-actions {
    display: flex;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .bloom-button {
    background: linear-gradient(135deg, #fbbf24, #d97706);
    border: none;
    border-radius: 100px;
    padding: 0.8rem 2.5rem;
    color: #000;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    box-shadow: 0 10px 20px rgba(251, 191, 36, 0.3);
    transition: all 0.3s ease;
  }

  .bloom-button:hover {
    transform: scale(1.05);
    box-shadow: 0 15px 30px rgba(251, 191, 36, 0.4);
  }

  .success-response {
    animation: scale-up 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  .heart-icon {
    display: block;
    font-size: 2rem;
    margin-bottom: 0.5rem;
    animation: heart-beat 1s ease infinite;
  }

  @keyframes heart-beat {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.2);
    }
  }

  @keyframes scale-up {
    from {
      opacity: 0;
      transform: scale(0.8);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (max-width: 480px) {
    .daily-modal-content {
      padding: 2rem 1.5rem;
      border-radius: 2rem;
    }
  }
</style>
