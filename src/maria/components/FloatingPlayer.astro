            class="text-[7px] md:text-[14px]"
            style="font-family:'Caveat',cursive;color:#8b3a3a;opacity:0.55;text-align:right;margin-top:4px;"
          >
            — Yo
          </p>
        </div><!-- /inner -->
        <!-- spacer matches caption height -->
        <div style="height:36px;"></div>
      </div><!-- /polaroid-back -->
    </div><!-- /size-reference -->
  </div><!-- /polaroid-tilt -->
</div><!-- /polaroid-widget -->

<!-- Spotify — aged paper note, slides in from bottom-right -->
{
  songId && (
    <a
      href={`https://open.spotify.com/track/${songId}`}
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-0 right-6 md:bottom-0 md:right-24 z-[80] animate-desk-note"
      style="text-decoration: none;"
      title="Escuchar en Spotify"
    >
      <div
        class="spotify-note-texture px-4 py-3 hover:scale-[1.02] transition-transform duration-500"
        style="background-color: #e4d8c0; border: 1px solid rgba(0,0,0,0.07); min-width: 80px; text-align: center; transform: rotate(4deg); filter: drop-shadow(0 5px 8px rgba(0,0,0,0.5));"
      >
        <svg
          class="mx-auto mb-1 opacity-40"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="#1a1510"
        >
          <path d="M9 18V5l12-2v13M9 18c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-2c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z" />
        </svg>
        <p style="font-family: 'Caveat', cursive; font-size: 0.85rem; color: #1a1510; opacity: 0.55; line-height: 1.2;">
          Escuchar
        </p>
      </div>
    </a>
  )
}

<script>
  // ── Envelope click → open modal ──────────────────────────────
  const envelope = document.getElementById("interactive-envelope");
  const questionModal = document.getElementById(
    "question-modal",
  ) as HTMLDialogElement;

  if (envelope && questionModal) {
    envelope.addEventListener("click", () => {
      envelope.style.opacity = "0";
      envelope.style.pointerEvents = "none";
      questionModal.showModal();
    });

    questionModal.addEventListener("close", () => {
      envelope.style.opacity = "1";
      envelope.style.pointerEvents = "none";
      const label = document.getElementById("envelope-label");
      if (label) {
        label.textContent = "Gracias";
        label.style.color = "#8b3a3a";
        label.style.opacity = "0.85";
      }
    });
  }

  // ── Polaroid flip — Web Animations API (no CSS 3D backface-visibility needed) ──
  const polaroidWidget = document.getElementById("polaroid-widget");
  const polaroidTilt = document.getElementById("polaroid-tilt");
  const polaroidFront = document.getElementById("polaroid-front");
  const polaroidBack = document.getElementById("polaroid-back");
  const polaroidTape = document.getElementById("polaroid-tape");
  let polaroidFlipped = false;
  let polaroidAnimating = false;

  if (polaroidWidget && polaroidTilt && polaroidFront && polaroidBack) {
    polaroidWidget.addEventListener("click", () => {
      if (polaroidAnimating) return;
      polaroidAnimating = true;

      // Phase 1: rotate to edge (0 → 90°) — card narrows to nothing
      polaroidTilt.animate(
        [
          { transform: "rotate(4deg) perspective(700px) rotateY(0deg)" },
          { transform: "rotate(4deg) perspective(700px) rotateY(90deg)" },
        ],
        { duration: 220, easing: "ease-in", fill: "forwards" },
      );

      // At midpoint: swap content
      setTimeout(() => {
        polaroidFlipped = !polaroidFlipped;
        if (polaroidFlipped) {
          polaroidFront.style.display = "none";
          polaroidBack.style.display = "flex";
          if (polaroidTape) polaroidTape.style.opacity = "0";
        } else {
          polaroidBack.style.display = "none";
          polaroidFront.style.display = "flex"; // Must be 'flex', not '' — empty clears flex and breaks photo layout
          if (polaroidTape) polaroidTape.style.opacity = "1";
        }

        // Phase 2: rotate back to flat (90° → 0°) — reveals new face
        polaroidTilt.animate(
          [
            { transform: "rotate(4deg) perspective(700px) rotateY(-90deg)" },
            { transform: "rotate(4deg) perspective(700px) rotateY(0deg)" },
          ],
          { duration: 250, easing: "ease-out", fill: "forwards" },
        );

        setTimeout(() => {
          // Reset inline transform so CSS rotation is back in control
          polaroidTilt.style.transform = "rotate(4deg)";
          polaroidAnimating = false;
        }, 260);
      }, 220);
    });
  }
</script>
