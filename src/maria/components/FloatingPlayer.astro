<script>
  // Arrastre solo en móvil/touch. En PC (mouse) los objetos no se arrastran:
  // se usa click normal (abrir carta / voltear polaroid / abrir Spotify).
  const isTouchDevice =
    typeof window !== "undefined" &&
    window.matchMedia("(pointer: coarse)").matches;

  // ── Make Desk Objects Draggable (touch only) ─────────────────
  function makeDraggable(el: HTMLElement) {
    let isDragging = false;
    let startX = 0,
      startY = 0,
      initialX = 0,
      initialY = 0;
    let hasMoved = false;

    const onPointerDown = (e: PointerEvent) => {
      // PC: nunca arrastrar, dejar que el click abra normalmente.
      if (e.pointerType === "mouse") return;

      isDragging = true;
      hasMoved = false;
      startX = e.clientX;
      startY = e.clientY;

      const rect = el.getBoundingClientRect();

      if (el.dataset.dragInitialized !== "true") {
        el.style.left = rect.left + "px";
        el.style.top = rect.top + "px";
        el.style.bottom = "auto";
        el.style.right = "auto";

        el.classList.remove(
          "bottom-0",
          "right-6",
          "md:bottom-0",
          "md:right-24",
          "right-2",
          "md:right-12",
          "left-4",
          "md:left-8",
          "top-2",
          "md:top-0",
        );
        el.dataset.dragInitialized = "true";
      }

      initialX = parseFloat(el.style.left) || rect.left;
      initialY = parseFloat(el.style.top) || rect.top;

      el.style.cursor = "grabbing";
      el.style.zIndex = "1000";
      el.setPointerCapture(e.pointerId);

      el.addEventListener("pointermove", onPointerMove);
      el.addEventListener("pointerup", onPointerUp);
    };

    const onPointerMove = (e: PointerEvent) => {
      if (!isDragging) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;

      if (Math.abs(dx) > 3 || Math.abs(dy) > 3) {
        hasMoved = true;
      }

      el.style.left = initialX + dx + "px";
      el.style.top = initialY + dy + "px";
    };

    const onPointerUp = (e: PointerEvent) => {
      if (!isDragging) return;
      isDragging = false;
      el.style.cursor = "pointer";

      el.releasePointerCapture(e.pointerId);
      el.removeEventListener("pointermove", onPointerMove);
      el.removeEventListener("pointerup", onPointerUp);

      if (hasMoved) {
        const preventClick = (ev: Event) => {
          ev.preventDefault();
          ev.stopPropagation();
          el.removeEventListener("click", preventClick, true);
        };
        el.addEventListener("click", preventClick, true);
        setTimeout(
          () => el.removeEventListener("click", preventClick, true),
          100,
        );
      }
    };

    el.addEventListener("pointerdown", onPointerDown);
    el.style.touchAction = "none";
  }

  // ── Envelope click → open modal ──────────────────────────────
  const envelope = document.getElementById("interactive-envelope");
  const questionModal = document.getElementById(
    "question-modal",
  ) as HTMLDialogElement;

  if (envelope && questionModal) {
    envelope.addEventListener("click", () => {
      envelope.style.opacity = "0";
      envelope.style.pointerEvents = "none";
      questionModal.showModal();
    });

    questionModal.addEventListener("close", () => {
      envelope.style.opacity = "1";
      envelope.style.pointerEvents = "none";
      const label = document.getElementById("envelope-label");
      if (label) {
        label.textContent = "Gracias";
        label.style.color = "#8b3a3a";
        label.style.opacity = "0.85";
      }
    });
  }

  // ── Polaroid flip — Web Animations API (no CSS 3D backface-visibility needed) ──
  const polaroidWidget = document.getElementById("polaroid-widget");
  const polaroidTilt = document.getElementById("polaroid-tilt");
  const polaroidFront = document.getElementById("polaroid-front");
  const polaroidBack = document.getElementById("polaroid-back");
  const polaroidTape = document.getElementById("polaroid-tape");
  let polaroidFlipped = false;
  let polaroidAnimating = false;

  if (polaroidWidget && polaroidTilt && polaroidFront && polaroidBack) {
    polaroidWidget.addEventListener("click", () => {
      if (polaroidAnimating) return;
      polaroidAnimating = true;

      // Phase 1: rotate to edge (0 → 90°) — card narrows to nothing
      polaroidTilt.animate(
        [
          { transform: "rotate(4deg) perspective(700px) rotateY(0deg)" },
          { transform: "rotate(4deg) perspective(700px) rotateY(90deg)" },
        ],
        { duration: 220, easing: "ease-in", fill: "forwards" },
      );

      // At midpoint: swap content
      setTimeout(() => {
        polaroidFlipped = !polaroidFlipped;
        if (polaroidFlipped) {
          polaroidFront.style.display = "none";
          polaroidBack.style.display = "flex";
          if (polaroidTape) polaroidTape.style.opacity = "0";
        } else {
          polaroidBack.style.display = "none";
          polaroidFront.style.display = "flex"; // Must be 'flex', not '' — empty clears flex and breaks photo layout
          if (polaroidTape) polaroidTape.style.opacity = "1";
        }

        // Phase 2: rotate back to flat (90° → 0°) — reveals new face
        polaroidTilt.animate(
          [
            { transform: "rotate(4deg) perspective(700px) rotateY(-90deg)" },
            { transform: "rotate(4deg) perspective(700px) rotateY(0deg)" },
          ],
          { duration: 250, easing: "ease-out", fill: "forwards" },
        );

        setTimeout(() => {
          // Reset inline transform so CSS rotation is back in control
          polaroidTilt.style.transform = "rotate(4deg)";
          polaroidAnimating = false;
        }, 260);
      }, 220);
    });
  }

  // ── Initialize Dragging (solo móvil/touch) ──────────────────
  const spotifyNoteEl = document.getElementById("spotify-note");
  if (isTouchDevice) {
    if (envelope) makeDraggable(envelope);
    if (polaroidWidget) makeDraggable(polaroidWidget);
    if (spotifyNoteEl) makeDraggable(spotifyNoteEl);
  }
</script>
