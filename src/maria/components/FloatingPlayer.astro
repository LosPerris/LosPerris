            ></circle><circle
              cx="55"
              cy="68"
              r="1.4"
              fill="#4a1e06"
              opacity="0.85"></circle>
            <circle cx="54" cy="63" r="1.4" fill="#5a2a08" opacity="0.85"
            ></circle><circle
              cx="58"
              cy="59"
              r="1.4"
              fill="#4a1e06"
              opacity="0.85"></circle>
            <circle cx="63" cy="57" r="1.4" fill="#5a2a08" opacity="0.85"
            ></circle><circle
              cx="68"
              cy="61"
              r="1.4"
              fill="#4a1e06"
              opacity="0.85"></circle>
            <circle cx="69" cy="67" r="1.4" fill="#5a2a08" opacity="0.85"
            ></circle><circle
