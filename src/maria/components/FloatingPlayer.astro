        <!-- Caption row -->
        <p
          class="text-[10px] md:text-[17px]"
          style="display:block; padding:7px 0 9px; text-align:center; font-family:'Caveat',cursive; color:#1a1510; opacity:0.70; font-weight:bold;"
        >
          Nuestra promesa
        </p>
      </div><!-- /polaroid-front -->

      <div
        id="polaroid-back"
        class="p-1 md:p-[14px]"
        style="
        position:absolute; inset:0;
        display: none;
        background: #faf6ed;
        border: 1px solid rgba(0,0,0,0.08);
        box-sizing: border-box;
      "
      >
        <!-- inner area matches photo aspect-ratio so total height = front -->
        <div
          style="display:flex; flex-direction:column; justify-content:center; gap:8px; width:100%; aspect-ratio:1;"
        >
          <p
            class="text-[5px] md:text-[8px]"
