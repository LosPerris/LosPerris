---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Para el amor de mi vida ❤️",
  description = "Todo lo que siento por ti",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f43f5e" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://losperris.dev/icon.webp" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>❤️</text></svg>"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --rose: #f43f5e;
        --rose-light: #fb7185;
        --rose-dark: #be123c;
        --pink: #ec4899;
        --purple: #a855f7;
        --purple-dark: #7c3aed;
        --bg: #0c0710;
        --card-bg: rgba(244, 63, 94, 0.04);
        --card-border: rgba(244, 63, 94, 0.15);
        --text: #fff1f5;
        --text-muted: rgba(255, 241, 245, 0.55);
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: "Inter", sans-serif;
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
        overflow-x: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        background:
          radial-gradient(
            ellipse 80% 60% at 50% 0%,
            rgba(168, 85, 247, 0.12) 0%,
            transparent 60%
          ),
          radial-gradient(
            ellipse 60% 40% at 80% 100%,
            rgba(244, 63, 94, 0.1) 0%,
            transparent 50%
          ),
          radial-gradient(
            ellipse 40% 30% at 10% 60%,
            rgba(236, 72, 153, 0.08) 0%,
            transparent 50%
          );
        pointer-events: none;
        z-index: 0;
      }

      .hearts-canvas {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 1;
        overflow: hidden;
      }

      @keyframes float-heart {
        0% {
          transform: translateY(0) rotate(var(--rot-start)) scale(var(--scale));
          opacity: 0;
        }
        25% {
          opacity: var(--max-opacity);
        }
        75% {
          opacity: var(--max-opacity);
        }
        100% {
          transform: translateY(-60vh) rotate(var(--rot-end))
            scale(var(--scale));
          opacity: 0;
        }
      }

      @keyframes sway {
        0%,
        100% {
          margin-left: 0;
        }
        25% {
          margin-left: 30px;
        }
        75% {
          margin-left: -30px;
        }
      }

      .heart-particle {
        position: absolute;
        bottom: -5%;
        font-size: var(--size);
        animation:
          float-heart var(--duration) linear var(--delay) infinite,
          sway calc(var(--duration) * 0.6) ease-in-out var(--delay) infinite;
        will-change: transform, opacity;
        left: var(--x);
        --rot-start: -15deg;
        --rot-end: 15deg;
      }

      .page-wrapper {
        position: relative;
        z-index: 2;
        width: 100%;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        gap: 0;
      }

      slot {
        display: contents;
      }
    </style>
  </head>
  <body>
    <div class="hearts-canvas" id="hearts-canvas" aria-hidden="true"></div>

    <div class="page-wrapper">
      <slot />
    </div>

    <script>
      const canvas = document.getElementById("hearts-canvas");
      if (canvas) {
        const emojis = ["❤️", "🩷", "💕", "💗", "💓", "💞", "🌹", "✨"];
        const count = 28;

        for (let i = 0; i < count; i++) {
          const el = document.createElement("span");
          el.className = "heart-particle";
          el.textContent = emojis[Math.floor(Math.random() * emojis.length)];

          const size = 12 + Math.random() * 22;
          const x = Math.random() * 100;
          const duration = 12 + Math.random() * 18;
          const delay = -(Math.random() * duration); // offset inicial para que no salgan todos a la vez
          const opacity = 0.15 + Math.random() * 0.45;
          const scale = 0.6 + Math.random() * 0.8;

          el.style.setProperty("--size", `${size}px`);
          el.style.setProperty("--x", `${x}%`);
          el.style.setProperty("--duration", `${duration}s`);
          el.style.setProperty("--delay", `${delay}s`);
          el.style.setProperty("--max-opacity", String(opacity));
          el.style.setProperty("--scale", String(scale));

          canvas.appendChild(el);
        }
      }
    </script>
  </body>
</html>
