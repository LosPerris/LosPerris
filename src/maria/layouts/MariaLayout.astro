---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Para el amor de mi vida ❤️",
  description = "Todo lo que siento por ti",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#fbbf24" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://losperris.dev/icon.webp" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌻</text></svg>"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --sunflower: #fbbf24;
        --sunflower-light: #fcd34d;
        --sunflower-dark: #b45309;
        --amber: #f59e0b;
        --gold: #d4af37;
        --bg: #070502;
        --card-bg: rgba(251, 191, 36, 0.03);
        --card-border: rgba(251, 191, 36, 0.12);
        --text: #fffef0;
        --text-muted: rgba(255, 254, 240, 0.5);
      }

      html {
        scroll-behavior: smooth;
        background: var(--bg);
      }

      body {
        font-family:
          "Inter",
          system-ui,
          -apple-system,
          sans-serif;
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
        overflow-x: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        cursor: default;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        background:
          radial-gradient(
            circle at 50% -20%,
            rgba(251, 191, 36, 0.15) 0%,
            transparent 60%
          ),
          radial-gradient(
            circle at 10% 40%,
            rgba(245, 158, 11, 0.08) 0%,
            transparent 40%
          ),
          radial-gradient(
            circle at 90% 80%,
            rgba(212, 175, 55, 0.05) 0%,
            transparent 40%
          );
        pointer-events: none;
        z-index: 0;
        filter: blur(60px);
      }

      .sunflower-canvas {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 1;
        overflow: hidden;
      }

      @keyframes float-sunflower {
        0% {
          transform: translateY(0) rotate(var(--rot-start)) scale(var(--scale));
          opacity: 0;
        }
        20% {
          opacity: var(--max-opacity);
        }
        80% {
          opacity: var(--max-opacity);
        }
        100% {
          transform: translateY(-80vh) rotate(var(--rot-end))
            scale(var(--scale));
          opacity: 0;
        }
      }

      @keyframes sway-subtle {
        0%,
        100% {
          margin-left: 0;
        }
        50% {
          margin-left: 20px;
        }
      }

      .sunflower-particle {
        position: absolute;
        bottom: -10%;
        font-size: var(--size);
        animation:
          float-sunflower var(--duration) linear var(--delay) infinite,
          sway-subtle calc(var(--duration) * 0.5) ease-in-out var(--delay)
            infinite;
        will-change: transform, opacity;
        left: var(--x);
        filter: drop-shadow(0 0 8px rgba(251, 191, 36, 0.3));
        --rot-start: -20deg;
        --rot-end: 20deg;
      }

      .click-particle {
        position: fixed;
        pointer-events: none;
        z-index: 100;
        font-size: 1.2rem;
        will-change: transform, opacity;
        animation: click-burst 0.8s ease-out forwards;
      }

      @keyframes click-burst {
        0% {
          transform: translate(-50%, -50%) scale(0);
          opacity: 1;
        }
        100% {
          transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy)))
            scale(1) rotate(var(--dr));
          opacity: 0;
        }
      }

      .page-wrapper {
        position: relative;
        z-index: 2;
        width: 100%;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        transition: transform 0.1s ease-out;
      }
    </style>
  </head>
  <body>
    <div class="sunflower-canvas" id="sunflower-canvas" aria-hidden="true">
    </div>

    <div class="page-wrapper" id="main-wrapper">
      <slot />
    </div>

    <script>
      const canvas = document.getElementById("sunflower-canvas");
      if (canvas) {
        const emojis = ["🌻", "🌻", "🌻", "🍃", "🌿"];
        const count = 40;

        for (let i = 0; i < count; i++) {
          const el = document.createElement("span");
          el.className = "sunflower-particle";
          el.textContent = emojis[Math.floor(Math.random() * emojis.length)];

          const size = 12 + Math.random() * 28;
          const x = Math.random() * 100;
          const duration = 20 + Math.random() * 25;
          const delay = -(Math.random() * duration);
          const opacity = 0.15 + Math.random() * 0.45;
          const scale = 0.6 + Math.random() * 0.8;

          el.style.setProperty("--size", `${size}px`);
          el.style.setProperty("--x", `${x}%`);
          el.style.setProperty("--duration", `${duration}s`);
          el.style.setProperty("--delay", `${delay}s`);
          el.style.setProperty("--max-opacity", String(opacity));
          el.style.setProperty("--scale", String(scale));

          canvas.appendChild(el);
        }

        // Sunburst click effect
        document.addEventListener("click", (e) => {
          const particleCount = 10;
          const bits = ["🌻", "🌻", "🍃", "🌿"]; // Solo girasoles y pasto

          for (let i = 0; i < particleCount; i++) {
            const p = document.createElement("span");
            p.className = "click-particle";
            p.textContent = bits[Math.floor(Math.random() * bits.length)];
            p.style.left = `${e.clientX}px`;
            p.style.top = `${e.clientY}px`;

            const angle = Math.random() * Math.PI * 2;
            const dist = 50 + Math.random() * 100;
            const dx = Math.cos(angle) * dist;
            const dy = Math.sin(angle) * dist;
            const dr = (Math.random() - 0.5) * 360;

            p.style.setProperty("--dx", `${dx}px`);
            p.style.setProperty("--dy", `${dy}px`);
            p.style.setProperty("--dr", `${dr}deg`);

            document.body.appendChild(p);
            setTimeout(() => p.remove(), 800);
          }
        });

        document.addEventListener("mousemove", (e) => {
          const x = (e.clientX / window.innerWidth - 0.5) * 15;
          const y = (e.clientY / window.innerHeight - 0.5) * 15;
          const wrapper = document.getElementById("main-wrapper");
          if (wrapper) {
            wrapper.style.transform = `translate(${x}px, ${y}px)`;
          }
        });
      }
    </script>
  </body>
</html>
