---
// SSR: rendered per request so new Date() is always today, not build time
export const prerender = false;

import MariaLayout from "../layouts/MariaLayout.astro";
import DailyMessage from "../components/DailyMessage.astro";
import AnniversaryModal from "../components/AnniversaryModal.astro";
import QuestionModal from "../components/QuestionModal.astro";
import NoteModal from "../components/NoteModal.astro";
import { SPOTIFY_TRACK_IDS } from "../data/songs";
import { QUESTIONS } from "../data/questions";

const today = new Date().toISOString().split("T")[0];
const seedStr = today; // Use date as seed instead of IP for GDPR compliance

function hashCode(s: string) {
  let h = 0;
  for (let i = 0; i < s.length; i++)
    h = (Math.imul(31, h) + s.charCodeAt(i)) | 0;
  return Math.abs(h);
}

const seed = hashCode(seedStr);
const songIndex = seed % SPOTIFY_TRACK_IDS.length;
const questionIndex = seed % QUESTIONS.length;

const selectedSongId = SPOTIFY_TRACK_IDS[songIndex];
const selectedQuestion = QUESTIONS[questionIndex];

const dateInCR = new Date(
  new Date().toLocaleString("en-US", { timeZone: "America/Costa_Rica" }),
);
const isMay15th = dateInCR.getMonth() === 4 && dateInCR.getDate() === 15;
---

<MariaLayout title="Tu Diario" description="Un lugar hecho solo para ti">
  <NoteModal />
  {isMay15th && <AnniversaryModal />}
  <QuestionModal />

  <script>
    const anniversaryModal = document.getElementById(
      "anniversary-modal",
    ) as HTMLDialogElement | null;

    if (anniversaryModal) {
      setTimeout(() => {
        anniversaryModal.showModal();
      }, 2000); // Muestra el aniversario 2 segundos después de entrar a la página
    }

    // Registrar la visita al cargar la página (evitando spam al refrescar)
    const hasVisitedSession = sessionStorage.getItem("maria_visited");
    if (!hasVisitedSession) {
      sessionStorage.setItem("maria_visited", "true");
      fetch("/api/maria/visit", { method: "POST" }).catch(() => {});
    }
  </script>

  <DailyMessage songId={selectedSongId} question={selectedQuestion} />
</MariaLayout>
