---
import Layout from "../layouts/Layout.astro";
import TermsSection from "../components/terms/TermsSection.astro";
import { termsSections } from "../data/terms";
import Button from "../components/ui/Button.astro";
---

<Layout
    title="Términos y Condiciones - LosPerris - Real"
    showHeader={false}
    showFooter={false}
>
    <header
        class="sticky top-0 z-[100] backdrop-blur-md bg-[#1a1a1a]/95 border-b-2 border-[#404040] py-4"
    >
        <nav class="w-full">
            <div
                class="max-w-7xl mx-auto px-8 flex justify-between items-center"
            >
                <div class="flex items-center gap-4">
                    <img
                        src="/img/Real.png"
                        alt="Los Perris Logo"
                        class="w-10 h-10 rounded-full"
                    />
                    <span class="text-2xl font-bold text-white"
                        >LosPerris - Real</span
                    >
                </div>
                <div class="nav-actions">
                    <Button href="/" variant="outline">
                        <i class="fas fa-arrow-left mr-2"></i> Volver al Inicio
                    </Button>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-1 py-8 bg-[#1a1a1a]">
        <div class="max-w-4xl mx-auto px-8">
            <div
                class="text-center mb-12 p-8 bg-[#2d2d2d] rounded-xl border border-[#404040] shadow-md"
            >
                <h1
                    class="text-4xl mb-4 text-white flex items-center justify-center gap-4 font-bold"
                >
                    <i class="fas fa-file-contract"></i> Términos y Condiciones
                </h1>
                <p class="text-[#808080] mb-4 text-sm">
                    Última actualización: <strong class="text-white"
                        >15 de Enero de 2024</strong
                    >
                </p>
                <p class="text-lg text-[#b0b0b0] max-w-2xl mx-auto">
                    Al utilizar los bots LosPerrisHelp y LosPerrisGame, aceptas
                    los siguientes términos y condiciones.
                </p>
            </div>

            <div class="mb-12">
                {
                    termsSections.map((section, index) => (
                        <TermsSection
                            title={section.title}
                            icon={section.icon}
                            content={section.content}
                            index={index}
                        />
                    ))
                }
            </div>

            <div class="mt-12">
                <div
                    class="bg-gradient-to-br from-[#2d2d2d] to-[#404040] p-6 rounded-xl mb-8 flex items-center gap-4 shadow-md"
                >
                    <i class="fas fa-check-circle text-2xl text-white"></i>
                    <p class="text-white font-semibold m-0">
                        Al utilizar nuestros bots, confirmas que has leído,
                        entendido y aceptado estos términos y condiciones.
                    </p>
                </div>
                <div class="flex gap-4 justify-center flex-wrap">
                    <Button href="/">
                        <i class="fas fa-home mr-2"></i> Volver al Inicio
                    </Button>
                    <Button onclick="window.print()" variant="outline">
                        <i class="fas fa-print mr-2"></i> Imprimir
                    </Button>
                </div>
            </div>
        </div>
    </main>

    <footer class="bg-[#1a1a1a]/95 py-8 border-t-2 border-[#404040] mt-auto">
        <div class="max-w-4xl mx-auto px-8">
            <div
                class="flex justify-between items-center flex-wrap gap-4 text-center"
            >
                <p class="text-[#808080]">
                    &copy; 2025 losperris.site. Todos los derechos reservados.
                </p>
                <div class="flex gap-8">
                    <a
                        href="/"
                        class="text-[#808080] no-underline transition-all hover:text-white"
                        >Inicio</a
                    >
                    <a
                        href="/terminos"
                        class="text-[#808080] no-underline transition-all hover:text-white"
                        >Términos y Condiciones</a
                    >
                    <a
                        href="https://discord.gg/JKPUVf9aeU"
                        class="text-[#808080] no-underline transition-all hover:text-white"
                        >Discord</a
                    >
                </div>
            </div>
        </div>
    </footer>
</Layout>
