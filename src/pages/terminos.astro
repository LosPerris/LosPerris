---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Términos y Condiciones - LosPerris - Real"
    showHeader={false}
    showFooter={false}
>
    <header
        class="sticky top-0 z-[100] backdrop-blur-md bg-[#1a1a1a]/95 border-b-2 border-[#404040] py-4"
    >
        <nav class="w-full">
            <div
                class="max-w-7xl mx-auto px-8 flex justify-between items-center"
            >
                <div class="flex items-center gap-4">
                    <img
                        src="/img/Real.png"
                        alt="Los Perris Logo"
                        class="w-10 h-10 rounded-full"
                    />
                    <span class="text-2xl font-bold text-white"
                        >LosPerris - Real</span
                    >
                </div>
                <div class="nav-actions">
                    <a
                        href="/"
                        class="inline-flex items-center gap-2 px-6 py-3 border-2 border-[#404040] rounded-xl text-white font-semibold transition-all hover:bg-[#2d2d2d] hover:border-[#404040] hover:-translate-y-1 bg-transparent no-underline"
                    >
                        <i class="fas fa-arrow-left"></i> Volver al Inicio
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-1 py-8 bg-[#1a1a1a]">
        <div class="max-w-4xl mx-auto px-8">
            <div
                class="text-center mb-12 p-8 bg-[#2d2d2d] rounded-xl border border-[#404040] shadow-md"
            >
                <h1
                    class="text-4xl mb-4 text-white flex items-center justify-center gap-4 font-bold"
                >
                    <i class="fas fa-file-contract"></i> Términos y Condiciones
                </h1>
                <p class="text-[#808080] mb-4 text-sm">
                    Última actualización: <strong class="text-white"
                        >15 de Enero de 2024</strong
                    >
                </p>
                <p class="text-lg text-[#b0b0b0] max-w-2xl mx-auto">
                    Al utilizar los bots LosPerrisHelp y LosPerrisGame, aceptas
                    los siguientes términos y condiciones.
                </p>
            </div>

            <div class="mb-12">
                <section
                    class="bg-[#2d2d2d] mb-8 p-8 rounded-xl border border-[#404040] transition-all shadow-md hover:-translate-y-1 hover:shadow-xl animate-[fadeInUp_0.6s_ease_forwards]"
                >
                    <h2
                        class="text-white mb-6 text-2xl flex items-center gap-3 pb-2 border-b-2 border-[#404040]"
                    >
                        <i class="fas fa-info-circle"></i> 1. Información General
                    </h2>
                    <div class="text-[#b0b0b0] leading-relaxed">
                        <p class="mb-4">
                            Los Perris Bots es un servicio que proporciona dos
                            bots especializados para Discord:
                        </p>
                        <ul class="ml-8 mb-4 list-disc marker:text-white">
                            <li class="mb-2">
                                <strong class="text-white"
                                    >LosPerrisHelp:</strong
                                > Bot de moderación y utilidades
                            </li>
                            <li class="mb-2">
                                <strong class="text-white"
                                    >LosPerrisGame:</strong
                                > Bot gaming con estadísticas de juegos
                            </li>
                        </ul>
                        <p class="mb-4">
                            Estos servicios son proporcionados de forma gratuita
                            y están sujetos a los términos descritos en este
                            documento.
                        </p>
                    </div>
                </section>

                <section
                    class="bg-[#2d2d2d] mb-8 p-8 rounded-xl border border-[#404040] transition-all shadow-md hover:-translate-y-1 hover:shadow-xl animate-[fadeInUp_0.6s_ease_forwards]"
                    style="animation-delay: 0.1s;"
                >
                    <h2
                        class="text-white mb-6 text-2xl flex items-center gap-3 pb-2 border-b-2 border-[#404040]"
                    >
                        <i class="fas fa-user-check"></i> 2. Aceptación de Términos
                    </h2>
                    <div class="text-[#b0b0b0] leading-relaxed">
                        <p class="mb-4">
                            Al invitar cualquiera de nuestros bots a tu servidor
                            de Discord, automáticamente aceptas:
                        </p>
                        <ul class="ml-8 mb-4 list-disc marker:text-white">
                            <li class="mb-2">
                                Cumplir con todos los términos y condiciones
                                establecidos
                            </li>
                            <li class="mb-2">
                                Respetar las políticas de uso de Discord
                            </li>
                            <li class="mb-2">
                                Utilizar los bots de manera responsable y ética
                            </li>
                            <li class="mb-2">
                                No intentar explotar, hackear o dañar los
                                servicios
                            </li>
                        </ul>
                    </div>
                </section>

                <section
                    class="bg-[#2d2d2d] mb-8 p-8 rounded-xl border border-[#404040] transition-all shadow-md hover:-translate-y-1 hover:shadow-xl animate-[fadeInUp_0.6s_ease_forwards]"
                    style="animation-delay: 0.2s;"
                >
                    <h2
                        class="text-white mb-6 text-2xl flex items-center gap-3 pb-2 border-b-2 border-[#404040]"
                    >
                        <i class="fas fa-cogs"></i> 3. Uso del Servicio
                    </h2>
                    <div class="text-[#b0b0b0] leading-relaxed">
                        <h3 class="text-[#b0b0b0] my-4 text-xl font-semibold">
                            Uso Permitido:
                        </h3>
                        <ul class="ml-8 mb-4 list-disc marker:text-white">
                            <li class="mb-2">
                                Utilizar los comandos según su propósito
                                diseñado
                            </li>
                            <li class="mb-2">
                                Moderar tu servidor con LosPerrisHelp
                            </li>
                            <li class="mb-2">
                                Consultar estadísticas de juegos con
                                LosPerrisGame
                            </li>
                            <li class="mb-2">
                                Reportar bugs o problemas técnicos
                            </li>
                        </ul>

                        <h3 class="text-[#b0b0b0] my-4 text-xl font-semibold">
                            Uso Prohibido:
                        </h3>
                        <ul class="ml-8 mb-4 list-disc marker:text-white">
                            <li class="mb-2">Spam o abuso de comandos</li>
                            <li class="mb-2">
                                Intentos de bypass de limitaciones
                            </li>
                            <li class="mb-2">
                                Uso para actividades ilegales o dañinas
                            </li>
                            <li class="mb-2">
                                Reventa o redistribución del servicio
                            </li>
                            <li class="mb-2">Ingeniería inversa del código</li>
                        </ul>
                    </div>
                </section>

                <section
                    class="bg-[#2d2d2d] mb-8 p-8 rounded-xl border border-[#404040] transition-all shadow-md hover:-translate-y-1 hover:shadow-xl animate-[fadeInUp_0.6s_ease_forwards]"
                    style="animation-delay: 0.3s;"
                >
                    <h2
                        class="text-white mb-6 text-2xl flex items-center gap-3 pb-2 border-b-2 border-[#404040]"
                    >
                        <i class="fas fa-shield-alt"></i> 4. Privacidad y Datos
                    </h2>
                    <div class="text-[#b0b0b0] leading-relaxed">
                        <h3 class="text-[#b0b0b0] my-4 text-xl font-semibold">
                            Datos Recopilados:
                        </h3>
                        <ul class="ml-8 mb-4 list-disc marker:text-white">
                            <li class="mb-2">
                                IDs de usuario y servidor de Discord
                            </li>
                            <li class="mb-2">
                                Mensajes procesados por comandos
                            </li>
                            <li class="mb-2">Estadísticas de uso básicas</li>
                            <li class="mb-2">
                                Logs de errores para mejoras técnicas
                            </li>
                        </ul>

                        <h3 class="text-[#b0b0b0] my-4 text-xl font-semibold">
                            Uso de Datos:
                        </h3>
                        <ul class="ml-8 mb-4 list-disc marker:text-white">
                            <li class="mb-2">
                                Proporcionar funcionalidad del bot
                            </li>
                            <li class="mb-2">
                                Mejorar el rendimiento y características
                            </li>
                            <li class="mb-2">Resolver problemas técnicos</li>
                            <li class="mb-2">
                                Cumplir con los términos de Discord
                            </li>
                        </ul>

                        <p class="mb-4">
                            <strong class="text-white">Compromiso:</strong> No vendemos,
                            compartimos o distribuimos tus datos personales a terceros.
                        </p>
                    </div>
                </section>

                <section
                    class="bg-[#2d2d2d] mb-8 p-8 rounded-xl border border-[#404040] transition-all shadow-md hover:-translate-y-1 hover:shadow-xl animate-[fadeInUp_0.6s_ease_forwards]"
                    style="animation-delay: 0.4s;"
                >
                    <h2
                        class="text-white mb-6 text-2xl flex items-center gap-3 pb-2 border-b-2 border-[#404040]"
                    >
                        <i class="fas fa-exclamation-triangle"></i> 5. Limitaciones
                        y Responsabilidades
                    </h2>
                    <div class="text-[#b0b0b0] leading-relaxed">
                        <h3 class="text-[#b0b0b0] my-4 text-xl font-semibold">
                            Disponibilidad del Servicio:
                        </h3>
                        <ul class="ml-8 mb-4 list-disc marker:text-white">
                            <li class="mb-2">
                                Los bots pueden experimentar tiempo de
                                inactividad por mantenimiento
                            </li>
                            <li class="mb-2">
                                No garantizamos disponibilidad 100% del tiempo
                            </li>
                            <li class="mb-2">
                                Nos reservamos el derecho de suspender el
                                servicio temporalmente
                            </li>
                        </ul>

                        <h3 class="text-[#b0b0b0] my-4 text-xl font-semibold">
                            Limitación de Responsabilidad:
                        </h3>
                        <ul class="ml-8 mb-4 list-disc marker:text-white">
                            <li class="mb-2">
                                No somos responsables por daños indirectos o
                                consecuenciales
                            </li>
                            <li class="mb-2">
                                El servicio se proporciona "tal como está"
                            </li>
                            <li class="mb-2">
                                Los usuarios son responsables del uso apropiado
                                en sus servidores
                            </li>
                        </ul>
                    </div>
                </section>

                <section
                    class="bg-[#2d2d2d] mb-8 p-8 rounded-xl border border-[#404040] transition-all shadow-md hover:-translate-y-1 hover:shadow-xl animate-[fadeInUp_0.6s_ease_forwards]"
                    style="animation-delay: 0.5s;"
                >
                    <h2
                        class="text-white mb-6 text-2xl flex items-center gap-3 pb-2 border-b-2 border-[#404040]"
                    >
                        <i class="fas fa-ban"></i> 6. Suspensión y Terminación
                    </h2>
                    <div class="text-[#b0b0b0] leading-relaxed">
                        <p class="mb-4">
                            Nos reservamos el derecho de suspender o terminar el
                            acceso a nuestros servicios en caso de:
                        </p>
                        <ul class="ml-8 mb-4 list-disc marker:text-white">
                            <li class="mb-2">
                                Violación de estos términos y condiciones
                            </li>
                            <li class="mb-2">
                                Uso abusivo o malicioso del servicio
                            </li>
                            <li class="mb-2">
                                Actividades que pongan en riesgo la estabilidad
                                del servicio
                            </li>
                            <li class="mb-2">
                                Incumplimiento de las políticas de Discord
                            </li>
                        </ul>
                        <p class="mb-4">
                            La suspensión puede ser temporal o permanente según
                            la gravedad de la infracción.
                        </p>
                    </div>
                </section>

                <section
                    class="bg-[#2d2d2d] mb-8 p-8 rounded-xl border border-[#404040] transition-all shadow-md hover:-translate-y-1 hover:shadow-xl animate-[fadeInUp_0.6s_ease_forwards]"
                    style="animation-delay: 0.6s;"
                >
                    <h2
                        class="text-white mb-6 text-2xl flex items-center gap-3 pb-2 border-b-2 border-[#404040]"
                    >
                        <i class="fas fa-edit"></i> 7. Modificaciones
                    </h2>
                    <div class="text-[#b0b0b0] leading-relaxed">
                        <p class="mb-4">
                            Nos reservamos el derecho de modificar estos
                            términos y condiciones en cualquier momento. Los
                            cambios serán efectivos inmediatamente después de su
                            publicación.
                        </p>
                        <p class="mb-4">
                            Es responsabilidad del usuario revisar
                            periódicamente estos términos para mantenerse
                            informado de cualquier cambio.
                        </p>
                        <p class="mb-4">
                            El uso continuado del servicio después de las
                            modificaciones constituye la aceptación de los
                            nuevos términos.
                        </p>
                    </div>
                </section>

                <section
                    class="bg-[#2d2d2d] mb-8 p-8 rounded-xl border border-[#404040] transition-all shadow-md hover:-translate-y-1 hover:shadow-xl animate-[fadeInUp_0.6s_ease_forwards]"
                    style="animation-delay: 0.7s;"
                >
                    <h2
                        class="text-white mb-6 text-2xl flex items-center gap-3 pb-2 border-b-2 border-[#404040]"
                    >
                        <i class="fas fa-envelope"></i> 8. Contacto
                    </h2>
                    <div class="text-[#b0b0b0] leading-relaxed">
                        <p class="mb-4">
                            Para preguntas, dudas o reportes relacionados con
                            estos términos y condiciones, puedes contactarnos a
                            través de:
                        </p>
                        <div class="mt-4">
                            <div
                                class="flex items-center gap-3 mb-3 p-3 bg-[#404040] rounded-xl border border-[#404040]"
                            >
                                <i class="fab fa-discord text-white text-xl w-5"
                                ></i>
                                <span
                                    >Servidor de Discord: <a
                                        href="https://discord.gg/TU_ENLACE_AQUI"
                                        target="_blank"
                                        class="text-white font-semibold no-underline hover:underline"
                                        >Los Perris Community</a
                                    ></span
                                >
                            </div>
                            <div
                                class="flex items-center gap-3 mb-3 p-3 bg-[#404040] rounded-xl border border-[#404040]"
                            >
                                <i class="fas fa-headset text-white text-xl w-5"
                                ></i>
                                <span
                                    >Canal de Soporte: <a
                                        href="https://discord.gg/TU_ENLACE_SOPORTE"
                                        target="_blank"
                                        class="text-white font-semibold no-underline hover:underline"
                                        >#soporte-técnico</a
                                    ></span
                                >
                            </div>
                        </div>
                    </div>
                </section>

                <section
                    class="bg-[#2d2d2d] mb-8 p-8 rounded-xl border border-[#404040] transition-all shadow-md hover:-translate-y-1 hover:shadow-xl animate-[fadeInUp_0.6s_ease_forwards]"
                    style="animation-delay: 0.8s;"
                >
                    <h2
                        class="text-white mb-6 text-2xl flex items-center gap-3 pb-2 border-b-2 border-[#404040]"
                    >
                        <i class="fas fa-gavel"></i> 9. Ley Aplicable
                    </h2>
                    <div class="text-[#b0b0b0] leading-relaxed">
                        <p class="mb-4">
                            Estos términos y condiciones se rigen por las leyes
                            aplicables y están sujetos a la jurisdicción
                            correspondiente.
                        </p>
                        <p class="mb-4">
                            Cualquier disputa será resuelta de manera amistosa a
                            través de nuestros canales de comunicación
                            oficiales.
                        </p>
                    </div>
                </section>
            </div>

            <div class="mt-12">
                <div
                    class="bg-gradient-to-br from-[#2d2d2d] to-[#404040] p-6 rounded-xl mb-8 flex items-center gap-4 shadow-md"
                >
                    <i class="fas fa-check-circle text-2xl text-white"></i>
                    <p class="text-white font-semibold m-0">
                        Al utilizar nuestros bots, confirmas que has leído,
                        entendido y aceptado estos términos y condiciones.
                    </p>
                </div>
                <div class="flex gap-4 justify-center flex-wrap">
                    <a
                        href="/"
                        class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-br from-[#2d2d2d] to-[#404040] border-2 border-[#404040] rounded-xl text-white font-semibold transition-all hover:-translate-y-1 hover:shadow-lg no-underline shadow-md"
                    >
                        <i class="fas fa-home"></i> Volver al Inicio
                    </a>
                    <a
                        href="#"
                        onclick="window.print()"
                        class="inline-flex items-center gap-2 px-6 py-3 border-2 border-[#404040] rounded-xl text-white font-semibold transition-all hover:bg-[#2d2d2d] hover:border-[#404040] hover:-translate-y-1 bg-transparent no-underline"
                    >
                        <i class="fas fa-print"></i> Imprimir
                    </a>
                </div>
            </div>
        </div>
    </main>

    <footer class="bg-[#1a1a1a]/95 py-8 border-t-2 border-[#404040] mt-auto">
        <div class="max-w-4xl mx-auto px-8">
            <div
                class="flex justify-between items-center flex-wrap gap-4 text-center"
            >
                <p class="text-[#808080]">
                    &copy; 2025 losperris.site. Todos los derechos reservados.
                </p>
                <div class="flex gap-8">
                    <a
                        href="/"
                        class="text-[#808080] no-underline transition-all hover:text-white"
                        >Inicio</a
                    >
                    <a
                        href="/terminos"
                        class="text-[#808080] no-underline transition-all hover:text-white"
                        >Términos y Condiciones</a
                    >
                    <a
                        href="https://discord.gg/JKPUVf9aeU"
                        class="text-[#808080] no-underline transition-all hover:text-white"
                        >Discord</a
                    >
                </div>
            </div>
        </div>
    </footer>
</Layout>
