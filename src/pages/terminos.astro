---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import TermsSection from "../components/terms/TermsSection.astro";
import { termsSections } from "../data/terms";
import Button from "../components/ui/Button.astro";
import { Image } from "astro:assets";
import realImg from "../assets/img/Real.webp";
import BackgroundEffects from "../components/ui/BackgroundEffects.astro";
import { discordLink, domain } from "../data/community";
---

<Layout
  title="Términos y Condiciones - LosPerris - Real"
  showHeader={false}
  showFooter={false}
>
  <header
    class="sticky top-0 z-100 backdrop-blur-md bg-primary/95 border-b-2 border-[#404040] py-4"
  >
    <nav class="w-full">
      <div class="max-w-7xl mx-auto px-8 flex justify-between items-center">
        <div class="flex items-center gap-4">
          <Image
            src={realImg}
            alt="Los Perris Logo"
            class="w-10 h-10 rounded-full"
            width={40}
            height={40}
            loading="eager"
          />
          <span class="text-2xl font-bold text-white">LosPerris - Real</span>
        </div>
        <div class="nav-actions">
          <Button href="/" variant="outline">
            <i class="fas fa-arrow-left mr-2"></i> Volver al Inicio
          </Button>
        </div>
      </div>
    </nav>
  </header>

  <main class="flex-1 py-12 bg-[#151515] relative overflow-hidden">
    <BackgroundEffects />

    <div class="max-w-4xl mx-auto px-8 relative z-10">
      <div class="text-center mb-16">
        <h1
          class="text-4xl md:text-6xl font-black mb-6 text-white flex flex-wrap items-center justify-center gap-x-4 gap-y-2 tracking-tight uppercase text-center"
        >
          <span class="flex items-center gap-3 justify-center">
            <i class="fas fa-file-contract text-[#5865F2]"></i> Términos
          </span>
          <span
            class="text-transparent bg-clip-text bg-linear-to-r from-[#5865F2] to-purple-500"
            >y Condiciones</span
          >
        </h1>
        <p
          class="text-text-muted mb-4 text-sm font-mono border border-white/10 inline-block px-4 py-1 rounded-full bg-white/5"
        >
          Última actualización: <strong class="text-white"
            >15 de Enero de 2024</strong
          >
        </p>
        <p
          class="text-xl text-text-secondary max-w-2xl mx-auto font-light mt-6"
        >
          Al utilizar los bots LosPerrisHelp y LosPerrisGame, aceptas los
          siguientes términos y condiciones.
        </p>
      </div>

      <div class="mb-12 space-y-6">
        {
          termsSections.map((section, index) => (
            <div class="bg-white/5 border border-white/10 rounded-2xl p-8 backdrop-blur-sm hover:bg-white/10 transition-colors">
              <TermsSection
                title={section.title}
                icon={section.icon}
                content={section.content}
                index={index}
              />
            </div>
          ))
        }
      </div>

      <div class="mt-12">
        <div
          class="bg-linear-to-r from-[#5865F2]/10 to-purple-500/10 border border-[#5865F2]/20 p-8 rounded-2xl mb-12 flex items-center gap-6 shadow-lg backdrop-blur-md"
        >
          <div
            class="w-12 h-12 shrink-0 rounded-full bg-[#5865F2]/20 flex items-center justify-center text-[#5865F2] text-2xl"
          >
            <i class="fas fa-check-circle"></i>
          </div>
          <p class="text-white font-medium m-0 text-lg">
            Al utilizar nuestros bots, confirmas que has leído, entendido y
            aceptado estos términos y condiciones.
          </p>
        </div>
        <div class="flex gap-4 justify-center flex-wrap">
          <Button href="/">
            <i class="fas fa-home mr-2"></i> Volver al Inicio
          </Button>
          <Button onclick="window.print()" variant="outline">
            <i class="fas fa-print mr-2"></i> Imprimir
          </Button>
        </div>
      </div>
    </div>
  </main>

  <footer class="bg-primary/95 py-8 border-t-2 border-[#404040] mt-auto">
    <div class="max-w-4xl mx-auto px-8">
      <div
        class="flex justify-between items-center flex-wrap gap-4 text-center"
      >
        <p class="text-text-muted">
          &copy; 2025 {domain}. Todos los derechos reservados.
        </p>
        <div class="flex gap-8">
          <a
            href="/"
            class="text-text-muted no-underline transition-all hover:text-white"
            >Inicio</a
          >
          <a
            href="/terminos"
            class="text-text-muted no-underline transition-all hover:text-white"
            >Términos y Condiciones</a
          >
          <a
            href={discordLink}
            class="text-text-muted no-underline transition-all hover:text-white"
            >Discord</a
          >
        </div>
      </div>
    </div>
  </footer>
</Layout>
