---
import LegalLayout from "../layouts/LegalLayout.astro";
import TermsSection from "../components/terms/TermsSection.astro";
import { termsSections } from "../data/terms";
---

<LegalLayout
  title="Términos y Condiciones - LosPerris"
  pageTitlePrimary="Términos"
  pageTitleSecondary="y Condiciones"
  pageIcon="fas fa-file-contract"
  lastUpdated="21 de Junio de 2026"
  description="Al utilizar los servicios, bots y APIs de LosPerris, aceptas los siguientes términos y condiciones."
>
  {
    termsSections.map((section, index) => (
      <div class="bg-white/5 border border-white/10 rounded-2xl p-8 backdrop-blur-sm hover:bg-white/10 transition-colors">
        <TermsSection
          title={section.title}
          icon={section.icon}
          content={section.content}
          index={index}
        />
      </div>
    ))
  }
</LegalLayout>
