---
import Layout from "../layouts/Layout.astro";
import Section from "../components/ui/Section.astro";
import ContactForm from "../components/contact/ContactForm.astro";
import ContactInfo from "../components/contact/ContactInfo.astro";
import FAQSection from "../components/contact/FAQSection.astro";
import Modal from "../components/ui/Modal.astro";
---

<Layout title="Contacto - LosPerris Real">
    <main class="pt-20 bg-[#1a1a1a]">
        <Section class="bg-[#1a1a1a] text-white text-center">
            <h1
                class="text-5xl font-bold mb-4 animate-[fadeInUp_0.8s_ease-out] text-white"
            >
                Contáctanos
            </h1>
            <p
                class="text-xl opacity-90 max-w-2xl mx-auto animate-[fadeInUp_0.8s_ease-out_0.2s_both] text-[#b0b0b0]"
            >
                ¿Tienes alguna pregunta o necesitas ayuda? Estamos aquí para ti
            </p>
        </Section>

        <Section class="bg-[#1a1a1a]">
            <div
                class="grid grid-cols-1 md:grid-cols-2 gap-16 max-w-6xl mx-auto"
            >
                <ContactForm />
                <ContactInfo />
            </div>
        </Section>

        <FAQSection />
    </main>

    <Modal id="supportModal" title="Ayuda rápida">
        <div class="text-white">
            <p class="mb-4">Para obtener ayuda rápida, puedes:</p>
            <ul class="list-none p-0">
                <li class="py-2 border-b border-[#404040]">
                    Unirte a nuestro <a
                        href="https://discord.gg/JKPUVf9aeU"
                        target="_blank"
                        class="text-[#b0b0b0] no-underline hover:text-white hover:underline"
                        >servidor de Discord</a
                    >
                </li>
                <li class="py-2 border-b border-[#404040]">
                    Enviar un email a <a
                        href="mailto:contacto@losperris.site"
                        class="text-[#b0b0b0] no-underline hover:text-white hover:underline"
                        >contacto@losperris.site</a
                    >
                </li>
                <li class="py-2 border-b-0">
                    Usar el formulario de contacto en esta página
                </li>
            </ul>
        </div>
    </Modal>
</Layout>

<script is:inline>
    window.openSupportModal = () => {
        const modal = document.getElementById("supportModal");
        if (modal) {
            modal.classList.remove("hidden");
            document.body.style.overflow = "hidden";
        }
    };
</script>
