---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contacto - LosPerris Real">
    <main class="pt-20 bg-[#1a1a1a]">
        <section class="bg-[#1a1a1a] text-white py-20 text-center">
            <div class="container mx-auto px-6">
                <h1
                    class="text-5xl font-bold mb-4 animate-[fadeInUp_0.8s_ease-out] text-white"
                >
                    Contáctanos
                </h1>
                <p
                    class="text-xl opacity-90 max-w-2xl mx-auto animate-[fadeInUp_0.8s_ease-out_0.2s_both] text-[#b0b0b0]"
                >
                    ¿Tienes alguna pregunta o necesitas ayuda? Estamos aquí para
                    ti
                </p>
            </div>
        </section>

        <section class="py-20 bg-[#1a1a1a]">
            <div class="container mx-auto px-6">
                <div
                    class="grid grid-cols-1 md:grid-cols-2 gap-16 max-w-6xl mx-auto"
                >
                    <div
                        class="bg-[#2d2d2d] p-10 rounded-xl shadow-2xl animate-[fadeInUp_0.8s_ease-out_0.4s_both] border border-[#404040]"
                    >
                        <h2
                            class="text-3xl font-semibold mb-8 text-white text-center"
                        >
                            Envíanos un mensaje
                        </h2>
                        <form class="flex flex-col gap-6" id="contactForm">
                            <div class="flex flex-col">
                                <label
                                    for="nombre"
                                    class="font-medium mb-2 block text-white"
                                    >Nombre completo</label
                                >
                                <input
                                    type="text"
                                    id="nombre"
                                    name="nombre"
                                    required
                                    class="w-full px-4 py-3 border-2 border-[#404040] rounded-lg text-base bg-[#404040] text-white transition-all focus:outline-none focus:border-[#404040] focus:shadow-lg focus:bg-[#2d2d2d]"
                                />
                            </div>
                            <div class="flex flex-col">
                                <label
                                    for="email"
                                    class="font-medium mb-2 block text-white"
                                    >Correo electrónico</label
                                >
                                <input
                                    type="email"
                                    id="email"
                                    name="email"
                                    required
                                    class="w-full px-4 py-3 border-2 border-[#404040] rounded-lg text-base bg-[#404040] text-white transition-all focus:outline-none focus:border-[#404040] focus:shadow-lg focus:bg-[#2d2d2d]"
                                />
                            </div>
                            <div class="flex flex-col">
                                <label
                                    for="asunto"
                                    class="font-medium mb-2 block text-white"
                                    >Asunto</label
                                >
                                <select
                                    id="asunto"
                                    name="asunto"
                                    required
                                    class="w-full px-4 py-3 border-2 border-[#404040] rounded-lg text-base bg-[#404040] text-white transition-all focus:outline-none focus:border-[#404040] focus:shadow-lg focus:bg-[#2d2d2d]"
                                >
                                    <option
                                        value=""
                                        class="bg-[#2d2d2d] text-white"
                                        >Selecciona un asunto</option
                                    >
                                    <option
                                        value="Ayuda técnica"
                                        class="bg-[#2d2d2d] text-white"
                                        >Ayuda técnica</option
                                    >
                                    <option
                                        value="Sugerencia"
                                        class="bg-[#2d2d2d] text-white"
                                        >Sugerencia</option
                                    >
                                    <option
                                        value="Reporte de bug"
                                        class="bg-[#2d2d2d] text-white"
                                        >Reporte de bug</option
                                    >
                                    <option
                                        value="Colaboración"
                                        class="bg-[#2d2d2d] text-white"
                                        >Colaboración</option
                                    >
                                    <option
                                        value="Consulta general"
                                        class="bg-[#2d2d2d] text-white"
                                        >Otro</option
                                    >
                                </select>
                            </div>
                            <div class="flex flex-col">
                                <label
                                    for="mensaje"
                                    class="font-medium mb-2 block text-white"
                                    >Mensaje</label
                                >
                                <textarea
                                    id="mensaje"
                                    name="mensaje"
                                    rows="6"
                                    required
                                    placeholder="Describe tu consulta o mensaje..."
                                    class="w-full px-4 py-3 border-2 border-[#404040] rounded-lg text-base bg-[#404040] text-white transition-all focus:outline-none focus:border-[#404040] focus:shadow-lg focus:bg-[#2d2d2d] resize-none min-h-[120px]"
                                ></textarea>
                            </div>
                            <button
                                type="submit"
                                class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl font-semibold transition-all border-2 border-[#404040] text-base cursor-pointer bg-gradient-to-br from-[#2d2d2d] to-[#404040] text-white hover:-translate-y-1 hover:shadow-lg"
                            >
                                <i class="fas fa-paper-plane"></i>
                                Enviar mensaje
                            </button>
                        </form>
                    </div>

                    <div class="animate-[fadeInUp_0.8s_ease-out_0.6s_both]">
                        <h2
                            class="text-3xl font-semibold mb-8 text-white text-center"
                        >
                            Información de contacto
                        </h2>

                        <div class="flex flex-col gap-8 mb-12">
                            <div
                                class="flex items-start gap-4 p-6 bg-[#2d2d2d] rounded-xl shadow-lg transition-all border border-[#404040] hover:-translate-y-2 hover:shadow-2xl hover:border-[#404040] group"
                            >
                                <div
                                    class="w-12 h-12 bg-gradient-to-br from-[#2d2d2d] to-[#404040] rounded-xl flex items-center justify-center text-white text-xl flex-shrink-0 group-hover:scale-110 transition-transform"
                                >
                                    <i class="fab fa-discord"></i>
                                </div>
                                <div>
                                    <h3
                                        class="text-lg font-semibold mb-2 text-white"
                                    >
                                        Discord
                                    </h3>
                                    <p class="text-[#b0b0b0] mb-2 text-sm">
                                        Únete a nuestro servidor oficial
                                    </p>
                                    <a
                                        href="https://discord.gg/JKPUVf9aeU"
                                        class="text-[#b0b0b0] no-underline font-medium transition-colors hover:text-white"
                                        target="_blank"
                                    >
                                        discord.gg/JKPUVf9aeU
                                    </a>
                                </div>
                            </div>

                            <div
                                class="flex items-start gap-4 p-6 bg-[#2d2d2d] rounded-xl shadow-lg transition-all border border-[#404040] hover:-translate-y-2 hover:shadow-2xl hover:border-[#404040] group"
                            >
                                <div
                                    class="w-12 h-12 bg-gradient-to-br from-[#2d2d2d] to-[#404040] rounded-xl flex items-center justify-center text-white text-xl flex-shrink-0 group-hover:scale-110 transition-transform"
                                >
                                    <i class="fas fa-envelope"></i>
                                </div>
                                <div>
                                    <h3
                                        class="text-lg font-semibold mb-2 text-white"
                                    >
                                        Email
                                    </h3>
                                    <p class="text-[#b0b0b0] mb-2 text-sm">
                                        Respuesta en 24-48 horas
                                    </p>
                                    <a
                                        href="mailto:contacto@losperris.site"
                                        class="text-[#b0b0b0] no-underline font-medium transition-colors hover:text-white"
                                    >
                                        contacto@losperris.site
                                    </a>
                                </div>
                            </div>

                            <div
                                class="flex items-start gap-4 p-6 bg-[#2d2d2d] rounded-xl shadow-lg transition-all border border-[#404040] hover:-translate-y-2 hover:shadow-2xl hover:border-[#404040] group"
                            >
                                <div
                                    class="w-12 h-12 bg-gradient-to-br from-[#2d2d2d] to-[#404040] rounded-xl flex items-center justify-center text-white text-xl flex-shrink-0 group-hover:scale-110 transition-transform"
                                >
                                    <i class="fas fa-question-circle"></i>
                                </div>
                                <div>
                                    <h3
                                        class="text-lg font-semibold mb-2 text-white"
                                    >
                                        Ayuda rápida
                                    </h3>
                                    <p class="text-[#b0b0b0] mb-2 text-sm">
                                        Para problemas urgentes
                                    </p>
                                    <a
                                        href="#"
                                        class="text-[#b0b0b0] no-underline font-medium transition-colors hover:text-white"
                                        onclick="openSupportModal()"
                                    >
                                        Abrir ticket de ayuda
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="py-20 bg-[#404040]">
            <div class="container mx-auto px-6">
                <h2 class="text-3xl font-semibold mb-8 text-white text-center">
                    Preguntas frecuentes
                </h2>
                <div
                    class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto"
                >
                    <div
                        class="p-8 bg-[#2d2d2d] rounded-xl border-l-4 border-[#404040] transition-all border border-[#404040] hover:-translate-y-1 hover:shadow-2xl hover:border-[#404040]"
                    >
                        <h3
                            class="text-lg font-semibold mb-4 text-white flex items-center gap-2"
                        >
                            <i class="fas fa-question-circle text-[#b0b0b0]"
                            ></i>
                            ¿Cómo agrego los bots a mi servidor?
                        </h3>
                        <p class="text-[#b0b0b0] leading-relaxed">
                            Puedes agregar nuestros bots desde la página
                            principal haciendo clic en los botones "Agregar a
                            Discord" de cada bot.
                        </p>
                    </div>
                    <div
                        class="p-8 bg-[#2d2d2d] rounded-xl border-l-4 border-[#404040] transition-all border border-[#404040] hover:-translate-y-1 hover:shadow-2xl hover:border-[#404040]"
                    >
                        <h3
                            class="text-lg font-semibold mb-4 text-white flex items-center gap-2"
                        >
                            <i class="fas fa-question-circle text-[#b0b0b0]"
                            ></i>
                            ¿Los bots son gratuitos?
                        </h3>
                        <p class="text-[#b0b0b0] leading-relaxed">
                            Sí, ambos bots son completamente gratuitos y siempre
                            lo serán. No hay costos ocultos ni suscripciones.
                        </p>
                    </div>
                    <div
                        class="p-8 bg-[#2d2d2d] rounded-xl border-l-4 border-[#404040] transition-all border border-[#404040] hover:-translate-y-1 hover:shadow-2xl hover:border-[#404040]"
                    >
                        <h3
                            class="text-lg font-semibold mb-4 text-white flex items-center gap-2"
                        >
                            <i class="fas fa-question-circle text-[#b0b0b0]"
                            ></i>
                            ¿Qué hago si encuentro un bug?
                        </h3>
                        <p class="text-[#b0b0b0] leading-relaxed">
                            Puedes reportar bugs a través del formulario de
                            contacto seleccionando "Reporte de bug" o
                            directamente en nuestro Discord.
                        </p>
                    </div>
                    <div
                        class="p-8 bg-[#2d2d2d] rounded-xl border-l-4 border-[#404040] transition-all border border-[#404040] hover:-translate-y-1 hover:shadow-2xl hover:border-[#404040]"
                    >
                        <h3
                            class="text-lg font-semibold mb-4 text-white flex items-center gap-2"
                        >
                            <i class="fas fa-question-circle text-[#b0b0b0]"
                            ></i>
                            ¿Puedo sugerir nuevas funciones?
                        </h3>
                        <p class="text-[#b0b0b0] leading-relaxed">
                            ¡Por supuesto! Valoramos mucho las sugerencias de la
                            comunidad. Usa el formulario de contacto o
                            compártelas en Discord.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <div
        id="supportModal"
        class="hidden fixed inset-0 z-[1000] bg-black/70 animate-[fadeIn_0.3s_ease]"
    >
        <div
            class="bg-[#2d2d2d] m-[10%_auto] p-0 rounded-xl w-[90%] max-w-[500px] shadow-2xl animate-[slideInUp_0.3s_ease] border border-[#404040]"
        >
            <div
                class="p-6 border-b border-[#404040] flex justify-between items-center bg-[#404040] rounded-t-xl"
            >
                <h2 class="m-0 text-white font-bold text-xl">Ayuda rápida</h2>
                <span
                    class="text-[#b0b0b0] text-3xl font-bold cursor-pointer transition-colors hover:text-white"
                    onclick="closeSupportModal()">&times;</span
                >
            </div>
            <div class="p-8 text-white">
                <p class="mb-4">Para obtener ayuda rápida, puedes:</p>
                <ul class="list-none p-0">
                    <li class="py-2 border-b border-[#404040]">
                        Unirte a nuestro <a
                            href="https://discord.gg/JKPUVf9aeU"
                            target="_blank"
                            class="text-[#b0b0b0] no-underline hover:text-white hover:underline"
                            >servidor de Discord</a
                        >
                    </li>
                    <li class="py-2 border-b border-[#404040]">
                        Enviar un email a <a
                            href="mailto:contacto@losperris.com"
                            class="text-[#b0b0b0] no-underline hover:text-white hover:underline"
                            >contacto@losperris.com</a
                        >
                    </li>
                    <li class="py-2 border-b-0">
                        Usar el formulario de contacto en esta página
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <script
        type="text/javascript"
        src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"
    ></script>
    <script type="text/javascript" is:inline>
        emailjs.init("GMUaeNqA-ftlkGhwm");
    </script>
    <script src="/js/contacto.js" is:inline></script>
</Layout>
