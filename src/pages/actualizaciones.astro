---
import Layout from "../layouts/Layout.astro";
import BackButton from "../components/ui/BackButton.astro";
import Dropdown from "../components/ui/Dropdown.astro";
import UpdateCard from "../components/updates/UpdateCard.astro";
import { socialIcons } from "../data/icons";
import { fetchPlannedUpdates, fetchPublishedUpdates } from "../lib/updates";

const [publishedUpdates, plannedUpdates] = await Promise.all([
  fetchPublishedUpdates(),
  Promise.resolve(fetchPlannedUpdates()),
]);

const PAGE_SIZE = 10;

const plannedSorted = [...plannedUpdates].sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
);
---

<Layout title="Actualizaciones | LosPerris" showBackgroundEffects={false}>
  <main class="min-h-screen pt-32 pb-24 px-4 relative z-10 bg-[#050505]">
    <div class="max-w-4xl mx-auto relative z-10">
      <BackButton class="mb-4" />

      <div class="mb-12">
        <h1
          class="text-4xl md:text-5xl font-black text-white tracking-tight relative inline-block animate-[fadeInUp_0.8s_ease-out] uppercase"
        >
          REGISTRO DE <br /><span
            class="text-transparent bg-clip-text bg-gradient-to-br from-[#f97316] to-[#ea580c] drop-shadow-[0_0_15px_rgba(249,115,22,0.2)]"
            >ACTUALIZACIONES</span
          >
        </h1>
        <p
          class="text-lg text-zinc-400 max-w-2xl mt-6 animate-[fadeInUp_0.8s_ease-out_0.1s_both]"
        >
          Historial de cambios y avisos de lo que viene en cada servicio.
        </p>
      </div>

      <div
        class="flex flex-wrap items-center gap-2 mb-10 animate-[fadeInUp_1s_ease-out_0.3s_both] relative z-50"
        role="group"
        aria-label="Filtrar actualizaciones"
      >
        <button
          data-filter-api="all"
          aria-pressed="true"
          class="filter-btn-api px-4 py-2 rounded-xl text-sm font-bold tracking-wide transition-all duration-300 bg-[#f97316] text-[#050505]"
          >Todos</button
        >
        <button
          data-filter-api="Twitch"
          aria-pressed="false"
          class="filter-btn-api px-4 py-2 rounded-xl text-sm font-bold tracking-wide transition-all duration-300 bg-white/5 text-zinc-400 hover:text-white hover:bg-white/10 flex items-center gap-2"
        >
          <Fragment
            set:html={socialIcons.twitch
              .replace("w-8 h-8", "w-4 h-4")
              .replace(
                "fill-current transition-colors duration-300",
                "fill-[#9146ff]",
              )}
          />
          Twitch
        </button>
        <button
          data-filter-api="Valorant"
          aria-pressed="false"
          class="filter-btn-api px-4 py-2 rounded-xl text-sm font-bold tracking-wide transition-all duration-300 bg-white/5 text-zinc-400 hover:text-white hover:bg-white/10 flex items-center gap-2"
        >
          <Fragment
            set:html={socialIcons.valorant
              .replace("w-8 h-8", "w-4 h-4")
              .replace(
                "fill-current transition-colors duration-300",
                "fill-[#ff4655]",
              )}
          />
          Valorant
        </button>
        <button
          data-filter-api="Transcripts"
          aria-pressed="false"
          class="filter-btn-api px-4 py-2 rounded-xl text-sm font-bold tracking-wide transition-all duration-300 bg-white/5 text-zinc-400 hover:text-white hover:bg-white/10 flex items-center gap-2"
        >
          <i class="fas fa-file-lines text-[#3b82f6]"></i>
          Transcripts
        </button>
        <button
          data-filter-api="Códigos QR"
          aria-pressed="false"
          class="filter-btn-api px-4 py-2 rounded-xl text-sm font-bold tracking-wide transition-all duration-300 bg-white/5 text-zinc-400 hover:text-white hover:bg-white/10 flex items-center gap-2"
        >
          <i class="fas fa-qrcode text-[#22c55e]"></i>
          Códigos QR
        </button>

        <div class="w-px h-6 bg-[#27272a] mx-1 self-center hidden sm:block">
        </div>

        <Dropdown
          id="date-filter"
          label=""
          options={[
            {
              value: "all",
              label: "Todas las fechas",
              icon: '<i class="fas fa-calendar-alt text-zinc-400"></i>',
            },
            {
              value: "7",
              label: "Últimos 7 días",
              icon: '<i class="fas fa-clock text-zinc-400"></i>',
            },
            {
              value: "30",
              label: "Último mes",
              icon: '<i class="fas fa-calendar-week text-zinc-400"></i>',
            },
          ]}
          defaultValue="all"
        />
      </div>

      {
        plannedSorted.length > 0 && (
          <section
            id="planned-section"
            class="mb-14 animate-[fadeInUp_1s_ease-out_0.35s_both]"
            aria-labelledby="planned-heading"
          >
            <div class="mb-6">
              <h2
                id="planned-heading"
                class="text-2xl font-black text-white tracking-tight uppercase"
              >
                Próximamente
              </h2>
              <p class="text-sm text-zinc-500 mt-1">
                Cambios planificados y avisos (migraciones, redirects, etc.).
              </p>
            </div>
            <div class="space-y-6" id="planned-list">
              {plannedSorted.map((update) => (
                <UpdateCard
                  title={update.data.title}
                  dateString={update.data.dateString}
                  tag={update.data.tag}
                  api={update.data.api}
                  description={update.data.description}
                  dateMs={update.data.date.valueOf()}
                  variant="planned"
                />
              ))}
            </div>
          </section>
        )
      }

      <section id="published-section" aria-labelledby="published-heading">
        <div class="mb-6 animate-[fadeInUp_1s_ease-out_0.4s_both]">
          <h2
            id="published-heading"
            class="text-2xl font-black text-white tracking-tight uppercase"
          >
            Historial
          </h2>
          <p class="text-sm text-zinc-500 mt-1">
            Cambios ya aplicados en cada servicio.
          </p>
        </div>

        <div
          class="space-y-6 animate-[fadeInUp_1s_ease-out_0.45s_both]"
          id="updates-list"
          style="view-transition-name: updates-list;"
        >
          {
            publishedUpdates.map((update) => (
              <UpdateCard
                title={update.data.title}
                dateString={update.data.dateString}
                tag={update.data.tag}
                api={update.data.api}
                description={update.data.description}
                dateMs={update.data.date.valueOf()}
                variant="published"
                commitSha={
                  "commitSha" in update.data &&
                  typeof update.data.commitSha === "string"
                    ? update.data.commitSha
                    : undefined
                }
              />
            ))
          }
        </div>

        <nav
          id="updates-pagination"
          class="hidden mt-10 flex flex-col items-center gap-4 animate-[fadeInUp_1s_ease-out_0.5s_both]"
          aria-label="Paginación del historial"
        >
          <p id="pagination-summary" class="text-sm text-zinc-500"></p>
          <div class="flex flex-wrap items-center justify-center gap-2">
            <button
              type="button"
              id="page-prev"
              class="px-4 py-2 rounded-xl text-sm font-bold tracking-wide transition-all duration-300 bg-white/5 text-zinc-400 hover:text-white hover:bg-white/10 disabled:opacity-40 disabled:pointer-events-none"
            >
              <i class="fas fa-chevron-left mr-1" aria-hidden="true"></i>
              Anterior
            </button>
            <span
              id="page-indicator"
              class="px-4 py-2 text-sm font-bold text-zinc-300 tabular-nums"
            ></span>
            <button
              type="button"
              id="page-next"
              class="px-4 py-2 rounded-xl text-sm font-bold tracking-wide transition-all duration-300 bg-white/5 text-zinc-400 hover:text-white hover:bg-white/10 disabled:opacity-40 disabled:pointer-events-none"
            >
              Siguiente
              <i class="fas fa-chevron-right ml-1" aria-hidden="true"></i>
            </button>
          </div>
        </nav>
      </section>

      <div id="no-results" class="hidden text-center py-20">
        <p class="text-zinc-400 text-sm">
          No hay actualizaciones para este filtro.
        </p>
      </div>
    </div>
  </main>
</Layout>

<script is:inline define:vars={{ pageSize: PAGE_SIZE }}>
  let activeApi = "all";
  let activeDate = "all";
  let currentPage = 1;

  const applyFilters = (
    apiFilter,
    dateFilter,
    cards,
    apiButtons,
    skipTransition = false,
  ) => {
    const now = Date.now();
    const msInDay = 86400000;

    apiButtons.forEach((b) => {
      const isActive = b.getAttribute("data-filter-api") === apiFilter;
      b.classList.toggle("bg-[#f97316]", isActive);
      b.classList.toggle("text-[#050505]", isActive);
      b.classList.toggle("bg-white/5", !isActive);
      b.classList.toggle("text-zinc-400", !isActive);
      b.classList.toggle("hover:text-white", !isActive);
      b.classList.toggle("hover:bg-white/10", !isActive);
      b.setAttribute("aria-pressed", isActive ? "true" : "false");
    });

    const updateDOM = () => {
      let visible = 0;
      const matchingPublished = [];

      cards.forEach((card) => {
        const api = card.getAttribute("data-api");
        const dateMs = parseInt(card.getAttribute("data-date") || "0", 10);
        const status = card.getAttribute("data-status");
        const element = card;
        const apiMatch = apiFilter === "all" || apiFilter === api;
        const dateMatch =
          status === "planned" ||
          dateFilter === "all" ||
          now - dateMs <= parseInt(dateFilter, 10) * msInDay;
        const filterMatch = apiMatch && dateMatch;

        if (status === "planned") {
          element.style.display = filterMatch ? "block" : "none";
          if (filterMatch) visible++;
        } else if (filterMatch) {
          matchingPublished.push(element);
        } else {
          element.style.display = "none";
        }
      });

      const totalPages = Math.max(
        1,
        Math.ceil(matchingPublished.length / pageSize),
      );
      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      matchingPublished.forEach((card, index) => {
        const page = Math.floor(index / pageSize) + 1;
        const onPage = page === currentPage;
        card.style.display = onPage ? "block" : "none";
        if (onPage) visible++;
      });

      const plannedSection = document.getElementById("planned-section");
      if (plannedSection) {
        const plannedVisible = [
          ...document.querySelectorAll('.update-card[data-status="planned"]'),
        ].some((c) => c.style.display !== "none");
        plannedSection.style.display = plannedVisible ? "" : "none";
      }

      const publishedSection = document.getElementById("published-section");
      const pagination = document.getElementById("updates-pagination");
      const pagePrev = document.getElementById("page-prev");
      const pageNext = document.getElementById("page-next");
      const pageIndicator = document.getElementById("page-indicator");
      const paginationSummary = document.getElementById("pagination-summary");

      if (publishedSection) {
        const publishedVisible = matchingPublished.length > 0;
        publishedSection.style.display = publishedVisible ? "" : "none";
      }

      if (
        pagination &&
        pagePrev &&
        pageNext &&
        pageIndicator &&
        paginationSummary
      ) {
        const showPagination = matchingPublished.length > pageSize;
        pagination.classList.toggle("hidden", !showPagination);
        pagination.classList.toggle("flex", showPagination);

        if (showPagination) {
          const start = (currentPage - 1) * pageSize + 1;
          const end = Math.min(
            currentPage * pageSize,
            matchingPublished.length,
          );
          paginationSummary.textContent = `Mostrando ${start}–${end} de ${matchingPublished.length}`;
          pageIndicator.textContent = `Página ${currentPage} de ${totalPages}`;
          pagePrev.disabled = currentPage <= 1;
          pageNext.disabled = currentPage >= totalPages;
        }
      }

      const noResults = document.getElementById("no-results");
      if (noResults) noResults.classList.toggle("hidden", visible > 0);
    };

    if (!skipTransition && document.startViewTransition) {
      document.startViewTransition(() => updateDOM());
    } else {
      updateDOM();
    }
  };

  const setupFilters = () => {
    const apiButtons = document.querySelectorAll(".filter-btn-api");
    const cards = document.querySelectorAll(".update-card");
    const dateDropdown = document.getElementById("date-filter");
    const pagePrev = document.getElementById("page-prev");
    const pageNext = document.getElementById("page-next");
    if (!document.getElementById("updates-list")) return;

    activeApi = "all";
    activeDate = "all";
    currentPage = 1;
    applyFilters(activeApi, activeDate, cards, apiButtons, true);

    const filterGroup = document.querySelector(
      "[aria-label='Filtrar actualizaciones']",
    );
    filterGroup?.addEventListener("click", (e) => {
      const btn = e.target.closest(".filter-btn-api");
      if (!btn) return;
      activeApi = btn.getAttribute("data-filter-api") || "all";
      currentPage = 1;
      applyFilters(activeApi, activeDate, cards, apiButtons);
    });

    dateDropdown?.addEventListener("change", (e) => {
      activeDate = e.detail.value;
      currentPage = 1;
      applyFilters(activeApi, activeDate, cards, apiButtons);
    });

    pagePrev?.addEventListener("click", () => {
      if (currentPage <= 1) return;
      currentPage -= 1;
      applyFilters(activeApi, activeDate, cards, apiButtons);
      document
        .getElementById("published-heading")
        ?.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    pageNext?.addEventListener("click", () => {
      currentPage += 1;
      applyFilters(activeApi, activeDate, cards, apiButtons);
      document
        .getElementById("published-heading")
        ?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  };

  document.addEventListener("astro:page-load", setupFilters);
</script>
