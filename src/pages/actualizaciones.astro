---
import Layout from "../layouts/Layout.astro";
import UpdateCard from "../components/updates/UpdateCard.astro";
import Dropdown from "../components/ui/Dropdown.astro";
import Button from "../components/ui/Button.astro";
import { fetchPublishedUpdates, fetchPlannedUpdates } from "../lib/updates";
import { socialIcons } from "../data/icons";

const publishedSorted = fetchPublishedUpdates();
const plannedSorted = fetchPlannedUpdates();
const tags = [...new Set(publishedSorted.map((u) => u.data.tag))];
---

<Layout title="Actualizaciones - LosPerris">
  <main class="min-h-screen bg-[#050505] pt-32 pb-24 px-6 overflow-hidden">
    <div class="max-w-[1100px] mx-auto relative z-10">
      <div class="mb-20 animate-[fadeInUp_0.8s_ease-out]">
        <div class="max-w-3xl">
          <p class="text-[#f97316] font-medium text-[13px] mb-4 tracking-wide">
            Notas de versión
          </p>

          <h1
            class="text-4xl md:text-5xl leading-[1.1] font-medium tracking-tight text-white mb-6"
          >
            Mejoras continuas, explicadas de forma sencilla.
          </h1>

          <p class="text-lg text-zinc-400 leading-relaxed mb-10 max-w-2xl">
            Mantente al día con los cambios pensados para hacer que la
            integración y el uso de nuestras APIs sea más claro, rápido y
            estable.
          </p>

          <div
            class="flex items-center text-[13px] text-zinc-500 font-medium border-t border-white/5 pt-6 inline-flex"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-[#f97316] mr-2"></span>
            v2.0 · Nuevas notas regularmente
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[260px_1fr] gap-12 lg:gap-24">
        <div
          class="lg:sticky lg:top-32 h-fit flex flex-col gap-10 animate-[fadeInUp_0.8s_ease-out]"
        >
          <div class="relative">
            <i
              class="fas fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-zinc-600 text-[12px] pointer-events-none"
            ></i>
            <input
              type="text"
              id="updates-search"
              placeholder="Buscar actualizaciones..."
              autocomplete="off"
              class="w-full bg-transparent border border-transparent rounded-xl pl-9 pr-4 py-2.5 text-[14px] font-medium text-zinc-400 placeholder-zinc-600 outline-none hover:text-white hover:bg-white/5 focus:bg-white/5 focus:border-white/10 focus:text-white transition-all duration-300"
            />
          </div>

          <div
            class="flex flex-col gap-1 w-full"
            role="group"
            aria-label="Filtrar actualizaciones por API"
          >
            <h2
              class="text-[11px] font-semibold text-zinc-500 mb-3 px-3 uppercase tracking-widest"
            >
              Explorar por API
            </h2>

            <button
              data-filter-api="all"
              aria-pressed="true"
              class="filter-btn-api w-full text-left px-4 py-2.5 rounded-xl text-[14px] font-medium transition-all duration-300 bg-white/[0.06] text-white border border-white/10"
            >
              Todos
            </button>
            <button
              data-filter-api="Twitch"
              aria-pressed="false"
              class="filter-btn-api w-full text-left px-4 py-2.5 rounded-xl text-[14px] font-medium transition-all duration-300 bg-transparent border border-transparent text-zinc-400 hover:text-white hover:bg-white/5 flex items-center gap-3"
            >
              <Fragment
                set:html={socialIcons.twitch
                  .replace("w-8 h-8", "w-[14px] h-[14px]")
                  .replace(
                    "fill-current transition-colors duration-300",
                    "fill-current",
                  )}
              />
              Twitch
            </button>
            <button
              data-filter-api="Valorant"
              aria-pressed="false"
              class="filter-btn-api w-full text-left px-4 py-2.5 rounded-xl text-[14px] font-medium transition-all duration-300 bg-transparent border border-transparent text-zinc-400 hover:text-white hover:bg-white/5 flex items-center gap-3"
            >
              <Fragment
                set:html={socialIcons.valorant
                  .replace("w-8 h-8", "w-[14px] h-[14px]")
                  .replace(
                    "fill-current transition-colors duration-300",
                    "fill-current",
                  )}
              />
              Valorant
            </button>
            <button
              data-filter-api="Códigos QR"
              aria-pressed="false"
              class="filter-btn-api w-full text-left px-4 py-2.5 rounded-xl text-[14px] font-medium transition-all duration-300 bg-transparent border border-transparent text-zinc-400 hover:text-white hover:bg-white/5 flex items-center gap-3"
            >
              <i class="fas fa-qrcode text-[14px] w-[14px] text-center"></i>
              Códigos QR
            </button>
          </div>

          <div class="px-3">
            <h2
              class="text-[11px] font-semibold text-zinc-500 mb-3 uppercase tracking-widest"
            >
              Tipo
            </h2>
            <Dropdown
              options={[
                { value: "all", label: "Todas las categorías" },
                ...tags.map((t) => ({ value: t, label: t })),
              ]}
              id="tag-filter"
            />
          </div>
        </div>

        <div class="flex flex-col min-h-[500px]">
          {
            plannedSorted.length > 0 && (
              <section
                id="planned-section"
                class="animate-[fadeInUp_1s_ease-out_0.35s_both]"
                aria-labelledby="planned-heading"
              >
                <div class="flex flex-col" id="planned-list">
                  {plannedSorted.map((update) => (
                    <UpdateCard
                      title={update.data.title}
                      dateString={update.data.dateString}
                      tag={update.data.tag}
                      api={update.data.api}
                      description={update.data.description}
                      dateMs={update.data.date.getTime()}
                      variant="planned"
                    />
                  ))}
                </div>
              </section>
            )
          }

          <section
            id="published-section"
            aria-labelledby="published-heading"
            class="animate-[fadeInUp_1s_ease-out_0.4s_both]"
          >
            <div class="flex flex-col" id="updates-list">
              {
                publishedSorted.map((update, index) => (
                  <UpdateCard
                    title={update.data.title}
                    dateString={update.data.dateString}
                    tag={update.data.tag}
                    api={update.data.api}
                    description={update.data.description}
                    dateMs={update.data.date.getTime()}
                    commitSha={
                      "commitSha" in update.data &&
                      typeof update.data.commitSha === "string"
                        ? update.data.commitSha
                        : undefined
                    }
                    class={index >= 10 ? "hidden-card" : ""}
                  />
                ))
              }
            </div>

            <div
              id="no-results"
              class="hidden text-center py-20 px-6 border border-dashed border-zinc-800 rounded-2xl bg-[#0a0a0a]/50 backdrop-blur-sm"
              aria-live="polite"
            >
              <i
                class="fas fa-search text-4xl text-zinc-700 mb-4"
                aria-hidden="true"></i>
              <p class="text-zinc-400 font-medium">
                No se encontraron actualizaciones para estos filtros.
              </p>
              <button
                id="reset-filters"
                class="mt-4 text-sm text-[#f97316] hover:text-[#ea580c] transition-colors underline decoration-[#f97316]/30 hover:decoration-[#ea580c]/80 underline-offset-4"
              >
                Limpiar filtros
              </button>
            </div>

            <div
              id="load-more-container"
              class="mt-12 flex justify-center w-full"
            >
              <Button
                id="load-more-btn"
                variant="outline"
                class="hidden px-8 py-3"
              >
                Cargar más
              </Button>
            </div>
          </section>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  function setupFilters() {
    const apiButtons = document.querySelectorAll(".filter-btn-api");
    const tagFilter = document.getElementById(
      "tag-filter",
    ) as HTMLSelectElement;
    const updatesList = document.getElementById("updates-list");
    const plannedList = document.getElementById("planned-list");
    const noResults = document.getElementById("no-results");
    const resetBtn = document.getElementById("reset-filters");
    const plannedSection = document.getElementById("planned-section");
    const publishedSection = document.getElementById("published-section");

    if (!updatesList || !tagFilter) return;

    let apiFilter = "all";
    let tagFilterValue = "all";
    let itemsToShow = 10;
    const itemsPerPage = 10;
    const loadMoreBtn = document.getElementById("load-more-btn");
    const searchInput = document.getElementById(
      "updates-search",
    ) as HTMLInputElement;

    const urlParams = new URLSearchParams(window.location.search);
    let textSearchFilter = (urlParams.get("q") || "").toLowerCase();
    if (searchInput && textSearchFilter) searchInput.value = textSearchFilter;
    if (textSearchFilter) itemsToShow = 50;

    function updateVisibility() {
      if (!updatesList) return;
      const allCards = [
        ...Array.from(updatesList.children),
        ...(plannedList ? Array.from(plannedList.children) : []),
      ];
      let visibleCount = 0;
      let visiblePlannedCount = 0;
      let visiblePublishedCount = 0;
      let matchCount = 0;

      allCards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return;

        const cardApi = card.getAttribute("data-api");
        const isPlanned = card.getAttribute("data-status") === "planned";

        const apiMatch = apiFilter === "all" || cardApi === apiFilter;
        const textContent = card.textContent?.toLowerCase() || "";
        const tagMatch =
          tagFilterValue === "all" ||
          textContent.includes(tagFilterValue.toLowerCase());
        const searchMatch =
          !textSearchFilter || textContent.includes(textSearchFilter);

        if (apiMatch && tagMatch && searchMatch) {
          matchCount++;
          if (matchCount <= itemsToShow) {
            card.classList.remove("hidden-card");
            visibleCount++;
            if (isPlanned) visiblePlannedCount++;
            else visiblePublishedCount++;
          } else {
            card.classList.add("hidden-card");
          }
        } else {
          card.classList.add("hidden-card");
        }
      });

      if (noResults) {
        noResults.classList.toggle("hidden", matchCount > 0);
      }

      if (loadMoreBtn) {
        loadMoreBtn.classList.toggle("hidden", matchCount <= itemsToShow);
      }

      if (plannedSection) {
        plannedSection.style.display = visiblePlannedCount > 0 ? "" : "none";
      }
      if (publishedSection && updatesList) {
        updatesList.style.display =
          visiblePublishedCount > 0 || matchCount > 0 ? "" : "none";
      }
    }

    function updateApiButtons() {
      apiButtons.forEach((b) => {
        const isActive = b.getAttribute("data-filter-api") === apiFilter;

        b.classList.toggle("bg-white/[0.06]", isActive);
        b.classList.toggle("border-white/10", isActive);
        b.classList.toggle("text-white", isActive);

        b.classList.toggle("bg-transparent", !isActive);
        b.classList.toggle("border-transparent", !isActive);
        b.classList.toggle("text-zinc-400", !isActive);
        b.classList.toggle("hover:text-white", !isActive);
        b.classList.toggle("hover:bg-white/5", !isActive);
        b.setAttribute("aria-pressed", isActive ? "true" : "false");
      });
    }

    apiButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        apiFilter = btn.getAttribute("data-filter-api") || "all";
        itemsToShow = itemsPerPage;
        updateApiButtons();
        updateVisibility();
      });
    });

    tagFilter.addEventListener("change", (e) => {
      const customEvent = e as CustomEvent;
      tagFilterValue = customEvent.detail ? customEvent.detail.value : "all";
      itemsToShow = itemsPerPage;
      updateVisibility();
    });

    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        apiFilter = "all";
        tagFilterValue = "all";
        textSearchFilter = "";
        itemsToShow = itemsPerPage;
        if (searchInput) searchInput.value = "";

        const url = new URL(window.location.href);
        url.searchParams.delete("q");
        window.history.replaceState({}, "", url);

        const defaultOption = tagFilter.querySelector(
          '.dropdown-item[data-value="all"]',
        ) as HTMLElement;
        if (defaultOption) defaultOption.click();
        updateApiButtons();
        updateVisibility();
      });
    }

    if (loadMoreBtn) {
      loadMoreBtn.addEventListener("click", () => {
        itemsToShow += itemsPerPage;
        updateVisibility();
      });
    }

    if (searchInput) {
      searchInput.addEventListener("input", () => {
        textSearchFilter = searchInput.value.trim().toLowerCase();
        itemsToShow = textSearchFilter ? 999 : itemsPerPage;
        updateVisibility();
      });
    }
  }

  setupFilters();
  document.addEventListener("astro:page-load", setupFilters);
</script>
