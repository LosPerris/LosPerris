---
import Layout from "../layouts/Layout.astro";
import Section from "../components/ui/Section.astro";
import Modal from "../components/ui/Modal.astro";
import GuideSearch from "../components/guides/GuideSearch.astro";
import GuideGrid from "../components/guides/GuideGrid.astro";
---

<Layout title="Guías de Uso - LosPerrisBot">
    <Section
        class="bg-[#151515] pt-32 pb-20 text-center relative overflow-hidden"
    >
        <div class="absolute inset-0 pointer-events-none">
            <div
                class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[800px] bg-[#5865F2]/5 rounded-full blur-[120px] animate-pulse"
            >
            </div>
        </div>

        <div class="relative z-10">
            <h1
                class="text-5xl md:text-7xl font-black mb-6 text-white animate-[fadeInUp_0.8s_ease-out_forwards] tracking-tight uppercase"
            >
                Guías de <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-[#5865F2] to-purple-500"
                    >Uso</span
                >
            </h1>
            <p
                class="text-xl md:text-2xl text-[#b0b0b0] max-w-2xl mx-auto animate-[fadeInUp_0.8s_ease-out_0.2s_forwards] opacity-0 translate-y-8 font-light"
            >
                Domina todas las funciones de LosPerrisBots con nuestras guías
                detalladas
            </p>
        </div>
    </Section>

    <Section class="bg-[#1a1a1a] min-h-screen">
        <GuideSearch />
        <GuideGrid />
    </Section>
    <Modal id="guideModal" title="Cargando guía...">
        <div id="modal-content-placeholder" class="text-[#b0b0b0]"></div>
    </Modal>
</Layout>

<script is:inline></script>
