---
import Layout from "../layouts/Layout.astro";
import Section from "../components/ui/Section.astro";
import Modal from "../components/ui/Modal.astro";
import GuideSearch from "../components/guides/GuideSearch.astro";
import GuideGrid from "../components/guides/GuideGrid.astro";
---

<Layout title="Guías de Uso - LosPerrisBot">
    <Section
        class="bg-gradient-to-br from-[#1a1a1a] to-[#2d2d2d] pt-32 pb-20 text-center"
    >
        <h1
            class="text-5xl font-bold mb-6 text-white animate-[fadeInUp_0.8s_ease-out_forwards]"
        >
            Guías de Uso
        </h1>
        <p
            class="text-xl text-[#b0b0b0] max-w-2xl mx-auto animate-[fadeInUp_0.8s_ease-out_0.2s_forwards] opacity-0 translate-y-8"
        >
            Domina todas las funciones de LosPerrisBots con nuestras guías
            detalladas
        </p>
    </Section>

    <Section class="bg-[#1a1a1a] min-h-screen">
        <GuideSearch />
        <GuideGrid />
    </Section>
    <Modal id="guideModal" title="Cargando guía...">
        <div id="modal-content-placeholder" class="text-[#b0b0b0]"></div>
    </Modal>
</Layout>

<script is:inline></script>
