---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/ui/Button.astro";
import Card from "../../components/ui/Card.astro";
import { apis } from "../../data/apis";
---

<Layout title="APIs | Los Perris" showWallpaper={false}>
  <main class="min-h-screen pt-32 pb-24 px-4 relative z-10 bg-[#151515]">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-20">
        <div class="mb-6">
          <span
            class="inline-block py-1 px-3 rounded-full bg-[#5865F2]/20 text-[#5865F2] border border-[#5865F2]/30 text-sm font-semibold opacity-0 translate-y-8 animate-[fadeInUp_1s_ease-out_0.1s_forwards]"
          >
            <i class="fas fa-code mr-2"></i>Developers
          </span>
        </div>
        <h1
          class="text-5xl md:text-7xl font-black text-white uppercase tracking-tight relative inline-block opacity-0 translate-y-8 animate-[fadeInUp_1s_ease-out_0.3s_forwards]"
        >
          PRO <span
            class="text-transparent bg-clip-text bg-linear-to-r from-[#5865F2] to-purple-500"
            >APIs</span
          >
        </h1>
        <p
          class="text-xl text-text-secondary max-w-2xl mx-auto opacity-0 translate-y-8 animate-[fadeInUp_1s_ease-out_0.6s_forwards]"
        >
          Integra la potencia de Los Perris en tus propias aplicaciones.
          Escalable, rápido y fácil de usar.
        </p>
      </div>

      <div
        class="grid grid-cols-1 md:grid-cols-2 gap-8 opacity-0 translate-y-8 animate-[fadeInUp_1s_ease-out_0.9s_forwards]"
      >
        {
          apis.map((api, index) => (
            <Card class="p-8 bg-white/2 bg-none border border-white/10 hover:border-[#5865F2]/50 hover:bg-white/4 transition-all duration-300 group hover:-translate-y-1 shadow-lg backdrop-blur-sm">
              <div class="flex items-start justify-between mb-6">
                <div
                  class={`w-14 h-14 rounded-xl bg-white/5 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform ${api.color || "text-white"}`}
                >
                  <i class={api.icon || "fas fa-code"} />
                </div>
                <span class="bg-secondary px-3 py-1 rounded-full text-xs text-text-secondary font-mono border border-[#404040]">
                  TESTED
                </span>
              </div>

              <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-[#5865F2] transition-colors">
                {api.title}
              </h3>
              <p class="text-[rgb(176,176,176)] leading-relaxed mb-6 grow min-h-[60px]">
                {api.description}
              </p>

              <div class="mt-auto space-y-4">
                <div class="hidden" id={`docs-${index}`}>
                  <div class="bg-[#0f0f0f] rounded-lg p-4 border border-[#333] mb-4 text-left">
                    <h4 class="text-white font-semibold mb-3 text-sm uppercase">
                      Endpoints
                    </h4>
                    <div class="space-y-4">
                      {api.endpoints?.map((endpoint) => (
                        <div>
                          <div class="flex items-center gap-2 mb-1">
                            <span class="text-xs font-bold bg-secondary text-green-400 px-2 py-0.5 rounded uppercase">
                              {endpoint.method}
                            </span>
                            <code class="text-xs md:text-sm text-gray-300 font-mono break-all">
                              {endpoint.path}
                            </code>
                          </div>
                          <p class="text-xs text-[#666] mb-2">
                            {endpoint.description}
                          </p>
                          {endpoint.example && (
                            <div class="bg-primary p-2 rounded border border-secondary">
                              <code class="text-xs text-text-muted block font-mono break-all">
                                {endpoint.example}
                              </code>
                            </div>
                          )}
                        </div>
                      ))}
                    </div>
                  </div>
                </div>

                <div class="flex flex-col md:flex-row gap-3">
                  <button
                    onclick={`document.getElementById('docs-${index}').classList.toggle('hidden')`}
                    class="flex-1 py-3 px-4 rounded-xl font-semibold border border-[#404040] text-white hover:bg-secondary transition-colors text-sm cursor-pointer"
                  >
                    <i class="fas fa-book mr-2" /> Documentación
                  </button>
                  <Button
                    href={api.link}
                    target="_blank"
                    class="flex-1 justify-center text-sm"
                  >
                    {api.linkText || "Ver más"}{" "}
                    <i class="fas fa-external-link-alt ml-2 text-xs" />
                  </Button>
                </div>
              </div>
            </Card>
          ))
        }
      </div>
    </div>
  </main>
</Layout>
