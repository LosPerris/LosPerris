---
import Layout from "../../layouts/Layout.astro";
import { apis } from "../../data/apis";
import ApiCard from "../../components/home/ApiCard.astro";
import BackButton from "../../components/ui/BackButton.astro";
---

<Layout title="APIs | LosPerris" showBackgroundEffects={false}>
  <main class="min-h-screen pt-32 pb-24 px-4 relative z-10 bg-[#050505]">
    <div class="max-w-6xl mx-auto relative z-10">
      <BackButton class="mb-4" />
      <div class="text-center mb-16">
        <h1
          class="text-4xl md:text-6xl font-black text-white tracking-tight relative inline-block animate-[fadeInUp_0.8s_ease-out] uppercase"
        >
          APIS PÚBLICAS DE <br /><span
            class="text-transparent bg-clip-text bg-gradient-to-br from-[#f97316] to-[#ea580c] drop-shadow-[0_0_15px_rgba(249,115,22,0.2)]"
            >LOSPERRIS</span
          >
        </h1>
        <p
          class="text-lg text-zinc-400 max-w-2xl mx-auto mt-6 animate-[fadeInUp_0.8s_ease-out_0.1s_both]"
        >
          Endpoints REST gratuitos diseñados para creadores de contenido y
          desarrolladores. Escalables, rápidos y sin complicaciones.
        </p>
      </div>

      <div
        class="grid grid-cols-1 md:grid-cols-2 gap-8 opacity-0 translate-y-8 animate-[fadeInUp_1s_ease-out_0.9s_forwards]"
      >
        {apis.map((api, index) => <ApiCard api={api} index={index} />)}
      </div>
    </div>
  </main>
</Layout>
