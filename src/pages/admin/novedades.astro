---
import Layout from "../../layouts/Layout.astro";
import { UPDATE_APIS, UPDATE_TAGS } from "../../lib/updates/admin/entry";
---

<Layout
  title="Admin — Novedades | LosPerris"
  showHeader={false}
  showFooter={false}
  showBackgroundEffects={false}
  noindex={true}
>
  <div class="min-h-screen bg-[#050505] text-white px-4 py-10">
    <div class="max-w-5xl mx-auto">
      <header class="mb-8">
        <p
          class="text-xs font-bold tracking-widest text-[#f97316] uppercase mb-2"
        >
          Panel interno
        </p>
        <h1 class="text-3xl font-black tracking-tight">Novedades</h1>
        <p class="text-sm text-zinc-500 mt-2">
          Edita historial manual y próximamente. Las automáticas vienen de los
          commits (solo lectura).
        </p>
      </header>

      <section
        id="login-panel"
        class="max-w-md mx-auto p-8 rounded-2xl border border-[#27272a] bg-[#0a0a0a]"
      >
        <label
          class="block text-sm font-semibold text-zinc-300 mb-2"
          for="admin-secret"
        >
          Clave de administración
        </label>
        <input
          id="admin-secret"
          type="password"
          autocomplete="current-password"
          class="w-full px-4 py-3 rounded-xl bg-[#050505] border border-[#27272a] text-white focus:border-[#f97316] outline-none"
          placeholder="UPDATES_ADMIN_SECRET"
        />
        <button
          id="login-btn"
          type="button"
          class="mt-4 w-full py-3 rounded-xl font-bold bg-[#f97316] text-[#050505] hover:bg-[#ea580c] transition-colors"
        >
          Entrar
        </button>
        <p id="login-error" class="hidden mt-3 text-sm text-red-400"></p>
      </section>

      <section id="admin-panel" class="hidden">
        <div class="flex flex-wrap gap-2 mb-6">
          <button
            type="button"
            data-tab="manual"
            class="tab-btn px-4 py-2 rounded-xl text-sm font-bold bg-[#f97316] text-[#050505]"
          >
            Historial manual
          </button>
          <button
            type="button"
            data-tab="planned"
            class="tab-btn px-4 py-2 rounded-xl text-sm font-bold bg-white/5 text-zinc-400"
          >
            Próximamente
          </button>
          <button
            type="button"
            data-tab="github"
            class="tab-btn px-4 py-2 rounded-xl text-sm font-bold bg-white/5 text-zinc-400"
          >
            Automáticas (solo lectura)
          </button>
          <button
            id="logout-btn"
            type="button"
            class="ml-auto px-4 py-2 rounded-xl text-sm font-bold bg-white/5 text-zinc-400 hover:text-white"
          >
            Salir
          </button>
        </div>

        <div id="editor-actions" class="flex justify-between items-center mb-4">
          <p id="tab-hint" class="text-sm text-zinc-500"></p>
          <button
            id="new-entry-btn"
            type="button"
            class="px-4 py-2 rounded-xl text-sm font-bold bg-[#f97316] text-[#050505]"
          >
            + Nueva entrada
          </button>
        </div>

        <div id="entries-list" class="space-y-3 mb-8"></div>

        <form
          id="entry-form"
          class="hidden p-6 rounded-2xl border border-[#27272a] bg-[#0a0a0a] space-y-4"
        >
          <h2 id="form-title" class="text-xl font-bold">Nueva entrada</h2>
          <input type="hidden" id="field-id" />

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="text-xs text-zinc-400" for="field-title"
                >Título</label
              >
              <input
                id="field-title"
                required
                class="mt-1 w-full px-3 py-2 rounded-lg bg-[#050505] border border-[#27272a]"
              />
            </div>
            <div>
              <label class="text-xs text-zinc-400" for="field-dateString"
                >Fecha visible</label
              >
              <input
                id="field-dateString"
                required
                placeholder="4 Julio 2026"
                class="mt-1 w-full px-3 py-2 rounded-lg bg-[#050505] border border-[#27272a]"
              />
            </div>
            <div>
              <label class="text-xs text-zinc-400" for="field-api">API</label>
              <select
                id="field-api"
                class="mt-1 w-full px-3 py-2 rounded-lg bg-[#050505] border border-[#27272a]"
              >
                {UPDATE_APIS.map((api) => <option value={api}>{api}</option>)}
              </select>
            </div>
            <div>
              <label class="text-xs text-zinc-400" for="field-tag"
                >Etiqueta</label
              >
              <select
                id="field-tag"
                class="mt-1 w-full px-3 py-2 rounded-lg bg-[#050505] border border-[#27272a]"
              >
                {UPDATE_TAGS.map((tag) => <option value={tag}>{tag}</option>)}
              </select>
            </div>
            <div>
              <label class="text-xs text-zinc-400" for="field-date"
                >Fecha ISO (orden)</label
              >
              <input
                id="field-date"
                type="date"
                required
                class="mt-1 w-full px-3 py-2 rounded-lg bg-[#050505] border border-[#27272a]"
              />
            </div>
          </div>

          <div>
            <label class="text-xs text-zinc-400" for="field-description"
              >Descripción</label
            >
            <textarea
              id="field-description"
              required
              rows="4"
              class="mt-1 w-full px-3 py-2 rounded-lg bg-[#050505] border border-[#27272a]"
            ></textarea>
          </div>

          <div class="flex gap-3">
            <button
              type="submit"
              class="px-5 py-2 rounded-xl font-bold bg-[#f97316] text-[#050505]"
            >
              Guardar en GitHub
            </button>
            <button
              id="cancel-form-btn"
              type="button"
              class="px-5 py-2 rounded-xl font-bold bg-white/5 text-zinc-300"
            >
              Cancelar
            </button>
          </div>
          <p id="form-status" class="text-sm text-zinc-500"></p>
        </form>
      </section>
    </div>
  </div>
</Layout>

<script is:inline>
  const STORAGE_KEY = "losperris-updates-admin-secret";

  let activeTab = "manual";
  let editingId = null;
  let store = {
    manual: { entries: [] },
    planned: { entries: [] },
    github: { entries: [] },
  };

  const $ = (id) => document.getElementById(id);

  function getSecret() {
    return sessionStorage.getItem(STORAGE_KEY) ?? "";
  }

  function setSecret(value) {
    if (value) sessionStorage.setItem(STORAGE_KEY, value);
    else sessionStorage.removeItem(STORAGE_KEY);
  }

  async function api(method, body) {
    const res = await fetch("/api/admin/updates", {
      method,
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${getSecret()}`,
      },
      body: body ? JSON.stringify(body) : undefined,
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || `Error ${res.status}`);
    return data;
  }

  function isoFromDateInput(value) {
    return new Date(`${value}T12:00:00`).toISOString();
  }

  function dateInputFromIso(iso) {
    return iso.slice(0, 10);
  }

  function renderEntries() {
    const list = $("entries-list");
    const isReadonly = activeTab === "github";
    const entries = store[activeTab]?.entries ?? [];

    $("editor-actions").classList.toggle("hidden", isReadonly);
    $("tab-hint").textContent = isReadonly
      ? "Generadas por commits en Valorant/QR. Edítalas con mensajes de commit o bórralas con prune en LosPerris."
      : activeTab === "planned"
        ? "Avisos de la sección Próximamente."
        : "Historial publicado que no viene del sync automático.";

    if (!entries.length) {
      list.innerHTML = `<p class="text-sm text-zinc-500 py-8 text-center">No hay entradas.</p>`;
      return;
    }

    list.innerHTML = entries
      .map(
        (e) => `
      <article class="p-4 rounded-xl border border-[#27272a] bg-[#0a0a0a] flex flex-wrap gap-3 justify-between items-start">
        <div class="min-w-0 flex-1">
          <p class="text-xs text-zinc-500 mb-1">${e.dateString} · ${e.api} · ${e.tag}</p>
          <h3 class="font-bold text-white">${e.title}</h3>
          <p class="text-sm text-zinc-400 mt-1 line-clamp-2">${e.description}</p>
          <p class="text-xs text-zinc-600 font-mono mt-2">${e.id}</p>
        </div>
        ${
          isReadonly
            ? ""
            : `<div class="flex gap-2 shrink-0">
          <button type="button" data-edit="${e.id}" class="px-3 py-1.5 text-xs font-bold rounded-lg bg-white/5 hover:bg-white/10">Editar</button>
          <button type="button" data-delete="${e.id}" class="px-3 py-1.5 text-xs font-bold rounded-lg bg-red-500/10 text-red-400 hover:bg-red-500/20">Borrar</button>
        </div>`
        }
      </article>`,
      )
      .join("");

    list.querySelectorAll("[data-edit]").forEach((btn) => {
      btn.addEventListener("click", () =>
        openForm(btn.getAttribute("data-edit")),
      );
    });
    list.querySelectorAll("[data-delete]").forEach((btn) => {
      btn.addEventListener("click", () =>
        removeEntry(btn.getAttribute("data-delete")),
      );
    });
  }

  function setActiveTab(tab) {
    activeTab = tab;
    document.querySelectorAll(".tab-btn").forEach((btn) => {
      const on = btn.getAttribute("data-tab") === tab;
      btn.classList.toggle("bg-[#f97316]", on);
      btn.classList.toggle("text-[#050505]", on);
      btn.classList.toggle("bg-white/5", !on);
      btn.classList.toggle("text-zinc-400", !on);
    });
    $("entry-form").classList.add("hidden");
    renderEntries();
  }

  function openForm(id = null) {
    editingId = id;
    const entry = id ? store[activeTab].entries.find((e) => e.id === id) : null;

    $("form-title").textContent = entry ? "Editar entrada" : "Nueva entrada";
    $("field-id").value = entry?.id ?? "";
    $("field-title").value = entry?.title ?? "";
    $("field-description").value = entry?.description ?? "";
    $("field-api").value = entry?.api ?? "General";
    $("field-tag").value = entry?.tag ?? "Infra";
    $("field-dateString").value = entry?.dateString ?? "";
    $("field-date").value = entry
      ? dateInputFromIso(entry.date)
      : new Date().toISOString().slice(0, 10);
    $("form-status").textContent = "";
    $("entry-form").classList.remove("hidden");
    $("entry-form").scrollIntoView({ behavior: "smooth" });
  }

  async function loadData() {
    store = await api("GET");
    setActiveTab(activeTab);
  }

  async function removeEntry(id) {
    if (!confirm("¿Eliminar esta entrada? Se commitea en GitHub.")) return;
    await api("DELETE", { collection: activeTab, id });
    await loadData();
  }

  $("login-btn")?.addEventListener("click", async () => {
    const secret = $("admin-secret").value.trim();
    $("login-error").classList.add("hidden");
    setSecret(secret);
    try {
      await loadData();
      $("login-panel").classList.add("hidden");
      $("admin-panel").classList.remove("hidden");
    } catch {
      setSecret("");
      $("login-error").textContent =
        "Clave incorrecta o servidor sin configurar.";
      $("login-error").classList.remove("hidden");
    }
  });

  $("logout-btn")?.addEventListener("click", () => {
    setSecret("");
    $("admin-panel").classList.add("hidden");
    $("login-panel").classList.remove("hidden");
    $("admin-secret").value = "";
  });

  document.querySelectorAll(".tab-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (btn.id === "logout-btn") return;
      setActiveTab(btn.getAttribute("data-tab"));
    });
  });

  $("new-entry-btn")?.addEventListener("click", () => openForm());
  $("cancel-form-btn")?.addEventListener("click", () =>
    $("entry-form").classList.add("hidden"),
  );

  $("entry-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const entry = {
      id: $("field-id").value || undefined,
      title: $("field-title").value,
      description: $("field-description").value,
      api: $("field-api").value,
      tag: $("field-tag").value,
      dateString: $("field-dateString").value,
      date: isoFromDateInput($("field-date").value),
    };

    $("form-status").textContent = "Guardando…";
    try {
      if (editingId) {
        await api("PUT", {
          collection: activeTab,
          entry: { ...entry, id: editingId },
        });
      } else {
        await api("POST", { collection: activeTab, entry });
      }
      $("form-status").textContent = "Guardado. Vercel desplegará en ~1 min.";
      await loadData();
      $("entry-form").classList.add("hidden");
    } catch (err) {
      $("form-status").textContent = err.message || "Error al guardar.";
    }
  });

  document.addEventListener("astro:page-load", () => {
    if (getSecret()) {
      loadData()
        .then(() => {
          $("login-panel").classList.add("hidden");
          $("admin-panel").classList.remove("hidden");
        })
        .catch(() => setSecret(""));
    }
  });
</script>
