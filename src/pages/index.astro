---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/home/HeroSection.astro";
import BotShowcase from "../components/home/BotShowcase.astro";
import StatsSection from "../components/home/StatsSection.astro";
import DiscordSection from "../components/home/DiscordSection.astro";
import Modal from "../components/ui/Modal.astro";
import { helpBotData, gameBotData } from "../data/bots";
---

<Layout title="LosPerris - Real - Página Oficial">
	<HeroSection />

	<BotShowcase {...helpBotData} />
	<BotShowcase {...gameBotData} />

	<StatsSection />

	<Modal id="commands-modal" title="Comandos">
		<div id="modal-body"></div>
	</Modal>

	<DiscordSection />
</Layout>

<script is:inline>
	function closeModal() {
		const modal = document.getElementById("commands-modal");
		if (modal) {
			modal.classList.add("hidden");
			document.body.style.overflow = "auto";
		}
	}
</script>
