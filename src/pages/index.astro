---
import Layout from "../layouts/Layout.astro";
---

<Layout title="LosPerris - Real - Página Oficial">
	<section
		id="home"
		class="min-h-screen flex items-center justify-center bg-gradient-to-br from-primary to-secondary relative overflow-hidden pt-20"
	>
		<div class="relative z-10 max-w-5xl px-6 text-center">
			<h1
				class="text-5xl md:text-7xl font-bold mb-6 text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400 opacity-0 translate-y-8 animate-[fadeInUp_1s_ease-out_0.3s_forwards]"
			>
				LosPerris - Real
			</h1>
			<p
				class="text-xl md:text-2xl text-[#b0b0b0] mb-6 max-w-2xl mx-auto font-light opacity-0 translate-y-8 animate-[fadeInUp_1s_ease-out_0.6s_forwards]"
			>
				Creamos Dos bots para Discord con moderación avanzada y gaming
				completo
			</p>
			<p
				class="text-lg text-[#808080] mb-10 max-w-3xl mx-auto leading-relaxed opacity-0 translate-y-8 animate-[fadeInUp_1s_ease-out_0.9s_forwards]"
			>
				Potencia tu servidor con bots simples y útiles: LosPerrisHelp
				para orden y seguridad, y LosPerrisGame para diversión con
				estadísticas de tus juegos favoritos.
			</p>
			<div
				class="flex flex-wrap justify-center gap-8 md:gap-16 my-12 opacity-0 translate-y-8 animate-[fadeInUp_1s_ease-out_1.2s_forwards]"
			>
				<div class="text-center">
					<span
						class="block text-3xl md:text-4xl font-bold text-white mb-2"
						>40+</span
					>
					<span
						class="text-sm text-[#b0b0b0] uppercase tracking-widest"
						>Comandos</span
					>
				</div>
				<div class="text-center">
					<span
						class="block text-3xl md:text-4xl font-bold text-white mb-2"
						>24/7</span
					>
					<span
						class="text-sm text-[#b0b0b0] uppercase tracking-widest"
						>Disponibilidad</span
					>
				</div>
				<div class="text-center">
					<span
						class="block text-3xl md:text-4xl font-bold text-white mb-2"
						>5+</span
					>
					<span
						class="text-sm text-[#b0b0b0] uppercase tracking-widest"
						>Juegos Soportados</span
					>
				</div>
			</div>
			<div
				class="flex gap-4 justify-center flex-wrap opacity-0 translate-y-8 animate-[fadeInUp_1s_ease-out_1.5s_forwards]"
			>
				<a
					href="#help-bot"
					class="inline-block px-8 py-3 rounded-xl font-semibold transition-all border-2 border-transparent text-base cursor-pointer bg-gradient-to-br from-[#2d2d2d] to-[#404040] text-white border-[#404040] hover:-translate-y-1 hover:shadow-lg"
					>LosPerrisHelp</a
				>
				<a
					href="#game-bot"
					class="inline-block px-8 py-3 rounded-xl font-semibold transition-all border-2 border-[#404040] text-base cursor-pointer bg-transparent text-white hover:bg-[#404040] hover:-translate-y-1"
					>LosPerrisGame</a
				>
			</div>
		</div>
		<div
			class="absolute inset-0 pointer-events-none opacity-30 bg-[url('/img/back.png')] bg-cover bg-center mix-blend-overlay"
		>
		</div>
	</section>

	<section id="help-bot" class="py-24 relative bg-[#2d2d2d]">
		<div class="container mx-auto px-6">
			<div
				class="flex flex-col md:flex-row items-center gap-8 mb-12 text-left"
			>
				<img
					src="/img/Real.png"
					alt="LosPerrisHelp"
					class="w-20 h-20 rounded-full border-4 border-[#404040]"
				/>
				<div class="bot-info">
					<h2 class="text-4xl font-bold mb-2">LosPerrisHelp</h2>
					<p class="text-xl text-[#b0b0b0]">
						Bot especializado en moderación y utilidades para
						servidores de Discord
					</p>
					<div class="flex gap-4 mt-4 flex-wrap">
						<span
							class="bg-[#404040] text-white px-4 py-2 rounded-full text-sm font-semibold"
							>🛡️ Moderación Avanzada</span
						>
						<span
							class="bg-[#404040] text-white px-4 py-2 rounded-full text-sm font-semibold"
							>🔒 Seguridad Total</span
						>
						<span
							class="bg-[#404040] text-white px-4 py-2 rounded-full text-sm font-semibold"
							>⚡ Respuesta Rápida</span
						>
					</div>
				</div>
			</div>

			<div
				class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-12 max-w-7xl mx-auto"
			>
				<div
					class="bg-gradient-to-br from-[#2d2d2d] to-[#404040] p-6 rounded-xl border border-[#404040] transition-all hover:-translate-y-1 hover:shadow-lg text-center"
				>
					<i class="fas fa-shield-alt text-4xl text-white mb-3"></i>
					<h3 class="text-xl font-semibold mb-3">Moderación</h3>
					<p class="text-[#b0b0b0] text-sm mb-4">
						Sistema completo de moderación con ban, kick, warn y
						más. Incluye sistema automático de advertencias y
						gestión de usuarios problemáticos.
					</p>
					<ul class="text-left mt-4 text-[#b0b0b0] text-sm space-y-2">
						<li
							class="relative pl-5 before:content-['✓'] before:absolute before:left-0 before:text-green-500 before:font-bold"
						>
							Ban/Unban automático
						</li>
						<li
							class="relative pl-5 before:content-['✓'] before:absolute before:left-0 before:text-green-500 before:font-bold"
						>
							Sistema de advertencias
						</li>
						<li
							class="relative pl-5 before:content-['✓'] before:absolute before:left-0 before:text-green-500 before:font-bold"
						>
							Purga de mensajes
						</li>
						<li
							class="relative pl-5 before:content-['✓'] before:absolute before:left-0 before:text-green-500 before:font-bold"
						>
							Reportes de usuarios
						</li>
					</ul>
				</div>
				<div
					class="bg-gradient-to-br from-[#2d2d2d] to-[#404040] p-6 rounded-xl border border-[#404040] transition-all hover:-translate-y-1 hover:shadow-lg text-center"
				>
					<i class="fas fa-info-circle text-4xl text-white mb-3"></i>
					<h3 class="text-xl font-semibold mb-3">Información</h3>
					<p class="text-[#b0b0b0] text-sm mb-4">
						Comandos informativos sobre usuarios y servidor. Obtén
						datos detallados y estadísticas completas de tu
						comunidad.
					</p>
					<ul class="text-left mt-4 text-[#b0b0b0] text-sm space-y-2">
						<li
							class="relative pl-5 before:content-['✓'] before:absolute before:left-0 before:text-green-500 before:font-bold"
						>
							Perfiles de usuario
						</li>
						<li
							class="relative pl-5 before:content-['✓'] before:absolute before:left-0 before:text-green-500 before:font-bold"
						>
							Información del servidor
						</li>
						<li
							class="relative pl-5 before:content-['✓'] before:absolute before:left-0 before:text-green-500 before:font-bold"
						>
							Avatares y tarjetas
						</li>
						<li
							class="relative pl-5 before:content-['✓'] before:absolute before:left-0 before:text-green-500 before:font-bold"
						>
							Estadísticas detalladas
						</li>
					</ul>
				</div>
				<div
					class="bg-gradient-to-br from-[#2d2d2d] to-[#404040] p-6 rounded-xl border border-[#404040] transition-all hover:-translate-y-1 hover:shadow-lg text-center"
				>
					<i class="fas fa-lock text-4xl text-white mb-3"></i>
					<h3 class="text-xl font-semibold mb-3">Seguridad</h3>
					<p class="text-[#b0b0b0] text-sm mb-4">
						Análisis de archivos y URLs para mantener tu servidor
						seguro. Protección contra malware y enlaces maliciosos.
					</p>
					<ul class="text-left mt-4 text-[#b0b0b0] text-sm space-y-2">
						<li
							class="relative pl-5 before:content-['✓'] before:absolute before:left-0 before:text-green-500 before:font-bold"
						>
							Escaneo de archivos
						</li>
						<li
							class="relative pl-5 before:content-['✓'] before:absolute before:left-0 before:text-green-500 before:font-bold"
						>
							Análisis de URLs
						</li>
						<li
							class="relative pl-5 before:content-['✓'] before:absolute before:left-0 before:text-green-500 before:font-bold"
						>
							Generador de contraseñas
						</li>
						<li
							class="relative pl-5 before:content-['✓'] before:absolute before:left-0 before:text-green-500 before:font-bold"
						>
							Detección de amenazas
						</li>
					</ul>
				</div>
				<div
					class="bg-gradient-to-br from-[#2d2d2d] to-[#404040] p-6 rounded-xl border border-[#404040] transition-all hover:-translate-y-1 hover:shadow-lg text-center"
				>
					<i class="fas fa-smile text-4xl text-white mb-3"></i>
					<h3 class="text-xl font-semibold mb-3">Diversión</h3>
					<p class="text-[#b0b0b0] text-sm mb-4">
						Comandos divertidos para animar tu servidor. Mantén a tu
						comunidad entretenida con contenido variado.
					</p>
					<ul class="text-left mt-4 text-[#b0b0b0] text-sm space-y-2">
						<li
							class="relative pl-5 before:content-['✓'] before:absolute before:left-0 before:text-green-500 before:font-bold"
						>
							Imágenes de gatos
						</li>
						<li
							class="relative pl-5 before:content-['✓'] before:absolute before:left-0 before:text-green-500 before:font-bold"
						>
							Sistema de saludos
						</li>
						<li
							class="relative pl-5 before:content-['✓'] before:absolute before:left-0 before:text-green-500 before:font-bold"
						>
							Comandos interactivos
						</li>
						<li
							class="relative pl-5 before:content-['✓'] before:absolute before:left-0 before:text-green-500 before:font-bold"
						>
							Entretenimiento variado
						</li>
					</ul>
				</div>
			</div>

			<div class="flex gap-4 justify-center mb-12 flex-wrap">
				<a
					href="https://discord.com/api/oauth2/authorize?client_id=TU_CLIENT_ID_HELP&permissions=8&scope=bot"
					target="_blank"
					class="inline-flex items-center gap-2 px-8 py-3 rounded-xl font-semibold transition-all border-2 border-transparent text-base cursor-pointer bg-gradient-to-br from-[#2d2d2d] to-[#404040] text-white border-[#404040] hover:-translate-y-1 hover:shadow-lg"
				>
					<i class="fas fa-plus"></i> Invitar LosPerrisHelp
				</a>
				<button
					class="inline-block px-8 py-3 rounded-xl font-semibold transition-all border-2 border-[#404040] text-base cursor-pointer bg-transparent text-[#b0b0b0] hover:bg-[#2d2d2d] hover:text-white hover:-translate-y-1"
					onclick="showHelpCommands()">Ver Todos los Comandos</button
				>
				<button
					class="inline-block px-8 py-3 rounded-xl font-semibold transition-all border-2 border-[#404040] text-base cursor-pointer bg-transparent text-[#b0b0b0] hover:bg-[#2d2d2d] hover:text-white hover:-translate-y-1"
					onclick="startHelpChat()">Demo Interactiva</button
				>
			</div>

			<div
				class="max-w-2xl mx-auto bg-[#2d2d2d] rounded-xl overflow-hidden border border-[#404040] hidden"
				id="help-chat"
			>
				<div class="bg-[#404040] p-4 flex items-center gap-2">
					<i class="fas fa-robot text-white"></i>
					<span class="font-bold">LosPerrisHelp - Demo en Vivo</span>
				</div>
				<div class="p-4 h-[300px] overflow-y-auto" id="help-messages">
				</div>
			</div>
		</div>
	</section>

	<section id="game-bot" class="py-24 relative bg-[#1a1a1a]">
		<div class="container mx-auto px-6">
			<div
				class="flex flex-col md:flex-row items-center gap-8 mb-12 text-left"
			>
				<img
					src="/img/gamer.png"
					alt="LosPerrisGame"
					class="w-20 h-20 rounded-full border-4 border-[#404040]"
				/>
				<div class="bot-info">
					<h2 class="text-4xl font-bold mb-2">LosPerrisGame</h2>
					<p class="text-xl text-[#b0b0b0]">
						Bot gaming con estadísticas y información de múltiples
						juegos populares
					</p>
					<div class="flex gap-4 mt-4 flex-wrap">
						<span
							class="bg-[#404040] text-white px-4 py-2 rounded-full text-sm font-semibold"
							>🎮 Multi-Juego</span
						>
						<span
							class="bg-[#404040] text-white px-4 py-2 rounded-full text-sm font-semibold"
							>📊 Stats en Tiempo Real</span
						>
						<span
							class="bg-[#404040] text-white px-4 py-2 rounded-full text-sm font-semibold"
							>🔄 Actualizaciones Diarias</span
						>
					</div>
				</div>
			</div>

			<div
				class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-12"
			>
				<div
					class="bg-gradient-to-br from-[#2d2d2d] to-[#404040] p-6 rounded-xl border border-[#404040] transition-all hover:-translate-y-1 hover:shadow-lg text-center"
				>
					<i class="fas fa-gamepad text-4xl text-white mb-4"></i>
					<h3 class="text-lg font-semibold mb-2">Fortnite</h3>
					<p class="text-[#b0b0b0] text-sm mb-3">
						Stats completas de jugadores y tienda diaria actualizada
					</p>
					<div class="mt-4">
						<span class="block text-[#b0b0b0] text-xs mb-1"
							>• Estadísticas de jugador</span
						>
						<span class="block text-[#b0b0b0] text-xs mb-1"
							>• Tienda diaria</span
						>
						<span class="block text-[#b0b0b0] text-xs mb-1"
							>• Historial de partidas</span
						>
					</div>
				</div>
				<div
					class="bg-gradient-to-br from-[#2d2d2d] to-[#404040] p-6 rounded-xl border border-[#404040] transition-all hover:-translate-y-1 hover:shadow-lg text-center"
				>
					<i class="fas fa-crown text-4xl text-white mb-4"></i>
					<h3 class="text-lg font-semibold mb-2">
						League of Legends
					</h3>
					<p class="text-[#b0b0b0] text-sm mb-3">
						Info completa de campeones, builds optimizados y
						perfiles
					</p>
					<div class="mt-4">
						<span class="block text-[#b0b0b0] text-xs mb-1"
							>• 160+ Campeones</span
						>
						<span class="block text-[#b0b0b0] text-xs mb-1"
							>• Builds aleatorios</span
						>
						<span class="block text-[#b0b0b0] text-xs mb-1"
							>• Perfiles de invocador</span
						>
					</div>
				</div>
				<div
					class="bg-gradient-to-br from-[#2d2d2d] to-[#404040] p-6 rounded-xl border border-[#404040] transition-all hover:-translate-y-1 hover:shadow-lg text-center"
				>
					<i class="fas fa-crosshairs text-4xl text-white mb-4"></i>
					<h3 class="text-lg font-semibold mb-2">Valorant</h3>
					<p class="text-[#b0b0b0] text-sm mb-3">
						Agentes detallados, arsenal completo y estadísticas
					</p>
					<div class="mt-4">
						<span class="block text-[#b0b0b0] text-xs mb-1"
							>• 20+ Agentes</span
						>
						<span class="block text-[#b0b0b0] text-xs mb-1"
							>• Arsenal completo</span
						>
						<span class="block text-[#b0b0b0] text-xs mb-1"
							>• Stats de jugador</span
						>
					</div>
				</div>
				<div
					class="bg-gradient-to-br from-[#2d2d2d] to-[#404040] p-6 rounded-xl border border-[#404040] transition-all hover:-translate-y-1 hover:shadow-lg text-center"
				>
					<i class="fas fa-cube text-4xl text-white mb-4"></i>
					<h3 class="text-lg font-semibold mb-2">Minecraft</h3>
					<p class="text-[#b0b0b0] text-sm mb-3">
						Visualización de skins con múltiples vistas y detalles
					</p>
					<div class="mt-4">
						<span class="block text-[#b0b0b0] text-xs mb-1"
							>• Skins de jugadores</span
						>
						<span class="block text-[#b0b0b0] text-xs mb-1"
							>• Múltiples vistas</span
						>
						<span class="block text-[#b0b0b0] text-xs mb-1"
							>• Historial de cambios</span
						>
					</div>
				</div>
				<div
					class="bg-gradient-to-br from-[#2d2d2d] to-[#404040] p-6 rounded-xl border border-[#404040] transition-all hover:-translate-y-1 hover:shadow-lg text-center"
				>
					<i class="fas fa-dragon text-4xl text-white mb-4"></i>
					<h3 class="text-lg font-semibold mb-2">Más Juegos</h3>
					<p class="text-[#b0b0b0] text-sm mb-3">
						Pokémon TCG, Dragon Ball y contenido en expansión
					</p>
					<div class="mt-4">
						<span class="block text-[#b0b0b0] text-xs mb-1"
							>• Cartas Pokémon TCG</span
						>
						<span class="block text-[#b0b0b0] text-xs mb-1"
							>• Personajes Dragon Ball</span
						>
						<span class="block text-[#b0b0b0] text-xs mb-1"
							>• Twitch integration</span
						>
					</div>
				</div>
			</div>

			<div class="flex gap-4 justify-center mb-12 flex-wrap">
				<a
					href="https://discord.com/api/oauth2/authorize?client_id=TU_CLIENT_ID_GAME&permissions=8&scope=bot"
					target="_blank"
					class="inline-flex items-center gap-2 px-8 py-3 rounded-xl font-semibold transition-all border-2 border-transparent text-base cursor-pointer bg-gradient-to-br from-[#2d2d2d] to-[#404040] text-white border-[#404040] hover:-translate-y-1 hover:shadow-lg"
				>
					<i class="fas fa-plus"></i> Invitar LosPerrisGame
				</a>
				<button
					class="inline-block px-8 py-3 rounded-xl font-semibold transition-all border-2 border-[#404040] text-base cursor-pointer bg-transparent text-[#b0b0b0] hover:bg-[#2d2d2d] hover:text-white hover:-translate-y-1"
					onclick="showGameCommands()">Ver Comandos de Juegos</button
				>
				<button
					class="inline-block px-8 py-3 rounded-xl font-semibold transition-all border-2 border-[#404040] text-base cursor-pointer bg-transparent text-[#b0b0b0] hover:bg-[#2d2d2d] hover:text-white hover:-translate-y-1"
					onclick="startGameChat()">Demo Interactiva</button
				>
			</div>

			<div
				class="max-w-2xl mx-auto bg-[#2d2d2d] rounded-xl overflow-hidden border border-[#404040] hidden"
				id="game-chat"
			>
				<div class="bg-[#404040] p-4 flex items-center gap-2">
					<i class="fas fa-gamepad text-white"></i>
					<span class="font-bold">LosPerrisGame - Demo Gaming</span>
				</div>
				<div class="p-4 h-[300px] overflow-y-auto" id="game-messages">
				</div>
			</div>
		</div>
	</section>

	<section
		id="stats"
		class="py-24 bg-gradient-to-br from-[#1a1a1a] to-[#2d2d2d] text-center"
	>
		<div class="container mx-auto px-6">
			<h2 class="text-4xl md:text-5xl font-bold mb-4 text-white">
				Estadísticas de LosPerrisBots
			</h2>
			<p class="text-xl text-[#b0b0b0] mb-12 max-w-2xl mx-auto">
				En poco de informacion de LosPerris
			</p>

			<div
				class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl mx-auto px-6"
			>
				<div
					class="p-8 rounded-xl bg-[#2d2d2d]/50 border border-[#404040] hover:-translate-y-2 hover:border-white/20 hover:bg-[#2d2d2d] transition-all duration-300 backdrop-blur-sm group"
				>
					<div
						class="text-4xl text-white mb-6 bg-gradient-to-br from-[#2d2d2d] to-[#404040] w-20 h-20 rounded-full flex items-center justify-center mx-auto shadow-lg group-hover:scale-110 transition-transform duration-300 border border-[#404040]"
					>
						<i class="fas fa-server"></i>
					</div>
					<div class="stat-content">
						<h3 class="text-4xl font-bold text-white mb-2">2+</h3>
						<p
							class="text-[#b0b0b0] uppercase tracking-widest text-sm mb-2 font-semibold"
						>
							Servidores Activos
						</p>
						<span class="text-[#808080] text-sm block"
							>Confiando en nuestros bots diariamente</span
						>
					</div>
				</div>
				<div
					class="p-8 rounded-xl bg-[#2d2d2d]/50 border border-[#404040] hover:-translate-y-2 hover:border-white/20 hover:bg-[#2d2d2d] transition-all duration-300 backdrop-blur-sm group"
				>
					<div
						class="text-4xl text-white mb-6 bg-gradient-to-br from-[#2d2d2d] to-[#404040] w-20 h-20 rounded-full flex items-center justify-center mx-auto shadow-lg group-hover:scale-110 transition-transform duration-300 border border-[#404040]"
					>
						<i class="fas fa-users"></i>
					</div>
