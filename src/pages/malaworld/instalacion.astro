---
import { Image } from "astro:assets";
import botwBg from "./malaimg/_botw-bg.png";
import serverIcon from "./malaimg/_icono_del_server.png";
import { siteUrl } from "../../data/community";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Mala World - Instalación</title>
        <meta
            name="description"
            content="Guía paso a paso para instalar el ModPack de Mala World (Minecraft 1.20.1). Descarga, configuración de CurseForge y optimización de RAM."
        />
        <link rel="icon" type="image/png" href={serverIcon.src} />

        <meta
            property="og:title"
            content="Instalación del ModPack - Mala World"
        />
        <meta
            property="og:description"
            content="Aprende a instalar y configurar el ModPack de Mala World para empezar tu aventura survival técnico."
        />
        <meta property="og:image" content={serverIcon.src} />
        <meta property="og:url" content={`${siteUrl}/malaworld/instalacion`} />
        <meta property="og:type" content="article" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Josefin+Sans:wght@300;400;600;700&display=swap"
            rel="stylesheet"
        />
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
        />
    </head>
    <body
        class="bg-[#050505] text-white font-['Josefin_Sans'] overflow-x-hidden relative selection:bg-[#7df9ff] selection:text-black min-h-screen flex flex-col"
    >
        <div class="fixed inset-0 z-[-1]">
            <Image
                src={botwBg}
                class="w-full h-full object-cover blur-xs opacity-40 fixed"
                alt="Background"
            />
            <div class="absolute inset-0 bg-[#0a0a0a]/60"></div>
            <div
                class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-20"
            >
            </div>
        </div>

        <nav
            class="fixed top-0 w-full z-50 flex justify-between items-center px-6 md:px-12 py-6 bg-linear-to-b from-black/90 to-transparent backdrop-blur-[2px]"
        >
            <a
                href="/malaworld"
                class="flex items-center gap-5 group cursor-pointer hover:scale-105 transition-transform"
            >
                <div class="relative w-12 h-12">
                    <img
                        src={serverIcon.src}
                        class="w-full h-full rounded-full p-1 border border-[#7df9ff]/50"
                        alt="Mala World Logo"
                    />
                </div>
                <span
                    class="font-['Cinzel'] text-xl md:text-2xl tracking-widest text-[#e3dac9] drop-shadow-[0_2px_4px_black]"
                    >MALA WORLD</span
                >
            </a>

            <a
                href="/malaworld"
                class="flex gap-2 items-center text-[#7df9ff] tracking-[0.2em] uppercase text-sm font-bold hover:text-[#e3dac9] transition-colors"
                data-astro-prefetch
            >
                <i class="fas fa-arrow-left"></i> Volver
            </a>
        </nav>

        <main
            class="grow pt-32 px-4 pb-20 relative z-10 w-full max-w-4xl mx-auto"
        >
            <h1
                class="font-['Cinzel'] text-4xl md:text-6xl text-[#e3dac9] text-center mb-4 drop-shadow-lg"
            >
                INSTALACIÓN DEL MODPACK
            </h1>
            <div
                class="w-32 h-1 bg-[#7df9ff] mx-auto rounded-full shadow-[0_0_15px_#7df9ff] mb-16"
            >
            </div>

            <!-- Paso 0: Prerrequisito -->
            <div
                class="mb-12 bg-[#7df9ff]/5 border border-[#7df9ff]/20 rounded-xl p-6 flex flex-col md:flex-row items-center gap-6 text-center md:text-left"
            >
                <div class="bg-[#7df9ff]/10 p-4 rounded-full">
                    <i class="fas fa-exclamation-circle text-3xl text-[#7df9ff]"
                    ></i>
                </div>
                <div>
                    <h3
                        class="font-['Cinzel'] text-xl text-[#7df9ff] mb-2 font-bold"
                    >
                        ¿NO TIENES CURSEFORGE?
                    </h3>
                    <p class="text-zinc-400 text-sm mb-3">
                        Necesitas tener instalado el cliente de CurseForge para
                        poder jugar nuestro ModPack.
                    </p>
                    <a
                        href="https://download.curseforge.com/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-white hover:text-[#7df9ff] underline font-bold tracking-wider text-sm transition-colors"
                    >
                        DESCARGAR CURSEFORGE AQUÍ <i
                            class="fas fa-external-link-alt ml-1 text-xs"></i>
                    </a>
                </div>
            </div>

            <!-- Paso 1 -->
            <section
                class="bg-black/80 border border-[#333] rounded-xl p-8 mb-12 shadow-2xl relative overflow-hidden group hover:border-[#7df9ff]/50 transition-all"
            >
                <div
                    class="absolute -right-10 -top-10 text-9xl text-[#7df9ff]/5 font-['Cinzel'] select-none"
                >
                    1
                </div>

                <h2
                    class="text-2xl md:text-3xl font-['Cinzel'] text-[#7df9ff] mb-6 flex items-center gap-4"
                >
                    <span
                        class="bg-[#7df9ff] text-black w-10 h-10 rounded-full flex items-center justify-center text-xl font-bold"
                        >1</span
                    >
                    DESCARGAR ARCHIVO
                </h2>

                <p class="text-zinc-300 mb-8 text-lg">
                    Primero necesitas descargar el archivo del ModPack (<span
                        class="text-[#e3dac9] font-mono bg-white/10 px-2 py-0.5 rounded"
                        >.zip</span
                    >).
                </p>

                <div class="text-center">
                    <a
                        href="https://www.mediafire.com/file/no18vosoib6d8zg/Mala+world-1.20.1.zip/file"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-block relative group px-12 py-5 bg-[#0a0a0a] border-2 border-[#7df9ff] hover:bg-[#7df9ff] rounded-xl transition-all duration-300 shadow-[0_0_20px_rgba(125,249,255,0.2)] cursor-pointer overflow-hidden"
                    >
                        <span
                            class="relative z-10 font-bold tracking-widest text-[#7df9ff] group-hover:text-black transition-colors flex items-center gap-3"
                        >
                            <i class="fas fa-download"></i> DESCARGAR MODPACK
                        </span>
                    </a>
                    <p
                        class="mt-4 text-xs text-zinc-500 uppercase tracking-widest"
                    >
                        Servidor: Mediafire • Versión: 1.20.1
                    </p>
                </div>
            </section>

            <!-- Paso 2 -->
            <section
                class="bg-black/80 border border-[#333] rounded-xl p-8 shadow-2xl relative overflow-hidden group hover:border-[#7df9ff]/50 transition-all"
            >
                <div
                    class="absolute -right-10 -top-10 text-9xl text-[#7df9ff]/5 font-['Cinzel'] select-none"
                >
                    2
                </div>

                <h2
                    class="text-2xl md:text-3xl font-['Cinzel'] text-[#7df9ff] mb-6 flex items-center gap-4"
                >
                    <span
                        class="bg-[#7df9ff] text-black w-10 h-10 rounded-full flex items-center justify-center text-xl font-bold"
                        >2</span
                    >
                    IMPORTAR EN CURSEFORGE
                </h2>

                <div class="space-y-6 text-zinc-300">
                    <div class="flex gap-4 items-start">
                        <i class="fas fa-chevron-right text-[#7df9ff] mt-1.5"
                        ></i>
                        <p>
                            Abre la aplicación de <strong class="text-white"
                                >CurseForge</strong
                            > en tu PC y selecciona <strong class="text-white"
                                >Minecraft</strong
                            >.
                        </p>
                    </div>

                    <div class="flex gap-4 items-start">
                        <i class="fas fa-chevron-right text-[#7df9ff] mt-1.5"
                        ></i>
                        <div>
                            <p class="mb-2">
                                En la parte superior, al lado del botón de
                                crear, haz clic en el botón de <strong
                                    class="text-[#7df9ff]">Importar</strong
                                > (usualmente un icono de carpeta o flecha).
                            </p>
                        </div>
                    </div>

                    <div class="flex gap-4 items-start">
                        <i class="fas fa-chevron-right text-[#7df9ff] mt-1.5"
                        ></i>
                        <div>
                            <p class="mb-2">
                                Se abrirá una ventana emergente llamada <strong
                                    class="text-white">"Import Profile"</strong
                                > con dos opciones:
                            </p>
                            <ul
                                class="list-none ml-2 space-y-2 border-l-2 border-[#7df9ff]/30 pl-4 my-3 text-sm"
                            >
                                <li class="flex items-center gap-2">
                                    <i class="fas fa-file-zipper text-[#e3dac9]"
                                    ></i>
                                    <span
                                        ><strong>Import Profile .zip</strong> (Esta
                                        es la correcta)</span
                                    >
                                </li>
                                <li
                                    class="flex items-center gap-2 text-zinc-500"
                                >
                                    <i class="fas fa-code"></i>
                                    <span>Use Profile Code (Ignorar esta)</span>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="flex gap-4 items-start">
                        <i class="fas fa-chevron-right text-[#7df9ff] mt-1.5"
                        ></i>
                        <p>
                            Haz clic en el botón <strong
                                class="text-white border border-zinc-600 bg-zinc-800 px-2 py-0.5 rounded text-sm"
                                >Choose .zip file</strong
                            > que está debajo de la primera opción.
                        </p>
                    </div>

                    <div class="flex gap-4 items-start">
                        <i class="fas fa-chevron-right text-[#7df9ff] mt-1.5"
                        ></i>
                        <div>
                            <p>
                                Busca y selecciona el archivo <strong
                                    class="text-[#e3dac9]"
                                    >Mala world-1.20.1.zip</strong
                                > que descargaste.
                            </p>
                            <div
                                class="mt-2 bg-black/50 border border-zinc-800 p-4 rounded text-sm text-zinc-400 italic"
                            >
                                <i class="fas fa-info-circle mr-2"></i> Tip: También
                                puedes simplemente arrastrar el archivo .zip descargado
                                directamente dentro de la ventana de CurseForge.
                            </div>
                        </div>
                    </div>

                    <div class="flex gap-4 items-start">
                        <i class="fas fa-check text-green-500 mt-1.5"></i>
                        <p>
                            ¡Listo! Espera a que se instalen los mods
                            automáticamente y luego dale a <strong>Jugar</strong
                            >.
                        </p>
                    </div>
                </div>
            </section>

            <!-- Tip de RAM -->
            <section
                class="bg-black/80 border border-[#333] rounded-xl p-8 shadow-2xl relative overflow-hidden group hover:border-[#FACC15]/50 transition-all"
            >
                <div
                    class="absolute -right-10 -top-10 text-9xl text-yellow-500/5 font-['Cinzel'] select-none"
                >
                    <i class="fas fa-memory"></i>
                </div>

                <h2
                    class="text-2xl md:text-3xl font-['Cinzel'] text-yellow-500 mb-6 flex items-center gap-4"
                >
                    <i class="fas fa-memory"></i> IMPORTANTE: MEMORIA RAM
                </h2>

                <p class="text-zinc-300 text-lg mb-6">
                    Por defecto, Minecraft usa poca memoria RAM. Para evitar
                    lag, te recomendamos asignar más memoria al perfil:
                </p>

                <div class="bg-black/50 border border-zinc-800 p-6 rounded-lg">
                    <ol
                        class="list-decimal list-inside text-zinc-300 space-y-3 font-light text-lg"
                    >
                        <li>
                            En CurseForge, ve a la configuración (⚙️) abajo a la
                            izquierda.
                        </li>
                        <li>
                            Selecciona la pestaña <strong class="text-white"
                                >Minecraft</strong
                            >.
                        </li>
                        <li>
                            Baja hasta <strong class="text-white"
                                >Allocated Memory</strong
                            > y mueve la barra hasta <strong
                                class="text-yellow-400 font-bold"
                                >4096MB (4GB)</strong
                            > o más.
                        </li>
                    </ol>
                </div>
            </section>
        </main>

        <footer
            class="bg-black py-8 text-center border-t border-[#222] mt-auto relative z-10 w-full"
        >
            <p
                class="text-zinc-600 text-xs uppercase tracking-[0.4em] font-bold"
            >
                Mala World // Ponss
            </p>
        </footer>

        <style is:global>
            @import "tailwindcss";

            ::-webkit-scrollbar {
                width: 8px;
            }
            ::-webkit-scrollbar-track {
                background: #000;
            }
            ::-webkit-scrollbar-thumb {
                background: #333;
                border-radius: 4px;
            }
            ::-webkit-scrollbar-thumb:hover {
                background: #7df9ff;
            }
        </style>
    </body>
</html>
