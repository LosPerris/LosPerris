---
import serverIcon from "./malaimg/icono del server.png";
import bgImage from "./malaimg/botw-bg.png";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Mala World - Instalación</title>
        <meta
            name="description"
            content="Guía de instalación del ModPack Mala World"
        />
        <link rel="icon" type="image/png" href={serverIcon.src} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Josefin+Sans:wght@300;400;600;700&display=swap"
            rel="stylesheet"
        />
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
        />
    </head>
    <body
        class="bg-[#050505] text-white font-['Josefin_Sans'] overflow-x-hidden relative selection:bg-[#7df9ff] selection:text-black min-h-screen flex flex-col"
    >
        <div class="fixed inset-0 z-[-1]">
            <img
                src={bgImage.src}
                class="w-full h-full object-cover blur-[4px] opacity-40 fixed"
                alt="Background"
            />
            <div class="absolute inset-0 bg-[#0a0a0a]/60"></div>
            <div
                class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-20"
            >
            </div>
        </div>

        <nav
            class="fixed top-0 w-full z-50 flex justify-between items-center px-6 md:px-12 py-6 bg-gradient-to-b from-black/90 to-transparent backdrop-blur-[2px]"
        >
            <a
                href="/malaworld"
                class="flex items-center gap-5 group cursor-pointer hover:scale-105 transition-transform"
            >
                <div class="relative w-12 h-12">
                    <img
                        src={serverIcon.src}
                        class="w-full h-full rounded-full p-1 border border-[#7df9ff]/50"
                        alt="Icon"
                    />
                </div>
                <span
                    class="font-['Cinzel'] text-xl md:text-2xl tracking-[0.1em] text-[#e3dac9] drop-shadow-[0_2px_4px_black]"
                    >MALA WORLD</span
                >
            </a>

            <a
                href="/malaworld"
                class="flex gap-2 items-center text-[#7df9ff] tracking-[0.2em] uppercase text-sm font-bold hover:text-[#e3dac9] transition-colors"
            >
                <i class="fas fa-arrow-left"></i> Volver
            </a>
        </nav>

        <main
            class="flex-grow pt-32 px-4 pb-20 relative z-10 w-full max-w-4xl mx-auto"
        >
            <h1
                class="font-['Cinzel'] text-4xl md:text-6xl text-[#e3dac9] text-center mb-4 drop-shadow-lg"
            >
                INSTALACIÓN DEL MODPACK
            </h1>
            <div
                class="w-32 h-1 bg-[#7df9ff] mx-auto rounded-full shadow-[0_0_15px_#7df9ff] mb-16"
            >
            </div>

            <!-- Paso 1 -->
            <section
                class="bg-black/80 border border-[#333] rounded-xl p-8 mb-12 shadow-2xl relative overflow-hidden group hover:border-[#7df9ff]/50 transition-all"
            >
                <div
                    class="absolute -right-10 -top-10 text-9xl text-[#7df9ff]/5 font-['Cinzel'] select-none"
                >
                    1
                </div>

                <h2
                    class="text-2xl md:text-3xl font-['Cinzel'] text-[#7df9ff] mb-6 flex items-center gap-4"
                >
                    <span
                        class="bg-[#7df9ff] text-black w-10 h-10 rounded-full flex items-center justify-center text-xl font-bold"
                        >1</span
                    >
                    DESCARGAR ARCHIVO
                </h2>

                <p class="text-zinc-300 mb-8 text-lg">
                    Primero necesitas descargar el archivo del ModPack (<span
                        class="text-[#e3dac9] font-mono bg-white/10 px-2 py-0.5 rounded"
                        >.zip</span
                    >).
                </p>

                <div class="text-center">
                    <a
                        href="https://www.mediafire.com/file/k9hxlwh8fll63s8/Mala_world-1.20.1.zip/file"
                        target="_blank"
                        class="inline-block relative group px-12 py-5 bg-[#0a0a0a] border-2 border-[#7df9ff] hover:bg-[#7df9ff] rounded-xl transition-all duration-300 shadow-[0_0_20px_rgba(125,249,255,0.2)] cursor-pointer overflow-hidden"
                    >
                        <span
                            class="relative z-10 font-bold tracking-widest text-[#7df9ff] group-hover:text-black transition-colors flex items-center gap-3"
                        >
                            <i class="fas fa-download"></i> DESCARGAR MODPACK
                        </span>
                    </a>
                    <p
                        class="mt-4 text-xs text-zinc-500 uppercase tracking-widest"
                    >
                        Servidor: Mediafire • Versión: 1.20.1
                    </p>
                </div>
            </section>

            <!-- Paso 2 -->
            <section
                class="bg-black/80 border border-[#333] rounded-xl p-8 shadow-2xl relative overflow-hidden group hover:border-[#7df9ff]/50 transition-all"
            >
                <div
                    class="absolute -right-10 -top-10 text-9xl text-[#7df9ff]/5 font-['Cinzel'] select-none"
                >
                    2
                </div>

                <h2
                    class="text-2xl md:text-3xl font-['Cinzel'] text-[#7df9ff] mb-6 flex items-center gap-4"
                >
                    <span
                        class="bg-[#7df9ff] text-black w-10 h-10 rounded-full flex items-center justify-center text-xl font-bold"
                        >2</span
                    >
                    IMPORTAR EN CURSEFORGE
                </h2>

                <div class="space-y-6 text-zinc-300">
                    <div class="flex gap-4 items-start">
                        <i class="fas fa-chevron-right text-[#7df9ff] mt-1.5"
                        ></i>
                        <p>
                            Abre la aplicación de <strong class="text-white"
                                >CurseForge</strong
                            > en tu PC.
                        </p>
                    </div>

                    <div class="flex gap-4 items-start">
                        <i class="fas fa-chevron-right text-[#7df9ff] mt-1.5"
                        ></i>
                        <p>
                            Selecciona el juego <strong class="text-white"
                                >Minecraft</strong
                            > en el menú lateral.
                        </p>
                    </div>

                    <div class="flex gap-4 items-start">
                        <i class="fas fa-chevron-right text-[#7df9ff] mt-1.5"
                        ></i>
                        <p>
                            Haz clic en el botón <strong
                                class="text-white border border-zinc-600 bg-zinc-800 px-2 rounded text-sm"
                                >Create Custom Profile</strong
                            > (Crear Perfil) en la parte superior derecha.
                        </p>
                    </div>

                    <div class="flex gap-4 items-start">
                        <i class="fas fa-chevron-right text-[#7df9ff] mt-1.5"
                        ></i>
                        <div>
                            <p class="mb-2">
                                En la ventana que aparece, busca el enlace que
                                dice <strong class="text-[#7df9ff] underline"
                                    >Import</strong
                                > (o "Importar un perfil ya creado").
                            </p>
                            <div
                                class="bg-black/50 border border-zinc-800 p-4 rounded text-sm text-zinc-400 italic"
                            >
                                <i class="fas fa-info-circle mr-2"></i> También puedes
                                simplemente arrastrar el archivo .zip descargado dentro
                                de la ventana de CurseForge.
                            </div>
                        </div>
                    </div>

                    <div class="flex gap-4 items-start">
                        <i class="fas fa-chevron-right text-[#7df9ff] mt-1.5"
                        ></i>
                        <p>
                            Selecciona el archivo <strong class="text-[#e3dac9]"
                                >Mala_world-1.20.1.zip</strong
                            > que descargaste en el paso anterior.
                        </p>
                    </div>

                    <div class="flex gap-4 items-start">
                        <i class="fas fa-check text-green-500 mt-1.5"></i>
                        <p>
                            ¡Listo! CurseForge instalará automáticamente todos
                            los mods necesarios. Cuando termine, solo dale a <strong
                                >Jugar</strong
                            >.
                        </p>
                    </div>
                </div>
            </section>
        </main>

        <footer
            class="bg-black py-8 text-center border-t border-[#222] mt-auto"
        >
            <p
                class="text-zinc-600 text-xs uppercase tracking-[0.4em] font-bold"
            >
                Mala World // Ponss
            </p>
        </footer>

        <style is:global>
            @import "tailwindcss";

            ::-webkit-scrollbar {
                width: 8px;
            }
            ::-webkit-scrollbar-track {
                background: #000;
            }
            ::-webkit-scrollbar-thumb {
                background: #333;
                border-radius: 4px;
            }
            ::-webkit-scrollbar-thumb:hover {
                background: #7df9ff;
            }
        </style>
    </body>
</html>
