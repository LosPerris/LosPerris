---
import serverIcon from "./malaimg/icono del server.png";

// Selected top mods from the user's list
const mods = [
    {
        name: "Ice and Fire",
        icon: "fa-dragon",
        desc: "Dragones y Criaturas Míticas",
    },
    { name: "Twilight Forest", icon: "fa-tree", desc: "Dimensiones Mágicas" },
    { name: "Cataclysm", icon: "fa-skull", desc: "Jefes Desafiantes" },
    { name: "Apotheosis", icon: "fa-khanda", desc: "Poder RPG" },
    { name: "Alex's Mobs", icon: "fa-paw", desc: "Animales Nuevos" },
    { name: "Create", icon: "fa-cogs", desc: "Ingeniería" },
    { name: "Simply Swords", icon: "fa-gavel", desc: "Combate Mejorado" },
    { name: "Biomes We've Gone", icon: "fa-mountain", desc: "Mundo Expansivo" },
    { name: "Waystones", icon: "fa-map-signs", desc: "Teletransporte" },
    {
        name: "Sophisticated Backpacks",
        icon: "fa-hiking",
        desc: "Almacenamiento Portátil",
    },
    { name: "Voice Chat", icon: "fa-microphone", desc: "Habla en el Juego" },
    { name: "Farmers Delight", icon: "fa-carrot", desc: "Cocina y Cultivos" },
];
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Mala World - Official Server</title>
        <meta
            name="description"
            content="Servidor de Minecraft Survival Mala World"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;900&display=swap"
            rel="stylesheet"
        />
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
        />
        <link rel="preconnect" href="https://mc-heads.net" />
    </head>
    <body
        class="bg-[#08080a] text-white font-['Outfit'] overflow-x-hidden antialiased selection:bg-[#55ff55] selection:text-black"
    >
        <!-- Background overlay -->
        <div class="fixed inset-0 z-[-1] pointer-events-none">
            <div
                class="absolute inset-0 bg-[radial-gradient(circle_at_10%_10%,_rgba(85,255,85,0.05)_0%,_transparent_40%),_radial-gradient(circle_at_90%_90%,_rgba(157,0,255,0.05)_0%,_transparent_40%)]"
            >
            </div>
            <div
                class="absolute inset-0 opacity-30"
                style="background-image: url('data:image/svg+xml,%3Csvg width=\'20\' height=\'20\' viewBox=\'0 0 20 20\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'0.03\' fill-rule=\'evenodd\'%3E%3Ccircle cx=\'3\' cy=\'3\' r=\'3\'/%3E%3Ccircle cx=\'13\' cy=\'13\' r=\'3\'/%3E%3C/g%3E%3C/svg%3E'); mask-image: radial-gradient(black, transparent 80%);"
            >
            </div>
        </div>

        <!-- Navbar -->
        <nav
            class="fixed top-0 w-full z-50 flex justify-between items-center px-[5%] py-4 bg-[#08080a]/85 backdrop-blur-xl border-b border-white/5"
        >
            <div
                class="flex items-center gap-3 text-2xl font-black tracking-tighter hover:text-[#55ff55] transition-colors cursor-default"
            >
                <img
                    src={serverIcon.src}
                    alt="Icon"
                    class="h-9 rounded-lg shadow-[0_0_15px_rgba(85,255,85,0.3)]"
                />
                MALA WORLD
            </div>
            <div class="hidden md:flex gap-8">
                <a
                    href="#home"
                    class="text-gray-400 font-semibold hover:text-[#55ff55] hover:drop-shadow-[0_0_8px_rgba(85,255,85,0.5)] transition-all"
                    >Inicio</a
                >
                <a
                    href="#players"
                    class="text-gray-400 font-semibold hover:text-[#55ff55] hover:drop-shadow-[0_0_8px_rgba(85,255,85,0.5)] transition-all"
                    >Jugadores</a
                >
                <a
                    href="#features"
                    class="text-gray-400 font-semibold hover:text-[#55ff55] hover:drop-shadow-[0_0_8px_rgba(85,255,85,0.5)] transition-all"
                    >Specs</a
                >
                <a
                    href="#mods"
                    class="text-gray-400 font-semibold hover:text-[#55ff55] hover:drop-shadow-[0_0_8px_rgba(85,255,85,0.5)] transition-all"
                    >Mods</a
                >
            </div>
        </nav>

        <!-- Hero -->
        <header
            id="home"
            class="min-h-screen flex flex-col justify-center items-center text-center px-4 relative pt-20"
        >
            <div
                class="absolute w-[600px] h-[600px] bg-[radial-gradient(closest-side,rgba(85,255,85,0.15),transparent)] rounded-full blur-3xl -z-10 animate-pulse"
            >
            </div>

            <img
                src={serverIcon.src}
                alt="Logo"
                class="w-40 h-40 rounded-3xl shadow-[0_0_50px_rgba(85,255,85,0.2)] border border-white/10 mb-10 animate-[float_6s_ease-in-out_infinite]"
            />

            <h1
                class="text-6xl md:text-8xl font-black uppercase tracking-tighter mb-4 bg-clip-text text-transparent bg-gradient-to-b from-white to-gray-400 drop-shadow-[0_0_20px_rgba(85,255,85,0.2)]"
            >
                Mala World
            </h1>
            <p
                class="text-xl md:text-2xl text-gray-400 font-medium mb-12 max-w-2xl"
            >
                Survival Técnico & RPG entre Amigos
            </p>

            <div
                class="flex items-center gap-3 bg-black/30 border border-white/5 px-4 py-2 rounded-full mb-8 backdrop-blur-sm"
            >
                <div
                    id="status-dot"
                    class="w-3 h-3 rounded-full bg-gray-500 transition-all duration-500 shadow-[0_0_10px_rgba(100,100,100,0.5)]"
                >
                </div>
                <span id="player-count" class="font-bold text-[#55ff55]"
                    >Cargando...</span
                >
            </div>

            <button
                onclick="copyIp()"
                class="group relative flex items-center gap-4 bg-white/5 border border-white/10 px-8 py-4 rounded-xl font-mono text-xl font-bold text-[#55ff55] hover:bg-[#55ff55]/10 hover:border-[#55ff55] hover:scale-105 hover:shadow-[0_0_30px_rgba(85,255,85,0.2)] transition-all duration-300"
            >
                <span
                    class="absolute -top-12 left-1/2 -translate-x-1/2 bg-white text-black text-sm font-bold px-3 py-1 rounded shadow-lg opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none before:content-[''] before:absolute before:bottom-[-4px] before:left-1/2 before:-translate-x-1/2 before:border-l-[6px] before:border-l-transparent before:border-r-[6px] before:border-r-transparent before:border-t-[6px] before:border-t-white tooltip-text"
                    >¡Click para copiar!</span
                >
                <span id="server-ip">23.230.3.241:25721</span>
                <i
                    class="fas fa-copy text-gray-400 group-hover:text-white transition-colors"
                ></i>
            </button>

            <div
                class="mt-8 flex items-center gap-2 text-sm text-gray-500 bg-white/5 px-4 py-1 rounded-full border border-white/5"
            >
                <span id="server-version">1.20.1 • Forge</span>
            </div>
        </header>

        <!-- Players -->
        <section
            id="players"
            class="py-24 px-[5%] max-w-7xl mx-auto border-y border-white/5 bg-black/20"
        >
            <h2
                class="text-4xl font-bold text-center mb-16 relative after:content-[''] after:block after:w-10 after:h-1 after:bg-[#55ff55] after:mx-auto after:mt-4 after:rounded after:shadow-[0_0_15px_#55ff55]"
            >
                Jugadores Conectados
            </h2>
            <div id="player-grid" class="flex flex-wrap justify-center gap-6">
                <p class="text-gray-500 italic">Consultando lista...</p>
            </div>
        </section>

        <!-- Features -->
        <section id="features" class="py-24 px-[5%] max-w-7xl mx-auto">
            <h2
                class="text-4xl font-bold text-center mb-16 relative after:content-[''] after:block after:w-10 after:h-1 after:bg-[#55ff55] after:mx-auto after:mt-4 after:rounded after:shadow-[0_0_15px_#55ff55]"
            >
                Potencia Dedicada
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                <div
                    class="card group relative bg-[#16161c]/80 p-8 rounded-2xl border border-white/5 hover:-translate-y-2 hover:bg-[#1e1e24] hover:border-white/10 transition-all duration-300 overflow-hidden"
                >
                    <div
                        class="absolute top-0 left-0 w-1 h-full bg-[#55ff55] opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                    >
                    </div>
                    <i
                        class="fas fa-microchip text-4xl text-white/80 mb-6 block group-hover:text-[#55ff55] group-hover:scale-110 transition-all duration-300"
                    ></i>
                    <h3 class="text-2xl font-bold mb-3 text-white">
                        Ryzen 9 7950X
                    </h3>
                    <p class="text-gray-400 leading-relaxed">
                        Procesador Top Tier con 7 vCores para un rendimiento
                        extremo.
                    </p>
                </div>
                <div
                    class="card group relative bg-[#16161c]/80 p-8 rounded-2xl border border-white/5 hover:-translate-y-2 hover:bg-[#1e1e24] hover:border-white/10 transition-all duration-300 overflow-hidden"
                >
                    <div
                        class="absolute top-0 left-0 w-1 h-full bg-[#55ff55] opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                    >
                    </div>
                    <i
                        class="fas fa-memory text-4xl text-white/80 mb-6 block group-hover:text-[#55ff55] group-hover:scale-110 transition-all duration-300"
                    ></i>
                    <h3 class="text-2xl font-bold mb-3 text-white">
                        32GB RAM DDR5
                    </h3>
                    <p class="text-gray-400 leading-relaxed">
                        Memoria de última generación para manejar cientos de
                        mods sin lag.
                    </p>
                </div>
                <div
                    class="card group relative bg-[#16161c]/80 p-8 rounded-2xl border border-white/5 hover:-translate-y-2 hover:bg-[#1e1e24] hover:border-white/10 transition-all duration-300 overflow-hidden"
                >
                    <div
                        class="absolute top-0 left-0 w-1 h-full bg-[#55ff55] opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                    >
                    </div>
                    <i
                        class="fas fa-hdd text-4xl text-white/80 mb-6 block group-hover:text-[#55ff55] group-hover:scale-110 transition-all duration-300"
                    ></i>
                    <h3 class="text-2xl font-bold mb-3 text-white">
                        NVMe 500GB
                    </h3>
                    <p class="text-gray-400 leading-relaxed">
                        Almacenamiento ultra rápido para carga de chunks
                        instantánea.
                    </p>
                </div>
                <div
                    class="card group relative bg-[#16161c]/80 p-8 rounded-2xl border border-white/5 hover:-translate-y-2 hover:bg-[#1e1e24] hover:border-white/10 transition-all duration-300 overflow-hidden"
                >
                    <div
                        class="absolute top-0 left-0 w-1 h-full bg-[#55ff55] opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                    >
                    </div>
                    <i
                        class="fas fa-save text-4xl text-white/80 mb-6 block group-hover:text-[#55ff55] group-hover:scale-110 transition-all duration-300"
                    ></i>
                    <h3 class="text-2xl font-bold mb-3 text-white">
                        Seguridad Total
                    </h3>
                    <p class="text-gray-400 leading-relaxed">
                        15 Copias de seguridad automáticas para proteger nuestro
                        mundo.
                    </p>
                </div>
            </div>
        </section>

        <!-- Mods -->
        <section id="mods" class="py-24 px-[5%] max-w-7xl mx-auto">
            <h2
                class="text-4xl font-bold text-center mb-16 relative after:content-[''] after:block after:w-10 after:h-1 after:bg-[#55ff55] after:mx-auto after:mt-4 after:rounded after:shadow-[0_0_15px_#55ff55]"
            >
                Colección de Mods
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                {
                    mods.map((mod) => (
                        <div class="mod-item group bg-white/5 border border-white/5 p-6 rounded-xl flex items-center gap-4 hover:bg-white/10 hover:border-[#aa00aa] hover:translate-x-1 transition-all duration-300">
                            <i
                                class={`fas ${mod.icon} text-2xl text-[#aa00aa] min-w-[30px] group-hover:scale-110 transition-transform`}
                            />
                            <div>
                                <div class="font-bold text-white group-hover:text-[#aa00aa] transition-colors">
                                    {mod.name}
                                </div>
                                <div class="text-sm text-gray-400">
                                    {mod.desc}
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </section>

        <footer class="py-12 bg-[#050507] text-center border-t border-white/5">
            <p class="text-gray-400">&copy; 2025 Mala World.</p>
            <p class="text-xs text-gray-600 mt-2">
                Hosteado con ❤️ para los panas.
            </p>
        </footer>

        <!-- Styles for JS Animations -->
        <style is:global>
            @keyframes float {
                0%,
                100% {
                    transform: translateY(0) rotate(0deg);
                }
                50% {
                    transform: translateY(-15px) rotate(1deg);
                }
            }
            .visible {
                opacity: 1 !important;
                transform: translateY(0) !important;
            }
            .player-head {
                @apply w-16 h-16 rounded-xl border-2 border-white/10 shadow-lg transition-all duration-300;
            }
            .player-item:hover .player-head {
                @apply scale-110 border-[#55ff55] shadow-[#55ff55]/30;
            }
        </style>

        <script is:inline>
            const SERVER_IP = "23.230.3.241";
            const SERVER_PORT = "25721";

            function copyIp() {
                const ipText = document.getElementById("server-ip").innerText;
                navigator.clipboard
                    .writeText(ipText)
                    .then(() => {
                        const tooltip = document.querySelector(".tooltip-text");
                        tooltip.innerText = "¡IP Copiada!";
                        tooltip.classList.remove("opacity-0");
                        tooltip.classList.add("opacity-100");

                        setTimeout(() => {
                            tooltip.classList.remove("opacity-100");
                            tooltip.classList.add("opacity-0");
                            setTimeout(() => {
                                tooltip.innerText = "¡Click para copiar!";
                            }, 300);
                        }, 2000);
                    })
                    .catch((err) => console.error("Error copying:", err));
            }

            async function fetchServerStatus() {
                const countElement = document.getElementById("player-count");
                const statusDot = document.getElementById("status-dot");
                const playerGrid = document.getElementById("player-grid");
                const versionElement =
                    document.getElementById("server-version");

                try {
                    const response = await fetch(
                        `https://api.mcsrvstat.us/3/${SERVER_IP}:${SERVER_PORT}`,
                    );
                    const data = await response.json();

                    if (data.online) {
                        countElement.innerText = `${data.players.online} / ${data.players.max} Online`;
                        statusDot.classList.replace(
                            "bg-gray-500",
                            "bg-[#55ff55]",
                        );
                        statusDot.classList.add("shadow-[0_0_15px_#55ff55]");
                        versionElement.innerText = `${data.version} • ${data.software || "Forge"}`;

                        if (data.players.list && data.players.list.length > 0) {
                            playerGrid.innerHTML = data.players.list
                                .map(
                                    (player) => `
                            <div class="player-item flex flex-col items-center gap-3 w-20">
                                <img src="https://mc-heads.net/avatar/${player.name}" alt="${player.name}" class="player-head w-16 h-16 rounded-xl border-2 border-white/10 shadow-lg transition-all duration-300">
                                <span class="text-sm text-gray-400 font-medium">${player.name}</span>
                            </div>
                        `,
                                )
                                .join("");
                        } else {
                            if (data.players.online > 0) {
                                playerGrid.innerHTML =
                                    '<p class="text-gray-500 italic">Jugadores ocultos.</p>';
                            } else {
                                playerGrid.innerHTML =
                                    '<p class="text-gray-600">Servidor vacío... por ahora 👀</p>';
                            }
                        }
                    } else {
                        countElement.innerText = "Offline";
                        statusDot.classList.replace(
                            "bg-gray-500",
                            "bg-red-500",
                        );
                        statusDot.classList.add("shadow-[0_0_15px_red]");
                        playerGrid.innerHTML =
                            '<p class="text-red-400/50 uppercase font-bold tracking-widest">Servidor Apagado</p>';
                    }
                } catch (error) {
                    console.error("fetch error:", error);
                    countElement.innerText = "Error API";
                }
            }

            // Observer for fade-in animations
            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            entry.target.classList.replace(
                                "opacity-0",
                                "opacity-100",
                            );
                            entry.target.classList.replace(
                                "translate-y-10",
                                "translate-y-0",
                            );
                            observer.unobserve(entry.target);
                        }
                    });
                },
                { threshold: 0.1 },
            );

            document.querySelectorAll(".card, .mod-item").forEach((el) => {
                el.classList.add(
                    "opacity-0",
                    "translate-y-10",
                    "transition-all",
                    "duration-700",
                );
                observer.observe(el);
            });

            // Initialize
            fetchServerStatus();
            setInterval(fetchServerStatus, 300000);
            window.copyIp = copyIp;
        </script>
    </body>
</html>
