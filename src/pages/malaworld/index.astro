---
import serverIcon from "./malaimg/icono del server.png";
import bgImage from "./malaimg/ruins-bg.png";
import { modList, categories } from "./mods";

// Mock Data for "Hall of Legends" (Stats)
const topKillers = [
    { name: "Pons", count: 1245, title: "El Carnicero" },
    { name: "Gordi", count: 982, title: "Cazador Sombrío" },
    { name: "Alex", count: 876, title: "Espada Rota" },
];

const topDeaths = [
    { name: "Steve", count: 420, title: "Sacrificio Eterno" },
    { name: "NoobMaster", count: 69, title: "Carne de Cañón" },
    { name: "Alex", count: 55, title: "Mala Suerte" },
];
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Mala World - Lands Between</title>
        <meta
            name="description"
            content="Servidor de Minecraft Survival Mala World - Dark Fantasy RPG"
        />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&display=swap"
            rel="stylesheet"
        />
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
        />
        <link rel="preconnect" href="https://mc-heads.net" />
    </head>
    <body
        class="bg-[#0c0c0c] text-[#e0e0e0] font-['Cormorant_Garamond'] text-lg overflow-x-hidden antialiased selection:bg-[#C8A97E] selection:text-black"
    >
        <!-- Background & Overlay -->
        <div class="fixed inset-0 z-[-1] bg-black">
            <img
                src={bgImage.src}
                alt="Background"
                class="w-full h-full object-cover opacity-60 fixed-bg-anim"
            />
            <div
                class="absolute inset-0 bg-gradient-to-t from-[#0c0c0c] via-transparent to-[#0c0c0c]/80"
            >
            </div>
            <!-- Fog overlay effect could go here -->
        </div>

        <!-- Navigation (Runic Style) -->
        <nav
            class="fixed top-0 w-full z-50 flex justify-between items-center px-6 py-4 bg-[#0c0c0c]/90 backdrop-blur-md border-b border-[#C8A97E]/30"
        >
            <div
                class="flex items-center gap-3 text-2xl font-['Cinzel'] font-bold text-[#C8A97E] tracking-widest uppercase"
            >
                <img
                    src={serverIcon.src}
                    alt="Icon"
                    class="h-10 w-10 rounded-full border border-[#C8A97E]/50 shadow-[0_0_15px_rgba(200,169,126,0.2)]"
                />
                Mala World
            </div>
            <div
                class="hidden md:flex gap-8 font-['Cinzel'] text-sm tracking-widest text-[#a0a0a0]"
            >
                <a
                    href="#home"
                    class="hover:text-[#C8A97E] transition-colors relative group"
                >
                    Inicio
                    <span
                        class="absolute -bottom-1 left-0 w-0 h-[1px] bg-[#C8A97E] transition-all group-hover:w-full"
                    ></span>
                </a>
                <a
                    href="#legends"
                    class="hover:text-[#C8A97E] transition-colors relative group"
                >
                    Leyendas
                    <span
                        class="absolute -bottom-1 left-0 w-0 h-[1px] bg-[#C8A97E] transition-all group-hover:w-full"
                    ></span>
                </a>
                <a
                    href="#players"
                    class="hover:text-[#C8A97E] transition-colors relative group"
                >
                    Jugadores
                    <span
                        class="absolute -bottom-1 left-0 w-0 h-[1px] bg-[#C8A97E] transition-all group-hover:w-full"
                    ></span>
                </a>
                <a
                    href="#mods"
                    class="hover:text-[#C8A97E] transition-colors relative group"
                >
                    Grimorio
                    <span
                        class="absolute -bottom-1 left-0 w-0 h-[1px] bg-[#C8A97E] transition-all group-hover:w-full"
                    ></span>
                </a>
            </div>
        </nav>

        <!-- Hero Section -->
        <header
            id="home"
            class="min-h-screen flex flex-col justify-center items-center text-center px-4 relative pt-20"
        >
            <div class="mb-6 relative">
                <h1
                    class="text-6xl md:text-8xl font-['Cinzel'] font-black uppercase tracking-widest text-transparent bg-clip-text bg-gradient-to-b from-[#f3e5ab] to-[#8b7355] drop-shadow-[0_4px_10px_rgba(0,0,0,0.8)] animate-fade-in-up"
                >
                    Mala World
                </h1>
                <div
                    class="h-[2px] w-32 bg-gradient-to-r from-transparent via-[#C8A97E] to-transparent mx-auto mt-4"
                >
                </div>
            </div>

            <p
                class="text-2xl text-[#a0a0a0] mb-12 italic tracking-wide max-w-2xl font-light"
            >
                "Donde las leyendas se forjan y el destino se rompe."
            </p>

            <!-- Status Rune -->
            <div
                class="flex items-center gap-4 mb-12 bg-black/40 border border-[#C8A97E]/30 px-6 py-2 rounded-full backdrop-blur-sm"
            >
                <div id="status-icon" class="text-[#C8A97E] text-xs">
                    <i class="fas fa-circle animate-pulse"></i>
                </div>
                <span
                    id="player-count"
                    class="font-['Cinzel'] text-[#dcdcdc] tracking-widest"
                    >Invocando Estado...</span
                >
            </div>

            <button
                onclick="copyIp()"
                class="group relative px-12 py-4 bg-transparent border border-[#C8A97E] text-[#C8A97E] font-['Cinzel'] tracking-[0.2em] uppercase transition-all duration-500 hover:bg-[#C8A97E]/10 overflow-hidden"
            >
                <span class="relative z-10 flex items-center gap-3">
                    <span id="server-ip">23.230.3.241:25721</span>
                    <i
                        class="fas fa-copy text-sm opacity-50 group-hover:opacity-100 transition-opacity"
                    ></i>
                </span>
                <div
                    class="absolute inset-0 bg-[#C8A97E] transform scale-x-0 group-hover:scale-x-100 transition-transform origin-left duration-500 opacity-10"
                >
                </div>
                <span
                    class="tooltip-text absolute -top-10 left-1/2 -translate-x-1/2 font-['Cormorant_Garamond'] italic text-[#e0e0e0] text-sm opacity-0 transition-opacity pointer-events-none"
                    >Copiar Runa de Viaje</span
                >
            </button>

            <div
                class="mt-8 flex items-center gap-4 text-sm text-[#777] font-['Cinzel'] tracking-widest"
            >
                <span>Ver. 1.20.1</span>
                <span class="w-[1px] h-3 bg-[#444]"></span>
                <span>Forge</span>
            </div>
        </header>

        <!-- Hall of Legends (Stats) -->
        <section
            id="legends"
            class="py-24 px-6 md:px-[10%] relative overflow-hidden"
        >
            <div
                class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/dark-leather.png')] opacity-20"
            >
            </div>

            <h2
                class="text-4xl md:text-5xl font-['Cinzel'] text-center mb-16 text-[#C8A97E] tracking-widest uppercase relative z-10"
            >
                <span
                    class="block text-sm text-[#777] mb-2 tracking-[0.5em] font-light"
                    >Estadísticas</span
                >
                Hall de Leyendas
            </h2>

            <div
                class="grid md:grid-cols-2 gap-12 max-w-6xl mx-auto relative z-10"
            >
                <!-- Top Killers -->
                <div
                    class="bg-black/40 border border-[#C8A97E]/20 p-8 relative group hover:border-[#C8A97E]/50 transition-colors"
                >
                    <h3
                        class="text-2xl font-['Cinzel'] text-[#a03030] mb-8 text-center border-b border-[#a03030]/30 pb-4 tracking-widest"
                    >
                        <i class="fas fa-skull mr-2"></i> Ejecutores
                    </h3>
                    <ul class="space-y-6">
                        {
                            topKillers.map((p, i) => (
                                <li class="flex justify-between items-center text-[#c0c0c0]">
                                    <div class="flex items-center gap-4">
                                        <span class="font-['Cinzel'] text-[#666] text-xl w-6">
                                            #{i + 1}
                                        </span>
                                        <div>
                                            <span class="block text-xl">
                                                {p.name}
                                            </span>
                                            <span class="text-xs text-[#a03030] uppercase tracking-widest">
                                                {p.title}
                                            </span>
                                        </div>
                                    </div>
                                    <span class="font-['Cinzel'] text-[#C8A97E] text-xl">
                                        {p.count}{" "}
                                        <small class="text-xs text-[#666]">
                                            Kills
                                        </small>
                                    </span>
                                </li>
                            ))
                        }
                    </ul>
                    <div
                        class="absolute top-0 right-0 w-2 h-2 border-t border-r border-[#C8A97E]"
                    >
                    </div>
                    <div
                        class="absolute bottom-0 left-0 w-2 h-2 border-b border-l border-[#C8A97E]"
                    >
                    </div>
                </div>

                <!-- Top Deaths -->
                <div
                    class="bg-black/40 border border-[#C8A97E]/20 p-8 relative group hover:border-[#C8A97E]/50 transition-colors"
                >
                    <h3
                        class="text-2xl font-['Cinzel'] text-[#555] mb-8 text-center border-b border-[#555]/30 pb-4 tracking-widest"
                    >
                        <i class="fas fa-tombstone mr-2"></i> Caídos
                    </h3>
                    <ul class="space-y-6">
                        {
                            topDeaths.map((p, i) => (
                                <li class="flex justify-between items-center text-[#c0c0c0]">
                                    <div class="flex items-center gap-4">
                                        <span class="font-['Cinzel'] text-[#666] text-xl w-6">
                                            #{i + 1}
                                        </span>
                                        <div>
                                            <span class="block text-xl">
                                                {p.name}
                                            </span>
                                            <span class="text-xs text-[#555] uppercase tracking-widest">
                                                {p.title}
                                            </span>
                                        </div>
                                    </div>
                                    <span class="font-['Cinzel'] text-[#777] text-xl">
                                        {p.count}{" "}
                                        <small class="text-xs text-[#444]">
                                            Muertes
                                        </small>
                                    </span>
                                </li>
                            ))
                        }
                    </ul>
                    <div
                        class="absolute top-0 right-0 w-2 h-2 border-t border-r border-[#C8A97E]"
                    >
                    </div>
                    <div
                        class="absolute bottom-0 left-0 w-2 h-2 border-b border-l border-[#C8A97E]"
                    >
                    </div>
                </div>
            </div>
            <p class="text-center text-[#555] mt-8 italic text-sm">
                * Datos de los antiguos pergaminos (Ejemplo Visual)
            </p>
        </section>

        <!-- Active Players (Tab List Style) -->
        <section
            id="players"
            class="py-24 px-6 bg-[#0a0a0a] border-y border-[#1a1a1a]"
        >
            <h2
                class="text-4xl font-['Cinzel'] text-center mb-16 text-[#C8A97E] tracking-widest uppercase"
            >
                Almas Presentes
            </h2>
            <div
                class="max-w-4xl mx-auto min-h-[200px] flex items-center justify-center"
            >
                <div
                    id="player-grid"
                    class="flex flex-wrap justify-center gap-6 w-full"
                >
                    <p class="text-[#555] italic animate-pulse">
                        Sintiendo presencias...
                    </p>
                </div>
            </div>
        </section>

        <!-- Mods Grimoire -->
        <section id="mods" class="py-24 px-6 md:px-[5%] max-w-7xl mx-auto">
            <h2
                class="text-4xl font-['Cinzel'] text-center mb-8 text-[#C8A97E] tracking-widest uppercase"
            >
                Grimorio de Conocimiento
            </h2>

            <!-- Runic Filters -->
            <div
                class="flex flex-wrap justify-center gap-6 mb-16 font-['Cinzel']"
            >
                {
                    categories.map((cat) => (
                        <button
                            onclick={`filterMods('${cat.id}')`}
                            class="filter-btn text-[#777] hover:text-[#C8A97E] tracking-widest uppercase text-sm transition-colors relative py-2"
                            data-category={cat.id}
                        >
                            {cat.label}
                            <span class="active-indicator absolute bottom-0 left-1/2 -translate-x-1/2 w-1 h-1 bg-[#C8A97E] rounded-full opacity-0 transition-opacity" />
                        </button>
                    ))
                }
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                {
                    modList.map((mod) => (
                        <div
                            class="mod-card border border-[#222] bg-[#0f0f0f] p-4 flex items-center gap-4 hover:border-[#C8A97E]/40 hover:bg-[#141414] transition-all duration-300 group"
                            data-category={mod.category}
                        >
                            <div class="w-12 h-12 flex items-center justify-center border border-[#333] rotate-45 group-hover:border-[#C8A97E]/50 group-hover:rotate-0 transition-all duration-500 bg-[#050505]">
                                <i
                                    class={`fas ${mod.icon} text-[#777] group-hover:text-[#C8A97E] -rotate-45 group-hover:rotate-0 transition-all duration-500`}
                                />
                            </div>
                            <div>
                                <h4 class="font-['Cinzel'] text-[#dcdcdc] tracking-wide group-hover:text-[#fff]">
                                    {mod.name}
                                </h4>
                                <span class="text-xs text-[#555] uppercase tracking-widest">
                                    {
                                        categories.find(
                                            (c) => c.id === mod.category,
                                        )?.label
                                    }
                                </span>
                            </div>
                        </div>
                    ))
                }
            </div>
        </section>

        <footer
            class="py-16 bg-[#050505] text-center border-t border-[#1a1a1a] font-['Cinzel']"
        >
            <div class="mb-6 opacity-30">
                <i class="fas fa-gem text-xl mb-2"></i>
                <div class="text-xs tracking-[0.5em] uppercase">Mala World</div>
            </div>
            <p class="text-[#444] text-sm tracking-widest">
                &copy; 2025 Tierras Intermedias.
            </p>
        </footer>

        <style is:global>
            @import "tailwindcss";

            @keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(20px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
            .animate-fade-in-up {
                animation: fadeInUp 1.5s ease-out forwards;
            }

            /* Custom Scrollbar */
            ::-webkit-scrollbar {
                width: 8px;
            }
            ::-webkit-scrollbar-track {
                bg: #0c0c0c;
            }
            ::-webkit-scrollbar-thumb {
                background: #333;
                border-radius: 4px;
            }
            ::-webkit-scrollbar-thumb:hover {
                background: #c8a97e;
            }

            .filter-btn.active {
                color: #c8a97e;
            }
            .filter-btn.active .active-indicator {
                opacity: 1;
            }

            .fixed-bg-anim {
                animation: subtleZoom 60s infinite alternate;
            }
            @keyframes subtleZoom {
                from {
                    transform: scale(1);
                }
                to {
                    transform: scale(1.1);
                }
            }
        </style>

        <script is:inline>
            const SERVER_IP = "23.230.3.241";
            const SERVER_PORT = "25721";

            window.filterMods = (category) => {
                const cards = document.querySelectorAll(".mod-card");
                const buttons = document.querySelectorAll(".filter-btn");

                buttons.forEach((btn) => {
                    if (btn.dataset.category === category)
                        btn.classList.add("active");
                    else btn.classList.remove("active");
                });

                cards.forEach((card) => {
                    const matches =
                        category === "all" ||
                        card.dataset.category === category;
                    card.style.display = matches ? "flex" : "none";
                    if (matches) {
                        // Simple fade in reset
                        card.style.opacity = "0";
                        requestAnimationFrame(() => {
                            card.style.transition = "opacity 0.5s ease";
                            card.style.opacity = "1";
                        });
                    }
                });
            };

            // Select 'all' by default
            document.addEventListener("DOMContentLoaded", () =>
                window.filterMods("all"),
            );

            function copyIp() {
                const ipText = document.getElementById("server-ip").innerText;
                navigator.clipboard.writeText(ipText).then(() => {
                    const tooltip = document.querySelector(".tooltip-text");
                    tooltip.classList.remove("opacity-0");
                    setTimeout(() => tooltip.classList.add("opacity-0"), 2000);
                });
            }

            async function fetchServerStatus() {
                const countElement = document.getElementById("player-count");
                const statusIcon = document.getElementById("status-icon");
                const playerGrid = document.getElementById("player-grid");

                try {
                    const response = await fetch(
                        `https://api.mcsrvstat.us/3/${SERVER_IP}:${SERVER_PORT}`,
                    );
                    const data = await response.json();

                    if (data.online) {
                        countElement.innerText = `${data.players.online} Almas Errantes`;
                        statusIcon.innerHTML =
                            '<i class="fas fa-circle text-[#55ff55] shadow-[0_0_10px_#55ff55]"></i>';

                        if (data.players.list && data.players.list.length > 0) {
                            playerGrid.innerHTML = data.players.list
                                .map(
                                    (player) => `
                            <div class="flex flex-col items-center gap-3 w-24 group">
                                <div class="relative">
                                    <img src="https://mc-heads.net/avatar/${player.name}" class="w-16 h-16 rounded-md border border-[#C8A97E]/30 grayscale group-hover:grayscale-0 transition-all duration-500 shadow-lg">
                                    <div class="absolute inset-0 border border-[#C8A97E] scale-110 opacity-0 group-hover:scale-105 group-hover:opacity-100 transition-all duration-500 rounded-md"></div>
                                </div>
                                <span class="font-['Cinzel'] text-[#C8A97E] text-sm tracking-wide group-hover:text-white transition-colors">${player.name}</span>
                            </div>
                        `,
                                )
                                .join("");
                        } else {
                            if (data.players.online > 0)
                                playerGrid.innerHTML =
                                    "<span class=\"text-[#444] italic font-['Cormorant_Garamond']\">Almas ocultas en la niebla...</span>";
                            else
                                playerGrid.innerHTML =
                                    "<span class=\"text-[#444] italic font-['Cormorant_Garamond']\">El mundo yace en silencio...</span>";
                        }
                    } else {
                        countElement.innerText = "Mundo Desconectado";
                        statusIcon.innerHTML =
                            '<i class="fas fa-circle text-red-900"></i>';
                    }
                } catch (error) {
                    console.error("fetch error:", error);
                    countElement.innerText = "Niebla densa...";
                }
            }

            fetchServerStatus();
            setInterval(fetchServerStatus, 300000);
            window.copyIp = copyIp;
        </script>
    </body>
</html>
