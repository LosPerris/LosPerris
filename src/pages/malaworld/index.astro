---
import serverIcon from "./malaimg/icono del server.png";
import bgImage from "./malaimg/botw-bg.png";
import { modList, categories } from "./mods";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Mala World</title>
        <meta name="description" content="Servidor de Minecraft" />
        <link rel="icon" type="image/png" href={serverIcon.src} />
        <meta property="og:image" content={serverIcon.src} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Josefin+Sans:wght@300;400;600;700&display=swap"
            rel="stylesheet"
        />
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
        />
        <link rel="preconnect" href="https://mc-heads.net" />
    </head>
    <body
        class="bg-[#050505] text-white font-['Josefin_Sans'] overflow-x-hidden relative selection:bg-[#7df9ff] selection:text-black"
    >
        <div class="fixed inset-0 z-[-1]">
            <img
                src={bgImage.src}
                class="w-full h-full object-cover animate-breathe blur-[2px] scale-105"
                alt="Background"
            />
            <div class="absolute inset-0 bg-[#0a0a0a]/40 mix-blend-multiply">
            </div>
            <div
                class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-20"
            >
            </div>
        </div>

        <nav
            class="fixed top-0 w-full z-50 flex justify-between items-center px-6 md:px-12 py-6 bg-gradient-to-b from-black/90 to-transparent backdrop-blur-[2px]"
        >
            <div class="flex items-center gap-5 group cursor-pointer">
                <div class="relative w-14 h-14">
                    <div
                        class="absolute inset-0 rounded-full border-2 border-[#7df9ff] animate-spin-slow opacity-80"
                    >
                    </div>
                    <img
                        src={serverIcon.src}
                        class="w-full h-full rounded-full p-1"
                        alt="Icon"
                    />
                </div>
                <span
                    class="font-['Cinzel'] text-2xl md:text-3xl tracking-[0.1em] text-[#e3dac9] drop-shadow-[0_2px_4px_black]"
                    >MALA WORLD</span
                >
            </div>

            <div
                class="hidden md:flex gap-12 text-[#7df9ff] tracking-[0.2em] uppercase text-sm font-bold"
            >
                {
                    [
                        "Inicio",
                        "Jugadores",
                        "Eventos",
                        "Estado",
                        "Inventario",
                    ].map((item) => (
                        <a
                            href={`#${item.toLowerCase()}`}
                            class="relative group py-2 hover:text-[#e3dac9] transition-colors"
                        >
                            {item}
                            <span class="absolute -bottom-1 left-0 w-0 h-[2px] bg-[#e3dac9] group-hover:w-full transition-all duration-300" />
                        </a>
                    ))
                }
                <a
                    href="/malaworld/instalacion"
                    class="relative group py-2 hover:text-[#e3dac9] transition-colors"
                >
                    INSTALACIÓN
                    <span
                        class="absolute -bottom-1 left-0 w-0 h-[2px] bg-[#e3dac9] group-hover:w-full transition-all duration-300"
                    ></span>
                </a>
            </div>
        </nav>

        <header
            id="inicio"
            class="min-h-screen flex flex-col justify-center items-center text-center relative z-10 px-4 pt-20"
        >
            <div class="animate-fade-in-up flex flex-col items-center">
                <h1
                    class="font-['Cinzel'] text-7xl md:text-9xl text-[#e3dac9] drop-shadow-[0_10px_10px_rgba(0,0,0,1)] mb-6 tracking-wide"
                >
                    MALA WORLD
                </h1>

                <div
                    class="bg-black/80 border border-[#7df9ff]/30 px-8 py-3 rounded-full mb-16 backdrop-blur-md shadow-2xl"
                >
                    <p
                        class="text-[#7df9ff] tracking-[0.4em] uppercase text-xs md:text-base font-bold"
                    >
                        La Aventura Continúa...
                    </p>
                </div>

                <button
                    onclick="copyIp()"
                    class="group relative px-12 py-6 bg-[#0a0a0a] border-2 border-[#333] hover:border-[#7df9ff] rounded-xl transition-all duration-300 shadow-[0_0_30px_rgba(0,0,0,0.5)] cursor-pointer"
                >
                    <div class="absolute inset-0 rounded-xl overflow-hidden">
                        <div
                            class="absolute inset-0 bg-[#7df9ff]/10 translate-y-full group-hover:translate-y-0 transition-transform duration-300"
                        >
                        </div>
                    </div>

                    <span
                        id="server-ip"
                        class="font-['Cinzel'] text-2xl md:text-3xl text-[#e3dac9] group-hover:text-white transition-colors relative z-10 font-bold tracking-wider"
                    >
                        23.230.3.241:25721
                    </span>

                    <span
                        class="tooltip absolute -bottom-10 left-1/2 -translate-x-1/2 text-sm text-[#7df9ff] font-bold opacity-0 transition-opacity whitespace-nowrap bg-black px-2 py-1 rounded z-20 border border-[#7df9ff]/30"
                    >
                        IP Copiada
                    </span>
                </button>

                <a
                    href="/malaworld/instalacion"
                    class="mt-8 group relative px-10 py-4 bg-transparent border border-[#7df9ff] hover:bg-[#7df9ff]/10 rounded-xl transition-all duration-300 cursor-pointer overflow-hidden"
                >
                    <span
                        class="font-['Cinzel'] text-xl text-[#7df9ff] tracking-widest font-bold flex items-center gap-3"
                    >
                        <i class="fas fa-download"></i> DESCARGAR MODS
                    </span>
                    <div
                        class="absolute inset-0 bg-[#7df9ff]/5 translate-y-full group-hover:translate-y-0 transition-transform duration-300"
                    >
                    </div>
                </a>

                <div
                    class="mt-12 flex items-center justify-center gap-4 bg-black/90 px-8 py-4 rounded-full border border-zinc-800 shadow-xl"
                >
                    <div
                        class="w-3 h-3 rounded-full bg-red-500 shadow-[0_0_10px_red]"
                        id="status-dot"
                    >
                    </div>
                    <span
                        id="status-text"
                        class="text-xs md:text-sm tracking-[0.2em] text-zinc-400 font-bold uppercase"
                        >Desconectado</span
                    >
                </div>
            </div>
        </header>

        <section
            id="jugadores"
            class="py-20 text-center relative z-10 bg-gradient-to-b from-transparent via-[#7df9ff]/5 to-transparent"
        >
            <div class="max-w-6xl mx-auto px-4">
                <h2
                    class="font-['Cinzel'] text-4xl text-[#7df9ff] mb-4 tracking-[0.3em] font-bold drop-shadow-lg inline-block bg-black/80 px-8 py-2 rounded-full border border-[#7df9ff]/20"
                >
                    SEÑALES DETECTADAS
                </h2>
                <div class="mb-12 flex justify-center">
                    <p
                        class="text-xs md:text-sm text-zinc-400 font-mono tracking-widest uppercase bg-black/60 px-6 py-2 rounded-full border border-zinc-800 backdrop-blur-sm"
                    >
                        Próximo escaneo en: <span
                            id="scan-timer"
                            class="text-[#7df9ff] font-bold ml-2">02:00</span
                        >
                    </p>
                </div>

                <div
                    id="player-grid"
                    class="flex flex-wrap justify-center gap-8 min-h-[100px]"
                >
                    <span
                        class="animate-pulse text-zinc-300 tracking-widest font-bold bg-black/50 px-4 py-2 rounded"
                        >ESCANEANDO EL MUNDO...</span
                    >
                </div>
            </div>
        </section>

        <section id="eventos" class="py-24 px-4 relative z-10">
            <div class="max-w-6xl mx-auto">
                <h2
                    class="text-center font-['Cinzel'] text-4xl text-[#e3dac9] mb-16 tracking-widest font-bold drop-shadow-lg"
                >
                    PRÓXIMOS EVENTOS
                </h2>

                <div class="grid md:grid-cols-2 gap-12">
                    <div
                        class="relative group overflow-hidden rounded-xl border-2 border-red-900/50 bg-black/80 hover:border-red-500/50 transition-all duration-500 shadow-[0_0_30px_rgba(220,38,38,0.1)]"
                    >
                        <div
                            class="absolute inset-0 bg-red-900/10 group-hover:bg-red-900/20 transition-colors"
                        >
                        </div>
                        <div
                            class="p-10 relative z-10 flex flex-col items-center text-center"
                        >
                            <i
                                class="fas fa-fire text-5xl text-red-500 mb-6 drop-shadow-[0_0_15px_rgba(239,68,68,0.5)] animate-pulse"
                            ></i>
                            <h3
                                class="font-['Cinzel'] text-3xl text-red-100 mb-4 font-bold"
                            >
                                APERTURA DEL NETHER
                            </h3>
                            <div
                                class="w-full h-[1px] bg-gradient-to-r from-transparent via-red-500 to-transparent mb-6"
                            >
                            </div>
                            <p
                                class="text-zinc-300 tracking-widest mb-2 font-bold uppercase"
                            >
                                Disponibilidad
                            </p>
                            <p
                                class="text-red-400 text-xl font-bold"
                                id="countdown-nether"
                            >
                                Calculando...
                            </p>
                        </div>
                    </div>

                    <div
                        class="relative group overflow-hidden rounded-xl border-2 border-purple-900/50 bg-black/80 hover:border-purple-500/50 transition-all duration-500 shadow-[0_0_30px_rgba(147,51,234,0.1)]"
                    >
                        <div
                            class="absolute inset-0 bg-purple-900/10 group-hover:bg-purple-900/20 transition-colors"
                        >
                        </div>
                        <div
                            class="p-10 relative z-10 flex flex-col items-center text-center"
                        >
                            <i
                                class="fas fa-dragon text-5xl text-purple-500 mb-6 drop-shadow-[0_0_15px_rgba(168,85,247,0.5)] animate-pulse"
                            ></i>
                            <h3
                                class="font-['Cinzel'] text-3xl text-purple-100 mb-4 font-bold"
                            >
                                APERTURA DEL END
                            </h3>
                            <div
                                class="w-full h-[1px] bg-gradient-to-r from-transparent via-purple-500 to-transparent mb-6"
                            >
                            </div>
                            <p
                                class="text-zinc-300 tracking-widest mb-2 font-bold uppercase"
                            >
                                Disponibilidad
                            </p>
                            <p
                                class="text-purple-400 text-xl font-bold"
                                id="countdown-end"
                            >
                                Calculando...
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="estado" class="py-24 px-4 relative z-10">
            <div
                class="max-w-5xl mx-auto bg-[#0a0a0a]/95 border border-[#333] p-10 md:p-16 relative shadow-2xl rounded-sm"
            >
                <div
                    class="absolute -top-5 left-1/2 -translate-x-1/2 bg-[#0a0a0a] px-10 py-2 border border-[#7df9ff]/50 rounded-full shadow-[0_0_20px_rgba(125,249,255,0.2)]"
                >
                    <h2
                        class="font-['Cinzel'] text-2xl text-[#7df9ff] tracking-widest font-bold"
                    >
                        INFORMACIÓN DEL SISTEMA
                    </h2>
                </div>

                <div class="grid md:grid-cols-2 gap-16 mt-8">
                    <div class="space-y-6 text-center md:text-left">
                        <h3
                            class="text-[#e3dac9] text-lg border-b border-[#333] pb-3 mb-4 tracking-[0.2em] font-bold"
                        >
                            <i class="fas fa-server text-[#7df9ff] mr-2"></i> ESTADO
                        </h3>
                        <div class="space-y-4">
                            <div
                                class="flex justify-between items-center text-zinc-400 bg-white/5 p-4 rounded border border-transparent hover:border-[#7df9ff]/20 transition-all"
                            >
                                <span>ONLINE</span>
                                <span
                                    id="server-online"
                                    class="text-[#7df9ff] font-bold"
                                    >Verificando...</span
                                >
                            </div>
                            <div
                                class="flex justify-between items-center text-zinc-400 bg-white/5 p-4 rounded border border-transparent hover:border-[#7df9ff]/20 transition-all"
                            >
                                <span>VERSIÓN</span>
                                <span
                                    id="server-version"
                                    class="text-white font-bold">...</span
                                >
                            </div>
                            <div
                                class="flex justify-between items-center text-zinc-400 bg-white/5 p-4 rounded border border-transparent hover:border-[#7df9ff]/20 transition-all"
                            >
                                <span>SOFTWARE</span>
                                <span
                                    id="server-software"
                                    class="text-white font-bold">...</span
                                >
                            </div>
                            <div
                                class="flex justify-between items-center text-zinc-400 bg-white/5 p-4 rounded border border-transparent hover:border-[#7df9ff]/20 transition-all"
                            >
                                <span>UBICACIÓN</span>
                                <span class="text-white font-bold"
                                    >Miami, US 🇺🇸</span
                                >
                            </div>
                        </div>
                    </div>

                    <div class="space-y-6 text-center md:text-left">
                        <h3
                            class="text-[#e3dac9] text-lg border-b border-[#333] pb-3 mb-4 tracking-[0.2em] font-bold"
                        >
                            <i class="fas fa-microchip text-[#7df9ff] mr-2"></i> HARDWARE
                        </h3>
                        <div class="space-y-4">
                            <div
                                class="flex justify-between items-center text-zinc-400 bg-white/5 p-4 rounded border border-transparent hover:border-[#7df9ff]/20 transition-all"
                            >
                                <span class="flex items-center gap-2"
                                    ><i class="fas fa-brain text-xs"></i> CPU</span
                                >
                                <span class="text-white font-bold text-sm"
                                    >Ryzen 9 7950X</span
                                >
                            </div>
                            <div
                                class="flex justify-between items-center text-zinc-400 bg-white/5 p-4 rounded border border-transparent hover:border-[#7df9ff]/20 transition-all"
                            >
                                <span class="flex items-center gap-2"
                                    ><i class="fas fa-memory text-xs"></i> RAM</span
                                >
                                <span class="text-white font-bold text-sm"
                                    >32GB DDR5</span
                                >
                            </div>
                            <div
                                class="flex justify-between items-center text-zinc-400 bg-white/5 p-4 rounded border border-transparent hover:border-[#7df9ff]/20 transition-all"
                            >
                                <span class="flex items-center gap-2"
                                    ><i class="fas fa-hdd text-xs"></i> NVMe</span
                                >
                                <span class="text-white font-bold text-sm"
                                    >1TB Gen4</span
                                >
                            </div>
                            <div
                                class="flex justify-between items-center text-zinc-400 bg-white/5 p-4 rounded border border-transparent hover:border-[#7df9ff]/20 transition-all"
                            >
                                <span class="flex items-center gap-2"
                                    ><i class="fas fa-network-wired text-xs"
                                    ></i> Uplink</span
                                >
                                <span class="text-white font-bold text-sm"
                                    >1Gbps</span
                                >
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section
            id="inventario"
            class="py-24 px-4 relative z-10 bg-black/90 backdrop-blur-md"
        >
            <div class="text-center mb-16">
                <h2
                    class="font-['Cinzel'] text-4xl md:text-5xl text-[#e3dac9] mb-6 drop-shadow-[0_4px_4px_black]"
                >
                    INVENTARIO DE MODS
                </h2>
                <div
                    class="w-32 h-1 bg-[#7df9ff] mx-auto rounded-full shadow-[0_0_15px_#7df9ff]"
                >
                </div>
            </div>

            <div
                class="flex justify-center mb-16 gap-3 flex-wrap max-w-6xl mx-auto px-4"
            >
                {
                    categories.map((cat) => (
                        <button
                            onclick={`filterMods('${cat.id}')`}
                            data-category={cat.id}
                            class="filter-btn px-6 py-3 text-xs md:text-sm bg-[#111] text-zinc-300 border border-[#333] hover:border-[#7df9ff] hover:text-[#7df9ff] hover:bg-[#1a1a1a] transition-all uppercase tracking-[0.2em] font-bold rounded-sm cursor-pointer"
                        >
                            {cat.label}
                        </button>
                    ))
                }
            </div>

            <div
                class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 max-w-7xl mx-auto px-4"
            >
                {
                    modList.map((mod) => (
                        <div
                            class="mod-card aspect-square bg-[#0a0a0a] border border-[#222] hover:border-[#7df9ff] hover:shadow-[0_0_20px_#7df9ff/30] hover:-translate-y-1 transition-all duration-300 flex flex-col items-center justify-center p-6 group relative overflow-hidden"
                            data-category={mod.category}
                        >
                            <div class="absolute top-0 right-0 w-8 h-8 border-t-2 border-r-2 border-[#7df9ff]/0 group-hover:border-[#7df9ff] transition-all duration-300" />
                            <div class="absolute bottom-0 left-0 w-8 h-8 border-b-2 border-l-2 border-[#7df9ff]/0 group-hover:border-[#7df9ff] transition-all duration-300" />

                            <i
                                class={`fas ${mod.icon} text-4xl mb-4 text-[#444] group-hover:text-[#e3dac9] group-hover:scale-110 transition-transform duration-500`}
                            />
                            <span class="text-[10px] md:text-xs text-center font-bold text-zinc-500 group-hover:text-[#7df9ff] leading-tight tracking-widest uppercase transition-colors">
                                {mod.name}
                            </span>
                        </div>
                    ))
                }
            </div>
        </section>

        <footer
            class="bg-black py-12 text-center border-t border-[#222] relative z-10 w-full mt-auto"
        >
            <p
                class="text-zinc-600 text-xs uppercase tracking-[0.4em] font-bold"
            >
                Mala World // Ponss
            </p>
        </footer>

        <style is:global>
            @import "tailwindcss";

            @keyframes breathe {
                0%,
                100% {
                    transform: scale(1.05);
                }
                50% {
                    transform: scale(1.07);
                }
            }
            .animate-breathe {
                animation: breathe 20s ease-in-out infinite;
            }

            .filter-btn.active {
                background-color: #0a0a0a;
                color: #7df9ff;
                border-color: #7df9ff;
                box-shadow: 0 0 15px rgba(125, 249, 255, 0.2);
            }

            ::-webkit-scrollbar {
                width: 8px;
            }
            ::-webkit-scrollbar-track {
                background: #000;
            }
            ::-webkit-scrollbar-thumb {
                background: #333;
                border-radius: 4px;
            }
            ::-webkit-scrollbar-thumb:hover {
                background: #7df9ff;
            }
        </style>

        <script is:inline>
            const SERVER_IP = "23.230.3.241";
            const SERVER_PORT = "25721";

            window.filterMods = (category) => {
                document
                    .querySelectorAll(".filter-btn")
                    .forEach((b) =>
                        b.classList.toggle(
                            "active",
                            b.dataset.category === category,
                        ),
                    );
                document.querySelectorAll(".mod-card").forEach((c) => {
                    const match =
                        category === "all" || c.dataset.category === category;
                    c.style.display = match ? "flex" : "none";
                    if (match) {
                        c.style.opacity = "0";
                        requestAnimationFrame(() => {
                            c.style.transition = "opacity 0.5s ease";
                            c.style.opacity = "1";
                        });
                    }
                });
            };

            document.addEventListener("DOMContentLoaded", () =>
                window.filterMods("all"),
            );

            window.copyIp = async () => {
                try {
                    const ipText = document
                        .getElementById("server-ip")
                        .innerText.trim();
                    await navigator.clipboard.writeText(ipText);

                    const tip = document.querySelector(".tooltip");
                    void tip.offsetWidth;

                    tip.classList.remove("opacity-0");
                    tip.classList.add("opacity-100");

                    setTimeout(() => {
                        tip.classList.remove("opacity-100");
                        tip.classList.add("opacity-0");
                    }, 2000);
                } catch (err) {
                    console.error("Error al copiar:", err);
                }
            };

            async function fetchStatus() {
                try {
                    const res = await fetch(
                        `https://api.mcsrvstat.us/3/${SERVER_IP}:${SERVER_PORT}`,
                    );
                    const data = await res.json();

                    const dot = document.getElementById("status-dot");
                    const txt = document.getElementById("status-text");
                    const grid = document.getElementById("player-grid");
                    const onlineTxt = document.getElementById("server-online");
                    const verTxt = document.getElementById("server-version");
                    const softTxt = document.getElementById("server-software");

                    if (data.online) {
                        dot.className =
                            "w-3 h-3 rounded-full bg-[#55ff55] shadow-[0_0_10px_#55ff55] animate-pulse";
                        txt.innerText = "EN LÍNEA";
                        txt.className =
                            "text-xs md:text-sm tracking-[0.2em] text-[#55ff55] font-bold uppercase";

                        onlineTxt.innerText = `${data.players.online}/${data.players.max}`;
                        verTxt.innerText = data.version;
                        softTxt.innerText = data.software || "Vanilla";

                        if (data.players.list?.length) {
                            grid.innerHTML = data.players.list
                                .map(
                                    (p) => `
                            <div class="flex flex-col items-center gap-3 group cursor-pointer hover:-translate-y-2 transition-transform duration-300">
                                <div class="relative w-20 h-20 rounded-xl overflow-hidden border-2 border-zinc-700 bg-[#0a0a0a] group-hover:border-[#7df9ff] shadow-lg transition-colors">
                                    <img src="https://mc-heads.net/avatar/${p.name}" class="w-full h-full grayscale group-hover:grayscale-0 transition-all duration-500">
                                    <div class="absolute inset-0 bg-[#7df9ff]/20 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                                </div>
                                <span class="text-xs text-[#7df9ff] font-bold tracking-widest bg-black/80 px-3 py-1 rounded border border-[#7df9ff]/30 shadow-lg">${p.name}</span>
                            </div>
                        `,
                                )
                                .join("");
                        } else {
                            grid.innerHTML =
                                '<span class="text-zinc-500 italic border border-zinc-800 bg-black/50 px-6 py-2 rounded-full">No hay héroes en este momento...</span>';
                        }
                    } else {
                        dot.className =
                            "w-3 h-3 rounded-full bg-red-500 shadow-[0_0_10px_red]";
                        txt.innerText = "DESCONECTADO";
                        txt.className =
                            "text-xs md:text-sm tracking-[0.2em] text-red-500 font-bold uppercase";
                        grid.innerHTML =
                            '<span class="text-red-900 border border-red-900/30 px-6 py-2 rounded-full">Señal Perdida</span>';
                    }
                } catch (e) {
                    console.log(e);
                }
            }

            function updateCountdowns() {
                const now = new Date().getTime();

                const netherDate = new Date("2025-12-18T18:00:00").getTime();
                const endDate = new Date("2025-12-25T18:00:00").getTime();

                const updateElement = (id, target) => {
                    const el = document.getElementById(id);
                    if (!el) return;

                    const distance = target - now;

                    if (distance < 0) {
                        el.innerText = "¡YA DISPONIBLE!";
                        el.classList.add("text-green-500", "animate-pulse");
                        el.classList.remove("text-red-400", "text-purple-400");
                        return;
                    }

                    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                    const hours = Math.floor(
                        (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
                    );
                    const minutes = Math.floor(
                        (distance % (1000 * 60 * 60)) / (1000 * 60),
                    );
                    const seconds = Math.floor((distance % (1000 * 60)) / 1000);

                    el.innerText = `${days}d ${hours}h ${minutes}m ${seconds}s`;
                };

                updateElement("countdown-nether", netherDate);
                updateElement("countdown-end", endDate);
            }

            fetchStatus();

            function updateScanTimer() {
                const timerEl = document.getElementById("scan-timer");
                if (!timerEl) return;

                const period = 120;
                const now = Math.floor(Date.now() / 1000);
                const timeLeft = period - (now % period);

                const minutes = Math.floor(timeLeft / 60);
                const seconds = timeLeft % 60;

                timerEl.innerText = `${minutes.toString().padStart(2, "0")}:${seconds.toString().padStart(2, "0")}`;

                if (timeLeft === 120) {
                    fetchStatus();
                }
            }
            setInterval(updateScanTimer, 1000);
            updateScanTimer();

            updateCountdowns();
            setInterval(updateCountdowns, 1000);
        </script>
    </body>
</html>
