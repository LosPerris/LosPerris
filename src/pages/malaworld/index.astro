---
import "./style.css";
import serverIcon from "./malaimg/icono del server.png";

const mods = [
    { name: "JEI", icon: "fa-book" },
    { name: "Xaero's Map", icon: "fa-map" },
    { name: "Create", icon: "fa-cogs" },
    { name: "Farmers Delight", icon: "fa-leaf" },
    { name: "Alex's Mobs", icon: "fa-paw" },
    { name: "Iron Chests", icon: "fa-box" },
    { name: "Sophisticated Backpacks", icon: "fa-hiking" },
    { name: "Ars Nouveau", icon: "fa-hat-wizard" },
];
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Mala World - Official Server</title>
        <meta
            name="description"
            content="Servidor de Minecraft Survival Mala World"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap"
            rel="stylesheet"
        />
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
        />
        <link rel="preconnect" href="https://mc-heads.net" />
    </head>
    <body>
        <div class="background-overlay"></div>

        <nav class="navbar">
            <div class="logo">
                <img src={serverIcon.src} alt="Mala World Icon" />
                MALA WORLD
            </div>
            <div class="nav-links">
                <a href="#home">Inicio</a>
                <a href="#players">Jugadores</a>
                <a href="#mods">Mods</a>
                <a href="#features">Características</a>
                <a href="#store" class="store-link">Tienda</a>
            </div>
        </nav>

        <header id="home" class="hero">
            <img
                src={serverIcon.src}
                alt="Mala World Logo"
                class="server-icon-large"
            />

            <div class="hero-content">
                <h1 class="glitch" data-text="MALA WORLD">MALA WORLD</h1>
                <p class="subtitle">
                    La experiencia Survival definitiva con mods y amigos
                </p>

                <div class="server-status-container">
                    <div id="status-dot" class="status-indicator"></div>
                    <span id="player-count">Cargando...</span>
                </div>

                <div class="ip-container" onclick="copyIp()">
                    <div class="tooltip">¡Click para copiar!</div>
                    <span id="server-ip">23.230.3.241:25721</span>
                    <i class="fas fa-copy"></i>
                </div>

                <div
                    id="server-meta"
                    style="margin-top: 1rem; color: #888; font-size: 0.9rem;"
                >
                    <span id="server-version">...</span>
                </div>
            </div>
        </header>

        <section id="players" class="player-list-section">
            <h2>Jugadores en Línea</h2>
            <div id="player-grid" class="player-grid">
                <p style="color: #666; font-style: italic;">
                    Cargando jugadores...
                </p>
            </div>
        </section>

        <section id="mods">
            <h2>Mods Principales</h2>
            <div class="mods-grid">
                {
                    mods.map((mod) => (
                        <div class="mod-item">
                            <i class={`fas ${mod.icon}`} />
                            <div class="mod-name">{mod.name}</div>
                        </div>
                    ))
                }
            </div>
            <p style="text-align: center; margin-top: 2rem; color: #666;">
                y muchos más...
            </p>
        </section>

        <section id="features" class="features">
            <h2>Características</h2>
            <div class="grid">
                <div class="card">
                    <i class="fas fa-hammer"></i>
                    <h3>Survival Modded</h3>
                    <p>
                        Una selección curada de los mejores mods para mejorar tu
                        experiencia sin perder la esencia.
                    </p>
                </div>
                <div class="card">
                    <i class="fas fa-shield-alt"></i>
                    <h3>Seguridad</h3>
                    <p>
                        Tus construcciones están protegidas. Juega tranquilo con
                        tus amigos.
                    </p>
                </div>
                <div class="card">
                    <i class="fas fa-server"></i>
                    <h3>Rendimiento</h3>
                    <p>
                        Hosteado en servidores de alta gama para garantizar 0
                        lag.
                    </p>
                </div>
            </div>
        </section>

        <footer>
            <p>&copy; 2025 Mala World.</p>
            <p style="font-size: 0.8rem; opacity: 0.5;">
                No afiliado con Mojang AB.
            </p>
        </footer>

        <script is:inline>
            const SERVER_IP = "23.230.3.241";
            const SERVER_PORT = "25721";

            function copyIp() {
                const ipText = document.getElementById("server-ip").innerText;
                navigator.clipboard
                    .writeText(ipText)
                    .then(() => {
                        const tooltip = document.querySelector(".tooltip");
                        tooltip.innerText = "¡IP Copiada!";
                        tooltip.style.opacity = "1";
                        setTimeout(() => {
                            tooltip.style.opacity = "0";
                            setTimeout(() => {
                                tooltip.innerText = "¡Click para copiar!";
                            }, 300);
                        }, 2000);
                    })
                    .catch((err) => console.error("Error copying:", err));
            }

            async function fetchServerStatus() {
                const countElement = document.getElementById("player-count");
                const statusDot = document.getElementById("status-dot");
                const playerGrid = document.getElementById("player-grid");
                const versionElement =
                    document.getElementById("server-version");

                try {
                    const response = await fetch(
                        `https://api.mcsrvstat.us/3/${SERVER_IP}:${SERVER_PORT}`,
                    );
                    const data = await response.json();

                    if (data.online) {
                        countElement.innerText = `${data.players.online} / ${data.players.max} Jugadores`;
                        statusDot.classList.add("online");
                        statusDot.classList.remove("offline");
                        versionElement.innerText = `${data.version} • ${data.software || "Vanilla"}`;

                        if (data.players.list && data.players.list.length > 0) {
                            playerGrid.innerHTML = data.players.list
                                .map(
                                    (player) => `
                            <div class="player-item">
                                <img src="https://mc-heads.net/avatar/${player.name}" alt="${player.name}" class="player-head">
                                <span class="player-name">${player.name}</span>
                            </div>
                        `,
                                )
                                .join("");
                        } else {
                            if (data.players.online > 0) {
                                playerGrid.innerHTML =
                                    '<p style="color: #888;">Jugadores conectados (lista oculta)</p>';
                            } else {
                                playerGrid.innerHTML =
                                    '<p style="color: #666;">No hay nadie jugando ahora :(</p>';
                            }
                        }
                    } else {
                        statusElement.innerText = "Offline";
                        statusDot.classList.remove("online");
                        statusDot.classList.add("offline");
                        playerGrid.innerHTML =
                            '<p style="color: #aa5555;">El servidor está apagado.</p>';
                    }
                } catch (error) {
                    console.error("fetch error:", error);
                    statusDot.classList.remove("online");
                    countElement.innerText = "Error API";
                }
            }

            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("visible");
                            observer.unobserve(entry.target);
                        }
                    });
                },
                { threshold: 0.1 },
            );

            document
                .querySelectorAll(".card, .mod-item, .player-item")
                .forEach((el) => {
                    el.style.opacity = "0";
                    el.style.transform = "translateY(20px)";
                    el.style.transition = "all 0.6s ease";
                    observer.observe(el);
                });

            const style = document.createElement("style");
            style.innerHTML = `.visible { opacity: 1 !important; transform: translateY(0) !important; }`;
            document.head.appendChild(style);

            fetchServerStatus();
            setInterval(fetchServerStatus, 300000);
            window.copyIp = copyIp;
        </script>
    </body>
</html>
