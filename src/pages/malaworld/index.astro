---
import { Image } from "astro:assets";
import botwBg from "./malaimg/_botw-bg.png";
import serverIcon from "./malaimg/_icono_del_server.png";
import Hero from "./_components/Hero.astro";
import PlayerGrid from "./_components/PlayerGrid.astro";
import Events from "./_components/Events.astro";
import Scoreboard from "./_components/Scoreboard.astro";
import ServerInfo from "./_components/ServerInfo.astro";
import ModInventory from "./_components/ModInventory.astro";
import ChristmasPopup from "./_components/ChristmasPopup.astro";
import Footer from "./_components/Footer.astro";
import { siteUrl } from "../../data/community";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Mala World</title>
        <meta
            name="description"
            content="Únete a Mala World, el mejor servidor Survival Technical SMP. Eventos semanales, comunidad activa y una experiencia de juego única."
        />
        <link rel="icon" type="image/png" href={serverIcon.src} />

        <meta
            property="og:title"
            content="Mala World - Servidor de Minecraft Survival SMP"
        />
        <meta
            property="og:description"
            content="Descubre Mala World: Comunidad activa, eventos épicos y un mundo técnico listo para explorar. ¡Únete ahora!"
        />
        <meta property="og:image" content={serverIcon.src} />
        <meta property="og:url" content={`${siteUrl}/malaworld/`} />
        <meta property="og:type" content="website" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Josefin+Sans:wght@300;400;600;700&display=swap"
            rel="stylesheet"
        />
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
        />
        <link rel="preconnect" href="https://mc-heads.net" />
    </head>
    <body
        class="bg-[#050505] text-white font-['Josefin_Sans'] overflow-x-hidden relative selection:bg-[#7df9ff] selection:text-black flex flex-col min-h-screen"
    >
        <ChristmasPopup />
        <div class="fixed inset-0 z-[-1]">
            <Image
                src={botwBg}
                class="w-full h-full object-cover animate-breathe blur-[2px] scale-105"
                alt="Background"
            />
            <div class="absolute inset-0 bg-[#0a0a0a]/40 mix-blend-multiply">
            </div>
            <div
                class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-20"
            >
            </div>
        </div>

        <nav
            class="fixed top-0 w-full z-50 flex justify-between items-center px-6 md:px-12 py-6 bg-linear-to-b from-black/90 to-transparent backdrop-blur-[2px]"
        >
            <div class="flex items-center gap-5 group cursor-pointer">
                <div class="relative w-14 h-14">
                    <div
                        class="absolute inset-0 rounded-full border-2 border-[#7df9ff] animate-spin-slow opacity-80"
                    >
                    </div>
                    <img
                        src={serverIcon.src}
                        class="w-full h-full rounded-full p-1"
                        alt="Mala World Icon"
                        width="56"
                        height="56"
                    />
                </div>
                <span
                    class="font-['Cinzel'] text-2xl md:text-3xl tracking-widest text-[#e3dac9] drop-shadow-[0_2px_4px_black]"
                    >MALA WORLD</span
                >
            </div>

            <div
                class="hidden md:flex gap-12 text-[#7df9ff] tracking-[0.2em] uppercase text-sm font-bold"
            >
                {
                    [
                        "Inicio",
                        "Jugadores",
                        "Eventos",
                        "Estado",
                        "Inventario",
                    ].map((item) => (
                        <a
                            href={`#${item.toLowerCase()}`}
                            class="relative group py-2 hover:text-[#e3dac9] transition-colors"
                            data-astro-prefetch
                        >
                            {item}
                            <span class="absolute -bottom-1 left-0 w-0 h-[2px] bg-[#e3dac9] group-hover:w-full transition-all duration-300" />
                        </a>
                    ))
                }
                <a
                    href="/malaworld/instalacion"
                    class="relative group py-2 hover:text-[#e3dac9] transition-colors"
                >
                    INSTALACIÓN
                    <span
                        class="absolute -bottom-1 left-0 w-0 h-[2px] bg-[#e3dac9] group-hover:w-full transition-all duration-300"
                    ></span>
                </a>
            </div>
        </nav>

        <main class="grow w-full relative z-10">
            <section id="inicio">
                <Hero />
            </section>

            <PlayerGrid />

            <Scoreboard />

            <Events />

            <ServerInfo />

            <ModInventory />
        </main>

        <Footer />

        <style is:global>
            @import "tailwindcss";

            @keyframes breathe {
                0%,
                100% {
                    transform: scale(1.05);
                }
                50% {
                    transform: scale(1.07);
                }
            }
            .animate-breathe {
                animation: breathe 20s ease-in-out infinite;
            }

            .filter-btn.active {
                background-color: #0a0a0a;
                color: #7df9ff;
                border-color: #7df9ff;
                box-shadow: 0 0 15px rgba(125, 249, 255, 0.2);
            }

            ::-webkit-scrollbar {
                width: 8px;
            }
            ::-webkit-scrollbar-track {
                background: #000;
            }
            ::-webkit-scrollbar-thumb {
                background: #333;
                border-radius: 4px;
            }
            ::-webkit-scrollbar-thumb:hover {
                background: #7df9ff;
            }
        </style>

        <script is:inline>
            const SERVER_IP = "23.230.3.241";
            const SERVER_PORT = "25721";
            const SCAN_PERIOD = 120;
            const STATS_API_URL = "/malaworld/api/all";

            const DataManager = {
                init() {
                    this.updateLoop();
                    setInterval(() => this.updateLoop(), 1000);
                },

                async updateLoop() {
                    const now = Date.now();
                    const lastFetch = parseInt(
                        localStorage.getItem("mw_stats_last_fetch") || "0",
                    );
                    const nextUpdate = lastFetch + SCAN_PERIOD * 1000;

                    if (now >= nextUpdate) {
                        await this.fetchData();
                    } else {
                        this.broadcastUpdate(nextUpdate);
                    }
                },

                async fetchData() {
                    try {
                        console.log("Fetching new stats data...");
                        const res = await fetch(STATS_API_URL);
                        if (!res.ok) throw new Error("API Error");
                        const data = await res.json();

                        localStorage.setItem(
                            "mw_stats_cache",
                            JSON.stringify(data),
                        );
                        localStorage.setItem(
                            "mw_stats_last_fetch",
                            Date.now().toString(),
                        );

                        const nextUpdate = Date.now() + SCAN_PERIOD * 1000;
                        this.broadcastUpdate(nextUpdate, data);
                    } catch (e) {
                        console.error("Error fetching stats:", e);
                    }
                },

                broadcastUpdate(nextUpdate, freshData = null) {
                    let data = freshData;
                    if (!data) {
                        const cached = localStorage.getItem("mw_stats_cache");
                        if (cached) data = JSON.parse(cached);
                    }

                    if (data) {
                        const event = new CustomEvent(
                            "malaworld-stats-update",
                            {
                                detail: { data, nextUpdate },
                            },
                        );
                        window.dispatchEvent(event);
                    }

                    updateScanTimerUI(nextUpdate);
                },
            };

            function renderPlayerGridFromStats(playersData) {
                const grid = document.getElementById("player-grid");
                if (!grid) return;

                const playersList = Object.values(playersData);
                const topPlayers = playersList.slice(0, 12);

                if (topPlayers.length) {
                    grid.innerHTML = topPlayers
                        .map(
                            (p) => `
                        <div class="flex flex-col items-center gap-3 group cursor-pointer hover:-translate-y-2 transition-transform duration-300">
                            <div class="relative w-20 h-20 rounded-xl overflow-hidden border-2 border-zinc-700 bg-[#0a0a0a] group-hover:border-[#7df9ff] shadow-lg transition-colors">
                                <img src="${p.skin}" alt="${p.name} Skin" loading="lazy" width="80" height="80" class="w-full h-full sm:grayscale group-hover:grayscale-0 transition-all duration-500">
                                <div class="absolute inset-0 bg-[#7df9ff]/20 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                            </div>
                            <span class="text-xs text-[#7df9ff] font-bold tracking-widest bg-black/80 px-3 py-1 rounded border border-[#7df9ff]/30 shadow-lg capitalize">${p.name}</span>
                        </div>
                    `,
                        )
                        .join("");
                } else {
                    grid.innerHTML =
                        '<span class="text-zinc-500 italic border border-zinc-800 bg-black/50 px-6 py-2 rounded-full">No hay señales detectadas...</span>';
                }
            }

            function updateScanTimerUI(nextUpdateTimestamp) {
                const timerEl = document.getElementById("scan-timer");
                if (!timerEl) return;

                const now = Date.now();
                let secondsLeft = Math.ceil((nextUpdateTimestamp - now) / 1000);
                if (secondsLeft < 0) secondsLeft = 0;

                const minutes = Math.floor(secondsLeft / 60);
                const seconds = secondsLeft % 60;
                timerEl.innerText = `${minutes.toString().padStart(2, "0")}:${seconds.toString().padStart(2, "0")}`;
            }

            function renderStatus(data) {
                const dot = document.getElementById("status-dot");
                const txt = document.getElementById("status-text");
                const onlineTxt = document.getElementById("server-online");
                const verTxt = document.getElementById("server-version");
                const softTxt = document.getElementById("server-software");

                if (!dot || !txt) return;

                if (data.online) {
                    dot.className =
                        "w-3 h-3 rounded-full bg-[#55ff55] shadow-[0_0_10px_#55ff55] animate-pulse";
                    txt.innerText = "EN LÍNEA";
                    txt.className =
                        "text-xs md:text-sm tracking-[0.2em] text-[#55ff55] font-bold uppercase";

                    if (onlineTxt)
                        onlineTxt.innerText = `${data.players.online}/${data.players.max}`;
                    if (verTxt) verTxt.innerText = data.version;
                    if (softTxt) softTxt.innerText = data.software || "Vanilla";

                    const grid = document.getElementById("player-grid");
                    if (grid) {
                        if (data.players.list?.length) {
                            grid.innerHTML = data.players.list
                                .map(
                                    (p) => `
                            <div class="flex flex-col items-center gap-3 group cursor-pointer hover:-translate-y-2 transition-transform duration-300">
                                <div class="relative w-20 h-20 rounded-xl overflow-hidden border-2 border-zinc-700 bg-[#0a0a0a] group-hover:border-[#7df9ff] shadow-lg transition-colors">
                                    <img src="https://mc-heads.net/avatar/${p.name}" alt="${p.name} Avatar" loading="lazy" width="80" height="80" class="w-full h-full grayscale group-hover:grayscale-0 transition-all duration-500">
                                    <div class="absolute inset-0 bg-[#7df9ff]/20 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                                </div>
                                <span class="text-xs text-[#7df9ff] font-bold tracking-widest bg-black/80 px-3 py-1 rounded border border-[#7df9ff]/30 shadow-lg">${p.name}</span>
                            </div>
                        `,
                                )
                                .join("");
                        } else {
                            grid.innerHTML =
                                '<span class="text-zinc-500 italic border border-zinc-800 bg-black/50 px-6 py-2 rounded-full">No hay héroes en este momento...</span>';
                        }
                    }
                } else {
                    dot.className =
                        "w-3 h-3 rounded-full bg-red-500 shadow-[0_0_10px_red]";
                    txt.innerText = "DESCONECTADO";
                    txt.className =
                        "text-xs md:text-sm tracking-[0.2em] text-red-500 font-bold uppercase";

                    const grid = document.getElementById("player-grid");
                    if (grid) {
                        grid.innerHTML =
                            '<span class="text-red-900 border border-red-900/30 px-6 py-2 rounded-full">Señal Perdida</span>';
                    }
                }
            }

            async function fetchStatus() {
                try {
                    const res = await fetch(
                        `https://api.mcsrvstat.us/3/${SERVER_IP}:${SERVER_PORT}`,
                    );
                    const data = await res.json();
                    renderStatus(data);
                } catch (e) {
                    console.log(e);
                }
                setTimeout(fetchStatus, SCAN_PERIOD * 1000);
            }

            DataManager.init();

            fetchStatus();

            window.filterMods = (category) => {
                document
                    .querySelectorAll(".filter-btn")
                    .forEach((b) =>
                        b.classList.toggle(
                            "active",
                            b.dataset.category === category,
                        ),
                    );
                document.querySelectorAll(".mod-card").forEach((c) => {
                    const match =
                        category === "all" || c.dataset.category === category;
                    c.style.display = match ? "flex" : "none";
                    if (match) {
                        c.style.opacity = "0";
                        requestAnimationFrame(() => {
                            c.style.transition = "opacity 0.5s ease";
                            c.style.opacity = "1";
                        });
                    }
                });
            };

            document.addEventListener("DOMContentLoaded", () =>
                window.filterMods("all"),
            );

            window.copyIp = async () => {
                try {
                    const ipText = document
                        .getElementById("server-ip")
                        .innerText.trim();
                    await navigator.clipboard.writeText(ipText);

                    const tip = document.querySelector(".tooltip");
                    void tip.offsetWidth;

                    tip.classList.remove("opacity-0");
                    tip.classList.add("opacity-100");

                    setTimeout(() => {
                        tip.classList.remove("opacity-100");
                        tip.classList.add("opacity-0");
                    }, 2000);
                } catch (err) {
                    console.error("Error al copiar:", err);
                }
            };

            function updateCountdowns() {
                const now = new Date().getTime();

                const netherDate = new Date("2025-12-18T18:00:00").getTime();
                const endDate = new Date("2025-12-25T18:00:00").getTime();

                const updateElement = (id, target) => {
                    const el = document.getElementById(id);
                    if (!el) return;

                    const distance = target - now;

                    if (distance < 0) {
                        el.innerText = "¡YA DISPONIBLE!";
                        el.classList.add("text-green-500", "animate-pulse");
                        el.classList.remove("text-red-400", "text-purple-400");
                        return;
                    }

                    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                    const hours = Math.floor(
                        (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
                    );
                    const minutes = Math.floor(
                        (distance % (1000 * 60 * 60)) / (1000 * 60),
                    );
                    const seconds = Math.floor((distance % (1000 * 60)) / 1000);

                    el.innerText = `${days}d ${hours}h ${minutes}m ${seconds}s`;
                };

                updateElement("countdown-nether", netherDate);
                updateElement("countdown-end", endDate);
            }

            updateCountdowns();
            setInterval(updateCountdowns, 1000);
        </script>
    </body>
</html>
