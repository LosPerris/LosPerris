---
import serverIcon from "./malaimg/icono del server.png";
import bgImage from "./malaimg/pixel-bg.png";

const modList = [
    { name: "Ice and Fire", category: "rpg", icon: "fa-dragon" },
    { name: "L_Enders Cataclysm", category: "rpg", icon: "fa-skull" },
    { name: "Twilight Forest", category: "rpg", icon: "fa-tree" },
    { name: "Apotheosis", category: "rpg", icon: "fa-khanda" },
    { name: "Mine and Slash", category: "rpg", icon: "fa-sword" },
    { name: "Simply Swords", category: "rpg", icon: "fa-gavel" },
    { name: "Iter RPG", category: "rpg", icon: "fa-dungeon" },
    { name: "The Graveyard", category: "rpg", icon: "fa-ghost" },
    { name: "The Hordes", category: "rpg", icon: "fa-users" },
    { name: "Bosses Rise", category: "rpg", icon: "fa-crown" },
    { name: "Dungeon Realm", category: "rpg", icon: "fa-fort-awesome" },
    { name: "Valarian Conquest", category: "rpg", icon: "fa-shield-alt" },
    { name: "Realmrpg Quests", category: "rpg", icon: "fa-scroll" },
    { name: "Realmrpg Skeletons", category: "rpg", icon: "fa-bone" },
    { name: "Human Companions", category: "rpg", icon: "fa-user-friends" },
    { name: "Player Revive", category: "rpg", icon: "fa-heart-pulse" },

    {
        name: "Oh The Biomes We've Gone",
        category: "world",
        icon: "fa-mountain",
    },
    { name: "Amplified Nether", category: "world", icon: "fa-fire" },
    {
        name: "Yung's Better Nether Fortresses",
        category: "world",
        icon: "fa-archway",
    },
    { name: "Yung's Better End Island", category: "world", icon: "fa-cubes" },
    {
        name: "Moog's Nether Structures",
        category: "world",
        icon: "fa-building",
    },
    { name: "Lukis Grand Capitals", category: "world", icon: "fa-city" },
    { name: "Additional Structures", category: "world", icon: "fa-home" },
    { name: "Ancient Obelisks", category: "world", icon: "fa-monument" },
    { name: "Formations Overworld", category: "world", icon: "fa-shapes" },

    { name: "Alex's Mobs", category: "mobs", icon: "fa-paw" },
    { name: "Legendary Creatures", category: "mobs", icon: "fa-spider" },
    { name: "End of Herobrine", category: "mobs", icon: "fa-eye" },
    { name: "More Mob Variants", category: "mobs", icon: "fa-frog" },
    { name: "The Obsessed", category: "mobs", icon: "fa-mask" },
    { name: "Myths and Legends", category: "mobs", icon: "fa-book-dead" },

    { name: "Artifacts", category: "magic", icon: "fa-hat-wizard" },
    { name: "Relics/Curios", category: "magic", icon: "fa-ring" },
    { name: "Waystones", category: "magic", icon: "fa-map-marker-alt" },
    { name: "Tombstone", category: "magic", icon: "fa-cross" },
    { name: "Paraglider", category: "magic", icon: "fa-parachute-box" },

    { name: "JEI", category: "utility", icon: "fa-book" },
    { name: "Jade", category: "utility", icon: "fa-info-circle" },
    { name: "Xaero's Minimap", category: "utility", icon: "fa-map" },
    { name: "Xaero's World Map", category: "utility", icon: "fa-globe" },
    { name: "Sophisticated Backpacks", category: "utility", icon: "fa-hiking" },
    { name: "Mouse Tweaks", category: "utility", icon: "fa-mouse-pointer" },
    { name: "AppleSkin", category: "utility", icon: "fa-apple-alt" },
    { name: "TreeChop", category: "utility", icon: "fa-axe" },
    { name: "Voice Chat", category: "utility", icon: "fa-microphone" },
    { name: "Lootr", category: "utility", icon: "fa-box-open" },
    { name: "Inventory HUD+", category: "utility", icon: "fa-th" },
    { name: "Lightman's Currency", category: "utility", icon: "fa-coins" },
    { name: "Chunky", category: "utility", icon: "fa-layer-group" },

    { name: "ModernFix", category: "performance", icon: "fa-tachometer-alt" },
    { name: "FerriteCore", category: "performance", icon: "fa-memory" },
    { name: "ImmediatelyFast", category: "performance", icon: "fa-bolt" },
];

const categories = [
    { id: "all", label: "Todos" },
    { id: "rpg", label: "RPG & Combate" },
    { id: "world", label: "Mundo" },
    { id: "mobs", label: "Mobs" },
    { id: "utility", label: "Utilidad" },
    { id: "performance", label: "Optimización" },
];
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Mala World - Adventure Server</title>
        <meta
            name="description"
            content="Servidor de Minecraft Survival Mala World"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=VT323&display=swap"
            rel="stylesheet"
        />
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
        />
        <link rel="preconnect" href="https://mc-heads.net" />
    </head>
    <body
        class="bg-[#1a1a1a] text-white font-['VT323'] text-xl overflow-x-hidden antialiased selection:bg-[#ffd700] selection:text-black"
    >
        <div class="fixed inset-0 z-[-1]">
            <img
                src={bgImage.src}
                alt="Background"
                class="w-full h-full object-cover pixelated opacity-80"
            />
            <div class="absolute inset-0 bg-black/30"></div>
        </div>

        <nav
            class="fixed top-0 w-full z-10 flex justify-between items-center px-4 md:px-8 py-3 bg-[#2b2b2b] border-b-4 border-[#111] shadow-xl"
        >
            <div
                class="flex items-center gap-3 text-3xl font-normal tracking-wide text-[#ffd700] drop-shadow-[2px_2px_0_#000]"
            >
                <img
                    src={serverIcon.src}
                    alt="Icon"
                    class="h-10 w-10 pixelated border-2 border-white/20"
                />
                MALA WORLD
            </div>
            <div class="hidden md:flex gap-6">
                <a
                    href="#home"
                    class="text-gray-300 hover:text-white hover:underline decoration-2 underline-offset-4 transition-all text-2xl"
                    >Inicio</a
                >
                <a
                    href="#players"
                    class="text-gray-300 hover:text-white hover:underline decoration-2 underline-offset-4 transition-all text-2xl"
                    >Jugadores</a
                >
                <a
                    href="#mods"
                    class="text-gray-300 hover:text-white hover:underline decoration-2 underline-offset-4 transition-all text-2xl"
                    >Mods</a
                >
            </div>
        </nav>

        <header
            id="home"
            class="min-h-screen flex flex-col justify-center items-center text-center px-4 pt-20"
        >
            <div class="animate-[float_6s_ease-in-out_infinite]">
                <h1
                    class="text-8xl md:text-9xl mb-4 text-[#ffd700] drop-shadow-[4px_4px_0_#3f3f3f] stroke-black"
                    style="-webkit-text-stroke: 2px #000;"
                >
                    MALA WORLD
                </h1>
            </div>

            <p
                class="text-3xl text-white mb-10 drop-shadow-[2px_2px_0_#000] bg-black/50 px-4 py-1 rounded"
            >
                Survival Técnico & RPG entre Amigos
            </p>

            <div
                class="mc-button pointer-events-none mb-8 px-6 py-2 flex items-center gap-3"
            >
                <div
                    id="status-dot"
                    class="w-4 h-4 bg-gray-500 border-2 border-black"
                >
                </div>
                <span
                    id="player-count"
                    class="text-[#55ff55] drop-shadow-[1px_1px_0_#000] text-2xl"
                    >Conectando...</span
                >
            </div>

            <button
                onclick="copyIp()"
                class="mc-button group relative px-8 py-4 text-3xl text-white active:translate-y-1 active:border-b-4 cursor-pointer"
            >
                <span
                    class="tooltip-text absolute -top-12 left-1/2 -translate-x-1/2 bg-[#111] text-white text-xl px-3 py-1 border-2 border-white opacity-0 transition-opacity pointer-events-none"
                    >¡Click para copiar!</span
                >
                <span id="server-ip" class="mr-3 drop-shadow-[1px_1px_0_#000]"
                    >23.230.3.241:25721</span
                >
                <i class="fas fa-copy text-gray-400 group-hover:text-white"></i>
            </button>

            <div
                class="mt-8 text-xl text-gray-300 bg-black/50 px-4 py-2 rounded border border-white/10"
            >
                <span id="server-version">1.20.1 • Forge</span>
            </div>
        </header>

        <section
            id="players"
            class="py-20 px-4 md:px-[10%] bg-black/60 border-y-4 border-[#111]"
        >
            <h2
                class="text-5xl text-center mb-12 text-[#ffd700] drop-shadow-[3px_3px_0_#000]"
            >
                Jugadores Conectados
            </h2>

            <div
                class="bg-[#00000080] p-4 max-w-4xl mx-auto rounded-none border-2 border-white/10"
            >
                <div class="text-center text-[#AAAAAA] mb-4 text-2xl">
                    - TAB LIST -
                </div>
                <div
                    id="player-grid"
                    class="flex flex-wrap justify-center gap-4"
                >
                    <p class="text-gray-500 italic">Buscando jugadores...</p>
                </div>
                <div class="text-center text-[#AAAAAA] mt-4 text-2xl">
                    Mala World Network
                </div>
            </div>
        </section>

        <section id="mods" class="py-20 px-4 md:px-[5%] max-w-7xl mx-auto">
            <h2
                class="text-5xl text-center mb-8 text-[#ffd700] drop-shadow-[3px_3px_0_#000]"
            >
                Lista de Mods
            </h2>

            <div
                class="flex flex-wrap justify-center gap-4 mb-12 sticky top-20 z-40 py-4 bg-black/40 backdrop-blur-sm rounded-xl border border-white/10"
            >
                {
                    categories.map((cat) => (
                        <button
                            onclick={`filterMods('${cat.id}')`}
                            class="mc-button-sm text-xl px-4 py-1 hover:text-[#ffd700] transition-colors cursor-pointer"
                            data-category={cat.id}
                        >
                            {cat.label}
                        </button>
                    ))
                }
            </div>

            <div
                id="mods-container"
                class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4"
            >
                {
                    modList.map((mod) => (
                        <div
                            class="mod-card bg-[#333] border-2 border-black p-3 flex items-center gap-3 hover:bg-[#444] transition-colors"
                            data-category={mod.category}
                        >
                            <div class="w-10 h-10 bg-[#222] border-2 border-[#111] flex items-center justify-center shrink-0">
                                <i
                                    class={`fas ${mod.icon} text-[#ffd700] text-xl`}
                                />
                            </div>
                            <div class="leading-none">
                                <div class="text-white text-xl drop-shadow-[1px_1px_0_#000]">
                                    {mod.name}
                                </div>
                                <div class="text-gray-400 text-base uppercase">
                                    {
                                        categories.find(
                                            (c) => c.id === mod.category,
                                        )?.label
                                    }
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>

            <p class="text-center text-gray-400 mt-8 text-xl">
                y {100 - modList.length > 0 ? 100 - modList.length : "muchos"} librerías
                más...
            </p>
        </section>

        <footer class="py-12 bg-[#111] text-center border-t-4 border-[#333]">
            <div
                class="w-full h-4 bg-[#5d3e1d] mb-8 opacity-50 pixelated"
                style="background-image: url('https://assets.codepen.io/13471/dirt-texture.png'); background-size: 64px;"
            >
            </div>

            <p class="text-gray-400 text-2xl">&copy; 2025 Mala World</p>
            <p class="text-gray-600">Hosteado con ❤️ para los panas.</p>
        </footer>

        <style is:global>
            @import "tailwindcss";

            .mc-button {
                background-color: #7d7d7d;
                border-top: 4px solid #c6c6c6;
                border-left: 4px solid #c6c6c6;
                border-bottom: 4px solid #3f3f3f;
                border-right: 4px solid #3f3f3f;
                box-shadow: 4px 4px 0 #000;
                transition: all 0.1s;
            }
            .mc-button:active {
                border-top: 4px solid #3f3f3f;
                border-left: 4px solid #3f3f3f;
                border-bottom: 4px solid #c6c6c6;
                border-right: 4px solid #c6c6c6;
                transform: translateY(4px);
                box-shadow: 0 0 0 #000;
            }

            .mc-button-sm {
                background-color: #555;
                border: 2px solid #000;
                box-shadow: 2px 2px 0 #000;
            }
            .mc-button-sm:active,
            .mc-button-sm.active {
                background-color: #777;
                transform: translateY(2px);
                box-shadow: none;
                color: #ffd700;
            }

            .mc-button-sm.active {
                background-color: #777;
                color: #ffd700;
                box-shadow: inset 2px 2px 0 #000;
            }

            .pixelated {
                image-rendering: pixelated;
            }
        </style>

        <script is:inline>
            const SERVER_IP = "23.230.3.241";
            const SERVER_PORT = "25721";

            window.filterMods = (category) => {
                const cards = document.querySelectorAll(".mod-card");
                const buttons = document.querySelectorAll(".mc-button-sm");

                buttons.forEach((btn) => {
                    if (btn.dataset.category === category)
                        btn.classList.add("active");
                    else btn.classList.remove("active");
                });

                cards.forEach((card) => {
                    if (
                        category === "all" ||
                        card.dataset.category === category
                    ) {
                        card.style.display = "flex";
                    } else {
                        card.style.display = "none";
                    }
                });
            };

            document.addEventListener("DOMContentLoaded", () =>
                window.filterMods("all"),
            );

            function copyIp() {
                const ipText = document.getElementById("server-ip").innerText;
                navigator.clipboard.writeText(ipText).then(() => {
                    const tooltip = document.querySelector(".tooltip-text");
                    tooltip.innerText = "¡Copiado!";
                    tooltip.classList.remove("opacity-0");
                    setTimeout(() => {
                        tooltip.classList.add("opacity-0");
                        setTimeout(() => {
                            tooltip.innerText = "¡Click para copiar!";
                        }, 300);
                    }, 2000);
                });
            }

            async function fetchServerStatus() {
                const countElement = document.getElementById("player-count");
                const statusDot = document.getElementById("status-dot");
                const playerGrid = document.getElementById("player-grid");

                try {
                    const response = await fetch(
                        `https://api.mcsrvstat.us/3/${SERVER_IP}:${SERVER_PORT}`,
                    );
                    const data = await response.json();

                    if (data.online) {
                        countElement.innerText = `${data.players.online} / ${data.players.max}`;
                        statusDot.classList.replace(
                            "bg-gray-500",
                            "bg-[#55ff55]",
                        );

                        if (data.players.list && data.players.list.length > 0) {
                            playerGrid.innerHTML = data.players.list
                                .map(
                                    (player) => `
                            <div class="flex items-center gap-2 bg-[#ffffff10] px-3 py-1 rounded-sm w-48">
                                <img src="https://mc-heads.net/avatar/${player.name}" class="w-6 h-6 rounded-sm pixelated">
                                <span class="text-white text-xl">${player.name}</span>
                                <span class="ml-auto text-[#55ff55] text-sm">Build 12ms</span> 
                            </div>
                        `,
                                )
                                .join("");
                        } else {
                            if (data.players.online > 0)
                                playerGrid.innerHTML =
                                    '<span class="text-[#AAAAAA]">Jugadores ocultos</span>';
                            else
                                playerGrid.innerHTML =
                                    '<span class="text-[#AAAAAA] text-xl">Nadie conectado :(</span>';
                        }
                    } else {
                        countElement.innerText = "Offline";
                        statusDot.classList.replace(
                            "bg-gray-500",
                            "bg-red-500",
                        );
                        playerGrid.innerHTML =
                            '<span class="text-red-500 text-xl">SERVIDOR APAGADO</span>';
                    }
                } catch (error) {
                    console.error("fetch error:", error);
                    countElement.innerText = "Error";
                }
            }

            fetchServerStatus();
            setInterval(fetchServerStatus, 300000);
            window.copyIp = copyIp;
        </script>
    </body>
</html>
