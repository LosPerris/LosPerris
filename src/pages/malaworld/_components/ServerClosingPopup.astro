---

---

<div
    id="shutdown-popup"
    class="fixed inset-0 z-100 flex items-center justify-center bg-black/80 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-1000"
>
    <div
        class="relative bg-black/90 border border-red-900/50 p-8 md:p-12 rounded-2xl max-w-2xl w-[90%] mx-auto text-center shadow-[0_0_50px_rgba(220,38,38,0.2)] overflow-hidden group"
    >
        <div
            class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-20"
        >
        </div>
        <div
            class="absolute -inset-1 bg-linear-to-r from-red-900/20 via-transparent to-red-900/20 animate-pulse"
        >
        </div>

        <div class="relative z-10 flex flex-col items-center gap-6">
            <div class="space-y-2">
                <h2
                    class="font-['Cinzel'] text-3xl md:text-5xl text-red-500 font-bold tracking-widest drop-shadow-[0_2px_10px_rgba(220,38,38,0.5)] uppercase"
                >
                    El Fin se Acerca
                </h2>
                <p
                    class="text-zinc-400 text-sm md:text-base tracking-[0.2em] uppercase font-bold"
                >
                    Cierre del Servidor
                </p>
            </div>

            <div
                class="grid grid-cols-4 gap-4 md:gap-8 w-full max-w-lg mx-auto py-6"
            >
                <div
                    class="flex flex-col items-center p-3 bg-red-950/20 rounded-lg border border-red-900/30"
                >
                    <span
                        id="sd-days"
                        class="text-3xl md:text-4xl font-bold text-white font-['Cinzel']"
                        >00</span
                    >
                    <span
                        class="text-[10px] md:text-xs text-red-400 uppercase tracking-wider mt-1"
                        >Días</span
                    >
                </div>
                <div
                    class="flex flex-col items-center p-3 bg-red-950/20 rounded-lg border border-red-900/30"
                >
                    <span
                        id="sd-hours"
                        class="text-3xl md:text-4xl font-bold text-white font-['Cinzel']"
                        >00</span
                    >
                    <span
                        class="text-[10px] md:text-xs text-red-400 uppercase tracking-wider mt-1"
                        >Hrs</span
                    >
                </div>
                <div
                    class="flex flex-col items-center p-3 bg-red-950/20 rounded-lg border border-red-900/30"
                >
                    <span
                        id="sd-minutes"
                        class="text-3xl md:text-4xl font-bold text-white font-['Cinzel']"
                        >00</span
                    >
                    <span
                        class="text-[10px] md:text-xs text-red-400 uppercase tracking-wider mt-1"
                        >Min</span
                    >
                </div>
                <div
                    class="flex flex-col items-center p-3 bg-red-950/20 rounded-lg border border-red-900/30"
                >
                    <span
                        id="sd-seconds"
                        class="text-3xl md:text-4xl font-bold text-white font-['Cinzel']"
                        >00</span
                    >
                    <span
                        class="text-[10px] md:text-xs text-red-400 uppercase tracking-wider mt-1"
                        >Seg</span
                    >
                </div>
            </div>

            <p class="text-zinc-500 text-sm italic max-w-md mx-auto">
                "Todo lo que tiene un principio tiene un final. Gracias por ser
                parte de esta historia."
            </p>

            <button
                id="close-shutdown-popup"
                class="mt-4 px-8 py-2 bg-red-900/20 hover:bg-red-900/40 text-red-400 border border-red-900/50 rounded transition-all duration-300 uppercase tracking-widest text-xs font-bold hover:shadow-[0_0_20px_rgba(220,38,38,0.3)]"
            >
                Entendido
            </button>
        </div>
    </div>
</div>

<script>
    const SHUTDOWN_DATE = new Date("2026-01-11T00:00:00-06:00").getTime();
    const STORAGE_KEY = "mw_shutdown_popup_seen_v1";

    function updateShutdownTimer() {
        const now = new Date().getTime();
        const distance = SHUTDOWN_DATE - now;

        const daysEl = document.getElementById("sd-days");
        const hoursEl = document.getElementById("sd-hours");
        const minutesEl = document.getElementById("sd-minutes");
        const secondsEl = document.getElementById("sd-seconds");

        if (!daysEl || !hoursEl || !minutesEl || !secondsEl) return;

        if (distance < 0) {
            daysEl.innerText = "00";
            hoursEl.innerText = "00";
            minutesEl.innerText = "00";
            secondsEl.innerText = "00";
            return;
        }

        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor(
            (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
        );
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        daysEl.innerText = days.toString().padStart(2, "0");
        hoursEl.innerText = hours.toString().padStart(2, "0");
        minutesEl.innerText = minutes.toString().padStart(2, "0");
        secondsEl.innerText = seconds.toString().padStart(2, "0");
    }

    const popup = document.getElementById("shutdown-popup");
    const closeBtn = document.getElementById("close-shutdown-popup");

    if (popup && closeBtn) {
        const seen = sessionStorage.getItem(STORAGE_KEY);

        if (!seen) {
            setTimeout(() => {
                popup.classList.remove("opacity-0", "pointer-events-none");
            }, 1000);
        }

        closeBtn.addEventListener("click", () => {
            popup.classList.add("opacity-0", "pointer-events-none");
            sessionStorage.setItem(STORAGE_KEY, "true");
        });

        setInterval(updateShutdownTimer, 1000);
        updateShutdownTimer();
    }
</script>
