<div
    id="rewind-overlay"
    class="fixed inset-0 z-100 flex items-center justify-center bg-black/90 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-1000"
>
    <div
        id="rewind-card"
        class="relative w-full max-w-lg mx-4 bg-[#0a0a0a] border border-zinc-800 rounded-2xl overflow-hidden shadow-[0_0_50px_rgba(0,0,0,0.5)] transform scale-90 transition-transform duration-500 min-h-[500px] flex flex-col"
    >
        <div
            class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-20"
        >
        </div>
        <div
            id="slide-bg"
            class="absolute inset-0 transition-colors duration-700 bg-linear-to-b from-black via-transparent to-black"
        >
        </div>

        <div class="snowflakes opacity-30" aria-hidden="true">
            <div class="snowflake">❅</div>
            <div class="snowflake">•</div>
            <div class="snowflake">.</div>
            <div class="snowflake">✦</div>
            <div class="snowflake">❅</div>
            <div class="snowflake">•</div>
            <div class="snowflake">.</div>
            <div class="snowflake">✦</div>
        </div>

        <button
            onclick="closeRewind()"
            class="absolute top-4 right-4 z-50 text-zinc-500 hover:text-white transition-colors"
        >
            <i class="fas fa-times text-xl"></i>
        </button>

        <div
            class="relative z-10 grow flex flex-col p-8 items-center justify-center text-center h-full"
        >
            <div id="rewind-loading" class="flex flex-col items-center">
                <div
                    class="w-12 h-12 border-4 border-[#7df9ff] border-t-transparent rounded-full animate-spin mb-6 shadow-[0_0_15px_#7df9ff]"
                >
                </div>
                <p
                    class="font-['Cinzel'] text-[#7df9ff] tracking-widest animate-pulse"
                >
                    Sincronizando Archivos...
                </p>
            </div>

            <div
                id="rewind-selection"
                class="hidden w-full h-full flex-col justify-center"
            >
                <h2 class="font-['Cinzel'] text-2xl text-zinc-300 mb-8">
                    ¿Quién eres, viajero?
                </h2>
                <div
                    id="rewind-candidates"
                    class="flex flex-wrap justify-center gap-6"
                >
                </div>
            </div>

            <div id="rewind-slides" class="hidden w-full h-full relative">
                <div
                    class="slide absolute inset-0 flex flex-col items-center justify-center transition-all duration-500 opacity-0 translate-x-10 pointer-events-none pb-20"
                    data-index="0"
                >
                    <h1
                        class="font-['Cinzel'] text-5xl md:text-6xl text-white mb-6 drop-shadow-[0_0_10px_white]"
                    >
                        REWIND<br /><span class="text-[#7df9ff]">2025</span>
                    </h1>
                    <p
                        class="text-zinc-400 tracking-widest uppercase mb-12 text-sm"
                    >
                        MalaWorld Server
                    </p>
                    <button
                        onclick="nextSlide()"
                        class="px-8 py-3 bg-white text-black font-bold uppercase tracking-widest hover:bg-[#7df9ff] hover:scale-105 transition-all rounded-full shadow-lg"
                    >
                        Ver mi año
                    </button>
                </div>

                <div
                    class="slide absolute inset-0 flex flex-col items-center transition-all duration-500 opacity-0 translate-x-10 pointer-events-none p-4"
                    data-index="1"
                >
                    <div
                        class="grow flex flex-col items-center justify-center w-full"
                    >
                        <div class="text-red-500 text-6xl mb-6 animate-bounce">
                            <i class="fas fa-skull"></i>
                        </div>
                        <h2 class="font-['Cinzel'] text-3xl text-red-100 mb-2">
                            EL GUERRERO
                        </h2>
                        <div class="w-16 h-1 bg-red-600 mb-8 rounded-full">
                        </div>

                        <div class="space-y-6 w-full max-w-xs">
                            <div
                                class="bg-black/40 border border-red-900/50 p-4 rounded-xl backdrop-blur-sm"
                            >
                                <p
                                    class="text-xs text-red-400 uppercase tracking-widest mb-1"
                                >
                                    Enemigos Eliminados
                                </p>
                                <p
                                    id="stat-pvp"
                                    class="text-4xl font-bold text-white"
                                >
                                    0
                                </p>
                            </div>
                            <div
                                class="bg-black/40 border border-red-900/50 p-4 rounded-xl backdrop-blur-sm"
                            >
                                <p
                                    class="text-xs text-red-400 uppercase tracking-widest mb-1"
                                >
                                    Veces que caíste
                                </p>
                                <p
                                    id="stat-deaths"
                                    class="text-4xl font-bold text-white"
                                >
                                    0
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="w-full flex justify-center pb-20 shrink-0">
                        <div
                            id="msg-combat"
                            class="w-full max-w-[90%] text-center min-h-[3em] max-h-[6em] overflow-y-auto bg-red-950/40 px-4 py-2 rounded-lg border border-red-500/30 shadow-[0_0_15px_rgba(255,0,0,0.1)] text-balance z-10 custom-scrollbar"
                            style="overflow-wrap: break-word;"
                        >
                        </div>
                    </div>
                </div>

                <div
                    class="slide absolute inset-0 flex flex-col items-center transition-all duration-500 opacity-0 translate-x-10 pointer-events-none p-4"
                    data-index="2"
                >
                    <div
                        class="grow flex flex-col items-center justify-center w-full"
                    >
                        <div
                            class="text-emerald-400 text-6xl mb-6 animate-pulse"
                        >
                            <i class="fas fa-clock"></i>
                        </div>
                        <h2
                            class="font-['Cinzel'] text-3xl text-emerald-100 mb-2"
                        >
                            LA DEDICACIÓN
                        </h2>
                        <div class="w-16 h-1 bg-emerald-500 mb-8 rounded-full">
                        </div>

                        <div class="space-y-6 w-full max-w-xs">
                            <div
                                class="bg-black/40 border border-emerald-900/50 p-4 rounded-xl backdrop-blur-sm"
                            >
                                <p
                                    class="text-xs text-emerald-400 uppercase tracking-widest mb-1"
                                >
                                    Tiempo en el reino
                                </p>
                                <p
                                    id="stat-hours"
                                    class="text-4xl font-bold text-white"
                                >
                                    0h
                                </p>
                            </div>
                            <div
                                class="bg-black/40 border border-emerald-900/50 p-4 rounded-xl backdrop-blur-sm"
                            >
                                <p
                                    class="text-xs text-emerald-400 uppercase tracking-widest mb-1"
                                >
                                    Mobs Aniquilados
                                </p>
                                <p
                                    id="stat-mobs"
                                    class="text-4xl font-bold text-white"
                                >
                                    0
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="w-full flex justify-center pb-20 shrink-0">
                        <div
                            id="msg-grind"
                            class="w-full max-w-[90%] text-center min-h-[3em] max-h-[6em] overflow-y-auto bg-emerald-950/40 px-4 py-2 rounded-lg border border-emerald-500/30 shadow-[0_0_15px_rgba(16,185,129,0.1)] text-balance z-10 custom-scrollbar"
                            style="overflow-wrap: break-word;"
                        >
                        </div>
                    </div>
                </div>

                <div
                    class="slide absolute inset-0 flex flex-col items-center justify-center transition-all duration-500 opacity-0 translate-x-10 pointer-events-none p-6 pb-20"
                    data-index="3"
                >
                    <div class="relative w-20 h-20 mb-3 shrink-0">
                        <img
                            id="rewind-avatar"
                            src=""
                            class="w-full h-full rounded-xl border-2 border-[#ffd700] shadow-[0_0_20px_#ffd700]"
                        />
                        <div
                            class="absolute -bottom-2 -right-2 bg-black border border-[#ffd700] text-[#ffd700] text-[10px] px-1.5 py-0.5 rounded font-bold"
                        >
                            2025
                        </div>
                    </div>

                    <h2
                        id="rewind-name"
                        class="font-['Cinzel'] text-2xl text-[#ffd700] mb-1 drop-shadow-md shrink-0"
                    >
                        Jugador
                    </h2>
                    <p
                        id="rewind-role"
                        class="text-zinc-400 italic text-xs mb-4 shrink-0"
                    >
                        "El Viajero Legendario"
                    </p>

                    <div class="w-full max-w-sm text-center mb-4 px-2 shrink-0">
                        <p
                            id="rewind-personal-msg"
                            class="text-zinc-300 text-xs italic mb-3 leading-tight"
                        >
                        </p>
                        <div
                            id="rewind-ponss-msg"
                            class="text-[10px] text-zinc-500 font-serif border-t border-zinc-800 pt-2 leading-tight"
                        >
                        </div>
                    </div>

                    <div
                        class="grid grid-cols-2 gap-2 w-full max-w-[280px] mb-6 shrink-0"
                    >
                        <div
                            class="p-1.5 bg-white/5 rounded border border-white/10 text-center"
                        >
                            <span
                                class="block text-[8px] text-zinc-500 uppercase"
                                >Kills</span
                            >
                            <span
                                id="sum-pvp"
                                class="text-white font-bold text-sm">0</span
                            >
                        </div>
                        <div
                            class="p-1.5 bg-white/5 rounded border border-white/10 text-center"
                        >
                            <span
                                class="block text-[8px] text-zinc-500 uppercase"
                                >Muertes</span
                            >
                            <span
                                id="sum-deaths"
                                class="text-white font-bold text-sm">0</span
                            >
                        </div>
                        <div
                            class="p-1.5 bg-white/5 rounded border border-white/10 text-center"
                        >
                            <span
                                class="block text-[8px] text-zinc-500 uppercase"
                                >Mobs</span
                            >
                            <span
                                id="sum-mobs"
                                class="text-white font-bold text-sm">0</span
                            >
                        </div>
                        <div
                            class="p-1.5 bg-white/5 rounded border border-white/10 text-center"
                        >
                            <span
                                class="block text-[8px] text-zinc-500 uppercase"
                                >Horas</span
                            >
                            <span
                                id="sum-hours"
                                class="text-white font-bold text-sm">0h</span
                            >
                        </div>
                    </div>
                </div>

                <div
                    class="absolute bottom-2 right-4 text-[9px] text-zinc-700 font-mono z-10"
                >
                    #MalaWorldRewind
                </div>
            </div>
        </div>

        <div
            id="rewind-controls"
            class="hidden absolute top-1/2 -translate-y-1/2 w-full px-4 justify-between items-center z-110 pointer-events-none"
        >
            <button
                onclick="prevSlide()"
                class="pointer-events-auto text-white/50 hover:text-white hover:scale-110 transition-all p-4 absolute -left-16"
                ><i
                    class="fas fa-chevron-left text-4xl shadow-xl drop-shadow-lg"
                ></i></button
            >
            <div
                class="flex gap-2 absolute bottom-4 left-1/2 -translate-x-1/2"
                id="rewind-dots"
            >
            </div>

            <button
                onclick="nextSlide()"
                class="pointer-events-auto text-white/50 hover:text-white hover:scale-110 transition-all p-4 absolute -right-16"
                ><i
                    class="fas fa-chevron-right text-4xl shadow-xl drop-shadow-lg"
                ></i></button
            >
        </div>
    </div>

    <style>
        .slide.active {
            opacity: 1;
            transform: translateX(0);
            pointer-events: auto;
        }
        .slide.prev {
            opacity: 0;
            transform: translateX(-50px);
            pointer-events: none;
        }
        .slide.next {
            opacity: 0;
            transform: translateX(50px);
            pointer-events: none;
        }

        .snowflake {
            position: absolute;
            top: -10%;
            z-index: 10;
            color: white;
            user-select: none;
            animation-name: fall;
            animation-duration: 10s;
            animation-timing-function: linear;
            animation-iteration-count: infinite;
        }
        @keyframes fall {
            100% {
                top: 100%;
            }
        }
        .snowflake:nth-child(1) {
            left: 10%;
            animation-delay: 0s;
            font-size: 1em;
            opacity: 0.5;
        }
        .snowflake:nth-child(2) {
            left: 30%;
            animation-delay: 2s;
            font-size: 0.5em;
            opacity: 0.3;
        }
        .snowflake:nth-child(3) {
            left: 70%;
            animation-delay: 4s;
            font-size: 0.8em;
            opacity: 0.6;
        }
    </style>

    <script is:inline>
        const TOTAL_SLIDES = 4;
        let currentSlideIdx = 0;
        let rewindData = null;

        async function initRewind() {
            const lastSeen = localStorage.getItem("mw_rewind_seen_v2");
            if (lastSeen && Date.now() - parseInt(lastSeen) < 3600000 * 2)
                return;

            const overlay = document.getElementById("rewind-overlay");
            const card = document.getElementById("rewind-card");
            const loading = document.getElementById("rewind-loading");

            try {
                overlay.classList.remove("opacity-0", "pointer-events-none");
                card.classList.remove("scale-90");
                card.classList.add("scale-100");

                const res = await fetch("/malaworld/api/identify");
                if (!res.ok) throw new Error("API Error");
                const data = await res.json();
                const candidates = data.candidates || [];

                loading.classList.add("hidden");

                if (candidates.length > 1) {
                    showSelection(candidates);
                } else if (candidates.length === 1) {
                    startExperience(candidates[0]);
                } else {
                    startExperience({
                        name: "Viajero",
                        skin: "MHF_Steve",
                        mob_kills: 0,
                        deaths: 0,
                        hours_played: 0,
                        player_kills: 0,
                        is_generic: true,
                        ip: data.ip,
                    });
                }
            } catch (e) {
                console.error(e);
                closeRewind();
            }
        }

        function showSelection(candidates) {
            const selDiv = document.getElementById("rewind-selection");
            const cont = document.getElementById("rewind-candidates");
            selDiv.classList.remove("hidden");
            selDiv.classList.add("flex");

            cont.innerHTML = candidates
                .map(
                    (p, i) => `
            <div onclick="selectRewindUser(${i})" class="cursor-pointer group flex flex-col items-center gap-3">
                <img src="${p.skin}" class="w-20 h-20 rounded-full border-2 border-zinc-700 group-hover:border-[#7df9ff] transition-all shadow-lg" />
                 <span class="text-zinc-400 font-bold group-hover:text-white transition-colors">${p.name}</span>
            </div>
        `,
                )
                .join("");

            window.tempCandidates = candidates;
        }

        window.selectRewindUser = (i) => {
            document.getElementById("rewind-selection").classList.add("hidden");
            startExperience(window.tempCandidates[i]);
        };

        function startExperience(user) {
            rewindData = user;
            document.getElementById("rewind-slides").classList.remove("hidden");
            document
                .getElementById("rewind-controls")
                .classList.remove("hidden");
            document.getElementById("rewind-controls").classList.add("flex");

            populateData(user);
            updateSlideUI();
        }

        function populateData(user) {
            document.getElementById("stat-pvp").innerText =
                user.player_kills || 0;
            document.getElementById("stat-deaths").innerText = user.deaths || 0;
            document.getElementById("stat-mobs").innerText =
                user.mob_kills || 0;
            document.getElementById("stat-hours").innerText =
                Math.floor(user.hours_played || 0) + "h";
            document.getElementById("rewind-avatar").src = user.is_generic
                ? `https://mc-heads.net/avatar/${user.skin}`
                : user.skin;
            document.getElementById("rewind-name").innerText = user.name;
            document.getElementById("sum-pvp").innerText =
                user.player_kills || 0;
            document.getElementById("sum-deaths").innerText = user.deaths || 0;
            document.getElementById("sum-mobs").innerText = user.mob_kills || 0;
            document.getElementById("sum-hours").innerText =
                Math.floor(user.hours_played || 0) + "h";

            let msgCombat = "Tu historia aún es pacifica... por ahora.";
            if (user.player_kills > 20) {
                msgCombat =
                    "¡Una amenaza real! Tus enemigos tiemblan al oír tu nombre.";
            } else if (user.deaths > 50) {
                msgCombat =
                    "Has conocido el suelo muchas veces, pero tu determinación es de hierro.";
            } else if (user.player_kills > 5) {
                msgCombat =
                    "Un guerrero prudente que sabe cuándo desenvainar la espada.";
            }

            let msgGrind = "Disfrutando del paisaje a tu propio ritmo.";
            if (user.hours_played > 100) {
                msgGrind =
                    "MalaWorld es tu segunda casa. ¡Quizás deberías ver el sol real un rato!";
            } else if (user.mob_kills > 2000) {
                msgGrind =
                    "Eres la pesadilla del ecosistema. Los mobs cuentan historias de terror sobre ti.";
            } else if (user.hours_played > 20) {
                msgGrind =
                    "Un habitante constante que contribuye al mundo día a día.";
            }

            if (user.is_generic) {
                msgCombat = "Tus batallas ocurrieron en las sombras.";
                msgGrind = "Tu tiempo aquí es un misterio para nosotros.";
            }

            document.getElementById("msg-combat").innerText = `"${msgCombat}"`;
            document.getElementById("msg-grind").innerText = `"${msgGrind}"`;

            let role = "El Viajero Silencioso";
            if (user.player_kills > 50) role = "El Señor de la Guerra";
            else if (user.mob_kills > 5000) role = "El Cazador Supremo";
            else if (user.hours_played > 100) role = "El Guardián Eterno";
            else if (user.deaths > 100) role = "El Renacido";

            if (user.is_generic) role = "Visitante Desconocido";

            let personalMsg = "Tu presencia en MalaWorld ha dejado huella...";
            if (user.player_kills > 50) {
                personalMsg =
                    "Tu espada ha cantado la canción de la victoria más veces de las que podemos contar. Eres el terror de los que osan cruzarse en tu camino.";
            } else if (user.mob_kills > 5000) {
                personalMsg =
                    "Los ecos de miles de monstruos derrotados resuenan en tu historia. Eres el guardián que mantiene la oscuridad a raya.";
            } else if (user.hours_played > 100) {
                personalMsg =
                    "Has hecho de este mundo tu verdadero hogar. Cada bloque, cada bioma, conoce el peso de tus pasos y tu dedicación inquebrantable.";
            } else if (user.deaths > 100) {
                personalMsg =
                    "La muerte no es el final, sino una lección. Tu determinación para levantarte una y otra vez es lo que te hace verdaderamente inmortal.";
            } else {
                personalMsg =
                    "Tu aventura apenas comienza, pero el destino te aguarda con grandes hazañas. ¡El 2026 será tu año para conquistar!";
            }

            if (user.is_generic)
                personalMsg =
                    "Aunque viajaste entre las sombras, tu visita nos honra. ¡Esperamos ver tu verdadero rostro en el nuevo año!";

            document.getElementById("rewind-role").innerText = `"${role}"`;
            document.getElementById("rewind-personal-msg").innerText =
                personalMsg;
            document.getElementById("rewind-ponss-msg").innerHTML = `
            <span class="block text-[#7df9ff] mb-1">✨ De parte de Ponss:</span>
            "¡Gracias por ser parte de esta locura un año más! Que esta Navidad esté llena de bloques de diamante y el 2026 traiga las construcciones más épicas de tu vida."
        `;
        }

        function updateSlideUI() {
            const slides = document.querySelectorAll(".slide");
            const bg = document.getElementById("slide-bg");
            const dots = document.getElementById("rewind-dots");

            slides.forEach((s) => {
                const idx = parseInt(s.dataset.index);
                s.className =
                    "slide absolute inset-0 flex flex-col items-center justify-center transition-all duration-500 pointer-events-none opacity-0";

                if (idx === currentSlideIdx) {
                    s.classList.add("active");
                } else if (idx < currentSlideIdx) {
                    s.classList.add("prev");
                } else {
                    s.classList.add("next");
                }
            });

            if (currentSlideIdx === 0)
                bg.className =
                    "absolute inset-0 transition-colors duration-700 bg-linear-to-b from-black via-[#0a0a0a] to-black";
            if (currentSlideIdx === 1)
                bg.className =
                    "absolute inset-0 transition-colors duration-700 bg-linear-to-b from-[#220000] via-[#110000] to-black";
            if (currentSlideIdx === 2)
                bg.className =
                    "absolute inset-0 transition-colors duration-700 bg-linear-to-b from-[#001100] via-[#002211] to-black";
            if (currentSlideIdx === 3)
                bg.className =
                    "absolute inset-0 transition-colors duration-700 bg-linear-to-b from-[#111] via-[#222100] to-black";

            const nav = document.getElementById("rewind-controls");
            if (currentSlideIdx === 0) nav.style.opacity = "0";
            else nav.style.opacity = "1";

            dots.innerHTML = Array(TOTAL_SLIDES)
                .fill(0)
                .map(
                    (_, i) => `
            <div class="w-2 h-2 rounded-full transition-all ${i === currentSlideIdx ? "bg-white scale-125" : "bg-zinc-700"}"></div>
        `,
                )
                .join("");
        }

        window.nextSlide = () => {
            if (currentSlideIdx < TOTAL_SLIDES - 1) {
                currentSlideIdx++;
                updateSlideUI();
            }
        };

        window.prevSlide = () => {
            if (currentSlideIdx > 0) {
                currentSlideIdx--;
                updateSlideUI();
            }
        };

        window.closeRewind = () => {
            const overlay = document.getElementById("rewind-overlay");
            const card = document.getElementById("rewind-card");
            overlay.classList.add("opacity-0", "pointer-events-none");
            card.classList.remove("scale-100");
            card.classList.add("scale-90");
            localStorage.setItem("mw_rewind_seen_v2", Date.now().toString());
        };

        setTimeout(initRewind, 1500);
    </script>
</div>
