<section id="scoreboard" class="py-20 relative px-6 md:px-12">
    <div class="max-w-7xl mx-auto z-10 relative">
        <h2
            class="text-4xl md:text-5xl font-['Cinzel'] text-center mb-12 text-[#e3dac9] drop-shadow-[0_2px_4px_black]"
        >
            <span class="text-[#7df9ff]">TOP</span> JUGADORES
        </h2>

        <div
            class="flex flex-wrap justify-center gap-4 mb-10"
            id="stats-toggles"
        >
            <button
                data-stat="mob_kills"
                class="stat-btn active px-6 py-2 bg-black/50 border border-[#7df9ff]/30 text-[#7df9ff] rounded-full uppercase tracking-widest text-sm font-bold hover:bg-[#7df9ff]/10 transition-all duration-300"
            >
                Mobs Asesinados
            </button>
            <button
                data-stat="player_kills"
                class="stat-btn px-6 py-2 bg-black/50 border border-zinc-700 text-zinc-400 rounded-full uppercase tracking-widest text-sm font-bold hover:text-white transition-all duration-300"
            >
                Asesinatos
            </button>
            <button
                data-stat="deaths"
                class="stat-btn px-6 py-2 bg-black/50 border border-zinc-700 text-zinc-400 rounded-full uppercase tracking-widest text-sm font-bold hover:text-white transition-all duration-300"
            >
                Muertes
            </button>
            <button
                data-stat="hours_played"
                class="stat-btn px-6 py-2 bg-black/50 border border-zinc-700 text-zinc-400 rounded-full uppercase tracking-widest text-sm font-bold hover:text-white transition-all duration-300"
            >
                Tiempo Jugado
            </button>
        </div>

        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
            id="scoreboard-grid"
        >
            <!-- Renderizado por JS -->
            <div class="col-span-full text-center py-10">
                <div
                    class="inline-block w-8 h-8 border-2 border-[#7df9ff] border-t-transparent rounded-full animate-spin"
                >
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .stat-btn.active {
        background-color: rgba(125, 249, 255, 0.1);
        border-color: #7df9ff;
        color: #7df9ff;
        box-shadow: 0 0 15px rgba(125, 249, 255, 0.2);
    }
</style>

<script>
    interface PlayerData {
        uuid: string;
        name: string;
        deaths: number;
        player_kills: number;
        mob_kills: number;
        hours_played: number;
        skin: string;
        [key: string]: any;
    }

    let allStats: Record<string, PlayerData> = {};

    async function loadStats() {
        const grid = document.getElementById("scoreboard-grid");
        if (!grid) return;

        try {
            const res = await fetch("/malaworld/api/scoreboard");
            if (!res.ok) throw new Error("Error al cargar stats");
            allStats = await res.json();
            renderScoreboard("mob_kills");
        } catch (e) {
            console.error(e);
            grid.innerHTML = `
                <div class="col-span-full text-center text-red-400 border border-red-900/30 bg-black/50 p-4 rounded-xl">
                    Error al cargar los datos del ranking.
                </div>
            `;
        }
    }

    function renderScoreboard(criteria: string) {
        const grid = document.getElementById("scoreboard-grid");
        if (!grid) return;

        const players = Object.values(allStats) as PlayerData[];

        const sorted = players
            .sort((a, b) => b[criteria] - a[criteria])
            .slice(0, 9);

        grid.innerHTML = sorted
            .map((player, index) => {
                let val = player[criteria];
                if (criteria === "hours_played") {
                    val = parseFloat(val).toFixed(1) + " h";
                }

                const rankColor =
                    index === 0
                        ? "text-yellow-400"
                        : index === 1
                          ? "text-gray-300"
                          : index === 2
                            ? "text-amber-600"
                            : "text-[#7df9ff]";

                const borderClass =
                    index === 0
                        ? "border-yellow-500/50 shadow-[0_0_20px_rgba(234,179,8,0.2)]"
                        : "border-zinc-800 hover:border-[#7df9ff]/50";

                return `
                <div class="flex items-center gap-4 bg-[#0a0a0a]/80 backdrop-blur-sm border ${borderClass} p-4 rounded-xl transition-all duration-300 hover:-translate-y-1">
                    <div class="font-['Cinzel'] text-2xl font-bold w-8 text-center ${rankColor}">#${index + 1}</div>
                    
                    <div class="relative w-12 h-12 rounded-lg overflow-hidden border border-zinc-700">
                        <img src="${player.skin}" alt="${player.name}" class="w-full h-full object-cover">
                    </div>
                    
                    <div class="flex-grow">
                        <h3 class="font-bold text-[#e3dac9] tracking-wider">${player.name}</h3>
                        <p class="text-xs text-zinc-500 uppercase tracking-widest">
                             ${formatLabel(criteria)}
                        </p>
                    </div>

                    <div class="text-xl font-bold text-[#7df9ff] font-mono">
                        ${val}
                    </div>
                </div>
            `;
            })
            .join("");
    }

    function formatLabel(key: string) {
        switch (key) {
            case "mob_kills":
                return "Mobs";
            case "player_kills":
                return "Kilis";
            case "deaths":
                return "Muertes";
            case "hours_played":
                return "Tiempo";
            default:
                return "";
        }
    }

    document.querySelectorAll(".stat-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
            const target = btn as HTMLElement;
            document
                .querySelectorAll(".stat-btn")
                .forEach((b) => b.classList.remove("active"));
            target.classList.add("active");
            if (target.dataset.stat) {
                renderScoreboard(target.dataset.stat);
            }
        });
    });

    document.addEventListener("DOMContentLoaded", loadStats);
</script>
