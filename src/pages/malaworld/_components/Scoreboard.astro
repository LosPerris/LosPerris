<section id="scoreboard" class="py-20 relative px-6 md:px-12">
    <div class="max-w-5xl mx-auto z-10 relative">
        <h2
            class="text-4xl md:text-5xl font-['Cinzel'] text-center mb-12 text-[#e3dac9] drop-shadow-[0_2px_4px_black]"
        >
            <span class="text-[#7df9ff]">TOP</span> JUGADORES
        </h2>

        <div
            class="flex flex-wrap justify-center gap-4 mb-10"
            id="stats-toggles"
        >
            <button
                data-stat="mob_kills"
                class="stat-btn active px-6 py-2 bg-black/50 border border-[#7df9ff]/30 text-[#7df9ff] rounded-full uppercase tracking-widest text-sm font-bold hover:bg-[#7df9ff]/10 transition-all duration-300"
            >
                Mobs
            </button>
            <button
                data-stat="player_kills"
                class="stat-btn px-6 py-2 bg-black/50 border border-zinc-700 text-zinc-400 rounded-full uppercase tracking-widest text-sm font-bold hover:text-white transition-all duration-300"
            >
                Kills
            </button>
            <button
                data-stat="deaths"
                class="stat-btn px-6 py-2 bg-black/50 border border-zinc-700 text-zinc-400 rounded-full uppercase tracking-widest text-sm font-bold hover:text-white transition-all duration-300"
            >
                Muertes
            </button>
            <button
                data-stat="hours_played"
                class="stat-btn px-6 py-2 bg-black/50 border border-zinc-700 text-zinc-400 rounded-full uppercase tracking-widest text-sm font-bold hover:text-white transition-all duration-300"
            >
                Tiempo
            </button>
        </div>

        <div
            class="overflow-x-auto rounded-xl border border-zinc-800 bg-[#0a0a0a]/80 backdrop-blur-sm shadow-2xl"
        >
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr
                        class="bg-black/60 text-[#7df9ff] text-xs uppercase tracking-widest border-b border-zinc-800"
                    >
                        <th class="p-4 text-center w-20">#</th>
                        <th class="p-4 w-20">Skin</th>
                        <th class="p-4">Jugador</th>
                        <th class="p-4 text-right" id="stat-header">Valor</th>
                    </tr>
                </thead>
                <tbody id="scoreboard-body" class="divide-y divide-zinc-800/50">
                    <tr>
                        <td colspan="4" class="p-10 text-center">
                            <div
                                class="inline-block w-8 h-8 border-2 border-[#7df9ff] border-t-transparent rounded-full animate-spin"
                            >
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="text-right mt-4 text-xs text-zinc-600 font-mono">
            Actualización automática: <span id="next-update">02:00</span>
        </div>
    </div>
</section>

<style>
    .stat-btn.active {
        background-color: rgba(125, 249, 255, 0.1);
        border-color: #7df9ff;
        color: #7df9ff;
        box-shadow: 0 0 15px rgba(125, 249, 255, 0.2);
    }

    tr:hover td {
        background-color: rgba(255, 255, 255, 0.02);
    }
</style>

<script>
    interface PlayerData {
        uuid: string;
        name: string;
        deaths: number;
        player_kills: number;
        mob_kills: number;
        hours_played: number;
        skin: string;
        [key: string]: any;
    }

    let allStats: Record<string, PlayerData> = {};
    let currentCriteria = "mob_kills";
    const REFRESH_RATE = 120; // 120 segundos
    let timerInterval: any;

    async function loadStats() {
        const tbody = document.getElementById("scoreboard-body");
        if (!tbody) return;

        try {
            if (Object.keys(allStats).length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="4" class="p-10 text-center">
                            <div class="inline-block w-8 h-8 border-2 border-[#7df9ff] border-t-transparent rounded-full animate-spin"></div>
                        </td>
                    </tr>
                `;
            }

            const res = await fetch("/malaworld/api/scoreboard");
            if (!res.ok) throw new Error("Error al cargar stats");
            allStats = await res.json();
            renderScoreboard(currentCriteria);
            startTimer();
        } catch (e) {
            console.error(e);
            if (Object.keys(allStats).length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="4" class="p-8 text-center text-red-500">
                            Error al cargar los datos. Reintentando...
                        </td>
                    </tr>
                `;
            }
        }
    }

    function renderScoreboard(criteria: string) {
        currentCriteria = criteria;
        const tbody = document.getElementById("scoreboard-body");
        const header = document.getElementById("stat-header");
        if (!tbody || !header) return;

        header.innerText = formatLabel(criteria).toUpperCase();

        const players = Object.values(allStats) as PlayerData[];
        const sorted = players
            .sort((a, b) => b[criteria] - a[criteria])
            .slice(0, 10);

        tbody.innerHTML = sorted
            .map((player, index) => {
                let val = player[criteria];
                if (criteria === "hours_played") {
                    val = parseFloat(val).toFixed(1) + " h";
                }

                const rankColor =
                    index === 0
                        ? "text-yellow-400"
                        : index === 1
                          ? "text-gray-300"
                          : index === 2
                            ? "text-amber-600"
                            : "text-[#7df9ff]";

                const fontClass = index < 3 ? "font-bold" : "font-normal";
                const rowClass = index < 3 ? "bg-[#7df9ff]/5" : "";

                return `
                <tr class="transition-colors duration-200 ${rowClass}">
                    <td class="p-4 text-center font-['Cinzel'] text-xl ${rankColor} ${fontClass}">
                        #${index + 1}
                    </td>
                    <td class="p-4">
                        <div class="w-10 h-10 rounded overflow-hidden border border-zinc-700 bg-black">
                            <img src="${player.skin}" alt="${player.name}" class="w-full h-full object-cover">
                        </div>
                    </td>
                    <td class="p-4">
                        <span class="text-[#e3dac9] font-['Josefin_Sans'] tracking-wider ${fontClass}">${player.name}</span>
                    </td>
                    <td class="p-4 text-right font-mono text-[#7df9ff] text-lg">
                        ${val}
                    </td>
                </tr>
            `;
            })
            .join("");
    }

    function formatLabel(key: string) {
        switch (key) {
            case "mob_kills":
                return "Mobs Asesinados";
            case "player_kills":
                return "Asesinatos";
            case "deaths":
                return "Muertes";
            case "hours_played":
                return "Tiempo Jugado";
            default:
                return "";
        }
    }

    function startTimer() {
        const timerEl = document.getElementById("next-update");
        if (!timerEl) return;

        clearInterval(timerInterval);

        let secondsLeft = REFRESH_RATE;

        const updateDisplay = () => {
            const m = Math.floor(secondsLeft / 60)
                .toString()
                .padStart(2, "0");
            const s = (secondsLeft % 60).toString().padStart(2, "0");
            timerEl.innerText = `${m}:${s}`;
        };

        updateDisplay();

        timerInterval = setInterval(() => {
            secondsLeft--;
            if (secondsLeft <= 0) {
                loadStats();
                secondsLeft = REFRESH_RATE;
            }
            updateDisplay();
        }, 1000);
    }

    document.querySelectorAll(".stat-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
            const target = btn as HTMLElement;
            document
                .querySelectorAll(".stat-btn")
                .forEach((b) => b.classList.remove("active"));
            target.classList.add("active");
            if (target.dataset.stat) {
                renderScoreboard(target.dataset.stat);
            }
        });
    });

    document.addEventListener("DOMContentLoaded", loadStats);
</script>
