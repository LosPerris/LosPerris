<section id="scoreboard" class="py-20 relative px-6 md:px-12">
    <div class="max-w-5xl mx-auto z-10 relative">
        <h2
            class="text-4xl md:text-5xl font-['Cinzel'] text-center mb-12 text-[#e3dac9] drop-shadow-[0_2px_4px_black]"
        >
            <span class="text-[#7df9ff]">TOP</span> JUGADORES
        </h2>

        <div
            class="flex flex-wrap justify-center gap-4 mb-10"
            id="stats-toggles"
        >
            <button
                data-stat="mob_kills"
                class="stat-btn active px-6 py-2 bg-black/50 border border-[#7df9ff]/30 text-[#7df9ff] rounded-full uppercase tracking-widest text-sm font-bold hover:bg-[#7df9ff]/10 transition-all duration-300"
            >
                Mobs
            </button>
            <button
                data-stat="player_kills"
                class="stat-btn px-6 py-2 bg-black/50 border border-zinc-700 text-zinc-400 rounded-full uppercase tracking-widest text-sm font-bold hover:text-white transition-all duration-300"
            >
                Kills
            </button>
            <button
                data-stat="deaths"
                class="stat-btn px-6 py-2 bg-black/50 border border-zinc-700 text-zinc-400 rounded-full uppercase tracking-widest text-sm font-bold hover:text-white transition-all duration-300"
            >
                Muertes
            </button>
            <button
                data-stat="hours_played"
                class="stat-btn px-6 py-2 bg-black/50 border border-zinc-700 text-zinc-400 rounded-full uppercase tracking-widest text-sm font-bold hover:text-white transition-all duration-300"
            >
                Tiempo
            </button>
        </div>

        <div
            class="overflow-hidden rounded-2xl border border-[#7df9ff]/20 bg-[#0a0a0a]/90 backdrop-blur-xl shadow-[0_0_30px_rgba(0,0,0,0.5)] relative group"
        >
            <div
                class="absolute inset-0 bg-linear-to-b from-[#7df9ff]/5 to-transparent pointer-events-none"
            >
            </div>

            <table class="w-full text-left border-collapse relative z-10">
                <thead>
                    <tr
                        class="bg-linear-to-r from-black via-[#0f0f0f] to-black text-[#7df9ff] text-xs uppercase tracking-[0.2em] border-b border-[#7df9ff]/20"
                    >
                        <th class="p-6 text-center w-24">Pos</th>
                        <th class="p-6 w-24 text-center">Avatar</th>
                        <th class="p-6">Jugador</th>
                        <th class="p-6 text-right" id="stat-header">Valor</th>
                    </tr>
                </thead>
                <tbody
                    id="scoreboard-body"
                    class="divide-y divide-[#7df9ff]/10"
                >
                    <tr>
                        <td colspan="4" class="p-16 text-center">
                            <div
                                class="inline-block w-10 h-10 border-2 border-[#7df9ff] border-t-transparent rounded-full animate-spin shadow-[0_0_15px_#7df9ff]"
                            >
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div
            class="flex flex-col md:flex-row justify-between items-center mt-6 px-4 gap-4"
        >
            <div
                class="text-xs text-[#7df9ff]/40 font-mono tracking-widest uppercase"
            >
                MalaWorld Stats System v1.0
            </div>
            <div
                class="flex items-center gap-3 bg-[#7df9ff]/10 px-4 py-2 rounded-full border border-[#7df9ff]/30 shadow-[0_0_15px_rgba(125,249,255,0.1)]"
            >
                <div
                    class="w-2 h-2 rounded-full bg-[#7df9ff] animate-pulse shadow-[0_0_10px_#7df9ff]"
                >
                </div>
                <span class="text-sm text-[#e3dac9] font-['Josefin_Sans']"
                    >Actualización en:</span
                >
                <span
                    id="next-update"
                    class="text-lg font-mono font-bold text-[#7df9ff]"
                    >02:00</span
                >
            </div>
        </div>
    </div>
</section>

<style>
    .stat-btn.active {
        background: linear-gradient(
            135deg,
            rgba(125, 249, 255, 0.1) 0%,
            rgba(125, 249, 255, 0.05) 100%
        );
        border-color: #7df9ff;
        color: #7df9ff;
        box-shadow:
            0 0 20px rgba(125, 249, 255, 0.15),
            inset 0 0 10px rgba(125, 249, 255, 0.05);
        text-shadow: 0 0 10px rgba(125, 249, 255, 0.5);
    }

    tr {
        transition: all 0.3s ease;
    }

    tr:hover td {
        background-color: rgba(125, 249, 255, 0.03);
    }
</style>

<script>
    interface PlayerData {
        uuid: string;
        name: string;
        deaths: number;
        player_kills: number;
        mob_kills: number;
        hours_played: number;
        skin: string;
        [key: string]: any;
    }

    let allStats: Record<string, PlayerData> = {};
    let currentCriteria = "mob_kills";
    const REFRESH_RATE = 120; // 120 segundos
    let timerInterval: any;

    async function loadStats() {
        const tbody = document.getElementById("scoreboard-body");
        if (!tbody) return;

        try {
            if (Object.keys(allStats).length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="4" class="p-10 text-center">
                            <div class="inline-block w-8 h-8 border-2 border-[#7df9ff] border-t-transparent rounded-full animate-spin"></div>
                        </td>
                    </tr>
                `;
            }

            const res = await fetch("/malaworld/api/scoreboard");
            if (!res.ok) throw new Error("Error al cargar stats");
            allStats = await res.json();
            renderScoreboard(currentCriteria);
            startTimer();
        } catch (e) {
            console.error(e);
            if (Object.keys(allStats).length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="4" class="p-8 text-center text-red-500">
                            Error al cargar los datos. Reintentando...
                        </td>
                    </tr>
                `;
            }
        }
    }

    function renderScoreboard(criteria: string) {
        currentCriteria = criteria;
        const tbody = document.getElementById("scoreboard-body");
        const header = document.getElementById("stat-header");
        if (!tbody || !header) return;

        header.innerText = formatLabel(criteria).toUpperCase();

        const players = Object.values(allStats) as PlayerData[];
        const sorted = players
            .sort((a, b) => b[criteria] - a[criteria])
            .slice(0, 10);

        tbody.innerHTML = sorted
            .map((player, index) => {
                let val = player[criteria];
                if (criteria === "hours_played") {
                    val = parseFloat(val).toFixed(1) + " h";
                }

                const rankColor =
                    index === 0
                        ? "text-[#ffd700] drop-shadow-[0_0_10px_rgba(255,215,0,0.5)]"
                        : index === 1
                          ? "text-[#c0c0c0] drop-shadow-[0_0_10px_rgba(192,192,192,0.5)]"
                          : index === 2
                            ? "text-[#cd7f32] drop-shadow-[0_0_10px_rgba(205,127,50,0.5)]"
                            : "text-[#7df9ff]/50";

                const fontClass =
                    index < 3 ? "font-bold scale-110" : "font-normal";

                // Efecto especial para el top 3
                let rowBg = "";
                let borderEffect = "";

                if (index === 0) {
                    rowBg = "bg-linear-to-r from-[#ffd700]/10 to-transparent";
                    borderEffect = "border-l-4 border-[#ffd700]";
                } else if (index === 1) {
                    rowBg = "bg-linear-to-r from-[#c0c0c0]/5 to-transparent";
                    borderEffect = "border-l-4 border-[#c0c0c0]";
                } else if (index === 2) {
                    rowBg = "bg-linear-to-r from-[#cd7f32]/5 to-transparent";
                    borderEffect = "border-l-4 border-[#cd7f32]";
                } else {
                    borderEffect =
                        "border-l-4 border-transparent hover:border-[#7df9ff]/30";
                }

                return `
                <tr class="group transition-all duration-300 ${rowBg} ${borderEffect}">
                    <td class="p-4 text-center">
                        <span class="font-['Cinzel'] text-xl block transition-transform group-hover:scale-110 ${rankColor} ${fontClass}">
                            #${index + 1}
                        </span>
                    </td>
                    <td class="p-4 text-center">
                        <div class="relative inline-block w-10 h-10 rounded-lg overflow-hidden border border-zinc-700/50 bg-black group-hover:border-[#7df9ff]/50 transition-colors shadow-lg">
                            <img src="${player.skin}" alt="${player.name}" class="w-full h-full object-cover">
                        </div>
                    </td>
                    <td class="p-4">
                        <span class="text-[#e3dac9] font-['Josefin_Sans'] tracking-widest text-lg group-hover:text-white transition-colors ${index < 3 ? "font-bold" : ""}">${player.name}</span>
                    </td>
                    <td class="p-4 text-right">
                        <span class="font-mono text-[#7df9ff] text-xl font-bold drop-shadow-[0_0_5px_rgba(125,249,255,0.3)]">
                            ${val}
                        </span>
                    </td>
                </tr>
            `;
            })
            .join("");
    }

    function formatLabel(key: string) {
        switch (key) {
            case "mob_kills":
                return "Mobs Asesinados";
            case "player_kills":
                return "Asesinatos";
            case "deaths":
                return "Muertes";
            case "hours_played":
                return "Tiempo Jugado";
            default:
                return "";
        }
    }

    function startTimer() {
        const timerEl = document.getElementById("next-update");
        if (!timerEl) return;

        clearInterval(timerInterval);

        let secondsLeft = REFRESH_RATE;

        const updateDisplay = () => {
            const m = Math.floor(secondsLeft / 60)
                .toString()
                .padStart(2, "0");
            const s = (secondsLeft % 60).toString().padStart(2, "0");
            timerEl.innerText = `${m}:${s}`;
        };

        updateDisplay();

        timerInterval = setInterval(() => {
            secondsLeft--;
            if (secondsLeft <= 0) {
                loadStats();
                secondsLeft = REFRESH_RATE;
            }
            updateDisplay();
        }, 1000);
    }

    document.querySelectorAll(".stat-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
            const target = btn as HTMLElement;
            document
                .querySelectorAll(".stat-btn")
                .forEach((b) => b.classList.remove("active"));
            target.classList.add("active");
            if (target.dataset.stat) {
                renderScoreboard(target.dataset.stat);
            }
        });
    });

    document.addEventListener("DOMContentLoaded", loadStats);
</script>
