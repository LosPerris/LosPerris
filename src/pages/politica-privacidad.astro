---
import LegalLayout from "../layouts/LegalLayout.astro";
import TermsSection from "../components/terms/TermsSection.astro";
import { privacySections } from "../data/privacy";
---

<LegalLayout
  title="Política de Privacidad - LosPerris"
  pageTitlePrimary="Política de"
  pageTitleSecondary="Privacidad"
  pageIcon="fas fa-shield-alt"
  lastUpdated="21 de Junio de 2026"
  description="Tu privacidad es importante para nosotros. Aquí explicamos cómo recopilamos, usamos y protegemos tus datos en los servicios de LosPerris."
>
  {
    privacySections.map((section, index) => (
      <div class="mb-12 border-b border-[#27272a] pb-8 last:border-0">
        <TermsSection
          title={section.title}
          icon={section.icon}
          content={section.content}
          index={index}
        />
      </div>
    ))
  }
</LegalLayout>
