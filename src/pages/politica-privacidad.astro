---
import LegalLayout from "../layouts/LegalLayout.astro";
import TermsSection from "../components/terms/TermsSection.astro";
import { privacySections } from "../data/privacy";
---

<LegalLayout
  title="Política de Privacidad - LosPerris"
  pageTitlePrimary="Política de"
  pageTitleSecondary="Privacidad"
  pageIcon="fas fa-shield-alt"
  lastUpdated="27 de Diciembre de 2025"
  description="Tu privacidad es importante para nosotros. Aquí explicamos cómo recopilamos, usamos y protegemos tus datos en LosPerris."
>
  {
    privacySections.map((section, index) => (
      <div class="bg-white/5 border border-white/10 rounded-2xl p-8 backdrop-blur-sm hover:bg-white/10 transition-colors">
        <TermsSection
          title={section.title}
          icon={section.icon}
          content={section.content}
          index={index}
        />
      </div>
    ))
  }
</LegalLayout>
