---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 - Página no encontrada">
  <section
    class="min-h-screen flex items-center justify-center relative overflow-hidden pt-20 bg-[#050505]"
  >
    <div class="absolute inset-0 z-0 pointer-events-none">
      <div
        class="absolute inset-0 bg-[radial-gradient(#27272a_1px,transparent_1px)] [background-size:24px_24px] opacity-20"
      >
      </div>
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#f97316]/5 blur-[120px] rounded-full"
      >
      </div>
    </div>

    <div
      class="relative z-10 max-w-4xl px-6 flex flex-col items-center text-center"
    >
      <h1
        class="text-8xl md:text-10xl font-black mb-4 text-transparent bg-clip-text bg-gradient-to-br from-[#f97316] to-[#ea580c] tracking-tight"
      >
        404
      </h1>
      <p class="text-3xl md:text-5xl font-bold text-white mb-6">
        Página no encontrada
      </p>
      <p class="text-lg md:text-xl text-zinc-400 mb-10 max-w-2xl font-light">
        La ruta que buscas no existe, ha sido movida o te has perdido en el
        vacío.
      </p>
      <a
        href="/"
        class="inline-flex items-center px-8 py-4 rounded-xl font-bold transition-all text-lg bg-[#f97316] text-[#050505] hover:bg-[#ea580c] shadow-[0_0_20px_rgba(249,115,22,0.3)] hover:shadow-[0_0_30px_rgba(249,115,22,0.5)]"
      >
        <i class="fas fa-home mr-3 text-xl"></i> Regresar al Inicio
      </a>
    </div>
  </section>
</Layout>
