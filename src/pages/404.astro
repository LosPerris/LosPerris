---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 - Página no encontrada">
  <section
    class="min-h-screen flex items-center justify-center relative overflow-hidden py-20"
  >
    <div class="absolute inset-0 pointer-events-none">
      <div
        class="absolute top-1/4 left-1/4 w-96 h-96 bg-purple-600/10 rounded-full blur-[128px]"
      >
      </div>
      <div
        class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-[#f97316]/10 rounded-full blur-[128px]"
      >
      </div>
    </div>

    <div
      class="relative z-10 max-w-4xl px-6 flex flex-col items-center text-center"
    >
      <h1
        class="text-8xl md:text-9xl font-black mb-4 text-[#f97316] tracking-tight glitch-text opacity-0 translate-y-8 animate-[fadeInUp_1s_ease-out_0.3s_forwards]"
        data-text="404"
      >
        404
      </h1>

      <p
        class="text-3xl md:text-5xl font-bold text-white mb-6 opacity-0 translate-y-8 animate-[fadeInUp_1s_ease-out_0.6s_forwards]"
      >
        Te has perdido en el vacío
      </p>

      <p
        class="text-xl md:text-2xl text-text-secondary mb-8 max-w-2xl font-light opacity-0 translate-y-8 animate-[fadeInUp_1s_ease-out_0.9s_forwards]"
      >
        La ruta que buscas no existe o ha sido movida a otra dimensión.
      </p>

      <div
        class="opacity-0 translate-y-8 animate-[fadeInUp_1s_ease-out_1.2s_forwards]"
      >
        <a
          href="/"
          class="inline-flex items-center px-8 py-4 rounded-full font-bold transition-all text-lg cursor-pointer bg-[#f97316] text-white hover:bg-[#ea580c] hover:scale-105 hover:shadow-[0_0_30px_rgba(249,115,22,0.5)]"
        >
          <i class="fas fa-home mr-3 text-2xl"></i> Regresar a la Base
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .glitch-text {
    position: relative;
  }

  .glitch-text::before,
  .glitch-text::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: transparent;
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    background-image: linear-gradient(to right, #f97316, #a855f7);
  }

  .glitch-text::before {
    left: 2px;
    text-shadow: none;
    clip: rect(44px, 450px, 56px, 0);
    animation: glitch-anim 5s infinite linear alternate-reverse;
  }

  .glitch-text::after {
    left: -2px;
    text-shadow: none;
    clip: rect(44px, 450px, 56px, 0);
    animation: glitch-anim2 5s infinite linear alternate-reverse;
  }

  @keyframes glitch-anim {
    0% {
      clip: rect(31px, 9999px, 94px, 0);
      transform: skew(0.85deg);
    }
    5% {
      clip: rect(70px, 9999px, 11px, 0);
      transform: skew(0.24deg);
    }
    10% {
