---
import Layout from "../layouts/Layout.astro";
import BackgroundEffects from "../components/ui/BackgroundEffects.astro";
import Button from "../components/ui/Button.astro";
import { apis } from "../data/apis";
---

<Layout title="APIs | Los Perris">
    <BackgroundEffects />

    <main class="min-h-screen pt-24 pb-12 px-4 relative z-10">
        <div class="max-w-6xl mx-auto">
            <div class="text-center mb-16">
                <h1
                    class="text-5xl font-black text-white mb-6 uppercase tracking-wider relative inline-block"
                >
                    PRO <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-[#ff3366] to-[#ff0000]"
                        >APIs</span
                    >
                    <div
                        class="absolute -bottom-2 left-0 w-full h-1 bg-gradient-to-r from-[#ff3366] to-[#ff0000]"
                    >
                    </div>
                </h1>
                <p class="text-xl text-gray-300 max-w-2xl mx-auto">
                    Integra la potencia de Los Perris en tus propias
                    aplicaciones. Escalable, rápido y fácil de usar.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
                {
                    apis.map((api) => (
                        <div class="bg-[#202020]/80 backdrop-blur-md rounded-2xl p-8 border border-[#333] hover:border-[#ff3366] transition-all duration-300 group">
                            <div class="flex justify-between items-start mb-6">
                                <h2 class="text-2xl font-bold text-white group-hover:text-[#ff3366] transition-colors">
                                    {api.title}
                                </h2>
                                <span class="px-3 py-1 rounded-full text-xs font-bold bg-green-500/20 text-green-400">
                                    Online
                                </span>
                            </div>

                            <p class="text-gray-400 mb-6 min-h-[50px]">
                                {api.description}
                            </p>

                            <div class="bg-[#151515] rounded-xl p-4 mb-6 font-mono text-sm">
                                <div class="flex justify-between text-xs text-gray-500 mb-2 uppercase tracking-wide">
                                    <span>Endpoints</span>
                                </div>
                                <div class="space-y-3">
                                    {api.endpoints.map((ep) => (
                                        <div class="flex flex-col gap-1">
                                            <div class="flex items-center gap-3">
                                                <span
                                                    class={`px-2 py-0.5 rounded text-[10px] font-bold ${
                                                        ep.method === "GET"
                                                            ? "bg-blue-500/20 text-blue-400"
                                                            : "bg-orange-500/20 text-orange-400"
                                                    }`}
                                                >
                                                    {ep.method}
                                                </span>
                                                <code class="text-gray-300 hover:text-white transition-colors cursor-pointer text-xs break-all">
                                                    {ep.path}
                                                </code>
                                            </div>
                                            <div class="text-[10px] text-gray-500 pl-1">
                                                {ep.description}
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>

                            <Button
                                href={api.link}
                                variant="secondary"
                                class="w-full"
                            >
                                {api.linkText}
                            </Button>
                        </div>
                    ))
                }
            </div>

            <div
                class="bg-gradient-to-r from-[#202020] to-[#252525] rounded-3xl p-12 border border-[#333] text-center relative overflow-hidden"
            >
                <div
                    class="absolute top-0 right-0 w-64 h-64 bg-[#ff3366]/5 rounded-full blur-3xl transform translate-x-1/2 -translate-y-1/2"
                >
                </div>

                <h3 class="text-3xl font-bold text-white mb-4 relative z-10">
                    ¿Necesitas una integración personalizada?
                </h3>
                <p class="text-gray-400 mb-8 max-w-2xl mx-auto relative z-10">
                    Podemos crear endpoints específicos para las necesidades de
                    tu comunidad o aplicación. Contáctanos para discutir tu caso
                    de uso.
                </p>
                <div class="relative z-10">
                    <Button
                        href="https://discord.gg/JKPUVf9aeU"
                        variant="primary"
                    >
                        <i class="fab fa-discord mr-2"></i>
                        Hablar con Desarrolladores
                    </Button>
                </div>
            </div>
        </div>
    </main>
</Layout>
