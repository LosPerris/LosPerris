---
import Layout from "../../layouts/Layout.astro";
import DocsSidebar from "../../components/guides/DocsSidebar.astro";
import DocsContent from "../../components/guides/DocsContent.astro";
import { guides } from "../../data/guides";

const initialGuide = guides[0];
---

<Layout title="Guías de Uso - LosPerris">
  <div class="flex flex-col lg:flex-row min-h-screen pt-20 bg-[#0A0A0A]">
    <DocsSidebar activeId={initialGuide.id} />
    <DocsContent />
  </div>
</Layout>

<script>
  import "../../scripts/sidebar.ts";
</script>

<style>
  #content-area {
    transition:
      opacity 0.3s ease-out,
      transform 0.3s ease-out;
  }
</style>
