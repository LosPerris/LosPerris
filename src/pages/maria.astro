---
import MariaLayout from "../maria/layouts/MariaLayout.astro";
import DailyMessage from "../maria/components/DailyMessage.astro";
import { trackVisit } from "../maria/scripts/tracking";

// Detectar el país desde los headers de Vercel
const country = Astro.request.headers.get("x-vercel-ip-country");

// Realizar el tracking
await trackVisit(country);
---

<MariaLayout
  title="🌻 Mi Jardín de Girasoles 🌻"
  description="Cada día es un nuevo girasol para ti"
>
  <DailyMessage />
</MariaLayout>
