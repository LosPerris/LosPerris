---
import MariaLayout from "../maria/layouts/MariaLayout.astro";
import DailyMessage from "../maria/components/DailyMessage.astro";
import AnniversaryModal from "../maria/components/AnniversaryModal.astro";
import { trackVisit } from "../maria/scripts/tracking";
import { SPOTIFY_TRACK_IDS } from "../maria/data/songs";
import { QUESTIONS } from "../maria/data/questions";

const country = Astro.request.headers.get("x-vercel-ip-country");
const ip = Astro.request.headers.get("x-real-ip") || "unknown";

const today = new Date().toISOString().split("T")[0];
const seedStr = `${ip}-${today}`;

function hashCode(s: string) {
  let h = 0;
  for (let i = 0; i < s.length; i++)
    h = (Math.imul(31, h) + s.charCodeAt(i)) | 0;
  return Math.abs(h);
}

const seed = hashCode(seedStr);
const songIndex = seed % SPOTIFY_TRACK_IDS.length;
const questionIndex = seed % QUESTIONS.length;

const selectedSongId = SPOTIFY_TRACK_IDS[songIndex];
const selectedQuestion = QUESTIONS[questionIndex];

const dateInCR = new Date(
  new Date().toLocaleString("en-US", { timeZone: "America/Costa_Rica" }),
);
const isMay2nd = dateInCR.getMonth() === 4 && dateInCR.getDate() === 2;

await trackVisit(country);
---

<MariaLayout
  title="🌻 Mi Jardín de Girasoles 🌻"
  description="Cada día es un nuevo girasol para ti"
>
  {isMay2nd && <AnniversaryModal />}

  <script>
    const closeDailyBtn = document.getElementById("close-daily-modal");
    const anniversaryModal = document.getElementById("anniversary-modal");

    if (closeDailyBtn && anniversaryModal) {
      closeDailyBtn.addEventListener("click", () => {
        setTimeout(() => {
          anniversaryModal.classList.add("is-active");
        }, 500);
      });
    }
  </script>

  <DailyMessage songId={selectedSongId} question={selectedQuestion} />
</MariaLayout>

<style>
  .anniversary-banner {
    position: relative;
    z-index: 1000;
    width: 100%;
    max-width: 600px;
    margin-bottom: 2rem;
    display: none;
    opacity: 0;
    transform: translateY(-20px);
  }

  .anniversary-banner.show {
    display: block;
    animation: slideDown 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }

  .banner-content {
    background: rgba(255, 235, 59, 0.15);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 215, 0, 0.4);
    box-shadow:
      0 8px 32px rgba(255, 215, 0, 0.2),
      inset 0 0 10px rgba(255, 255, 255, 0.3);
    border-radius: 20px;
    padding: 1.2rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: #ffd700;
    font-family: "Inter", system-ui, sans-serif;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
    text-align: center;
  }

  .message-text {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .date-title {
    font-weight: 700;
    font-size: 1.1rem;
    margin: 0;
  }

  .emotional-text {
    font-weight: 500;
    font-size: 0.95rem;
    margin: 0;
    line-height: 1.4;
    color: #fff9c4;
  }

  .sparkle {
    font-size: 1.5rem;
    animation: pulse 2s infinite;
  }

  @keyframes slideDown {
    0% {
      opacity: 0;
      transform: translateY(-20px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.2);
      opacity: 0.8;
    }
  }

  @media (max-width: 480px) {
    .banner-content {
      font-size: 0.95rem;
      padding: 0.8rem 1rem;
    }
    .sparkle {
      font-size: 1.2rem;
    }
  }
</style>
