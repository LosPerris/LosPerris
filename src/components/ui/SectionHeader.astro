---
interface Props {
  align?: "center" | "left" | "right";
  title: string;
  highlight?: string;
  description?: string;
  class?: string;
}

const {
  align = "center",
  title,
  highlight,
  description,
  class: className = "",
} = Astro.props;

const alignClass =
  align === "center"
    ? "text-center items-center"
    : align === "right"
      ? "text-right items-end"
      : "text-left items-start";
const mxClass =
  align === "center" ? "mx-auto" : align === "right" ? "ml-auto" : "";
---

<div class={`mb-16 relative z-10 ${alignClass} ${className}`}>
  <h2
    class="text-4xl md:text-6xl font-black text-white mb-4 animate-[fadeInUp_0.8s_ease-out]"
  >
    {title}
    {
      highlight && (
        <span class="text-transparent bg-clip-text bg-gradient-to-br from-[#f97316] to-[#ea580c] drop-shadow-[0_0_15px_rgba(249,115,22,0.2)] ml-2">
          {highlight}
        </span>
      )
    }
  </h2>

  {
    description && (
      <p
        class={`text-text-secondary text-xl max-w-2xl font-light animate-[fadeInUp_0.8s_ease-out_0.2s_both] ${mxClass}`}
      >
        {description}
      </p>
    )
  }
</div>
