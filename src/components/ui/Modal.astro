---
interface Props {
    id: string;
    title: string;
}

const { id, title } = Astro.props;
---

<div
    id={id}
    class="hidden fixed inset-0 z-[2000] bg-black/80 backdrop-blur-sm animate-[fadeIn_0.3s_ease]"
>
    <div
        class="bg-[#2d2d2d] m-[5%_auto] p-0 rounded-xl w-[90%] max-w-[800px] max-h-[80vh] overflow-hidden border border-[#404040] animate-[slideInUp_0.4s_ease] shadow-2xl relative flex flex-col"
    >
        <div
            class="bg-[#404040] px-8 py-6 flex justify-between items-center bg-gradient-to-r from-[#2d2d2d] to-[#404040] border-b border-[#404040]"
        >
            <h2 class="text-2xl font-bold text-white m-0">
                {title}
            </h2>
            <span
                class="text-[#b0b0b0] text-4xl font-bold cursor-pointer transition-colors hover:text-white hover:scale-110 close-modal"
                data-target={id}
                role="button"
                aria-label="Cerrar modal"
                tabindex="0">&times;</span
            >
        </div>
        <div class="p-8 overflow-y-auto modal-body">
            <slot />
        </div>
    </div>
</div>

<script define:vars={{ id }} is:inline>
    const modal = document.getElementById(id);
    const closeButtons = modal?.querySelectorAll(".close-modal");

    if (modal) {
        modal.addEventListener("click", (e) => {
            if (e.target === modal) {
                modal.classList.add("hidden");
                document.body.style.overflow = "auto";
            }
        });

        closeButtons?.forEach((btn) => {
            btn.addEventListener("click", () => {
                modal.classList.add("hidden");
                document.body.style.overflow = "auto";
            });
        });
    }
</script>
