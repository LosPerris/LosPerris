---
interface Props {
    class?: string;
    hoverEffect?: boolean;
    animate?: boolean;
    [key: string]: any;
}

const {
    class: className,
    hoverEffect = true,
    animate = false,
    ...rest
} = Astro.props;

const baseStyles =
    "bg-gradient-to-br from-[#2d2d2d] to-[#404040] rounded-xl border border-[#404040]";
const hoverStyles = hoverEffect
    ? "transition-all hover:-translate-y-1 hover:shadow-lg hover:border-[#404040]"
    : "";
const animateStyles = animate
    ? "opacity-0 animate-[fadeInUp_0.6s_ease-out_forwards]"
    : "";

const styles = `${baseStyles} ${hoverStyles} ${animateStyles} ${className || ""}`;
---

<div class={`${styles} group relative overflow-hidden`} {...rest}>
    <div
        class="absolute inset-0 p-[2px] rounded-[inherit] opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
        style="mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); mask-composite: exclude; -webkit-mask-composite: xor;"
    >
        <div
            class="absolute -inset-full bg-[conic-gradient(from_0deg,#5865F2,#a855f7_40%,#ffffff_48%,#d946ef_52%,#5865F2)] animate-[spin_8s_linear_infinite]"
        >
        </div>
    </div>

    <div class="relative z-10 h-full">
        <slot />
    </div>
</div>
