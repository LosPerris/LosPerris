---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  class?: string;
  hoverEffect?: boolean;
  animate?: boolean;
}

const {
  class: className,
  hoverEffect = true,
  animate = false,
  ...rest
} = Astro.props;

const baseStyles =
  "bg-[#090a0b] rounded-xl border border-zinc-800 transition-all duration-300";
const hoverStyles = hoverEffect
  ? "hover:bg-[#0c0d0e] hover:border-zinc-700/80"
  : "";
const animateStyles = animate
  ? "opacity-0 animate-[fadeInUp_0.6s_ease-out_forwards]"
  : "";

const styles = `${baseStyles} ${hoverStyles} ${animateStyles} ${className || ""}`;
---

<div class={`${styles} group relative overflow-hidden`} {...rest}>
  <slot />
</div>
