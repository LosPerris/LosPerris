<style>
  .cloud-anim {
    animation-name: move-cloud;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    will-change: transform;
  }

  /* Pareja 1: Hero (45s) */
  .cloud-1 {
    animation-duration: 45s;
    animation-delay: 0s;
  }
  .cloud-1-clone {
    animation-duration: 45s;
    animation-delay: -22s;
  }

  /* Pareja 2: Hero Naranjas (70s) */
  .cloud-2 {
    animation-duration: 70s;
    animation-delay: -10s;
  }
  .cloud-2-clone {
    animation-duration: 70s;
    animation-delay: -45s;
  }

  /* Pareja 3: Media Blancas (55s) */
  .cloud-3 {
    animation-duration: 55s;
    animation-delay: -5s;
  }
  .cloud-3-clone {
    animation-duration: 55s;
    animation-delay: -32s;
  }

  /* Pareja 4: Media Naranjas (90s) */
  .cloud-4 {
    animation-duration: 90s;
    animation-delay: -20s;
  }
  .cloud-4-clone {
    animation-duration: 90s;
    animation-delay: -65s;
  }

  /* Pareja 5: Footer Blancas (65s) */
  .cloud-5 {
    animation-duration: 65s;
    animation-delay: -15s;
  }
  .cloud-5-clone {
    animation-duration: 65s;
    animation-delay: -47s;
  }

  /* Pareja 6: Footer Blancas Pequeñas (80s) */
  .cloud-6 {
    animation-duration: 80s;
    animation-delay: -30s;
  }
  .cloud-6-clone {
    animation-duration: 80s;
    animation-delay: -70s;
  }

  @keyframes move-cloud {
    0% {
      transform: translateX(100vw);
    }
    100% {
      transform: translateX(-100vw);
    }
  }
</style>
