---
import { Image } from "astro:assets";
import backgroundImage from "../../assets/img/back.webp";

interface Props {
  withWallpaper?: boolean;
  variant?: "default" | "hero" | "global" | "discrete";
  showBlobs?: boolean;
}

const {
  withWallpaper = false,
  variant = "default",
  showBlobs = true,
} = Astro.props;

const blobSize =
  variant === "hero" || variant === "global"
    ? "w-[900px] h-[900px] opacity-20"
    : variant === "discrete"
      ? "w-[100px] h-[300px] opacity-[0.005]"
      : "w-[600px] h-[600px] opacity-10";
---

<div
  class={`absolute inset-0 pointer-events-none overflow-hidden ${variant === "global" ? "fixed h-screen w-screen -z-10" : ""}`}
>
  {
    withWallpaper && (
      <div class="absolute inset-0 opacity-10 mix-blend-overlay">
        <Image
          src={backgroundImage}
          alt=""
          role="presentation"
          class="w-full h-full object-cover object-center"
          loading="eager"
        />
      </div>
    )
  }
  {
    showBlobs && (
      <>
        <div
          class={`absolute top-0 right-0 ${blobSize} bg-[#5865F2]/20 rounded-full blur-[120px] animate-pulse`}
        />
        <div
          class={`absolute bottom-0 left-0 ${blobSize} bg-purple-500/20 rounded-full blur-[120px] animate-pulse`}
          style="animation-delay: 2s;"
        />
      </>
    )
  }
</div>
