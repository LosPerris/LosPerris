---
import Winds from "./background/Winds.astro";
import Clouds from "./background/Clouds.astro";
import Stars from "./background/Stars.astro";
---

<div
  class="absolute inset-0 pointer-events-none overflow-hidden z-0 bg-[#090a0b]"
  id="hero-grid-container"
>
  <Winds />
</div>

<div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
  <Clouds />
  <Stars />
</div>
