<style>
  .cloud-anim {
    animation-name: move-cloud;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    will-change: transform;
  }

  .cloud-1 {
    animation-duration: 45s;
    animation-delay: 0s;
  }
  .cloud-1-clone {
    animation-duration: 45s;
    animation-delay: -22s;
  }
  .cloud-2 {
    animation-duration: 70s;
    animation-delay: -10s;
  }
  .cloud-2-clone {
    animation-duration: 70s;
    animation-delay: -45s;
  }
  .cloud-3 {
    animation-duration: 55s;
    animation-delay: -5s;
  }
  .cloud-3-clone {
    animation-duration: 55s;
    animation-delay: -32s;
  }
  .cloud-4 {
    animation-duration: 90s;
    animation-delay: -20s;
  }
  .cloud-4-clone {
    animation-duration: 90s;
    animation-delay: -65s;
  }
  .cloud-5 {
    animation-duration: 65s;
    animation-delay: -15s;
  }
  .cloud-5-clone {
    animation-duration: 65s;
    animation-delay: -47s;
  }
  .cloud-6 {
    animation-duration: 80s;
    animation-delay: -30s;
  }
  .cloud-6-clone {
    animation-duration: 80s;
    animation-delay: -70s;
  }

  @keyframes move-cloud {
    0% {
      transform: translateX(100vw);
    }
    100% {
      transform: translateX(-100vw);
    }
  }

  .wind-anim {
    animation-name: move-wind;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    will-change: transform, opacity;
  }

  .wind-1 {
    animation-duration: 6s;
    animation-delay: 0s;
  }
  .wind-2 {
    animation-duration: 10s;
    animation-delay: -3s;
  }
  .wind-3 {
    animation-duration: 8s;
    animation-delay: -5s;
  }
  .wind-4 {
    animation-duration: 12s;
    animation-delay: -1s;
  }
  .wind-5 {
    animation-duration: 7s;
    animation-delay: -4s;
  }
  .wind-6 {
    animation-duration: 15s;
    animation-delay: -7s;
  }
  .wind-7 {
    animation-duration: 9s;
    animation-delay: -2s;
  }
  .wind-8 {
    animation-duration: 11s;
    animation-delay: -6s;
  }

  @keyframes move-wind {
    0% {
      transform: translateX(100vw);
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    92% {
      opacity: 1;
    }
    100% {
      transform: translateX(-100vw);
      opacity: 0;
    }
  }

  /* Estrellas */
  .star-twinkle {
    animation: twinkle var(--ts, 3s) var(--td, 0s) infinite ease-in-out;
    opacity: 0.05;
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.04;
    }
    50% {
      opacity: 0.65;
    }
  }
</style>
