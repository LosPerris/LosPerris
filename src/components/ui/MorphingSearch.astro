---

---

<div class="morphing-search-container relative flex items-center">
  <button
    id="search-trigger"
    class="text-zinc-400 hover:text-white transition-colors p-2 rounded-lg flex items-center justify-center bg-transparent hover:bg-white/5"
    aria-label="Buscar"
  >
    <i class="fas fa-search text-[15px]"></i>
  </button>

  <form
    id="search-form"
    class="absolute right-0 top-1/2 -translate-y-1/2 flex items-center bg-[#121214] border border-white/10 rounded-full overflow-hidden transition-all duration-300 opacity-0 pointer-events-none w-0"
    action="/actualizaciones"
    method="get"
  >
    <i class="fas fa-search text-zinc-500 text-[13px] ml-4"></i>
    <input
      type="text"
      name="q"
      id="search-input"
      class="w-full bg-transparent border-none outline-none text-sm text-white px-3 py-2 placeholder-zinc-500"
      placeholder="Buscar... (Ctrl+K)"
      autocomplete="off"
    />
    <button
      type="button"
      id="search-close"
      class="text-zinc-500 hover:text-white transition-colors p-2 mr-1 flex items-center justify-center"
      aria-label="Cerrar búsqueda"
    >
      <i class="fas fa-times text-[13px]"></i>
    </button>
  </form>
</div>

<style>
  .morphing-search-container.active #search-trigger {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.8);
  }

  .morphing-search-container.active #search-form {
    opacity: 1;
    pointer-events: auto;
    width: 240px;
    box-shadow: 0 4px 20px -5px rgba(0, 0, 0, 0.5);
  }

  @media (max-width: 640px) {
    .morphing-search-container.active #search-form {
      width: 180px;
    }
  }
</style>

<script>
  function setupSearch() {
    const container = document.querySelector(".morphing-search-container");
    const trigger = document.getElementById("search-trigger");
    const form = document.getElementById("search-form") as HTMLFormElement;
    const input = document.getElementById("search-input") as HTMLInputElement;
    const closeBtn = document.getElementById("search-close");

    if (!container || !trigger || !form || !input || !closeBtn) return;

    const newTrigger = trigger.cloneNode(true);
    trigger.parentNode?.replaceChild(newTrigger, trigger);

    const newCloseBtn = closeBtn.cloneNode(true);
    closeBtn.parentNode?.replaceChild(newCloseBtn, closeBtn);

    const openSearch = () => {
      container.classList.add("active");
      setTimeout(() => input.focus(), 100);
    };

    const closeSearch = () => {
      container.classList.remove("active");
      input.blur();
    };

    newTrigger.addEventListener("click", openSearch);
    newCloseBtn.addEventListener("click", closeSearch);

    document.addEventListener("click", (e) => {
      if (
        !container.contains(e.target as Node) &&
        container.classList.contains("active")
      ) {
        closeSearch();
      }
    });

    // Si estamos en /actualizaciones, filtrar en-página; si no, navegar
    const isOnActualizaciones =
      window.location.pathname.startsWith("/actualizaciones");

    if (isOnActualizaciones) {
      // Filtrado en tiempo real
      input.addEventListener("input", () => {
        document.dispatchEvent(
          new CustomEvent("search-filter", { detail: { query: input.value } }),
        );
      });

      // Prevenir envío del form (no queremos navegar)
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        closeSearch();
      });
    }

    const handleKeyDown = (e: KeyboardEvent) => {
      if ((e.ctrlKey || e.metaKey) && e.key === "k") {
        e.preventDefault();
        if (container.classList.contains("active")) {
          closeSearch();
        } else {
          openSearch();
        }
      }

      if (e.key === "Escape" && container.classList.contains("active")) {
        closeSearch();
      }
    };

    const existingListener = (window as any)._searchKeydownListener;
    if (existingListener) {
      document.removeEventListener("keydown", existingListener);
    }
    document.addEventListener("keydown", handleKeyDown);
    (window as any)._searchKeydownListener = handleKeyDown;
  }

  setupSearch();
  document.addEventListener("astro:page-load", setupSearch);
</script>
