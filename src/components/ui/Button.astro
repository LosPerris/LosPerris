---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "outline" | "ghost";
  class?: string;
  onclick?: string;
  target?: string;
  rel?: string;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  id?: string;
}

const {
  href,
  variant = "primary",
  class: className,
  onclick,
  target,
  rel,
  type = "button",
  ...rest
} = Astro.props;

const baseStyles =
  "inline-flex items-center justify-center gap-2 px-8 py-3 rounded-xl font-semibold transition-all text-base cursor-pointer";

const variants = {
  primary:
    "bg-[#f97316] text-[#050505] hover:bg-[#ea580c] hover:shadow-lg transition-all",
  secondary:
    "bg-[#252525] text-white border border-white/5 hover:bg-[#303030] hover:shadow-md transition-all",
  outline:
    "bg-transparent text-[#b0b0b0] border border-white/10 hover:border-zinc-700/80 hover:text-white transition-all",
  ghost: "bg-transparent text-[#b0b0b0] hover:text-white transition-all",
};

const styles = `${baseStyles} ${variants[variant]} ${className || ""}`;
---

{
  href ? (
    <a
      href={href}
      class={styles}
      onclick={onclick}
      target={target}
      rel={rel}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button type={type} class={styles} onclick={onclick} {...rest}>
      <slot />
    </button>
  )
}
