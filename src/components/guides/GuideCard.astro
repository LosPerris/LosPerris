---
import type { Guide } from "../../data/guides";
import Card from "../ui/Card.astro";

interface Props {
    guide: Guide;
}

const { guide } = Astro.props;
---

<Card
    class="guide-card p-4 sm:p-6 bg-[#2d2d2d] rounded-xl border border-[#404040] hover:-translate-y-1 hover:shadow-lg transition-all cursor-pointer h-full flex flex-col items-center text-center group relative overflow-hidden"
    data-category={guide.category}
    data-title={guide.title.toLowerCase()}
    data-description={guide.description.toLowerCase()}
    onclick={`openGuide('${guide.id}')`}
>
    <div
        class="w-12 h-12 bg-gradient-to-br from-[#1a1a1a] to-[#2d2d2d] rounded-full flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300 border border-[#404040]"
    >
        <i class={`${guide.icon} text-xl text-white`}></i>
    </div>
    <h3 class="text-lg font-bold text-white mb-2">{guide.title}</h3>
    <p class="text-[#b0b0b0] text-sm mb-4 line-clamp-2">{guide.description}</p>
    <div class="flex flex-wrap justify-center gap-2 mt-auto">
        <span
            class={`${guide.difficultyColor} ${guide.difficultyTextColor} px-2 py-1 rounded text-xs font-bold`}
        >
            {guide.difficulty}
        </span>
        <span
            class="bg-[#404040] text-white px-2 py-1 rounded text-xs font-bold"
        >
            <i class="far fa-clock mr-1"></i>{guide.time}
        </span>
    </div>
</Card>
