---
import type { Guide } from "../../data/guides";
import Card from "../ui/Card.astro";

interface Props {
    guide: Guide;
}

const { guide } = Astro.props;
---

<Card
    class="guide-card group relative p-6 h-full bg-white/3 hover:bg-white/6 border border-white/10 hover:border-[#5865F2]/50 rounded-2xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl backdrop-blur-sm cursor-pointer overflow-hidden flex flex-col"
    data-category={guide.category}
    data-title={guide.title.toLowerCase()}
    data-description={guide.description.toLowerCase()}
    onclick={`openGuide('${guide.id}')`}
>
    <div
        class="absolute -right-10 -top-10 w-32 h-32 bg-[#5865F2]/10 rounded-full blur-[50px] group-hover:bg-[#5865F2]/20 transition-colors"
    >
    </div>

    <div class="relative z-10 flex items-start justify-between mb-6">
        <div
            class="w-14 h-14 rounded-2xl bg-[#5865F2]/10 flex items-center justify-center border border-[#5865F2]/20 group-hover:scale-110 group-hover:border-[#5865F2]/50 transition-all duration-300 shadow-lg shadow-[#5865F2]/5"
        >
            <i class={`${guide.icon} text-2xl text-[#5865F2]`}></i>
        </div>

        <span
            class={`${guide.difficultyColor} ${guide.difficultyTextColor} px-3 py-1 rounded-full text-xs font-bold border border-white/5 shadow-sm uppercase tracking-wide`}
        >
            {guide.difficulty}
        </span>
    </div>

    <div class="relative z-10 grow flex flex-col">
        <h3
            class="text-xl font-bold text-white mb-3 group-hover:text-[#5865F2] transition-colors line-clamp-1"
        >
            {guide.title}
        </h3>
        <p
            class="text-text-secondary text-sm leading-relaxed line-clamp-2 mb-6 grow"
        >
            {guide.description}
        </p>

        <div
            class="flex items-center justify-between pt-4 border-t border-white/5 mt-auto"
        >
            <span class="flex items-center text-xs font-medium text-text-muted">
                <i class="far fa-clock mr-2 text-[#5865F2]"></i>
                {guide.time}
            </span>
            <span
                class="text-xs font-bold text-white group-hover:translate-x-1 transition-transform flex items-center"
            >
                Leer guía <i class="fas fa-arrow-right ml-2 text-[#5865F2]"></i>
            </span>
        </div>
    </div>
</Card>
