---
import { guides } from "../../data/guides";

const initialGuide = guides[0];
---

<div class="flex-1 p-6 lg:p-12 min-h-[50vh] bg-[#0A0A0A]">
    <div id="content-area" class="max-w-4xl mx-auto">
        <div class="mb-10 pb-6 border-b border-[#2A2A2A]">
            <div class="flex items-center gap-3 mb-4">
                <span
                    id="guide-badge"
                    class={`${initialGuide.difficultyColor} ${initialGuide.difficultyTextColor} px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide`}
                >
                    {initialGuide.difficulty}
                </span>
                <span class="text-gray-400 text-sm flex items-center gap-2">
                    <i class="far fa-clock"></i>
                    <span id="guide-time">{initialGuide.time}</span>
                </span>
            </div>
            <h1
                id="guide-title"
                class="text-4xl md:text-5xl font-black text-white mb-4 tracking-tight"
            >
                {initialGuide.contentTitle}
            </h1>
            <p id="guide-desc" class="text-xl text-gray-400 font-light">
                {initialGuide.description}
            </p>
        </div>

        <div id="guide-body" class="space-y-8">
            {
                initialGuide.sections?.map((section) => (
                    <div class="section-block">
                        <h3 class="text-2xl font-bold text-white mb-5 flex items-center gap-3 border-b border-[#2A2A2A] pb-3">
                            <span class="text-3xl">{section.icon}</span>{" "}
                            {section.title}
                        </h3>

                        {section.content && (
                            <div
                                class="mb-6 text-gray-300 leading-relaxed"
                                set:html={section.content}
                            />
                        )}

                        {section.commands && (
                            <div class="grid gap-4">
                                {section.commands.map((cmd) => (
                                    <div class="group bg-[#151515] hover:bg-[#1A1A1A] border border-[#2A2A2A] hover:border-[#404040] rounded-xl p-4 transition-all duration-300">
                                        <div class="flex flex-col sm:flex-row sm:items-center gap-4">
                                            <div class="shrink-0">
                                                <code class="px-3 py-1.5 rounded-lg bg-[#202020] text-[#5865F2] font-mono text-sm font-bold border border-[#303030] shadow-sm group-hover:shadow-[0_0_10px_rgba(88,101,242,0.15)] transition-shadow">
                                                    {cmd.name}
                                                </code>
                                            </div>
                                            <div class="flex items-center gap-3 text-gray-400 group-hover:text-gray-200 transition-colors">
                                                {cmd.emoji && (
                                                    <span class="text-lg">
                                                        {cmd.emoji}
                                                    </span>
                                                )}
                                                <span class="text-sm sm:text-base font-medium">
                                                    {cmd.description}
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        )}
                    </div>
                ))
            }
        </div>
    </div>
</div>

<script is:inline define:vars={{ guides }}>
    window.GUIDES_DATA = guides;
</script>
