---
import { guides } from "../../data/guides";
import { discordLink } from "../../data/community";

const initialGuide = guides[0];

const emojiToIcon: Record<string, string> = {
  "😺": "fas fa-cat",
  "👋": "fas fa-hand-sparkles",
  "📷": "fas fa-camera",
  "📋": "fas fa-clipboard-list",
  "📊": "fas fa-chart-bar",
  "👤": "fas fa-user",
  "❌": "fas fa-times-circle text-red-500/70",
  "📖": "fas fa-book",
  "🚮": "fas fa-trash",
  "✅": "fas fa-check-circle text-green-500/70",
  "🎉": "fas fa-gift",
  "🔊": "fas fa-volume-up",
  "📨": "fas fa-envelope",
  "🔍": "fas fa-search",
  "🔐": "fas fa-lock",
  "🛡️": "fas fa-shield-alt",
  "🖼️": "fas fa-image",
  "🛒": "fas fa-shopping-cart",
  "❓": "fas fa-question-circle",
  "🔫": "fas fa-crosshairs",
  "🗺️": "fas fa-map",
  "🧱": "fas fa-cubes",
  "🎴": "fas fa-clone",
  "🐉": "fas fa-dragon",
  "📺": "fas fa-tv",
  "🎮": "fas fa-gamepad",
  "🛠️": "fas fa-tools",
  "🎲": "fas fa-dice",
  "💳": "fas fa-credit-card",
  "🎰": "fas fa-coins",
  "⚙️": "fas fa-cog",
  "📝": "fas fa-clipboard-check",
  "🔔": "fas fa-bell",
  "🔧": "fas fa-wrench",
  "👑": "fas fa-crown",
};
---

<div class="flex-1 p-6 lg:p-12 min-h-[50vh] bg-transparent">
  <div id="content-area" class="max-w-6xl mx-auto">
    <div class="mb-10 pb-6 border-b border-[#27272a]">
      <div class="flex items-center gap-3 mb-4">
        <span
          id="guide-badge"
          class={`${initialGuide.difficultyColor} ${initialGuide.difficultyTextColor} px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide`}
        >
          {initialGuide.difficulty}
        </span>
        <span class="text-gray-400 text-sm flex items-center gap-2">
          <i class="far fa-clock" aria-hidden="true"></i>
          <span id="guide-time">{initialGuide.time}</span>
        </span>
      </div>
      <h1
        id="guide-title"
        class="text-4xl md:text-5xl font-black text-white mb-6 tracking-tight uppercase"
      >
        {initialGuide.contentTitle}
      </h1>
      <p
        id="guide-desc"
        class="text-lg text-gray-400 font-light mb-8 max-w-2xl leading-relaxed"
      >
        {initialGuide.description}
      </p>

      <div class="flex flex-wrap items-center gap-4">
        <a
          href="#content"
          class="px-6 py-2 bg-[#f97316] text-white font-semibold rounded-lg hover:bg-[#ea580c] transition-colors"
        >
          Explorar Temas
        </a>
        <a
          href={discordLink}
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-2 bg-transparent text-gray-300 border border-[#333] font-semibold rounded-lg hover:bg-[#1a1a1a] hover:text-white transition-colors flex items-center gap-2"
        >
          <i class="fab fa-discord"></i> Soporte en Discord
        </a>
      </div>
    </div>

    <div id="guide-body" class="space-y-8">
      {
        initialGuide.sections?.map((section) => (
          <div class="section-block border-t border-[#27272a] py-12 first:border-0 first:pt-0">
            <div class="grid grid-cols-1 xl:grid-cols-12 gap-8 xl:gap-12">
              <div class="xl:col-span-5 relative">
                <div class="xl:sticky xl:top-28">
                  <h3 class="text-2xl font-bold text-white mb-5 flex items-center gap-3">
                    <i
                      class={`${emojiToIcon[section.icon || ""] || "fas fa-layer-group"} text-[#f97316]`}
                    />
                    {section.title}
                  </h3>
                  {section.content && (
                    <div
                      class="text-zinc-400 leading-relaxed text-sm md:text-base"
                      set:html={section.content}
                    />
                  )}
                </div>
              </div>

              <div class="xl:col-span-7">
                {section.commands && (
                  <div class="bg-[#0a0a0a] border border-[#27272a] rounded-xl overflow-hidden shadow-[0_8px_30px_rgba(0,0,0,0.5)] flex flex-col divide-y divide-[#27272a]/50">
                    {section.commands.map((cmd) => (
                      <div class="p-5 flex flex-col sm:flex-row sm:items-start gap-4 hover:bg-white/[0.02] transition-colors group">
                        <div class="shrink-0 sm:w-48">
                          <code class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-[#050505] border border-[#27272a] text-[#f97316] font-mono text-sm shadow-sm group-hover:border-[#f97316]/30 transition-colors">
                            {cmd.emoji && (
                              <i
                                class={`${emojiToIcon[cmd.emoji] || "fas fa-terminal"} opacity-70`}
                              />
                            )}
                            {cmd.name}
                          </code>
                        </div>
                        <div class="flex-1 pt-0.5">
                          <span class="text-sm text-zinc-400 leading-relaxed block">
                            {cmd.description}
                          </span>
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<script is:inline define:vars={{ emojiToIcon }}>
  window.emojiToIcon = emojiToIcon;
</script>

<script>
  import { guides } from "../../data/guides";
  import type { GuideSection, Command } from "../../data/commands";

  declare global {
    interface Window {
      switchGuide: (id: string) => void;
    }
  }

  document.addEventListener("astro:page-load", () => {
    // Forzar scroll arriba al entrar a la página (corrige el bug de Lenis)
    window.scrollTo(0, 0);

    const contentArea = document.getElementById("content-area");

    const elements = {
      badge: document.getElementById("guide-badge"),
      time: document.getElementById("guide-time"),
      title: document.getElementById("guide-title"),
      desc: document.getElementById("guide-desc"),
      body: document.getElementById("guide-body"),
    };

    window.switchGuide = (id: string) => {
      const currentActiveBtn = document.querySelector(
        `.guide-btn[data-id="${id}"]`,
      );
      if (
        currentActiveBtn &&
        currentActiveBtn.classList.contains("border-[#f97316]")
      ) {
        // Si tocaste la misma sección en la que ya estás, solo sube
        window.scrollTo({ top: 0, behavior: "smooth" });
        return;
      }

      const guide = guides.find((g) => g.id === id);
      if (!guide || !contentArea) return;

      // Actualizar contenido instantáneamente sin parpadeos
      if (elements.badge) {
        elements.badge.className = `${guide.difficultyColor} ${guide.difficultyTextColor} px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide`;
        elements.badge.textContent = guide.difficulty;
      }

      if (elements.time) elements.time.textContent = guide.time;
      if (elements.title) elements.title.textContent = guide.contentTitle;
      if (elements.desc) elements.desc.textContent = guide.description;

      if (elements.body) {
        elements.body.innerHTML = renderGuideSections(guide.sections);
      }

      // Animación súper sutil de entrada
      contentArea.style.animation = "none";
      void contentArea.offsetWidth;
      contentArea.style.animation = "fadeInUp 0.4s ease-out forwards";

      // Hacer scroll suave hacia arriba al cambiar de sección
      window.scrollTo({ top: 0, behavior: "smooth" });

      document.querySelectorAll(".guide-btn").forEach((btn) => {
        const button = btn as HTMLElement;
        if (button.dataset.id === id) {
          button.classList.remove(
            "text-[#a1a1aa]",
            "hover:text-white",
            "hover:bg-white/5",
            "border-transparent",
          );
          button.classList.add(
            "text-[#f97316]",
            "font-semibold",
            "bg-[#f97316]/10",
            "border-[#f97316]",
          );
        } else {
          button.classList.remove(
            "text-[#f97316]",
            "font-semibold",
            "bg-[#f97316]/10",
            "border-[#f97316]",
          );
          button.classList.add(
            "text-[#a1a1aa]",
            "hover:text-white",
            "hover:bg-white/5",
            "border-transparent",
          );
        }
      });

      const sidebar = document.getElementById("sidebar-nav");
      if (window.innerWidth < 1024 && sidebar) {
        sidebar.classList.add("hidden");
      }
    };
  });

  function renderGuideSections(sections: GuideSection[]) {
    if (!sections) return "";
    return sections
      .map(
        (section) => `
                <div class="section-block border-t border-[#27272a] py-12 first:border-0 first:pt-0">
                    <div class="grid grid-cols-1 xl:grid-cols-12 gap-8 xl:gap-12">
                        <div class="xl:col-span-5 relative">
                            <div class="xl:sticky xl:top-28">
                                <h3 class="text-2xl font-bold text-white mb-5 flex items-center gap-3">
                                    <i class="${(window as any).emojiToIcon?.[section.icon || ""] || "fas fa-layer-group"} text-[#f97316]"></i> 
                                    ${section.title}
                                </h3>
                                ${section.content ? `<div class="text-zinc-400 leading-relaxed text-sm md:text-base">${section.content}</div>` : ""}
                            </div>
                        </div>
                        
                        <div class="xl:col-span-7">
                            ${
                              section.commands
                                ? `
                                <div class="bg-[#0a0a0a] border border-[#27272a] rounded-xl overflow-hidden shadow-[0_8px_30px_rgba(0,0,0,0.5)] flex flex-col divide-y divide-[#27272a]/50">
                                    ${section.commands
                                      .map(
                                        (cmd: Command) => `
                                        <div class="p-5 flex flex-col sm:flex-row sm:items-start gap-4 hover:bg-white/[0.02] transition-colors group">
                                            <div class="shrink-0 sm:w-48">
                                                <code class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-[#050505] border border-[#27272a] text-[#f97316] font-mono text-sm shadow-sm group-hover:border-[#f97316]/30 transition-colors">
                                                    ${cmd.emoji ? `<i class="${(window as any).emojiToIcon?.[cmd.emoji] || "fas fa-terminal"} opacity-70"></i>` : ""}
                                                    ${cmd.name}
                                                </code>
                                            </div>
                                            <div class="flex-1 pt-0.5">
                                                <span class="text-sm text-zinc-400 leading-relaxed block">${cmd.description}</span>
                                            </div>
                                        </div>
                                    `,
                                      )
                                      .join("")}
                                </div>
                            `
                                : ""
                            }
                        </div>
                    </div>
                </div>
        `,
      )
      .join("");
  }
</script>
