---

---

<div class="mb-12 max-w-4xl mx-auto">
    <div class="flex flex-col md:flex-row gap-4 mb-8">
        <div class="flex-1 relative group">
            <i
                class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-[#b0b0b0] group-focus-within:text-[#5865F2] transition-colors"
            ></i>
            <input
                type="text"
                id="searchInput"
                placeholder="Buscar guías..."
                class="w-full bg-white/5 text-white pl-12 pr-6 py-4 rounded-xl border border-white/10 focus:border-[#5865F2]/50 focus:bg-white/10 focus:outline-none transition-all placeholder:text-[#666]"
            />
        </div>
    </div>

    <div
        class="flex flex-wrap justify-center gap-3 md:gap-4"
        id="filterButtons"
    >
        <button
            class="filter-btn active px-6 py-2.5 rounded-xl border border-white/10 bg-white/5 text-white hover:bg-white/10 transition-all cursor-pointer data-[active=true]:bg-[#5865F2] data-[active=true]:border-[#5865F2] data-[active=true]:text-white data-[active=true]:shadow-lg data-[active=true]:shadow-[#5865F2]/20 shadow-sm"
            data-filter="all"
            data-active="true"
        >
            Todas
        </button>
        <button
            class="filter-btn px-6 py-2.5 rounded-xl border border-white/10 bg-white/5 text-[#b0b0b0] hover:bg-white/10 hover:text-white transition-all cursor-pointer hover:-translate-y-0.5"
            data-filter="bot-ayuda"
        >
            <i class="fas fa-robot mr-2"></i>Bot Ayuda
        </button>
        <button
            class="filter-btn px-6 py-2.5 rounded-xl border border-white/10 bg-white/5 text-[#b0b0b0] hover:bg-white/10 hover:text-white transition-all cursor-pointer hover:-translate-y-0.5"
            data-filter="bot-gaming"
        >
            <i class="fas fa-gamepad mr-2"></i>Bot Gaming
        </button>
        <button
            class="filter-btn px-6 py-2.5 rounded-xl border border-white/10 bg-white/5 text-[#b0b0b0] hover:bg-white/10 hover:text-white transition-all cursor-pointer hover:-translate-y-0.5"
            data-filter="configuracion"
        >
            <i class="fas fa-cog mr-2"></i>Configuración
        </button>
    </div>
</div>

<script>
    const filterButtons = document.querySelectorAll(".filter-btn");
    const searchInput = document.getElementById("searchInput");

    function filterCards() {
        const cards = document.querySelectorAll(".guide-card");
        const activeBtn = document.querySelector(".filter-btn.active");
        const filterValue = activeBtn?.getAttribute("data-filter") || "all";
        const searchTerm =
            (searchInput as HTMLInputElement)?.value.toLowerCase() || "";

        cards.forEach((card) => {
            const category = card.getAttribute("data-category");
            const title = card.getAttribute("data-title") || "";
            const description = card.getAttribute("data-description") || "";

            const matchesFilter =
                filterValue === "all" || category === filterValue;
            const matchesSearch =
                title.includes(searchTerm) || description.includes(searchTerm);

            if (matchesFilter && matchesSearch) {
                (card as HTMLElement).style.display = "flex";
                card.classList.add("animate-[fadeInUp_0.4s_ease-out_forwards]");
            } else {
                (card as HTMLElement).style.display = "none";
                card.classList.remove(
                    "animate-[fadeInUp_0.4s_ease-out_forwards]",
                );
            }
        });
    }

    filterButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
            filterButtons.forEach((b) => {
                b.removeAttribute("data-active");
                b.classList.remove("active");
                if (b === btn) {
                    b.setAttribute("data-active", "true");
                    b.classList.add("active");
                }
            });

            filterCards();
        });
    });

    searchInput?.addEventListener("input", filterCards);
</script>
