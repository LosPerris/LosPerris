---
import GuideCard from "./GuideCard.astro";
import { guides } from "../../data/guides";
---

<div
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
    id="guidesGrid"
>
    {guides.map((guide) => <GuideCard guide={guide} />)}
</div>

<script define:vars={{ guides }} is:inline>
    if (!window.guideContent) {
        window.guideContent = {};
    }

    guides.forEach((guide) => {
        window.guideContent[guide.id] = {
            title: guide.contentTitle,
            content: guide.content,
        };
    });

    window.openGuide = (id) => {
        const guide = window.guideContent[id];
        if (guide) {
            const modal = document.getElementById("guideModal");
            const modalTitle = modal?.querySelector("h2");
            const modalBody = modal?.querySelector(".modal-body");

            if (modal && modalTitle && modalBody) {
                modalTitle.textContent = guide.title;
                modalBody.innerHTML = guide.content;
                modal.classList.remove("hidden");
                document.body.style.overflow = "hidden";
            }
        }
    };
</script>
