---
import { guides } from "../../data/guides";
import { helpBotData, gameBotData } from "../../data/bots";
import { Image } from "astro:assets";
import BackButton from "../ui/BackButton.astro";

const categoryImages = {
  "Bot Ayuda": helpBotData.imageSrc,
  "Bot Gaming": gameBotData.imageSrc,
};

const groupedGuides = guides.reduce(
  (acc, guide) => {
    const categoryName =
      guide.category === "bot-ayuda"
        ? "Bot Ayuda"
        : guide.category === "bot-gaming"
          ? "Bot Gaming"
          : "Configuración";

    if (!acc[categoryName]) {
      acc[categoryName] = [];
    }
    acc[categoryName].push(guide);
    return acc;
  },
  {} as Record<string, typeof guides>,
);

interface Props {
  activeId?: string;
}

const { activeId } = Astro.props;
const categories = Object.keys(groupedGuides);
---

<aside
  class="w-full lg:w-72 shrink-0 lg:border-r border-[#27272a] bg-[#050505] lg:h-[calc(100vh-80px)] lg:sticky lg:top-20 overflow-y-auto"
>
  <div class="p-6 lg:p-0">
    <div class="mb-6 lg:hidden">
      <button
        id="toggle-sidebar"
        class="w-full py-3 bg-[#111111] text-[#b0b0b0] rounded-lg font-medium border border-[#27272a] flex items-center justify-center gap-2 hover:bg-[#18181b] hover:text-white transition-colors"
      >
        <i class="fas fa-bars"></i> Índice de Documentación
      </button>
    </div>

    <nav id="sidebar-nav" class="hidden lg:block space-y-2 lg:p-6 lg:pt-10">
      <BackButton class="mb-8" />
      <h2
        class="text-xs font-black text-[#f97316] uppercase tracking-[0.2em] mb-6 pl-2 hidden lg:block"
      >
        Documentación
      </h2>
      {
        categories.map((category) => {
          return (
            <div class="category-group mb-6">
              <div class="flex items-center gap-2 px-2 mb-3">
                {categoryImages[category as keyof typeof categoryImages] ? (
                  <Image
                    src={
                      categoryImages[category as keyof typeof categoryImages]
                    }
                    alt=""
                    class="w-4 h-4 rounded-full"
                    width={16}
                    height={16}
                    aria-hidden="true"
                    loading="eager"
                  />
                ) : (
                  <i
                    class="fas fa-cog text-gray-500 text-[10px] w-4 text-center"
                    aria-hidden="true"
                  />
                )}
                <span class="text-xs font-bold text-gray-500 uppercase tracking-widest">
                  {category}
                </span>
              </div>

              <div class="pl-2">
                <ul class="space-y-1">
                  {groupedGuides[category].map((guide) => {
                    const isActive = guide.id === activeId;
                    return (
                      <li>
                        <button
                          class={`guide-btn w-full text-left px-3 py-2 text-sm transition-colors duration-200 flex items-center justify-between group rounded-lg border-l-2
                                                    ${
                                                      isActive
                                                        ? "text-[#f97316] font-semibold bg-[#f97316]/10 border-[#f97316]"
                                                        : "text-[#a1a1aa] hover:text-white hover:bg-white/5 border-transparent"
                                                    }`}
                          data-id={guide.id}
                          onclick={`switchGuide('${guide.id}')`}
                        >
                          <span class="truncate ml-2">{guide.title}</span>
                        </button>
                      </li>
                    );
                  })}
                </ul>
              </div>
            </div>
          );
        })
      }
    </nav>
  </div>
</aside>
