---
import Card from "../ui/Card.astro";

interface Props {
  method: string;
  path: string;
  description: string;
  example: string;
}

const { method, path, description, example } = Astro.props;

const getMethodColor = (m: string) => {
  switch (m.toUpperCase()) {
    case "GET":
      return "text-[#22c55e] bg-[#22c55e]/10 border-[#22c55e]/20";
    case "POST":
      return "text-[#f97316] bg-[#f97316]/10 border-[#f97316]/20";
    case "WEB":
      return "text-zinc-400 bg-white/5 border-white/10";
    default:
      return "text-zinc-400 bg-white/5 border-white/10";
  }
};

const methodBadge = getMethodColor(method);
---

<Card
  hoverEffect={false}
  class="group relative !p-0 bg-[#090a0b] border-zinc-800/80 transition-all duration-300 overflow-hidden flex flex-col"
>
  <div
    class="flex items-center justify-between p-5 border-b border-zinc-800/50 bg-white/[0.01]"
  >
    <div class="flex items-center gap-3 overflow-hidden">
      <span
        class={`px-2 py-1 rounded-[6px] text-[10px] font-mono font-bold tracking-widest border ${methodBadge}`}
      >
        {method.toUpperCase()}
      </span>
      <span class="font-mono text-[13px] text-zinc-300 truncate font-medium">
        {path}
      </span>
    </div>

    {
      example && (
        <button
          class="copy-btn w-8 h-8 rounded-lg bg-white/[0.03] border border-white/5 flex items-center justify-center text-zinc-500 hover:text-white hover:bg-white/10 transition-colors shrink-0"
          data-clipboard={example}
          aria-label="Copiar endpoint"
          title="Copiar URL"
        >
          <i class="fas fa-copy text-sm pointer-events-none" />
          <i class="fas fa-check text-sm text-[#22c55e] hidden pointer-events-none" />
        </button>
      )
    }
  </div>

  <div class="p-5 flex flex-col gap-4">
    <p
      class="text-[14px] text-zinc-400 leading-relaxed group-hover:text-zinc-300 transition-colors"
    >
      {description}
    </p>

    {
      example && (
        <div class="mt-2 bg-[#000000] rounded-xl border border-zinc-800/50 p-4 overflow-x-auto">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-zinc-700" />
            <span class="w-2 h-2 rounded-full bg-zinc-700" />
            <span class="w-2 h-2 rounded-full bg-zinc-700" />
          </div>
          <code class="font-mono text-[12px] text-zinc-300 opacity-90 break-all">
            {example}
          </code>
        </div>
      )
    }
  </div>
</Card>
