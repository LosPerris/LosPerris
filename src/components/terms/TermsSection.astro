---
interface Props {
    title: string;
    icon: string;
    content: string;
    index: number;
}

const { title, icon, content, index } = Astro.props;
const delay = `${index * 0.1}s`;
---

<section
    class="bg-secondary mb-8 p-8 rounded-xl border border-[#404040] transition-all shadow-md hover:-translate-y-1 hover:shadow-xl animate-[fadeInUp_0.6s_ease_forwards] opacity-0"
    style={{ animationDelay: delay }}
>
    <h2
        class="text-white mb-6 text-2xl flex items-center gap-3 pb-2 border-b-2 border-[#404040]"
    >
        <i class={icon}></i>
        {title}
    </h2>
    <div class="text-text-secondary leading-relaxed" set:html={content} />
</section>
