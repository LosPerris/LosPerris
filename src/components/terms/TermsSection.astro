---
interface Props {
  title: string;
  icon: string;
  content: string;
  index: number;
}

const { title, icon, content, index } = Astro.props;
const delay = `${index * 0.1}s`;
---

<section
  class="bg-[#111111] mb-8 p-8 rounded-xl border border-[#27272a] hover:border-[#f97316]/30 transition-all shadow-md hover:-translate-y-1 hover:shadow-[0_8px_30px_rgba(249,115,22,0.05)] animate-[fadeInUp_0.6s_ease_forwards] opacity-0 group"
  style={{ animationDelay: delay }}
>
  <h2
    class="text-white mb-6 text-2xl flex items-center gap-4 pb-4 border-b border-[#27272a]"
  >
    <div
      class="w-10 h-10 rounded-lg bg-[#f97316]/10 flex items-center justify-center shrink-0 border border-[#f97316]/20 group-hover:bg-[#f97316]/20 transition-colors"
    >
      <i class={`${icon} text-[#f97316]`}></i>
    </div>
    {title}
  </h2>
  <div class="text-text-secondary leading-relaxed" set:html={content} />
</section>
