---
import { discordLink, domain } from "../data/community";
const pathname = new URL(Astro.request.url).pathname;
const isHome =
  pathname === "/" || pathname === "/index.html" || pathname === "/index";

const getLink = (hash: string) => {
  if (hash.startsWith("http")) return hash;
  if (hash === "index.html" || hash === "/") return "/";
  if (!hash.startsWith("#")) return hash;
  return isHome ? hash : `/${hash}`;
};
---

<footer
  class="bg-[#050505] border-t border-[#f97316]/40 py-10 mt-auto relative z-10"
>
  <div class="max-w-6xl mx-auto px-6">
    <div
      class="flex flex-col md:flex-row justify-between items-start gap-10 mb-10"
    >
      <!-- Logo y Descripción -->
      <div class="md:w-1/3">
        <div class="flex items-center gap-3 mb-6">
          <img
            src="/LosPerris-minimal.svg"
            alt="LosPerris Logo"
            class="w-8 h-8"
            loading="lazy"
            decoding="async"
          />
          <h3 class="text-xl font-bold text-white tracking-wide">LosPerris</h3>
        </div>
        <p class="text-zinc-400 text-sm leading-relaxed">
          Potenciando comunidades de Discord con herramientas, APIs y bots de
          alto rendimiento diseñados para creadores y desarrolladores.
        </p>
      </div>

      <!-- Enlaces del Ecosistema -->
      <div class="md:w-2/3 grid grid-cols-2 md:grid-cols-3 gap-8">
        <div class="space-y-4">
          <h3
            class="text-sm font-semibold text-white uppercase tracking-wider mb-4"
          >
            Productos
          </h3>
          <ul class="space-y-3">
            <li>
              <a
                href={getLink("#bots")}
                class="text-zinc-400 hover:text-zinc-200 transition-colors text-sm"
                >Bots de Moderación</a
              >
            </li>
            <li>
              <a
                href={getLink("#apis")}
                class="text-zinc-400 hover:text-zinc-200 transition-colors text-sm"
                >APIs Públicas</a
              >
            </li>
          </ul>
        </div>

        <div class="space-y-4">
          <h3
            class="text-sm font-semibold text-white uppercase tracking-wider mb-4"
          >
            Soporte
          </h3>
          <ul class="space-y-3">
            <li>
              <a
                href={discordLink}
                class="text-zinc-400 hover:text-zinc-200 transition-colors text-sm"
                >Servidor de Discord</a
              >
            </li>
            <li>
              <a
                href="https://status.losperris.dev"
                target="_blank"
                rel="noopener noreferrer"
                class="text-zinc-400 hover:text-zinc-200 transition-colors text-sm"
                >Estado del Sistema</a
              >
            </li>
          </ul>
        </div>

        <div class="space-y-4">
          <h3
            class="text-sm font-semibold text-white uppercase tracking-wider mb-4"
          >
            Legal
          </h3>
          <ul class="space-y-3">
            <li>
              <a
                href="/terminos"
                class="text-zinc-400 hover:text-zinc-200 transition-colors text-sm"
                >Términos de Servicio</a
              >
            </li>
            <li>
              <a
                href="/politica-privacidad"
                class="text-zinc-400 hover:text-zinc-200 transition-colors text-sm"
                >Privacidad</a
              >
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Línea final -->
    <div
      class="flex flex-col md:flex-row justify-between items-center pt-8 border-t border-[#f97316]/20"
    >
      <p class="text-white text-sm">
        &copy; {new Date().getFullYear()}
        {domain}. Todos los derechos reservados.
      </p>
      <!-- Better Stack Live Badge -->
      <a
        href="https://status.losperris.dev"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 md:mt-0 flex items-center justify-center opacity-80 hover:opacity-100 transition-opacity"
        aria-label="Ver estado de los servicios (Página externa)"
      >
        <iframe
          src="https://status.losperris.dev/badge?theme=dark"
          width="250"
          height="30"
          frameborder="0"
          scrolling="no"
          title="Estado de los servicios de LosPerris"
          loading="lazy"
          style="color-scheme: normal; pointer-events: none;"></iframe>
      </a>
    </div>
  </div>
</footer>
