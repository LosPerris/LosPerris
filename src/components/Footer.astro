---
import { discordLink, domain } from "../data/community";

const pathname = new URL(Astro.request.url).pathname;
const isHome =
  pathname === "/" || pathname === "/index.html" || pathname === "/index";

const getLink = (hash: string) => {
  if (hash.startsWith("http")) return hash;
  if (hash === "index.html" || hash === "/") return "/";
  if (!hash.startsWith("#")) return hash;
  return isHome ? hash : `/${hash}`;
};

const year = new Date().getFullYear();

const nav = [
  {
    heading: "Productos",
    links: [
      { label: "APIs Públicas", href: getLink("#apis") },
      { label: "Actualizaciones", href: "/actualizaciones" },
      {
        label: "Estado del sistema",
        href: "https://status.losperris.dev",
        external: true,
      },
    ],
  },
  {
    heading: "Comunidad",
    links: [
      { label: "Discord", href: discordLink, external: true },
      {
        label: "Canal de APIs",
        href: "https://discord.com/channels/1158802490561667103/1447647406639288420",
        external: true,
      },
    ],
  },
];
---

<footer class="relative z-10 bg-[#090a0b] border-t border-zinc-800/80 mt-auto">
  <div class="max-w-6xl mx-auto px-6 py-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <div class="md:col-span-1">
        <a href="/" class="flex items-center gap-3 mb-5 group w-fit">
          <img
            src="/LosPerris-minimal.svg"
            alt="LosPerris"
            class="w-8 h-8 group-hover:scale-110 transition-transform duration-300 drop-shadow-[0_0_8px_rgba(249,115,22,0.5)]"
            loading="lazy"
            decoding="async"
          />
          <span class="text-lg font-bold text-white tracking-tight"
            >LosPerris</span
          >
        </a>
        <p class="text-[14px] text-zinc-500 leading-relaxed">
          APIs públicas y gratuitas para streamers y desarrolladores.
        </p>

        <div class="flex items-center gap-3 mt-6">
          <a
            href={discordLink}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Discord"
            class="w-9 h-9 rounded-lg bg-zinc-800/50 border border-zinc-700/50 flex items-center justify-center text-zinc-400 hover:text-[#5865F2] hover:border-[#5865F2]/40 hover:bg-[#5865F2]/10 transition-all duration-200"
          >
            <i class="fab fa-discord text-sm"></i>
          </a>
          <a
            href="https://status.losperris.dev"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Status"
            class="w-9 h-9 rounded-lg bg-zinc-800/50 border border-zinc-700/50 flex items-center justify-center text-zinc-400 hover:text-[#22c55e] hover:border-[#22c55e]/40 hover:bg-[#22c55e]/10 transition-all duration-200"
          >
            <i class="fas fa-circle-check text-sm"></i>
          </a>
        </div>
      </div>

      {
        nav.map((col) => (
          <div>
            <h4 class="text-[10px] font-mono font-bold text-zinc-500 uppercase tracking-widest mb-5">
              {col.heading}
            </h4>
            <ul class="space-y-3">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                    class="text-[14px] text-zinc-400 hover:text-white transition-colors duration-200 flex items-center gap-1.5 group w-fit"
                  >
                    {link.label}
                    {link.external && (
                      <i class="fas fa-arrow-up-right-from-square text-[10px] opacity-0 group-hover:opacity-60 transition-opacity" />
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-8 border-t border-zinc-800/80"
    >
      <p class="text-zinc-500 text-sm">
        © {year}
        {domain} · Hecho con <span class="text-[#f97316]">♥</span> para la comunidad
      </p>

      <a
        href="https://status.losperris.dev"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Estado de los servicios"
        class="flex items-center gap-1.5 bg-[#22c55e]/5 px-3 py-1.5 rounded-md text-[9px] text-[#22c55e] font-mono uppercase tracking-widest border border-[#22c55e]/20 hover:border-[#22c55e]/40 hover:bg-[#22c55e]/10 transition-all shadow-[0_0_10px_rgba(34,197,94,0.05)]"
      >
        <span
          class="w-1.5 h-1.5 rounded-full bg-[#22c55e] shadow-[0_0_8px_rgba(34,197,94,0.6)] animate-pulse"
        ></span>
        Sistemas operativos
      </a>
    </div>
  </div>
</footer>
