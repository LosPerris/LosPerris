---
import { faqs } from "../../data/faq";
import Section from "../ui/Section.astro";
---

<Section class="bg-[#404040]">
    <h2 class="text-3xl font-semibold mb-8 text-white text-center">
        Preguntas frecuentes
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        {
            faqs.map((faq) => (
                <div class="p-8 bg-[#2d2d2d] rounded-xl border-l-4 border-[#404040] transition-all border border-[#404040] hover:-translate-y-1 hover:shadow-2xl hover:border-[#404040]">
                    <h3 class="text-lg font-semibold mb-4 text-white flex items-center gap-2">
                        <i class="fas fa-question-circle text-[#b0b0b0]" />
                        {faq.question}
                    </h3>
                    <p class="text-[#b0b0b0] leading-relaxed">{faq.answer}</p>
                </div>
            ))
        }
    </div>
</Section>
