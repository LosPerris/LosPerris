---
import { faqs } from "../../data/faq";
import Section from "../ui/Section.astro";
---

<Section class="bg-transparent">
  <h2 class="text-3xl font-semibold mb-8 text-white text-center">
    Preguntas frecuentes
  </h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
    {
      faqs.map((faq) => (
        <div class="p-8 bg-white/2 rounded-xl border-l-4 transition-all border-y border-r border-white/10 hover:-translate-y-1 hover:shadow-2xl hover:bg-white/4">
          <h3 class="text-lg font-semibold mb-4 text-white flex items-center gap-2">
            <i
              class="fas fa-question-circle text-[#5865F2]"
              aria-hidden="true"
            />
            {faq.question}
          </h3>
          <p class="text-text-secondary leading-relaxed">{faq.answer}</p>
        </div>
      ))
    }
  </div>
</Section>
