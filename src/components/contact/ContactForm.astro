---
import Button from "../ui/Button.astro";
import { contactEmail } from "../../data/community";
---

<div class="h-full">
    <h2 class="text-3xl font-semibold mb-8 text-white">Envíanos un mensaje</h2>
    <form
        class="flex flex-col gap-6"
        id="contactForm"
        data-to-email={contactEmail}
    >
        <div class="flex flex-col">
            <label
                for="nombre"
                class="font-medium mb-2 block text-text-secondary"
                >Nombre completo</label
            >
            <input
                type="text"
                id="nombre"
                name="nombre"
                required
                class="w-full px-4 py-3 border border-white/10 rounded-xl text-base bg-white/5 text-white transition-all focus:outline-none focus:border-[#5865F2] focus:bg-white/10 placeholder:text-white/20"
                placeholder="Tu nombre"
            />
        </div>
        <div class="flex flex-col">
            <label
                for="email"
                class="font-medium mb-2 block text-text-secondary"
                >Correo electrónico</label
            >
            <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 border border-white/10 rounded-xl text-base bg-white/5 text-white transition-all focus:outline-none focus:border-[#5865F2] focus:bg-white/10 placeholder:text-white/20"
                placeholder="tu@email.com"
            />
        </div>
        <div class="flex flex-col">
            <label
                for="asunto"
                class="font-medium mb-2 block text-text-secondary">Asunto</label
            >
            <select
                id="asunto"
                name="asunto"
                required
                class="w-full px-4 py-3 border border-white/10 rounded-xl text-base bg-white/5 text-white transition-all focus:outline-none focus:border-[#5865F2] focus:bg-white/10 appearance-none"
            >
                <option value="" class="bg-[#151515] text-white"
                    >Selecciona un asunto</option
                >
                <option value="Soporte API" class="bg-[#151515] text-white"
                    >Soporte API</option
                >
                <option value="Acceso a API" class="bg-[#151515] text-white"
                    >Solicitar Acceso API</option
                >
                <option value="Ayuda técnica" class="bg-[#151515] text-white"
                    >Ayuda técnica general</option
                >
                <option value="Sugerencia" class="bg-[#151515] text-white"
                    >Sugerencia</option
                >
                <option value="Reporte de bug" class="bg-[#151515] text-white"
                    >Reporte de bug</option
                >
                <option value="Colaboración" class="bg-[#151515] text-white"
                    >Colaboración</option
                >
                <option value="Consulta general" class="bg-[#151515] text-white"
                    >Otro</option
                >
            </select>
        </div>
        <div class="flex flex-col">
            <label
                for="mensaje"
                class="font-medium mb-2 block text-text-secondary"
                >Mensaje</label
            >
            <textarea
                id="mensaje"
                name="mensaje"
                rows="6"
                required
                placeholder="Describe tu consulta o mensaje..."
                class="w-full px-4 py-3 border border-white/10 rounded-xl text-base bg-white/5 text-white transition-all focus:outline-none focus:border-[#5865F2] focus:bg-white/10 resize-none min-h-[120px] placeholder:text-white/20"
            ></textarea>
        </div>
        <Button type="submit" class="w-full">
            <i class="fas fa-paper-plane mr-2"></i>
            Enviar mensaje
        </Button>
    </form>
</div>

<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"
></script>
<script is:inline>
    (function () {
        if (window.emailjs) {
            emailjs.init("GMUaeNqA-ftlkGhwm");
        }
    })();

    const form = document.getElementById("contactForm");

    if (form) {
        const inputs = form.querySelectorAll("input, select, textarea");
        inputs.forEach((input) => {
            input.addEventListener("blur", validateField);
            input.addEventListener("input", clearErrors);
        });

        form.addEventListener("submit", function (event) {
            event.preventDefault();

            const btn = form.querySelector('button[type="submit"]');
            const originalText = btn.innerHTML;

            let isValid = true;
            inputs.forEach((input) => {
                if (!validateField({ target: input })) isValid = false;
            });

            if (!isValid) {
                showNotification("Por favor corrige los errores.", "error");
                return;
            }

            if (btn) {
                btn.innerHTML =
                    '<i class="fas fa-spinner fa-spin mr-2"></i> Enviando...';
                btn.disabled = true;
            }

            const templateParams = {
                from_name: form.nombre.value.trim(),
                from_email: form.email.value.trim(),
                subject: form.asunto.value.trim(),
                message: form.mensaje.value.trim(),
                to_email: form.dataset.toEmail,
                sent_date: new Date().toLocaleString("es-ES"),
            };

            if (window.emailjs) {
                emailjs
                    .send("service_3hduvpa", "template_f4qyw0q", templateParams)
                    .then(function (response) {
                        showNotification(
                            "¡Mensaje enviado correctamente!",
                            "success",
                        );
                        form.reset();
                    })
                    .catch(function (error) {
                        console.error("FAILED...", error);
                        showNotification(
                            "Error al enviar. Inténtalo de nuevo.",
                            "error",
                        );
                    })
                    .finally(function () {
                        btn.innerHTML = originalText;
                        btn.disabled = false;
                    });
            }
        });
    }

    function validateField(event) {
        const field = event.target;
        const value = field.value.trim();
        clearFieldError(field);

        if (field.hasAttribute("required") && !value) {
            showFieldError(field, "Este campo es obligatorio");
            return false;
        }

        if (field.type === "email" && value) {
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(value)) {
                showFieldError(field, "Email inválido");
                return false;
            }
        }
        return true;
    }

    function showFieldError(field, message) {
        const error = document.createElement("span");
        error.className = "field-error text-red-500 text-sm mt-1 block";
        error.innerText = message;
        field.style.borderColor = "#ef4444";
        field.parentElement.appendChild(error);
    }

    function clearFieldError(field) {
        const error = field.parentElement.querySelector(".field-error");
        if (error) error.remove();
        field.style.borderColor = "rgba(255, 255, 255, 0.1)";
    }

    function clearErrors(event) {
        clearFieldError(event.target);
    }

    function showNotification(message, type = "info") {
        const notification = document.createElement("div");
        notification.className = `fixed top-5 right-5 z-50 p-4 rounded-lg shadow-xl flex items-center gap-3 animate-[slideIn_0.3s_ease] border border-white/10 ${
            type === "success"
                ? "bg-green-900/90 text-green-100"
                : type === "error"
                  ? "bg-red-900/90 text-red-100"
                  : "bg-gray-800 text-white"
        }`;

        notification.innerHTML = `
            <i class="fas ${type === "success" ? "fa-check-circle" : "fa-exclamation-circle"}"></i>
            <span>${message}</span>
        `;

        document.body.appendChild(notification);
        setTimeout(() => notification.remove(), 4000);
    }
</script>
