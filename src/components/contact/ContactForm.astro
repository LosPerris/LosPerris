---
import Button from "../ui/Button.astro";
import { contactEmail } from "../../data/community";
---

<div class="h-full">
    <h2 class="text-3xl font-semibold mb-8 text-white">Envíanos un mensaje</h2>
    <form
        class="flex flex-col gap-6"
        id="contactForm"
        data-to-email={contactEmail}
    >
        <div class="flex flex-col">
            <label
                for="nombre"
                class="font-medium mb-2 block text-text-secondary"
                >Nombre completo</label
            >
            <input
                type="text"
                id="nombre"
                name="nombre"
                required
                class="w-full px-4 py-3 border border-white/10 rounded-xl text-base bg-white/5 text-white transition-all focus:outline-none focus:border-[#5865F2] focus:bg-white/10 placeholder:text-white/20"
                placeholder="Tu nombre"
            />
        </div>
        <div class="flex flex-col">
            <label
                for="email"
                class="font-medium mb-2 block text-text-secondary"
                >Correo electrónico</label
            >
            <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 border border-white/10 rounded-xl text-base bg-white/5 text-white transition-all focus:outline-none focus:border-[#5865F2] focus:bg-white/10 placeholder:text-white/20"
                placeholder="tu@email.com"
            />
        </div>
        <div class="flex flex-col">
            <label
                for="asunto"
                class="font-medium mb-2 block text-text-secondary">Asunto</label
            >
            <select
                id="asunto"
                name="asunto"
                required
                class="w-full px-4 py-3 border border-white/10 rounded-xl text-base bg-white/5 text-white transition-all focus:outline-none focus:border-[#5865F2] focus:bg-white/10 appearance-none"
            >
                <option value="" class="bg-[#151515] text-white"
                    >Selecciona un asunto</option
                >
                <option value="Soporte API" class="bg-[#151515] text-white"
                    >Soporte API</option
                >
                <option value="Acceso a API" class="bg-[#151515] text-white"
                    >Solicitar Acceso API</option
                >
                <option value="Ayuda técnica" class="bg-[#151515] text-white"
                    >Ayuda técnica general</option
                >
                <option value="Sugerencia" class="bg-[#151515] text-white"
                    >Sugerencia</option
                >
                <option value="Reporte de bug" class="bg-[#151515] text-white"
                    >Reporte de bug</option
                >
                <option value="Colaboración" class="bg-[#151515] text-white"
                    >Colaboración</option
                >
                <option value="Consulta general" class="bg-[#151515] text-white"
                    >Otro</option
                >
            </select>
        </div>
        <div class="flex flex-col">
            <label
                for="mensaje"
                class="font-medium mb-2 block text-text-secondary"
                >Mensaje</label
            >
            <textarea
                id="mensaje"
                name="mensaje"
                rows="6"
                required
                placeholder="Describe tu consulta o mensaje..."
                class="w-full px-4 py-3 border border-white/10 rounded-xl text-base bg-white/5 text-white transition-all focus:outline-none focus:border-[#5865F2] focus:bg-white/10 resize-none min-h-[120px] placeholder:text-white/20"
            ></textarea>
        </div>
        <Button type="submit" class="w-full">
            <i class="fas fa-paper-plane mr-2"></i>
            Enviar mensaje
        </Button>
    </form>
</div>
