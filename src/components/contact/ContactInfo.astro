---
import {
  discordLink,
  discordTicketLink,
  contactEmail,
} from "../../data/community";
---

<div class="flex flex-col gap-8 mb-12">
  <h2 class="text-3xl font-semibold mb-8 text-white text-center">
    Información de contacto
  </h2>

  <div
    class="flex items-start gap-4 p-6 bg-black/40 backdrop-blur-sm rounded-xl border border-white/5 transition-all hover:-translate-y-2 hover:shadow-2xl hover:border-[#5865F2]/50 hover:bg-black/60 group"
  >
    <div
      class="w-12 h-12 bg-white/5 rounded-xl flex items-center justify-center text-white text-xl shrink-0 group-hover:scale-110 transition-transform"
    >
      <i class="fab fa-discord" aria-hidden="true"></i>
    </div>
    <div>
      <h3 class="text-lg font-semibold mb-2 text-white">Discord</h3>
      <p class="text-text-secondary mb-2 text-sm">
        Únete a nuestro servidor oficial
      </p>
      <a
        href={discordLink}
        class="text-text-secondary no-underline font-medium transition-colors hover:text-white"
        target="_blank"
      >
        {discordLink.replace("https://", "")}
      </a>
    </div>
  </div>

  <div
    class="flex items-start gap-4 p-6 bg-black/40 backdrop-blur-sm rounded-xl border border-white/5 transition-all hover:-translate-y-2 hover:shadow-2xl hover:border-[#5865F2]/50 hover:bg-black/60 group"
  >
    <div
      class="w-12 h-12 bg-white/5 rounded-xl flex items-center justify-center text-white text-xl shrink-0 group-hover:scale-110 transition-transform"
    >
      <i class="fas fa-envelope" aria-hidden="true"></i>
    </div>
    <div>
      <h3 class="text-lg font-semibold mb-2 text-white">Email</h3>
      <p class="text-text-secondary mb-2 text-sm">Respuesta en 24-48 horas</p>
      <a
        href={`mailto:${contactEmail}`}
        class="text-text-secondary no-underline font-medium transition-colors hover:text-white"
      >
        {contactEmail}
      </a>
    </div>
  </div>

  <div
    class="flex items-start gap-4 p-6 bg-black/40 backdrop-blur-sm rounded-xl border border-white/5 transition-all hover:-translate-y-2 hover:shadow-2xl hover:border-[#5865F2]/50 hover:bg-black/60 group"
  >
    <div
      class="w-12 h-12 bg-white/5 rounded-xl flex items-center justify-center text-white text-xl shrink-0 group-hover:scale-110 transition-transform"
    >
      <i class="fas fa-question-circle" aria-hidden="true"></i>
    </div>
    <div>
      <h3 class="text-lg font-semibold mb-2 text-white">Ayuda rápida</h3>
      <p class="text-text-secondary mb-2 text-sm">Para problemas urgentes</p>
      <a
        href={discordTicketLink}
        class="text-text-secondary no-underline font-medium transition-colors hover:text-white"
        target="_blank"
      >
        Abrir ticket de ayuda
      </a>
    </div>
  </div>
</div>
