---
import Card from "../ui/Card.astro";
import Button from "../ui/Button.astro";

interface Feature {
    icon: string;
    title: string;
    description: string;
    list: string[];
}

interface Props {
    id: string;
    botName: string;
    description: string;
    imageSrc: string;
    tags: string[];
    features: Feature[];
    backgroundColor: string;
    inviteLink: string;
    commandsFunction: string;
    demoFunction: string;
    demoId: string;
}

const {
    id,
    botName,
    description,
    imageSrc,
    tags,
    features,
    backgroundColor,
    inviteLink,
    commandsFunction,
    demoFunction,
    demoId,
} = Astro.props;
---

<section id={id} class={`py-24 relative ${backgroundColor}`}>
    <div class="container mx-auto px-6">
        <div
            class="flex flex-col md:flex-row items-center gap-8 mb-12 text-left"
        >
            <img
                src={imageSrc}
                alt={botName}
                class="w-20 h-20 rounded-full border-4 border-[#404040]"
            />
            <div class="bot-info">
                <h2 class="text-4xl font-bold mb-2 text-white">{botName}</h2>
                <p class="text-xl text-[#b0b0b0]">
                    {description}
                </p>
                <div class="flex gap-4 mt-4 flex-wrap">
                    {
                        tags.map((tag) => (
                            <span class="bg-[#404040] text-white px-4 py-2 rounded-full text-sm font-semibold">
                                {tag}
                            </span>
                        ))
                    }
                </div>
            </div>
        </div>

        <div
            class={`grid grid-cols-1 md:grid-cols-2 lg:grid-cols-${Math.min(features.length, 5)} gap-4 mb-12`}
        >
            {
                features.map((feature) => (
                    <Card class="p-6 text-center">
                        <i class={`${feature.icon} text-4xl text-white mb-3`} />
                        <h3 class="text-xl font-semibold mb-3 text-white">
                            {feature.title}
                        </h3>
                        <p class="text-[#b0b0b0] text-sm mb-4">
                            {feature.description}
                        </p>
                        <ul class="text-left mt-4 text-[#b0b0b0] text-sm space-y-2">
                            {feature.list.map((item) => (
                                <li class="relative pl-5 before:content-['✓'] before:absolute before:left-0 before:text-green-500 before:font-bold">
                                    {item}
                                </li>
                            ))}
                        </ul>
                    </Card>
                ))
            }
        </div>

        <div class="flex gap-4 justify-center mb-12 flex-wrap">
            <Button href={inviteLink} target="_blank">
                <i class="fas fa-plus"></i> Invitar {botName}
            </Button>
            <Button variant="outline" onclick={commandsFunction}>
                Ver Comandos
            </Button>
            <Button variant="outline" onclick={demoFunction}>
                Demo Interactiva
            </Button>
        </div>

        <div
            class="max-w-2xl mx-auto bg-[#2d2d2d] rounded-xl overflow-hidden border border-[#404040] hidden"
            id={demoId}
        >
            <div class="bg-[#404040] p-4 flex items-center gap-2">
                <i class="fas fa-robot text-white"></i>
                <span class="font-bold text-white"
                    >{botName} - Demo en Vivo</span
                >
            </div>
            <div
                class="p-4 h-[300px] overflow-y-auto"
                id={id === "help-bot" ? "help-messages" : "game-messages"}
            >
            </div>
        </div>
    </div>
</section>
