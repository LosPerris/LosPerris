---
import Card from "../ui/Card.astro";
---

<section
    id="stats"
    class="py-24 bg-linear-to-br from-primary to-secondary text-center"
>
    <div class="container mx-auto px-6">
        <h2 class="text-4xl md:text-5xl font-bold mb-4 text-white">
            Estadísticas de LosPerrisBots
        </h2>
        <p class="text-xl text-text-secondary mb-12 max-w-2xl mx-auto">
            Sobre nosotros
        </p>

        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl mx-auto px-6"
        >
            <Card
                class="p-8 bg-secondary/50 backdrop-blur-sm group hover:bg-secondary"
            >
                <div
                    class="text-4xl text-white mb-6 bg-linear-to-br from-secondary to-[#404040] w-20 h-20 rounded-full flex items-center justify-center mx-auto shadow-lg group-hover:scale-110 transition-transform duration-300 border border-[#404040]"
                >
                    <i class="fas fa-terminal"></i>
                </div>
                <div class="stat-content">
                    <h3 class="text-4xl font-bold text-white mb-2">40+</h3>
                    <p
                        class="text-text-secondary uppercase tracking-widest text-sm mb-2 font-semibold"
                    >
                        Comandos creados
                    </p>
                    <span class="text-text-muted text-sm block"
                        >Seguiremos implementando funciones en los bots</span
                    >
                </div>
            </Card>
            <Card
                class="p-8 bg-secondary/50 backdrop-blur-sm group hover:bg-secondary"
            >
                <div
                    class="text-4xl text-white mb-6 bg-linear-to-br from-secondary to-[#404040] w-20 h-20 rounded-full flex items-center justify-center mx-auto shadow-lg group-hover:scale-110 transition-transform duration-300 border border-[#404040]"
                >
                    <i class="fas fa-clock"></i>
                </div>
                <div class="stat-content">
                    <h3 class="text-4xl font-bold text-white mb-2">99.9%</h3>
                    <p
                        class="text-text-secondary uppercase tracking-widest text-sm mb-2 font-semibold"
                    >
                        Tiempo de Actividad
                    </p>
                    <span class="text-text-muted text-sm block"
                        >Disponibilidad garantizada 24/7</span
                    >
                </div>
            </Card>
        </div>
    </div>
</section>
