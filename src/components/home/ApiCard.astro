---
import Card from "../ui/Card.astro";
import { socialIcons } from "../../data/icons";

interface ApiEndpoint {
  method: string;
  path: string;
  description: string;
  example?: string;
}

interface Props {
  api: {
    slug?: string;
    title: string;
    description: string;
    icon?: string;
    iconId?: string;
    color?: string;
    link: string;
    linkText?: string;
    baseUrl?: string;
    private?: boolean;
    endpoints?: ApiEndpoint[];
  };
}

const { api } = Astro.props;
const isExternalLink = api.link.startsWith("http");
---

<Card
  hoverEffect={false}
  class="api-card p-6 md:p-8 flex flex-col h-full group bg-[#090a0b] hover:bg-[#0c0d0e] transition-all duration-300 relative border border-zinc-800/80 hover:border-zinc-700/80"
>
  <a
    href={api.link}
    target={isExternalLink ? "_blank" : undefined}
    rel={isExternalLink ? "noopener noreferrer" : undefined}
    class="absolute inset-0 z-20"
    aria-label={`Ver detalles de ${api.title}`}></a>

  <div class="flex items-start justify-between mb-6 gap-3 relative z-10">
    <div
      class="w-12 h-12 rounded-xl bg-white/[0.03] border border-white/5 backdrop-blur-sm flex items-center justify-center text-xl shrink-0 text-zinc-400 group-hover:text-zinc-200 group-hover:scale-105 transition-all duration-300"
    >
      {
        api.iconId && socialIcons[api.iconId] ? (
          <div
            set:html={socialIcons[api.iconId]}
            class="flex items-center justify-center w-full h-full"
          />
        ) : (
          <i class={api.icon || "fas fa-code"} />
        )
      }
    </div>

    <div class="flex flex-wrap items-center justify-end gap-2">
      <span
        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-[#f97316]/10 border border-[#f97316]/20 text-[9px] font-bold tracking-widest text-[#f97316] uppercase"
      >
        <div class="w-1.5 h-1.5 rounded-full bg-[#f97316]"></div>
        {api.slug}
      </span>
      {
        api.private && (
          <span class="flex items-center gap-1.5 bg-[#5865F2]/5 px-2 py-1 rounded-md text-[9px] text-[#5865F2] font-mono uppercase tracking-widest border border-[#5865F2]/20">
            <span class="w-1.5 h-1.5 rounded-full bg-[#5865F2] animate-pulse" />
            Privada
          </span>
        )
      }
    </div>
  </div>

  <h3
    class="text-xl font-medium text-zinc-100 mb-2 tracking-tight relative z-10 group-hover:text-white transition-colors"
  >
    {api.title}
  </h3>
  <p
    class="text-zinc-500 leading-relaxed text-[14px] mb-8 grow relative z-10 group-hover:text-zinc-400 transition-colors"
  >
    {api.description}
  </p>

  <div
    class="mt-auto flex items-center text-[#f97316] text-[13px] font-semibold tracking-wide opacity-70 group-hover:opacity-100 transition-opacity relative z-10"
  >
    <span>{api.linkText || "Ver documentación"}</span>
    <i
      class="fas fa-arrow-right ml-2 text-[11px] transition-transform duration-300 group-hover:translate-x-1.5"
      aria-hidden="true"></i>
  </div>
</Card>
