---
import Card from "../ui/Card.astro";
import Button from "../ui/Button.astro";
import { socialIcons } from "../../data/icons";

interface ApiEndpoint {
  method: string;
  path: string;
  description: string;
  example?: string;
}

interface Props {
  api: {
    title: string;
    description: string;
    icon?: string;
    iconId?: string;
    color?: string;
    hoverColor?: string;
    link: string;
    linkText?: string;
    baseUrl?: string;
    private?: boolean;
    endpoints?: ApiEndpoint[];
  };
  index: number;
  showTestedBadge?: boolean;
}

const { api, showTestedBadge = false } = Astro.props;
const isExternalLink = api.link.startsWith("http");
---

<Card
  class="api-card p-8 bg-none border border-white/6 shadow-lg backdrop-blur-sm transition-all duration-300 hover:border-[#f97316]/25 hover:shadow-[0_0_30px_rgba(249,115,22,0.06)] rounded-3xl flex flex-col"
>
  <div class="flex items-start justify-between mb-6 gap-3">
    <div
      class={`w-14 h-14 rounded-xl bg-white/5 flex items-center justify-center text-3xl shrink-0 ${api.color || "text-white"}`}
    >
      {
        api.iconId && socialIcons[api.iconId] ? (
          <div
            set:html={socialIcons[api.iconId]}
            class="flex items-center justify-center w-full h-full"
          />
        ) : (
          <i class={api.icon || "fas fa-code"} />
        )
      }
    </div>
    <div class="flex flex-wrap items-center justify-end gap-2">
      {
        api.private && (
          <span class="bg-[#5865F2]/15 px-3 py-1 rounded-full text-xs text-[#5865F2] font-bold border border-[#5865F2]/40 tracking-wider">
            PRIVADA
          </span>
        )
      }
      {
        showTestedBadge && (
          <span class="bg-[#f97316]/20 px-3 py-1 rounded-full text-xs text-[#f97316] font-bold border border-[#f97316]/50 tracking-wider">
            TESTED
          </span>
        )
      }
    </div>
  </div>

  <h3 class="text-2xl font-bold text-white mb-3">
    {api.title}
  </h3>
  <p class="text-zinc-400 leading-relaxed mb-8 grow">
    {api.description}
  </p>

  <div class="mt-auto">
    <Button
      href={api.link}
      target={isExternalLink ? "_blank" : undefined}
      rel={isExternalLink ? "noopener noreferrer" : undefined}
      class="w-full justify-center text-sm py-3 rounded-xl"
    >
      {api.linkText || "Ver más"}{" "}
      <i class="fas fa-arrow-right ml-2 text-xs" aria-hidden="true"></i>
    </Button>
  </div>
</Card>
