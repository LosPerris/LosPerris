---
import {
  discordLink,
  inviteCode,
  discordHelpBotsLink,
  discordHelpApisLink,
} from "../../data/community";
import Button from "../ui/Button.astro";

const links = [
  {
    title: "Actualizaciones",
    description: "Historial de cambios de cada servicio.",
    href: "/actualizaciones",
    icon: "fas fa-clock-rotate-left",
  },
  {
    title: "Documentación",
    description: "Guías y comandos de los bots.",
    href: "/bots/documentacion",
    icon: "fas fa-book-open",
  },
  {
    title: "APIs",
    description: "Listado de endpoints públicos.",
    href: "/apis",
    icon: "fas fa-code",
  },
  {
    title: "Discord",
    description: "El sitio donde estamos de verdad.",
    href: discordLink,
    icon: "fab fa-discord",
    external: true,
  },
  {
    title: "Canal de APIs",
    description: "Dudas técnicas de desarrollo.",
    href: discordHelpApisLink,
    icon: "fas fa-terminal",
    external: true,
  },
];
---

<section
  id="comunidad"
  class="static-zone relative z-10 bg-[#050505] border-t border-[#f97316]/20"
  data-discord-stats
  data-invite-code={inviteCode}
>
  <div class="max-w-7xl mx-auto px-6 py-20 lg:py-28">
    <div
      class="grid grid-cols-1 lg:grid-cols-2 gap-14 lg:gap-20 items-center mb-16"
    >
      <div>
        <h2
          class="text-3xl md:text-4xl font-black text-white mb-4 tracking-tight leading-tight uppercase"
        >
          ENLACES <br /><span
            class="text-transparent bg-clip-text bg-gradient-to-br from-[#f97316] to-[#ea580c] drop-shadow-[0_0_15px_rgba(249,115,22,0.2)]"
            >ÚTILES</span
          >
        </h2>
        <p class="text-zinc-400 text-lg leading-relaxed mb-8 max-w-lg">
          Enlaces directos y datos del servidor de Discord.
        </p>

        <div class="flex flex-wrap gap-6 mb-8">
          <div>
            <p
              class="text-2xl font-black text-white"
              id="community-member-count"
              data-stat="members"
            >
              —
            </p>
            <p class="text-xs text-zinc-400 uppercase tracking-wider mt-1">
              En el servidor
            </p>
          </div>
          <div
            class="w-px bg-gradient-to-b from-transparent via-[#f97316]/40 to-transparent self-stretch"
          >
          </div>
          <div>
            <p
              class="text-2xl font-black text-white"
              id="community-online-count"
              data-stat="online"
            >
              —
            </p>
            <p class="text-xs text-zinc-400 uppercase tracking-wider mt-1">
              Conectados ahora
            </p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-4">
          <Button
            href={discordLink}
            target="_blank"
            class="px-8 py-4 text-base justify-center"
          >
            <i class="fab fa-discord mr-2"></i> Discord
          </Button>
          <Button
            href={discordHelpBotsLink}
            target="_blank"
            variant="outline"
            class="px-8 py-4 text-base justify-center border-[#27272a]"
          >
            Ayuda con bots
          </Button>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          links.map((link) => (
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
              class="group rounded-2xl bg-[#0a0a0a] border border-[#27272a] p-5 transition-all duration-300 hover:border-[#f97316]/40 hover:bg-[#0f0f0f] hover:shadow-[0_0_20px_rgba(249,115,22,0.05)]"
            >
              <div class="flex items-start justify-between mb-4">
                <div class="w-10 h-10 rounded-xl bg-[#111111] border border-[#27272a] flex items-center justify-center text-[#f97316] group-hover:scale-110 group-hover:border-[#f97316]/30 transition-all duration-300">
                  <i class={`${link.icon} text-sm`} />
                </div>
                <i class="fas fa-arrow-right text-zinc-700 text-xs mt-1 group-hover:text-[#f97316] group-hover:translate-x-0.5 transition-all duration-300" />
              </div>
              <h3 class="font-bold text-white text-sm mb-1">{link.title}</h3>
              <p class="text-sm text-zinc-400 leading-relaxed">
                {link.description}
              </p>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
