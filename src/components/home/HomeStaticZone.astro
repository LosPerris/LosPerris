---
import {
  discordLink,
  discordHelpBotsLink,
  discordHelpApisLink,
} from "../../data/community";
import Button from "../ui/Button.astro";

const inviteCode = discordLink.split("/").pop();

const links = [
  {
    title: "Documentación",
    description: "Guías y comandos de los bots.",
    href: "/bots/documentacion",
    icon: "fas fa-book-open",
  },
  {
    title: "APIs",
    description: "Listado de endpoints públicos.",
    href: "/api",
    icon: "fas fa-code",
  },
  {
    title: "Discord",
    description: "El sitio donde estamos de verdad.",
    href: discordLink,
    icon: "fab fa-discord",
    external: true,
  },
  {
    title: "Canal de APIs",
    description: "Dudas técnicas de desarrollo.",
    href: discordHelpApisLink,
    icon: "fas fa-terminal",
    external: true,
  },
];
---

<section
  id="comunidad"
  class="static-zone relative z-10 bg-[#050505] border-t border-[#1a1a1a]"
  data-discord-stats
  data-invite-code={inviteCode}
>
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-2/3 max-w-xl h-px bg-gradient-to-r from-transparent via-[#27272a] to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="max-w-7xl mx-auto px-6 py-20 lg:py-28">
    <div
      class="grid grid-cols-1 lg:grid-cols-2 gap-14 lg:gap-20 items-center mb-16"
    >
      <div>
        <h2
          class="text-3xl md:text-4xl font-black text-white mb-4 tracking-tight leading-tight uppercase"
        >
          ENLACES <br /><span
            class="text-transparent bg-clip-text bg-gradient-to-br from-[#f97316] to-[#ea580c] drop-shadow-[0_0_15px_rgba(249,115,22,0.2)]"
            >ÚTILES</span
          >
        </h2>
        <p class="text-zinc-400 text-lg leading-relaxed mb-8 max-w-lg">
          Enlaces directos y datos del servidor de Discord.
        </p>

        <div class="flex flex-wrap gap-6 mb-8">
          <div>
            <p
              class="text-2xl font-black text-white"
              id="community-member-count"
              data-stat="members"
            >
              —
            </p>
            <p class="text-xs text-zinc-500 uppercase tracking-wider mt-1">
              En el servidor
            </p>
          </div>
          <div class="w-px bg-[#27272a]"></div>
          <div>
            <p
              class="text-2xl font-black text-white"
              id="community-online-count"
              data-stat="online"
            >
              —
            </p>
            <p class="text-xs text-zinc-500 uppercase tracking-wider mt-1">
              Conectados ahora
            </p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-4">
          <Button
            href={discordLink}
            target="_blank"
            class="px-8 py-4 text-base justify-center"
          >
            <i class="fab fa-discord mr-2"></i> Discord
          </Button>
          <Button
            href={discordHelpBotsLink}
            target="_blank"
            variant="outline"
            class="px-8 py-4 text-base justify-center border-[#27272a]"
          >
            Ayuda con bots
          </Button>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          links.map((link) => (
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
              class="group rounded-2xl bg-[#0a0a0a] border border-[#27272a] p-5 transition-colors hover:border-[#f97316]/40 hover:bg-[#111111]"
            >
              <div class="w-10 h-10 rounded-xl bg-[#111111] border border-[#27272a] flex items-center justify-center text-[#f97316] mb-4 group-hover:scale-105 transition-transform">
                <i class={`${link.icon} text-sm`} />
              </div>
              <h3 class="font-bold text-white text-sm mb-1">{link.title}</h3>
              <p class="text-sm text-zinc-500 leading-relaxed">
                {link.description}
              </p>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
