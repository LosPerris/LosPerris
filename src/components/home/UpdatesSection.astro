---
import Button from "../ui/Button.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import Card from "../ui/Card.astro";
import { fetchPublishedUpdates } from "../../lib/updates";

const sortedUpdates = fetchPublishedUpdates().slice(0, 3);
---

<section id="actualizaciones" class="py-24 relative">
  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="mb-8">
      <SectionHeader
        title="Últimas"
        highlight="actualizaciones."
        description="Mantente al día con el historial de cambios, mejoras de rendimiento y nuevos endpoints."
        align="split"
      />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      {
        sortedUpdates.map((update) => (
          <Card
            hoverEffect={false}
            class="group p-6 flex flex-col h-full bg-[#090a0b] hover:bg-white/[0.02] transition-all duration-300 relative border border-zinc-800/80 hover:border-zinc-700/80 cursor-pointer"
          >
            <div class="flex justify-between items-center mb-6 gap-3">
              <span class="text-[10px] font-mono tracking-widest text-zinc-500 uppercase">
                {update.data.dateString}
              </span>
              <div class="flex flex-wrap items-center justify-end gap-2">
                <span class="flex items-center gap-1.5 bg-zinc-800/50 px-2 py-1 rounded-md text-[9px] text-zinc-400 font-mono uppercase tracking-widest border border-zinc-700/50 hidden sm:inline-flex">
                  {update.data.api}
                </span>
                <span class="flex items-center gap-1.5 bg-zinc-800/50 px-2 py-1 rounded-md text-[9px] text-zinc-400 font-mono uppercase tracking-widest border border-zinc-700/50">
                  {update.data.tag}
                </span>
              </div>
            </div>

            <h3 class="text-xl font-medium text-zinc-100 mb-3 tracking-tight group-hover:text-white transition-colors">
              {update.data.title}
            </h3>
            <p class="text-[14px] text-zinc-500 leading-relaxed mb-4 group-hover:text-zinc-400 transition-colors">
              {update.data.description}
            </p>
          </Card>
        ))
      }
    </div>

    <div class="flex justify-center">
      <Button
        href="/actualizaciones"
        variant="outline"
        class="px-8 py-3 font-bold"
      >
        Ver historial completo
      </Button>
    </div>
  </div>
</section>
