---
import SectionHeader from "../ui/SectionHeader.astro";

const features = [
  {
    icon: "fas fa-bolt",
    title: "Respuestas en milisegundos",
    description:
      "Infraestructura optimizada para latencia mínima. Caché inteligente en el edge para que tus peticiones lleguen al instante.",
  },
  {
    icon: "fas fa-shield-halved",
    title: "Privacidad por diseño",
    description:
      "No recopilamos datos personales innecesarios. Lo que consultas se queda entre tú y la API.",
  },
  {
    icon: "fas fa-plug",
    title: "Listo en minutos",
    description:
      "Un fetch y ya funciona. Endpoints claros, respuestas consistentes, sin configuración ni registro previo.",
  },
  {
    icon: "fas fa-arrows-rotate",
    title: "Siempre actualizado",
    description:
      "Publicamos mejoras y nuevos endpoints continuamente, guiados por las sugerencias de la comunidad.",
  },
];
---

<section class="py-28 relative bg-[#070707]" id="features-section" data-reveal>
  <div class="max-w-6xl mx-auto px-6">
    <SectionHeader
      title="Construidas para"
      highlight="durar"
      description="Cada endpoint está pensado para ser confiable, rápido y transparente. Sin sorpresas."
      align="center"
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      {
        features.map((f) => (
          <div class="group rounded-3xl bg-[#0c0c0c] border border-white/6 p-8 hover:border-[#f97316]/25 hover:bg-[#0f0f0f] transition-all duration-300 hover:shadow-[0_0_30px_rgba(249,115,22,0.04)]">
            <div class="w-12 h-12 rounded-2xl bg-[#f97316]/10 border border-[#f97316]/15 flex items-center justify-center text-[#f97316] mb-6 group-hover:scale-110 group-hover:bg-[#f97316]/15 transition-all duration-300">
              <i class={`${f.icon} text-lg`} />
            </div>
            <h3 class="text-xl font-bold text-white mb-3 leading-snug">
              {f.title}
            </h3>
            <p class="text-zinc-500 leading-relaxed text-[15px]">
              {f.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
