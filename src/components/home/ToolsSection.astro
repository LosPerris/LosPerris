---
import { helpBotData, gameBotData } from "../../data/bots";
import Section from "../ui/Section.astro";
import Card from "../ui/Card.astro";
import Button from "../ui/Button.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { Image } from "astro:assets";

const bots = [helpBotData, gameBotData];
---

<Section id="bots" class="relative overflow-hidden">
    <SectionHeader
        badge="Ecosistema"
        title="NUESTRAS"
        highlight="HERRAMIENTAS"
        description="Bots exclusivos desarrollados para potenciar tu experiencia en Discord."
    />

    <div
        class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-6xl mx-auto px-6 relative z-10"
    >
        {
            bots.map((bot) => (
                <Card class="p-8 bg-white/[0.02] bg-none border border-white/10 hover:bg-white/[0.04] hover:border-[#5865F2]/50 transition-all duration-300 group hover:-translate-y-1 shadow-xl backdrop-blur-sm">
                    <div class="flex items-start gap-6 mb-6">
                        <Image
                            src={bot.imageSrc}
                            alt={bot.botName}
                            class="w-24 h-24 rounded-2xl shadow-lg group-hover:scale-105 transition-transform bg-[#2d2d2d]"
                            width={96}
                            height={96}
                        />
                        <div>
                            <h3 class="text-3xl font-bold text-white mb-2 group-hover:text-[#5865F2] transition-colors">
                                {bot.botName}
                            </h3>
                            <p class="text-[#bdbdbd] text-sm leading-relaxed mb-4">
                                {bot.description}
                            </p>
                            <div class="flex gap-2 flex-wrap">
                                {bot.tags.slice(0, 2).map((tag) => (
                                    <span class="text-xs font-bold bg-[#2d2d2d] text-white px-3 py-1 rounded-full border border-white/10">
                                        {tag}
                                    </span>
                                ))}
                            </div>
                        </div>
                    </div>

                    <div class="space-y-4 mb-8 bg-white/[0.02] p-6 rounded-xl border border-white/5">
                        {bot.features.slice(0, 3).map((feature) => (
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-[#5865F2]/20 flex items-center justify-center text-[#5865F2]">
                                    <i class={feature.icon} />
                                </div>
                                <div>
                                    <span class="text-white font-semibold block text-sm">
                                        {feature.title}
                                    </span>
                                    <span class="text-xs text-[#b0b0b0]">
                                        {feature.list[0]}
                                    </span>
                                </div>
                            </div>
                        ))}
                    </div>

                    <div class="flex gap-4">
                        <Button
                            href={bot.inviteLink}
                            target="_blank"
                            class="flex-1 justify-center bg-[#5865F2] hover:bg-[#4752c4] border-none shadow-lg shadow-[#5865F2]/20"
                            aria-label={`Invitar al bot ${bot.botName}`}
                        >
                            <i class="fas fa-plus mr-2" /> Añadir
                        </Button>
                        <Button
                            variant="outline"
                            href="/guias"
                            class="flex-1 justify-center border-white/20 hover:bg-white/10 hover:border-white"
                        >
                            Ver Guías
                        </Button>
                    </div>
                </Card>
            ))
        }
    </div>
</Section>
