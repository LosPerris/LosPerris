---
import { helpBotData, gameBotData } from "../../data/bots";
import Section from "../ui/Section.astro";
import Card from "../ui/Card.astro";
import Button from "../ui/Button.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { Image } from "astro:assets";

const bots = [helpBotData, gameBotData];
---

<Section id="bots" class="relative overflow-hidden">
  <SectionHeader
    badge="Ecosistema"
    title="NUESTRAS"
    highlight="HERRAMIENTAS"
    description="Bots exclusivos desarrollados para potenciar tu experiencia en Discord."
  />

  <div
    class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-6xl mx-auto px-6 relative z-10"
  >
    {
      bots.map((bot) => (
        <Card
          class={`p-6 md:p-8 bg-white/2 bg-none border border-white/10 hover:bg-white/4 hover:border-[#f97316]/50 transition-all duration-300 group hover:-translate-y-1 shadow-xl backdrop-blur-sm relative ${bot.backgroundColor}`}
        >
          <div class="absolute top-4 right-4 bg-red-500/20 text-red-400 border border-red-500/30 px-3 py-1 rounded-full text-xs font-bold flex items-center gap-2 z-20 shadow-lg">
            <i class="fas fa-ban" /> Deshabilitado
          </div>
          <div class="flex flex-col md:flex-row items-start gap-4 md:gap-6 mb-6 text-left">
            <Image
              src={bot.imageSrc}
              alt={bot.botName}
              class="w-20 h-20 md:w-24 md:h-24 rounded-2xl shadow-lg group-hover:scale-105 transition-transform bg-white/5 self-start"
              width={96}
              height={96}
            />
            <div>
              <h3 class="text-2xl md:text-3xl font-bold text-white mb-2 group-hover:text-[#f97316] transition-colors">
                {bot.botName}
              </h3>
              <p class="text-[#bdbdbd] text-sm leading-relaxed mb-4">
                {bot.description}
              </p>
              <div class="flex gap-2 flex-wrap justify-start">
                {bot.tags.slice(0, 2).map((tag) => (
                  <span class="text-xs font-bold bg-[#f97316]/20 text-[#f97316] px-3 py-1 rounded-full border border-[#f97316]/50 shadow-[0_0_10px_rgba(249,115,22,0.2)] tracking-wider">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <div class="space-y-4 mb-8 bg-white/5 p-6 rounded-xl border border-white/10">
            {bot.features.slice(0, 3).map((feature) => (
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-[#f97316]/20 flex items-center justify-center text-[#f97316] shrink-0 border border-[#f97316]/30">
                  <i class={feature.icon} aria-hidden="true" />
                </div>
                <div class="overflow-hidden">
                  <span class="text-white font-semibold block text-sm truncate">
                    {feature.title}
                  </span>
                  <span class="text-xs text-[#a0a0a0] truncate block">
                    {feature.list[0]}
                  </span>
                </div>
              </div>
            ))}
          </div>

          <div class="flex gap-4">
            <Button
              class="flex-1 justify-center bg-[#2d2d2d] text-gray-500 cursor-not-allowed border border-[#404040]"
              aria-label={`El bot ${bot.botName} está deshabilitado`}
              disabled
            >
              <i class="fas fa-lock mr-2" aria-hidden="true" /> No Disponible
            </Button>
            <Button
              variant="outline"
              href="/bots/documentacion"
              class="flex-1 justify-center"
              aria-label={`Ver guías para ${bot.botName}`}
            >
              Ver Guías
            </Button>
          </div>
        </Card>
      ))
    }
  </div>
</Section>
