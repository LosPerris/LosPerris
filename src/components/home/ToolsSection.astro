---
import { helpBotData, gameBotData } from "../../data/bots";
import Card from "../ui/Card.astro";
import Button from "../ui/Button.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import TimelineLine from "../ui/TimelineLine.astro";
import { Image } from "astro:assets";

const bots = [helpBotData, gameBotData];
---

<section
  id="bots"
  data-timeline-section
  class="py-24 relative bg-[#050505] scroll-mt-32"
>
  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-start">
      <div
        class="lg:col-span-4 lg:col-start-9 lg:sticky lg:top-32 text-right order-1 lg:order-2 self-start"
      >
        <SectionHeader
          title="NUESTRAS"
          highlight="HERRAMIENTAS"
          description="Bots exclusivos desarrollados para potenciar tu experiencia en Discord."
          align="right"
        />
        <div class="mt-8 flex justify-end lg:justify-end justify-center">
          <Button
            variant="primary"
            href="/bots/documentacion"
            class="px-6 py-3 shadow-[0_0_15px_rgba(249,115,22,0.3)] hover:shadow-[0_0_25px_rgba(249,115,22,0.5)] group flex items-center gap-2 bg-[#f97316] text-white hover:bg-[#ea580c] transition-all rounded-xl font-bold"
          >
            <i class="fas fa-book-open"></i> Ver Documentación
            <i
              class="fas fa-arrow-right group-hover:translate-x-1 transition-transform ml-1"
            ></i>
          </Button>
        </div>
      </div>

      <div
        class="lg:col-span-8 lg:col-start-1 lg:pr-16 relative order-2 lg:order-1"
        data-timeline-track
      >
        <TimelineLine side="right" />

        <div class="space-y-12 relative z-10 py-4">
          {
            bots.map((bot) => (
              <div class="relative pl-0 md:pr-20 text-right" data-timeline-item>
                <div class="timeline-node timeline-node--right top-6">
                  <img
                    src="/LosPerris-minimal.svg"
                    alt=""
                    class="w-8 h-8 object-contain timeline-logo"
                    width="32"
                    height="32"
                    loading="lazy"
                    decoding="async"
                  />
                </div>

                <Card
                  hoverEffect={false}
                  class="p-8 relative flex flex-col bg-none border border-[#27272a] backdrop-blur-sm shadow-xl timeline-content timeline-content--card"
                >
                  <div class="flex items-start justify-start gap-5 mb-8">
                    <div class="w-16 h-16 rounded-2xl bg-white/5 flex items-center justify-center p-2 border border-white/10 shadow-lg flex-shrink-0">
                      <Image
                        src={bot.imageSrc}
                        alt={bot.botName}
                        class="w-full h-full object-contain drop-shadow-md"
                        width={64}
                        height={64}
                      />
                    </div>
                    <div class="pt-1 text-left">
                      <h3 class="text-2xl font-black text-white tracking-tight mb-2">
                        {bot.botName}
                      </h3>
                      <div class="flex gap-2 items-center justify-start">
                        {bot.tags.slice(0, 1).map((tag) => (
                          <span class="bg-[#f97316]/20 px-3 py-1 rounded-full text-[10px] sm:text-xs text-[#f97316] font-bold border border-[#f97316]/50 shadow-[0_0_10px_rgba(249,115,22,0.2)] tracking-wider uppercase">
                            {tag}
                          </span>
                        ))}
                      </div>
                    </div>
                  </div>

                  <p class="text-zinc-400 text-base leading-relaxed mb-8 text-left font-medium">
                    {bot.description}
                  </p>

                  <div class="space-y-5 mb-10">
                    {bot.features.slice(0, 3).map((feature) => (
                      <div class="flex items-start justify-start gap-4 text-left">
                        <div class="flex-shrink-0 text-[#f97316] text-sm bg-[#f97316]/10 w-10 h-10 flex items-center justify-center rounded-xl border border-[#f97316]/20">
                          <i class="fas fa-check" aria-hidden="true" />
                        </div>
                        <div>
                          <span class="text-white font-bold text-base block">
                            {feature.title}
                          </span>
                          <span class="text-sm text-zinc-400 block mt-1 leading-relaxed">
                            {feature.list[0]}
                          </span>
                        </div>
                      </div>
                    ))}
                  </div>

                  <div class="mt-auto border-t border-[#27272a] pt-6 flex justify-start items-center">
                    <span class="text-xs font-bold text-zinc-400 flex items-center gap-2 uppercase tracking-wider">
                      <span class="w-2 h-2 rounded-full bg-red-500/80 shadow-[0_0_8px_rgba(239,68,68,0.6)] inline-block" />{" "}
                      Mantenimiento
                    </span>
                  </div>
                </Card>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
