---
import { apis } from "../../data/apis";
import SectionHeader from "../ui/SectionHeader.astro";
import ApiCard from "./ApiCard.astro";
---

<section id="apis" class="py-28 relative scroll-mt-20" data-reveal>
  <div class="max-w-6xl mx-auto px-6">
    <SectionHeader
      title="Todo lo que"
      highlight="necesitas."
      description="Endpoints públicos gratuitos para streamers y desarrolladores. Sin autenticación en la mayoría de rutas, listos para integrarse en segundos."
      align="split"
    />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {apis.map((api) => <ApiCard api={api} />)}
    </div>
  </div>
</section>
