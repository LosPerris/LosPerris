---
import { apis } from "../../data/apis";
import Section from "../ui/Section.astro";
import Card from "../ui/Card.astro";
import Button from "../ui/Button.astro";
import SectionHeader from "../ui/SectionHeader.astro";
---

<Section id="apis" class="py-20 relative overflow-hidden">
  <SectionHeader
    badge="Developers"
    title="APIs Públicas"
    description="Recursos gratuitos para desarrolladores y creadores de contenido."
  />

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto px-6">
    {
      apis
        .filter((api) => api.popular)
        .map((api, index) => (
          <Card class="p-8 bg-white/2 bg-none border border-white/10 hover:border-[#f97316]/50 hover:bg-white/4 transition-all duration-300 group hover:-translate-y-1 shadow-lg backdrop-blur-sm">
            <div class="flex items-start justify-between mb-6">
              <div
                class={`w-14 h-14 rounded-xl bg-white/5 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform ${api.color}`}
              >
                <i class={api.icon} />
              </div>
              <div class="bg-[#f97316]/20 px-3 py-1 rounded-full text-xs text-[#f97316] font-bold border border-[#f97316]/50 shadow-[0_0_10px_rgba(249,115,22,0.2)] tracking-wider">
                TESTED
              </div>
            </div>

            <h3
              class={`text-2xl font-bold text-white mb-3 transition-colors ${api.hoverColor}`}
            >
              {api.title}
            </h3>
            <p class="text-[#bdbdbd] leading-relaxed mb-6 grow">
              {api.description}
            </p>

            <div class="mt-auto space-y-4">
              <div class="hidden" id={`docs-${index}`}>
                <div class="bg-[#0f0f0f] rounded-lg p-4 border border-[#333] mb-4 text-left">
                  <h4 class="text-white font-semibold mb-3 text-sm uppercase">
                    Endpoints
                  </h4>
                  <div class="space-y-4">
                    {api.endpoints?.map((endpoint) => (
                      <div>
                        <div class="flex items-center gap-2 mb-1">
                          <span class="text-xs font-bold bg-secondary text-green-400 px-2 py-0.5 rounded uppercase">
                            {endpoint.method}
                          </span>
                          <code class="text-xs md:text-sm text-gray-300 font-mono break-all">
                            {endpoint.path}
                          </code>
                        </div>
                        <p class="text-xs text-[#666] mb-2">
                          {endpoint.description}
                        </p>
                        <div class="bg-primary p-2 rounded border border-secondary">
                          <code class="text-xs text-text-muted block font-mono break-all">
                            {endpoint.example}
                          </code>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              <div class="flex flex-col md:flex-row gap-3">
                <button
                  class="api-docs-btn flex-1 py-3 px-4 rounded-xl font-semibold border border-[#404040] text-white hover:bg-secondary transition-colors text-sm cursor-pointer"
                  data-api-index={index}
                  aria-label={`Ver documentación para ${api.title}`}
                >
                  <i class="fas fa-book mr-2" aria-hidden="true" />{" "}
                  Documentación
                </button>
                <Button
                  href={api.link}
                  target="_blank"
                  class="flex-1 justify-center text-sm"
                >
                  {api.linkText}{" "}
                  <i
                    class="fas fa-external-link-alt ml-2 text-xs"
                    aria-hidden="true"
                  />
                </Button>
              </div>
            </div>
          </Card>
        ))
    }
  </div>

  <script>
    document.querySelectorAll(".api-docs-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const index = btn.getAttribute("data-api-index");
        const docs = document.getElementById(`docs-${index}`);
        if (docs) {
          docs.classList.toggle("hidden");
        }
      });
    });
  </script>

  <div class="mt-12 text-center">
    <Button href="/api" class="px-8 py-3 text-lg">
      Ver todas las APIs{" "}
      <i class="fas fa-arrow-right ml-2 text-sm" aria-hidden="true"></i>
    </Button>
  </div>
</Section>
