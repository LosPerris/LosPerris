---
import { apis } from "../../data/apis";
import SectionHeader from "../ui/SectionHeader.astro";
import ApiCard from "./ApiCard.astro";
---

<section id="apis" class="py-28 relative bg-[#050505] scroll-mt-20" data-reveal>
  <div class="max-w-6xl mx-auto px-6">
    <SectionHeader
      pill="02 · APIs Públicas"
      title="Todo lo que"
      highlight="necesitas"
      description="Endpoints gratuitos para streamers, creadores y desarrolladores. Sin autenticación en la mayoría."
      align="center"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {apis.map((api, index) => <ApiCard api={api} index={index} />)}
    </div>
  </div>
</section>
