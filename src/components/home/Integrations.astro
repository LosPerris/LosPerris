---
import { icons } from "../../data/icons";

const technologies = [
  { name: "Node.js", slug: "nodedotjs", color: "text-[#339933]" },
  { name: "Astro", slug: "astro", color: "text-[#FF5D01]" },
  { name: "Zod", slug: "zod", color: "text-[#3E67B1]" },
  { name: "Tailwind CSS", slug: "tailwindcss", color: "text-[#06B6D4]" },
  { name: "Discord Developer", slug: "discord", color: "text-[#5865F2]" },
  { name: "Upstash Redis", slug: "upstash", color: "text-[#00E9A3]" },
  { name: "React", slug: "react", color: "text-[#61DAFB]" },
  { name: "Express", slug: "express", color: "text-zinc-200" },
  { name: "Twitch Developer", slug: "twitch", color: "text-[#9146FF]" },
  { name: "TypeScript", slug: "typescript", color: "text-[#3178C6]" },
  { name: "Supabase", slug: "supabase", color: "text-[#3FCF8E]" },
  { name: "Vercel", slug: "vercel", color: "text-zinc-200" },
];
---

<section
  class="py-10 border-y border-[#f97316]/40 bg-[#050505] overflow-hidden relative"
>
  <div
    data-timeline-bridge-source
    class="hidden md:block absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0 pointer-events-none"
    aria-hidden="true"
  >
  </div>

  <div
    class="absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-[#050505] to-transparent z-10 pointer-events-none"
  >
  </div>
  <div
    class="absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-[#050505] to-transparent z-10 pointer-events-none"
  >
  </div>

  <div class="flex whitespace-nowrap w-max" id="integrations-carousel">
    <div
      class="marquee-group flex items-center justify-around min-w-full w-max shrink-0 gap-16 px-8 animate-[marquee_40s_linear_infinite]"
    >
      {
        technologies.map((tech) => (
          <div
            class={`group flex items-center gap-3 transition duration-300 cursor-default ${tech.color} opacity-60 hover:opacity-100 hover:scale-105 hover:drop-shadow-lg`}
          >
            <div
              class="flex items-center justify-center shrink-0"
              set:html={icons[tech.slug as keyof typeof icons]}
            />
            <span class="text-sm font-bold uppercase tracking-wider text-zinc-300 group-hover:text-white transition-colors">
              {tech.name}
            </span>
          </div>
        ))
      }
    </div>

    <div
      class="marquee-group flex items-center justify-around min-w-full w-max shrink-0 gap-16 px-8 animate-[marquee_40s_linear_infinite]"
    >
      {
        technologies.map((tech) => (
          <div
            class={`group flex items-center gap-3 transition duration-300 cursor-default ${tech.color} opacity-60 hover:opacity-100 hover:scale-105 hover:drop-shadow-lg`}
          >
            <div
              class="flex items-center justify-center shrink-0"
              set:html={icons[tech.slug as keyof typeof icons]}
            />
            <span class="text-sm font-bold uppercase tracking-wider text-zinc-300 group-hover:text-white transition-colors">
              {tech.name}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-100%);
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const carousel = document.getElementById("integrations-carousel");
    if (!carousel) return;

    const groups = carousel.querySelectorAll(".marquee-group");
    if (groups.length < 2) return;

    // Crear un orden aleatorio
    const itemCount = groups[0].children.length;
    const randomOrder = Array.from({ length: itemCount }, (_, i) => i).sort(
      () => Math.random() - 0.5,
    );

    // Aplicar el mismo orden exacto a ambos grupos para mantener el scroll infinito sin saltos
    groups.forEach((group) => {
      const children = Array.from(group.children);
      children.forEach((child, i) => {
        (child as HTMLElement).style.order = randomOrder[i].toString();
      });
    });
  });
</script>
