---
import { icons } from "../../data/icons";

const technologies = [
  { name: "Node.js", slug: "nodedotjs", color: "text-[#339933]" },
  { name: "Astro", slug: "astro", color: "text-[#FF5D01]" },
  { name: "Zod", slug: "zod", color: "text-[#3E67B1]" },
  { name: "Tailwind CSS", slug: "tailwindcss", color: "text-[#06B6D4]" },
  { name: "Discord Developer", slug: "discord", color: "text-[#5865F2]" },
  { name: "Upstash Redis", slug: "upstash", color: "text-[#00E9A3]" },
  { name: "React", slug: "react", color: "text-[#61DAFB]" },
  { name: "Express", slug: "express", color: "text-zinc-200" },
  { name: "Twitch Developer", slug: "twitch", color: "text-[#9146FF]" },
  { name: "TypeScript", slug: "typescript", color: "text-[#3178C6]" },
  { name: "Supabase", slug: "supabase", color: "text-[#3FCF8E]" },
  { name: "Vercel", slug: "vercel", color: "text-zinc-200" },
];
---

<section class="py-6 overflow-hidden relative w-full">
  <div
    class="flex whitespace-nowrap w-max group/carousel"
    id="integrations-carousel"
  >
    <div
      class="marquee-group flex items-center justify-around min-w-full w-max shrink-0 gap-16 px-8 animate-[marquee_40s_linear_infinite] group-hover/carousel:[animation-play-state:paused]"
    >
      {
        technologies.map((tech) => (
          <div class="group flex items-center gap-3 transition-all duration-500 cursor-default text-[#a1a1aa] opacity-50 hover:opacity-100 hover:text-white hover:scale-105">
            <div
              class="flex items-center justify-center shrink-0 transition-all duration-500"
              set:html={icons[tech.slug as keyof typeof icons]}
            />
            <span class="text-sm font-bold uppercase tracking-wider transition-colors duration-500">
              {tech.name}
            </span>
          </div>
        ))
      }
    </div>

    <div
      class="marquee-group flex items-center justify-around min-w-full w-max shrink-0 gap-16 px-8 animate-[marquee_40s_linear_infinite] group-hover/carousel:[animation-play-state:paused]"
    >
      {
        technologies.map((tech) => (
          <div class="group flex items-center gap-3 transition-all duration-500 cursor-default text-[#a1a1aa] opacity-50 hover:opacity-100 hover:text-white hover:scale-105">
            <div
              class="flex items-center justify-center shrink-0 transition-all duration-500"
              set:html={icons[tech.slug as keyof typeof icons]}
            />
            <span class="text-sm font-bold uppercase tracking-wider transition-colors duration-500">
              {tech.name}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-100%);
    }
  }
</style>
