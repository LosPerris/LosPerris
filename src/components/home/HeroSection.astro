---
import { discordLink } from "../../data/community";
---

---

<section
    id="home"
    class="min-h-screen flex items-center justify-center relative overflow-hidden pt-20"
>
    <div class="relative z-10 max-w-5xl px-6 text-center">
        <span
            class="inline-block py-1 px-3 rounded-full bg-[#5865F2]/20 text-[#5865F2] border border-[#5865F2]/30 text-sm font-semibold mb-6 opacity-0 translate-y-8 animate-[fadeInUp_1s_ease-out_0.1s_forwards]"
        >
            <i class="fab fa-discord mr-2"></i>Comunidad Oficial
        </span>
        <h1
            class="text-5xl md:text-8xl font-black mb-6 text-white tracking-tight opacity-0 translate-y-8 animate-[fadeInUp_1s_ease-out_0.3s_forwards]"
        >
            LOS PERRIS <span
                class="text-transparent bg-clip-text bg-gradient-to-r from-[#5865F2] to-purple-500"
                >REAL</span
            >
        </h1>
        <p
            class="text-xl md:text-2xl text-[#b0b0b0] mb-8 max-w-3xl mx-auto font-light opacity-0 translate-y-8 animate-[fadeInUp_1s_ease-out_0.6s_forwards]"
        >
            Mejora tu servidor de Discord con moderación avanzada y estadísticas
            de juegos en tiempo real.
        </p>

        <div
            class="flex flex-wrap justify-center gap-4 my-8 opacity-0 translate-y-8 animate-[fadeInUp_1s_ease-out_0.9s_forwards]"
        >
            <a
                href={discordLink}
                target="_blank"
                class="inline-flex items-center px-8 py-4 rounded-full font-bold transition-all text-lg cursor-pointer bg-[#5865F2] text-white hover:bg-[#4752c4] hover:scale-105 hover:shadow-[0_0_30px_rgba(88,101,242,0.5)]"
            >
                <i class="fab fa-discord mr-3 text-2xl"></i> Unirse al Discord
            </a>
            <a
                href="#features"
                class="inline-flex items-center px-8 py-4 rounded-full font-bold transition-all text-lg cursor-pointer bg-[#2d2d2d] text-white border border-[#404040] hover:bg-[#404040] hover:-translate-y-1"
            >
                Saber más
            </a>
        </div>

        <div
            class="flex justify-center gap-12 mt-12 opacity-0 translate-y-8 animate-[fadeInUp_1s_ease-out_1.2s_forwards] border-t border-[#404040] pt-10"
        >
            <div class="text-center">
                <span
                    id="member-count"
                    class="block text-3xl md:text-4xl font-bold text-white mb-1"
                    >24k+</span
                >
                <span
                    class="text-xs text-[#808080] uppercase tracking-widest font-semibold"
                    >Miembros</span
                >
            </div>
            <div class="text-center">
                <span
                    id="online-count"
                    class="block text-3xl md:text-4xl font-bold text-[#4ade80] mb-1"
                    >1.2k+</span
                >
                <span
                    class="text-xs text-[#808080] uppercase tracking-widest font-semibold"
                    >Online</span
                >
            </div>
            <div class="text-center">
                <span
                    class="block text-3xl md:text-4xl font-bold text-[#f472b6] mb-1"
                    >2+</span
                >
                <span
                    class="text-xs text-[#808080] uppercase tracking-widest font-semibold"
                    >Bots Propios</span
                >
            </div>
        </div>
    </div>

    <script is:inline>
        fetch("https://discord.com/api/v9/invites/8uN3qY5E?with_counts=true")
            .then((res) => res.json())
            .then((data) => {
                if (data.approximate_member_count) {
                    const members = data.approximate_member_count;
                    const formattedMembers =
                        members > 1000
                            ? (members / 1000).toFixed(1) + "k+"
                            : members;
                    document.getElementById("member-count").innerText =
                        formattedMembers;
                }
                if (data.approximate_presence_count) {
                    const online = data.approximate_presence_count;
                    const formattedOnline =
                        online > 1000
                            ? (online / 1000).toFixed(1) + "k+"
                            : online;
                    document.getElementById("online-count").innerText =
                        formattedOnline;
                }
            })
            .catch((e) => console.error("Error fetching Discord stats:", e));
    </script>
</section>
