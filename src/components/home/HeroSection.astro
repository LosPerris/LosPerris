---
import { discordLink, inviteCode } from "../../data/community";
---

<section
  id="home"
  class="min-h-screen flex flex-col items-center justify-center relative overflow-hidden pt-20"
  data-invite-code={inviteCode}
>
  <div class="relative z-10 w-full max-w-4xl px-6 text-center mx-auto pb-8">
    <!-- Headline principal -->
    <h1
      class="text-6xl md:text-8xl lg:text-[100px] font-black mb-6 text-white tracking-tight leading-[1.0] animate-[fadeInUp_0.8s_ease-out_0.1s_both]"
    >
      APIs para tu<br />
      <span
        class="text-transparent bg-clip-text bg-gradient-to-br from-[#f97316] via-[#fb923c] to-[#ea580c] drop-shadow-[0_0_30px_rgba(249,115,22,0.4)]"
      >
        proyecto
      </span>
    </h1>

    <!-- Sub-headline -->
    <p
      class="text-xl md:text-2xl text-zinc-400 mb-10 max-w-2xl mx-auto font-normal leading-relaxed animate-[fadeInUp_0.8s_ease-out_0.2s_both]"
    >
      Endpoints públicos de alto rendimiento para streamers y desarrolladores.
      Rápidos, confiables y completamente gratuitos.
    </p>

    <!-- CTAs -->
    <div
      class="flex flex-col sm:flex-row justify-center gap-4 mb-14 animate-[fadeInUp_0.8s_ease-out_0.3s_both]"
    >
      <a
        href="#apis"
        class="group inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl font-bold text-base bg-[#f97316] text-[#050505] hover:bg-[#fb923c] shadow-[0_0_30px_rgba(249,115,22,0.35)] hover:shadow-[0_0_40px_rgba(249,115,22,0.55)] hover:-translate-y-0.5 transition-all duration-200"
      >
        <i class="fas fa-code text-base"></i>
        Ver APIs
        <i
          class="fas fa-arrow-right text-sm group-hover:translate-x-1 transition-transform duration-200"
        ></i>
      </a>
      <a
        href={discordLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl font-bold text-base bg-white/5 text-white border border-white/10 hover:bg-white/10 hover:border-white/20 hover:-translate-y-0.5 transition-all duration-200"
      >
        <i class="fab fa-discord text-[#5865F2]"></i>
        Únete a Discord
      </a>
    </div>

    <!-- Social proof — stats Discord -->
    <div
      class="inline-flex items-center gap-4 px-6 py-3 rounded-2xl bg-white/4 border border-white/8 text-sm text-zinc-400 animate-[fadeInUp_0.8s_ease-out_0.45s_both]"
      data-discord-stats
      data-invite-code={inviteCode}
    >
      <span class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#22c55e] shadow-[0_0_6px_#22c55e]"
        ></span>
        <span
          ><strong
            class="text-white font-bold"
            id="hero-online"
            data-stat="online">—</strong
          > en línea</span
        >
      </span>
      <span class="w-px h-4 bg-white/10"></span>
      <span>
        <strong
          class="text-white font-bold"
          id="hero-members"
          data-stat="members">—</strong
        > miembros en Discord
      </span>
    </div>
  </div>
</section>
