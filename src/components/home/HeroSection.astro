---
import { discordLink, inviteCode } from "../../data/community";
import Integrations from "./Integrations.astro";
---

<section
  id="home"
  class="min-h-screen flex flex-col relative overflow-hidden"
  data-invite-code={inviteCode}
>
  <div
    class="flex-grow flex flex-col justify-center items-center relative z-10 w-full max-w-5xl px-6 text-center mx-auto pt-16"
  >
    <h1
      class="text-[3.5rem] sm:text-[4.5rem] md:text-6xl lg:text-[85px] font-bold mb-6 text-white tracking-tight leading-[1.0] animate-[fadeInUp_0.8s_ease-out_0.1s_both]"
    >
      APIs públicas listas <br class="hidden sm:block" />
      para <span
        class="font-mono font-normal tracking-[0.1em] text-[#f97316] drop-shadow-[0_0_12px_rgba(249,115,22,0.3)]"
        >usar.</span
      >
    </h1>

    <p
      class="text-base md:text-lg text-[#a1a1aa] mb-10 max-w-2xl mx-auto font-normal leading-relaxed animate-[fadeInUp_0.8s_ease-out_0.15s_both]"
    >
      Colección de herramientas gratuitas para streamers y desarrolladores.
      Endpoints simples para obtener rangos de Valorant, generar códigos QR y
      mejorar tu chat de Twitch, sin necesidad de registros.
    </p>

    <div
      class="flex flex-col sm:flex-row justify-center gap-4 animate-[fadeInUp_0.8s_ease-out_0.25s_both]"
    >
      <a
        href="#apis"
        class="inline-flex items-center justify-center px-6 py-2.5 rounded-lg font-semibold text-sm bg-white text-black hover:bg-zinc-200 transition-colors duration-200"
      >
        Ver APIs
      </a>
      <a
        href={discordLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-6 py-2.5 rounded-lg font-semibold text-sm bg-[#111] text-white border border-zinc-800 hover:bg-zinc-800 transition-colors duration-200"
      >
        Prueba gratis
      </a>
    </div>
  </div>

  <div
    class="w-full mt-auto relative z-20 pb-4 animate-[fadeIn_1s_ease-out_0.4s_both]"
  >
    <Integrations />
  </div>
</section>
