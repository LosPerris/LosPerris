---
import { discordLink } from "../data/community";

const navItems = [
  { name: "Inicio", href: "/" },
  { name: "Actualizaciones", href: "/#actualizaciones" },
  { name: "API", href: "/#apis" },
];
---

<header
  id="main-header"
  class="fixed top-0 inset-x-0 z-50 h-16 bg-[#050505] border-b border-transparent transition-all duration-500"
>
  <div
    class="h-full container mx-auto px-6 max-w-[1400px] flex items-center justify-between"
  >
    <a href="/" class="flex items-center gap-3 group">
      <img
        src="/LosPerris-minimal.svg"
        alt="Los Perris"
        class="w-7 h-7 group-hover:scale-110 transition-transform duration-300"
      />
      <span
        class="font-bold text-lg tracking-tight text-white group-hover:text-[#f97316] transition-colors"
        >LosPerris</span
      >
    </a>

    <nav class="hidden md:flex items-center gap-8">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="group relative text-sm font-medium text-zinc-400 hover:text-[#f97316] transition-colors"
          >
            {item.name}
            <span class="absolute -bottom-1.5 left-0 w-full h-[2px] bg-[#f97316] scale-x-0 group-hover:scale-x-100 transition-transform origin-left duration-300 ease-out" />
          </a>
        ))
      }
    </nav>

    <div class="hidden md:flex items-center">
      <a
        href="https://status.losperris.dev"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 text-sm font-semibold bg-[#22c55e]/10 text-[#22c55e] hover:bg-[#22c55e]/20 hover:text-[#4ade80] border border-[#22c55e]/20 hover:border-[#22c55e]/40 px-4 py-1.5 rounded-lg transition-all duration-300 shadow-[0_0_10px_rgba(34,197,94,0.1)] hover:shadow-[0_0_15px_rgba(34,197,94,0.2)]"
      >
        <span
          class="w-2 h-2 rounded-full bg-current shadow-[0_0_8px_currentColor] animate-pulse"
        ></span>
        <span>status</span>
      </a>
    </div>

    <button
      id="menu-btn"
      class="md:hidden p-2 text-zinc-400 hover:text-white transition-colors"
      aria-label="Menú principal"
    >
      <i class="fas fa-bars text-lg" aria-hidden="true"></i>
    </button>
  </div>
</header>

<div
  id="mobile-menu"
  class="fixed inset-0 z-[100] bg-[#050505]/95 backdrop-blur-xl translate-x-full transition-transform duration-500 md:hidden flex flex-col"
>
  <div
    class="h-16 px-6 flex items-center justify-between border-b border-white/5"
  >
    <div class="flex items-center gap-3">
      <img src="/LosPerris-minimal.svg" alt="" class="w-7 h-7" />
      <span class="font-bold text-lg text-white">Navegación</span>
    </div>
    <button
      id="close-menu"
      class="p-2 text-zinc-400 hover:text-white transition-colors"
      aria-label="Cerrar menú"
    >
      <i class="fas fa-times text-xl" aria-hidden="true"></i>
    </button>
  </div>

  <div class="flex-1 p-6 flex flex-col gap-2">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class="block px-4 py-3 rounded-lg text-zinc-300 font-medium hover:bg-white/5 hover:text-white transition-all active:scale-[0.98]"
        >
          {item.name}
        </a>
      ))
    }
  </div>

  <div class="p-6 border-t border-white/5">
    <div class="flex items-center justify-between text-zinc-400 text-xs">
      <span>LosPerris © 2026</span>
      <a
        href={discordLink}
        class="text-zinc-400 hover:text-white transition-colors text-lg"
        aria-label="Ir a nuestro Discord"
      >
        <i class="fab fa-discord" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</div>

<script>
  let _headerScrollHandler: (() => void) | null = null;

  function initHeaderScroll() {
    const header = document.getElementById("main-header");
    if (!header) return;

    // Cleanup del listener anterior para evitar acumulación
    if (_headerScrollHandler) {
      window.removeEventListener("scroll", _headerScrollHandler);
    }

    const handleScroll = () => {
      if (window.scrollY > 20) {
        header.classList.add(
          "shadow-[0_4px_15px_rgba(249,115,22,0.08)]",
          "border-[#f97316]/30",
        );
        header.classList.remove("border-transparent");
      } else {
        header.classList.remove(
          "shadow-[0_4px_15px_rgba(249,115,22,0.08)]",
          "border-[#f97316]/30",
        );
        header.classList.add("border-transparent");
      }
    };

    _headerScrollHandler = handleScroll;
    window.addEventListener("scroll", handleScroll);
    handleScroll();
  }

  document.addEventListener("astro:page-load", initHeaderScroll);
</script>
