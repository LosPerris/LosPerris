---
import { discordLink } from "../data/community";

const navItems = [
  { name: "Inicio", href: "/" },
  { name: "Ecosistema", href: "/#bots" },
  { name: "Desarrolladores", href: "/#apis" },
];
---

<header
  class="fixed top-0 inset-x-0 z-50 h-20 bg-[#050505] border-b border-[#111111] transition-all duration-300"
>
  <div class="h-full container mx-auto px-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 group">
      <img
        src="/LosPerris-minimal.svg"
        alt="Los Perris"
        class="w-10 h-10 group-hover:scale-110 group-hover:rotate-6 transition-all duration-300"
      />
      <span
        class="font-bold text-xl tracking-tight text-white group-hover:text-[#f97316] transition-colors"
        >LosPerris</span
      >
    </a>

    <nav
      class="hidden md:flex items-center gap-6 absolute left-1/2 -translate-x-1/2"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-[#a1a1aa] hover:text-white transition-colors"
          >
            {item.name}
          </a>
        ))
      }
    </nav>

    <button
      id="menu-btn"
      class="md:hidden p-2 text-white/80 hover:text-white transition-colors"
      aria-label="Menú principal"
    >
      <i class="fas fa-bars text-xl" aria-hidden="true"></i>
    </button>
  </div>
</header>

<div
  id="mobile-menu"
  class="fixed inset-0 z-[100] bg-[#050505] translate-x-full transition-transform duration-500 md:hidden flex flex-col"
>
  <div
    class="h-20 px-6 flex items-center justify-between border-b border-[#111111]"
  >
    <div class="flex items-center gap-3">
      <img src="/LosPerris-minimal.svg" alt="" class="w-8 h-8" />
      <span class="font-bold text-xl text-white">Navegación</span>
    </div>
    <button
      id="close-menu"
      class="p-2 w-10 h-10 rounded-full bg-white/5 text-white/60 hover:text-white transition-colors flex items-center justify-center"
      aria-label="Cerrar menú"
    >
      <i class="fas fa-times text-xl" aria-hidden="true"></i>
    </button>
  </div>

  <div class="flex-1 overflow-y-auto p-6 space-y-4">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class="block p-4 rounded-2xl bg-white/[0.03] border border-white/5 text-white font-bold hover:bg-white/[0.08] transition-all active:scale-[0.98]"
        >
          {item.name}
        </a>
      ))
    }
  </div>

  <div class="p-6 border-t border-[#111111] bg-[#050505]">
    <div class="flex items-center justify-between text-white/40 text-xs">
      <span>LosPerris © 2026</span>
      <div class="flex gap-4">
        <a
          href={discordLink}
          class="hover:text-white transition-colors"
          aria-label="Ir a nuestro Discord"
        >
          <i class="fab fa-discord" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </div>
</div>
