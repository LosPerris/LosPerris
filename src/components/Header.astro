---
import { Image } from "astro:assets";
import realImg from "../assets/img/Real.webp";
import {
    discordLink,
    discordTicketLink,
    discordUpdatesLink,
} from "../data/community";

const navItems = [
    { name: "Inicio", href: "/" },
    {
        name: "Herramientas",
        type: "dropdown",
        items: [
            { name: "Bots", href: "/#bots", icon: "fa-robot" },
            { name: "APIs", href: "/#apis", icon: "fa-code" },
        ],
    },
    {
        name: "Comunidad",
        type: "dropdown",
        items: [
            { name: "Discord", href: discordLink, icon: "fab fa-discord" },
            { name: "Soporte", href: discordTicketLink, icon: "fa-life-ring" },
            {
                name: "Actualizaciones",
                href: discordUpdatesLink,
                icon: "fa-bell",
            },
        ],
    },
    { name: "Contacto", href: "/contacto" },
];
---

<header
    class="fixed top-0 inset-x-0 z-50 h-20 bg-[#0f0f0f]/80 backdrop-blur-md border-b border-white/5 transition-all duration-300"
>
    <div
        class="h-full container mx-auto px-4 flex items-center justify-between"
    >
        <a href="/" class="flex items-center gap-3 group">
            <div class="relative">
                <div
                    class="absolute inset-0 bg-blue-500/20 rounded-full blur-md group-hover:bg-blue-500/30 transition-all"
                >
                </div>
                <Image
                    src={realImg}
                    alt="Los Perris"
                    class="relative w-10 h-10 rounded-full border border-white/10 group-hover:scale-105 transition-transform"
                    width={40}
                    height={40}
                />
            </div>
            <span class="font-bold text-xl tracking-tight text-white"
                >LosPerris</span
            >
        </a>

        <nav class="hidden md:flex items-center gap-1">
            {
                navItems.map((item) =>
                    item.type === "dropdown" ? (
                        <div class="relative group">
                            <button class="px-4 py-2 text-sm font-medium text-white/80 hover:text-white hover:bg-white/5 rounded-full transition-all flex items-center gap-2 cursor-pointer">
                                {item.name}
                                <i class="fas fa-chevron-down text-xs opacity-50 group-hover:opacity-100 transition-opacity" />
                            </button>
                            <div class="absolute top-full right-0 mt-2 w-56 p-2 bg-[#1a1a1a] border border-white/10 rounded-xl shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transform translate-y-2 group-hover:translate-y-0 transition-all duration-200">
                                {item.items.map((subItem) => (
                                    <a
                                        href={subItem.href}
                                        class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-white/5 text-white/70 hover:text-white transition-colors"
                                    >
                                        <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center text-blue-400">
                                            <i class={`fas ${subItem.icon}`} />
                                        </div>
                                        <span class="text-sm font-medium">
                                            {subItem.name}
                                        </span>
                                    </a>
                                ))}
                            </div>
                        </div>
                    ) : (
                        <a
                            href={item.href}
                            class="px-4 py-2 text-sm font-medium text-white/80 hover:text-white hover:bg-white/5 rounded-full transition-all"
                        >
                            {item.name}
                        </a>
                    ),
                )
            }
        </nav>

        <button
            id="menu-btn"
            class="md:hidden p-2 text-white/80 hover:text-white transition-colors"
            aria-label="Menu"
        >
            <i class="fas fa-bars text-xl"></i>
        </button>
    </div>
</header>

<div
    id="mobile-menu"
    class="fixed inset-0 z-[100] bg-[#0f0f0f] translate-x-full transition-transform duration-300 md:hidden flex flex-col"
>
    <div
        class="h-20 px-4 flex items-center justify-between border-b border-white/5"
    >
        <span class="font-bold text-xl text-white">Menu</span>
        <button
            id="close-menu"
            class="p-2 text-white/60 hover:text-white transition-colors"
        >
            <i class="fas fa-times text-xl"></i>
        </button>
    </div>

    <div class="flex-1 overflow-y-auto p-4 space-y-2">
        {
            navItems.map((item) =>
                item.type === "dropdown" ? (
                    <div class="space-y-2">
                        <button class="mobile-dropdown-btn w-full flex items-center justify-between p-4 rounded-xl bg-white/5 text-white font-medium">
                            {item.name}
                            <i class="fas fa-chevron-down text-sm transition-transform duration-300" />
                        </button>
                        <div class="hidden space-y-1 pl-2">
                            {item.items.map((subItem) => (
                                <a
                                    href={subItem.href}
                                    class="flex items-center gap-3 p-3 rounded-lg text-white/70 hover:text-white hover:bg-white/5 transition-colors"
                                >
                                    <i
                                        class={`fas ${subItem.icon} w-5 text-center text-blue-400`}
                                    />
                                    {subItem.name}
                                </a>
                            ))}
                        </div>
                    </div>
                ) : (
                    <a
                        href={item.href}
                        class="block p-4 rounded-xl bg-white/5 text-white font-medium hover:bg-white/10 transition-colors"
                    >
                        {item.name}
                    </a>
                ),
            )
        }
    </div>
</div>
