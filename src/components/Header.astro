---
const pathname = new URL(Astro.request.url).pathname;
const isHome =
    pathname === "/" || pathname === "/index.html" || pathname === "/index";
const isContacto = pathname.includes("contacto");

const getLink = (hash: string) => {
    if (hash.startsWith("http")) return hash;
    if (hash === "index.html" || hash === "/") return "/";
    if (!hash.startsWith("#")) return hash;
    return isHome ? hash : `/${hash}`;
};

import { Image } from "astro:assets";
import realImg from "../assets/img/Real.webp";
import {
    discordLink,
    discordTicketLink,
    discordUpdatesLink,
} from "../data/community";
---

<header
    class="fixed top-0 w-full z-50 transition-all duration-300 backdrop-blur-md bg-linear-to-br from-[#0f0f0f] via-primary to-[#0f0f0f] border-b border-white/5 shadow-lg"
>
    ...
    <span
        class="bar w-5 h-0.5 bg-linear-to-r from-white to-gray-300 my-0.5 rounded transition-all"
    ></span>
    <span
        class="bar w-5 h-0.5 bg-linear-to-r from-white to-gray-300 my-0.5 rounded transition-all"
    ></span>
    <span
        class="bar w-5 h-0.5 bg-linear-to-r from-white to-gray-300 my-0.5 rounded transition-all"
    ></span>
    <div
        class="nav-menu fixed inset-0 bg-[#0f0f0f]/95 backdrop-blur-xl flex flex-col items-center justify-start pt-28 pb-10 gap-8 translate-x-full transition-transform duration-300 md:hidden z-40 overflow-y-auto"
    >
        <ul
            class="flex flex-col items-center gap-6 w-full px-8 overflow-y-auto max-h-[calc(100vh-120px)]"
        >
            <li>
                <a
                    href={isHome ? "#home" : "/"}
                    class="nav-link text-2xl font-bold text-white hover:text-[#5865F2] transition-colors block py-2"
                    >Inicio</a
                >
            </li>
            <li class="dropdown flex flex-col items-center w-full">
                <button
                    class="nav-link text-2xl font-bold text-white hover:text-[#5865F2] transition-colors cursor-pointer flex items-center justify-center gap-3 w-full py-2 bg-transparent border-none"
                >
                    Herramientas <i
                        class="fas fa-chevron-down text-sm transition-transform duration-300"
                    ></i>
                </button>
                <div
                    class="dropdown-content hidden flex-col items-center gap-4 mt-2 bg-white/5 p-4 rounded-xl w-full border border-white/5"
                >
                    <a
                        href={getLink("#bots")}
                        class="dropdown-item text-lg text-white/90 hover:text-white w-full text-center py-2 active:scale-95 transition-all"
                        >Bots</a
                    >
                    <a
                        href={getLink("#apis")}
                        class="dropdown-item text-lg text-white/90 hover:text-white w-full text-center py-2 active:scale-95 transition-all"
                        >APIs</a
                    >
                </div>
            </li>
            <li class="dropdown flex flex-col items-center w-full">
                <button
                    class="nav-link text-2xl font-bold text-white hover:text-[#5865F2] transition-colors cursor-pointer flex items-center justify-center gap-3 w-full py-2 bg-transparent border-none"
                >
                    Comunidad <i
                        class="fas fa-chevron-down text-sm transition-transform duration-300"
                    ></i>
                </button>
                <div
                    class="dropdown-content hidden flex-col items-center gap-4 mt-2 bg-white/5 p-4 rounded-xl w-full border border-white/5"
                >
                    <a
                        href={discordLink}
                        class="dropdown-item text-lg text-white/90 hover:text-white w-full text-center py-2 active:scale-95 transition-all"
                        >Discord</a
                    >
                    <a
                        href={discordTicketLink}
                        target="_blank"
                        class="dropdown-item text-lg text-white/90 hover:text-white w-full text-center py-2 active:scale-95 transition-all"
                        >Soporte</a
                    >
                    <a
                        href={discordUpdatesLink}
                        target="_blank"
                        class="dropdown-item text-lg text-white/90 hover:text-white w-full text-center py-2 active:scale-95 transition-all"
                        >Actualizaciones</a
                    >
                </div>
            </li>
            <li>
                <a
                    href="/contacto"
                    class="nav-link text-2xl font-bold text-white hover:text-[#5865F2] transition-colors block py-2"
                    >Contacto</a
                >
            </li>
        </ul>
    </div>
</header>
